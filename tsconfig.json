{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "skipLibCheck": true,
    "types": ["astro/client", "bun", "@playwright/test", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "coverage",
    "dist",
    "node_modules",
    "packages/*/action",
    "**/*.test*.ts",
    "**/*.test*.tsx",
    "tests"
  ]
}
