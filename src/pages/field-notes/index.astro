---
import "../../styles/components/field-notes.css";
import "../../styles/components/field-notes-animations.css";
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import FieldNotesTabs from "../../components/FieldNotesTabs.astro";
import { formatMonth } from "../../utils/dates";

const fieldNotesEntry = (await getEntry("fieldNotes", "field-notes"))!;
const {
  pageTitle,
  pageDescription,
  sections,
  entries,
  latestUpdate,
  cadenceNote,
} = fieldNotesEntry.data;
const anchorLinks = sections.map((section) => ({
  href: `#${section.format}`,
  label: section.title,
}));
const latestUpdateLabel = formatMonth(latestUpdate);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link
      rel="alternate"
      type="application/rss+xml"
      href="/field-notes/rss.xml"
      title="Field notes RSS"
    />
  </Fragment>
  <PageIntro
    eyebrow="Field notes"
    title="Field notes"
    description={pageDescription}
    anchorLinks={anchorLinks}
    lastUpdated={latestUpdateLabel}
  />
  <p class="muted small">
    {cadenceNote}
    <a href="/field-notes/rss.xml">Subscribe via RSS</a>.
  </p>
  {
    /* A "latest highlight" callout restated the newest note above the list
       that opens with it, and the reading paths sat between the two copies.
       The notes come first; the paths are where to go after them. */
  }
  <FieldNotesTabs sections={sections} entries={entries} />
  <section
    class="callout field-notes__paths"
    aria-labelledby="field-notes-paths-title"
  >
    <p class="eyebrow">Reading paths</p>
    <h2 id="field-notes-paths-title">Start from the task in front of you</h2>
    <div class="field-notes__path-grid">
      <a class="field-notes__path-item" href="/diagnostics#quick-triage">
        <span class="field-notes__path-label">Incident response path</span>
        <strong>Start with diagnostics triage</strong>
      </a>
      <a class="field-notes__path-item" href="/mechanisms#mechanisms">
        <span class="field-notes__path-label">Policy drafting path</span>
        <strong>Browse the mechanisms catalog</strong>
      </a>
      <a class="field-notes__path-item" href="/glossary">
        <span class="field-notes__path-label">Shared language path</span>
        <strong>Use the glossary's definitions</strong>
      </a>
    </div>
  </section>
</BaseLayout>
