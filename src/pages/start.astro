---
import BaseLayout from "../layouts/BaseLayout.astro";
import { roles, rolePermalink, type RoleId } from "../content/roles";
import { Icon } from "astro-icon/components";

/**
 * One glyph per audience. The page asks the reader who they are and then gave
 * them seven text cards to recognise themselves in; a mark for what each role
 * holds turns a scroll into a scan. Lucide, like the rest of the chrome.
 */
const roleIcons: Record<RoleId, string> = {
  engineering: "lucide:code-2",
  policy: "lucide:scale",
  audit: "lucide:file-search",
  operations: "lucide:life-buoy",
  design: "lucide:pen-tool",
  research: "lucide:flask-conical",
  executive: "lucide:briefcase",
};

const pageTitle = "Start — Ethotechnics role paths";
const pageDescription =
  "Seven audiences, one page each. Pick the one that describes your work and get the standards, diagnostics, and checklists that bear on it.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2026-01-09T00:00:00.000Z"
  mainClass="page page--wide"
>
  <header class="section-header container">
    <span class="pill pill--ghost">Start</span>
    <h1 class="page-title">Find your path through Ethotechnics</h1>
    <p class="page-lede">
      This is the only page that asks you about yourself. Pick the role that
      describes your work; each one has a single page carrying whatever has been
      written for it. If you would rather read what the framework claims before
      deciding where you fit, <a href="/method">the method</a> never asks you anything.
    </p>
  </header>

  <main class="container">
    <nav class="role-chips" aria-label="Jump to a role">
      {
        roles.map((role) => (
          <a class="role-chip" href={`#${role.id}`}>
            <Icon name={roleIcons[role.id]} class="role-chip__icon" />
            <span>{role.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="role-grid">
      {
        roles.map((role) => (
          <article class="role-card" id={role.id}>
            <div class="role-card__header">
              <span class="role-card__glyph" aria-hidden="true">
                <Icon name={roleIcons[role.id]} />
              </span>
              <span class="role-card__badge">{role.label.toUpperCase()}</span>
              <h2 class="role-card__title">
                <a href={rolePermalink(role.id)}>{role.who}</a>
              </h2>
              <p class="role-card__tagline">{role.tagline}</p>
            </div>

            {role.orientation?.length ? (
              <div class="role-card__steps">
                <span class="role-card__steps-heading">Where to start</span>
                <ol class="role-card__step-list">
                  {role.orientation.map((step) => (
                    <li class="role-card__step-item">
                      <div class="role-card__step-content">
                        <strong class="role-card__step-title">
                          {step.title}
                        </strong>
                        <p class="role-card__step-desc">{step.description}</p>
                        <a href={step.ctaHref} class="role-card__step-link">
                          {step.ctaLabel} &rarr;
                        </a>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            ) : null}

            <p class="role-card__more">
              <a href={rolePermalink(role.id)}>
                Everything for {role.label.toLowerCase()} &rarr;
              </a>
            </p>
          </article>
        ))
      }
    </div>

    <!-- Delegation entry point -->
    <section class="matrix-banner">
      <div class="matrix-banner__content">
        <h2>Not sure what the system has been allowed to do?</h2>
        <p>
          Take one workflow and check what has been delegated, on what evidence,
          and whether the delegation is still justified. The audit asks plain
          questions and reports what has no authorizer behind it.
        </p>
      </div>
      <div class="matrix-banner__links">
        <a href="/diagnostics/delegation-audit" class="button"
          >Run a delegation audit</a
        >
        <a href="/method" class="button">Read the method</a>
      </div>
    </section>

    <!-- The two routes kept out of the front-door collapse. Neither is an
         entry point, and both were unreachable until now, which rather
         undercut the case for keeping them. -->
    <section class="matrix-banner">
      <div class="matrix-banner__content">
        <h2>Already decided to adopt?</h2>
        <p>
          Two routes assume you are past the question of whether. The fast path
          is a one-sprint adoption plan; Finite is a training environment for
          rehearsing a halt before you need one.
        </p>
      </div>
      <div class="matrix-banner__links">
        <a href="/fast-path" class="button">Adoption plan (one sprint)</a>
        <a href="/finite" class="button">Finite: stoppability drills</a>
      </div>
    </section>

    <!-- Quick Navigation Matrix -->
    <section class="matrix-banner">
      <div class="matrix-banner__content">
        <h2>Looking for a specific domain?</h2>
        <p>Explore our 4 core technical repositories directly:</p>
      </div>
      <div class="matrix-banner__links">
        <a href="/standards" class="button">1. Standards (Specs & Clauses)</a>
        <a href="/mechanisms" class="button"
          >2. Mechanisms (Architecture Blueprints)</a
        >
        <a href="/diagnostics" class="button"
          >3. Diagnostics (Interactive Workbench)</a
        >
        <a href="/glossary" class="button">4. Knowledge (Taxonomy & Metrics)</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .role-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .role-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--panel);
    font-family: var(--sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--motion-fast) ease,
      background-color var(--motion-fast) ease;
  }

  .role-chip:hover,
  .role-chip:focus-visible {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--panel));
  }

  .role-chip__icon {
    width: 1rem;
    height: 1rem;
    color: var(--accent-strong);
  }

  @media (max-width: 640px) {
    .role-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      scrollbar-width: none;
    }
    .role-chip {
      flex: 0 0 auto;
    }
  }

  .role-card {
    scroll-margin-top: calc(var(--nav-bottom, 0px) + 1rem);
  }

  .role-card__glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent-strong);
    margin-bottom: 0.5rem;
  }

  .role-card__glyph svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .role-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    margin-top: 2rem;
  }

  .role-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: var(--shadow-sm), var(--card-inner-highlight);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition:
      transform var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease;
  }

  .role-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .role-card__header {
    display: grid;
    gap: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    padding-bottom: 1rem;
  }

  .role-card__badge {
    font-size: 0.68rem;
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .role-card__title {
    margin: 0;
    font-size: 1.2rem;
    font-family: var(--sans);
    font-weight: 750;
    color: var(--text);
  }

  .role-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .role-card__title a:hover,
  .role-card__title a:focus-visible {
    text-decoration: underline;
  }

  .role-card__tagline {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.45;
  }

  /* Every card ends with the same link, so a role with no orientation steps
     still has an obvious way in rather than looking like a dead card. */
  .role-card__more {
    margin: auto 0 0;
    padding-top: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .role-card__steps {
    display: grid;
    gap: 0.75rem;
  }

  .role-card__steps-heading {
    font-size: 0.72rem;
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .role-card__step-list {
    list-style: decimal;
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 1rem;
  }

  .role-card__step-item {
    font-size: var(--text-sm);
    color: var(--text);
  }

  .role-card__step-title {
    display: block;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .role-card__step-desc {
    margin: 0 0 0.35rem 0;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .role-card__step-link {
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .role-card__step-link:hover {
    text-decoration: underline;
    color: var(--accent-strong);
  }

  .matrix-banner {
    margin: 3.5rem 0 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--surface-emphasis);
    border: 1px solid var(--border);
    display: grid;
    gap: 1.25rem;
  }

  .matrix-banner__content h2 {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
  }

  .matrix-banner__content p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .matrix-banner__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
