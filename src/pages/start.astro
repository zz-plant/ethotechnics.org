---
import BaseLayout from "../layouts/BaseLayout.astro";
import { roles, rolePermalink } from "../content/roles";
import SectionIllustration from "../components/SectionIllustration.astro";

const pageTitle = "Start — Ethotechnics role paths";
const pageDescription =
  "Seven roles, one page each. Pick the one that describes your work and get the standards, tools, and checklists that apply to it.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2026-01-09T00:00:00.000Z"
  mainClass="page page--wide"
>
  <header class="start-hero container">
    <div class="start-hero__layout">
      <div class="start-hero__main">
        <span class="pill pill--ghost">Start</span>
        <h1 class="page-title">Find your path through Ethotechnics</h1>
        <p class="page-lede">
          Seven roles, one page each. Pick the one closest to your work to see
          the standards, tools, and first steps that apply to it.
        </p>
      </div>
      <div class="start-hero__illustration">
        <SectionIllustration section="start" size="sm" />
      </div>
    </div>
  </header>

  {
    /* A section, not a main: BaseLayout already renders the page's only
       <main>, and a second one nested inside it is invalid and gives screen
       readers two main landmarks to choose between. */
  }
  <section class="container">
    <nav class="role-chips" aria-label="Jump to a role">
      {
        roles.map((role) => (
          <a class="role-chip" href={`#${role.id}`}>
            <span>{role.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="role-grid">
      {
        roles.map((role) => (
          <article class="role-card" id={role.id}>
            <div class="role-card__header">
              <span class="role-card__badge">{role.label}</span>
              <h2 class="role-card__title">
                <a href={rolePermalink(role.id)}>{role.who} &rarr;</a>
              </h2>
              <p class="role-card__tagline">{role.tagline}</p>
            </div>

            {role.orientation?.length ? (
              <div class="role-card__steps">
                <span class="role-card__steps-heading">Where to start</span>
                <ol class="role-card__step-list">
                  {role.orientation.map((step) => (
                    <li class="role-card__step-item">
                      <div class="role-card__step-content">
                        <strong class="role-card__step-title">
                          {step.title}
                        </strong>
                        <p class="role-card__step-desc">{step.description}</p>
                        <a href={step.ctaHref} class="role-card__step-link">
                          {step.ctaLabel} &rarr;
                        </a>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            ) : null}
          </article>
        ))
      }
    </div>

    <!-- Targeted operational entry points -->
    <section class="direct-tracks" aria-label="Direct tracks">
      <div class="direct-track">
        <span class="eyebrow">Delegation</span>
        <h2>Unsure what the system is allowed to decide?</h2>
        <p>
          Take one workflow and check what decisions it hands to the system, on
          what evidence, and whether that is still justified.
        </p>
        <div class="direct-track__links">
          <a href="/diagnostics/delegation-audit" class="button">Delegation audit</a>
          <a href="/method" class="button button--ghost">Methodology</a>
        </div>
      </div>

      <div class="direct-track">
        <span class="eyebrow">Affected individual</span>
        <h2>A system decided about you?</h2>
        <p>
          Three checks: can the decision be appealed, who holds authority to reverse it,
          and what evidence must be preserved?
        </p>
        <div class="direct-track__links">
          <a href="/diagnostics/self-defense-tools" class="button">Check a decision about you</a>
          <a href="/triage" class="button button--ghost">Incident triage</a>
        </div>
      </div>

      <div class="direct-track">
        <span class="eyebrow">Adoption</span>
        <h2>Already decided to adopt?</h2>
        <p>
          Two paths: follow the one-sprint adoption plan, or practice halting an
          automated system in Finite, a training simulation.
        </p>
        <div class="direct-track__links">
          <a href="#fast-path" class="button">Adoption plan</a>
          <a href="/evals#finite" class="button button--ghost">Practice in Finite</a>
        </div>
      </div>
    </section>

    <!-- Fast-path adoption (one sprint) -->
    <section id="fast-path" class="fast-path-section">
      <div class="fast-path-header">
        <span class="pill pill--ghost">Adoption plan</span>
        <h2>Adopt the basics in one sprint</h2>
        <p class="muted">
          Three safeguards with owners and effort estimates, a record format for each decision, and four things to ship.
        </p>
      </div>

      <div class="fast-path-grid">
        <div class="fast-path-card">
          <span class="fast-path-card__badge">1 day</span>
          <h3>Kill switch</h3>
          <p class="fast-path-card__owner">Ops / Reliability</p>
          <p class="fast-path-card__desc">Gives a named person a tested way to stop the automation.</p>
          <a href="/mechanisms/patterns/kill-switch" class="fast-path-link">Open mechanism &rarr;</a>
        </div>
        <div class="fast-path-card">
          <span class="fast-path-card__badge">2 days</span>
          <h3>Decision log with dissent</h3>
          <p class="fast-path-card__owner">Product / Policy</p>
          <p class="fast-path-card__desc">Records why a decision was made and who disagreed, so changes are visible.</p>
          <a href="/mechanisms/patterns/decision-log" class="fast-path-link">Open mechanism &rarr;</a>
        </div>
        <div class="fast-path-card">
          <span class="fast-path-card__badge">2 days</span>
          <h3>In-product appeal path</h3>
          <p class="fast-path-card__owner">Support / Trust</p>
          <p class="fast-path-card__desc">Gives people a way to challenge a decision inside the product.</p>
          <a href="/mechanisms/patterns/appeal-paths" class="fast-path-link">Open mechanism &rarr;</a>
        </div>
      </div>

      <div class="fast-path-details">
        <div class="fast-path-code">
          <p class="eyebrow">Example decision receipt</p>
          <pre class="code-block"><code>{`{
  "schema_version": "1.0.0",
  "receipt_id": "RCP-2026-0842",
  "issued_at": "2026-04-11T18:12:09Z",
  "owner": { "name": "Risk Operations", "role": "System owner" },
  "action": { "class": "WRITE", "description": "Eligibility update", "reversible": true },
  "clocks": { "ack": { "hours": 2 }, "review": { "hours": 24 }, "remedy": { "hours": 72 } },
  "appeal_path": { "url": "/appeals/eligibility", "channel": "in-product form" }
}`}</code></pre>
          <div class="receipt-guarantees">
            <div class="receipt-guarantee">
              <strong>Owner:</strong> Names the role that can reverse the action.
            </div>
            <div class="receipt-guarantee">
              <strong>Reversible:</strong> Says whether the decision can be undone without losing anyone's rights or records.
            </div>
            <div class="receipt-guarantee">
              <strong>Deadlines:</strong> Sets hard limits: acknowledge in 2 hours, review in 24, fix in 72. Missing one is a breach.
            </div>
            <div class="receipt-guarantee">
              <strong>Appeal path:</strong> Gives the person affected a direct link to appeal, not a general support queue.
            </div>
          </div>
          <p class="small muted">
            Check receipts against the <a href="/standards/agent-receipt-schema.json">published receipt schema</a> so tools can read them.
          </p>
        </div>

        <div class="fast-path-deliverables">
          <p class="eyebrow">Sprint deliverables</p>
          <ul class="deliverables-list">
            <li>
              <a href="/standards/agent-receipt-schema.json"><strong>Receipt schema</strong></a>
              <span>Implement the canonical receipt payload and validate it in CI.</span>
            </li>
            <li>
              <a href="/examples/automated-eligibility-denial"><strong>Worked example</strong></a>
              <span>Ship at least one end-to-end scenario with receipts, clocks, and remedies.</span>
            </li>
            <li>
              <a href="/evidence-packs"><strong>Release gate binding</strong></a>
              <span>Copy the release gate checklist into your deployment template.</span>
            </li>
            <li>
              <a href="/agents/spec"><strong>Safety Object Model</strong></a>
              <span>Publish a machine-readable description of the system's safeguards, checked in CI.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Repository surfaces index -->
    <section class="repository-sections" aria-label="Core repository sections">
      <div class="repository-sections__header">
        <span class="eyebrow">Index</span>
        <h2>The main sections</h2>
        <p class="muted">Numbered standards, safeguards, diagnostic tools, and scored cases.</p>
      </div>
      <div class="repository-sections__grid">
        <a href="/standards" class="section-card">
          <span class="section-card__tag">Rulebook</span>
          <h3 class="section-card__title">Standards &rarr;</h3>
          <p class="section-card__desc">Numbered clauses for stoppability, explainability, appealability, and human agency.</p>
        </a>
        <a href="/mechanisms" class="section-card">
          <span class="section-card__tag">Architecture</span>
          <h3 class="section-card__title">Mechanisms &rarr;</h3>
          <p class="section-card__desc">Specifications for kill switches, decision logs with dissent, and limits on automation.</p>
        </a>
        <a href="/diagnostics" class="section-card">
          <span class="section-card__tag">Assessment</span>
          <h3 class="section-card__title">Diagnostics &rarr;</h3>
          <p class="section-card__desc">Tools that score what a system may decide, who can stop it, and whether people can appeal.</p>
        </a>
        <a href="/casebook" class="section-card">
          <span class="section-card__tag">Empirical evidence</span>
          <h3 class="section-card__title">Casebook &rarr;</h3>
          <p class="section-card__desc">Public failures of automated decision systems, each scored against the standards.</p>
        </a>
        <a href="/glossary" class="section-card">
          <span class="section-card__tag">Reference</span>
          <h3 class="section-card__title">Glossary &rarr;</h3>
          <p class="section-card__desc">Definitions of the terms the standards and tools use.</p>
        </a>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .start-hero {
    padding-block: 1rem 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  }

  .start-hero__layout {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .start-hero__layout {
      grid-template-columns: 1fr auto;
      gap: 2.5rem;
    }
  }

  .start-hero__main {
    display: grid;
    gap: 0.5rem;
  }

  .start-hero__illustration {
    display: flex;
    justify-content: center;
  }

  .role-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .role-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--panel);
    font-family: var(--sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--motion-fast) ease,
      background-color var(--motion-fast) ease;
  }

  .role-chip:hover,
  .role-chip:focus-visible {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--panel));
  }

  @media (max-width: 640px) {
    .role-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      scrollbar-width: none;
    }
    .role-chip {
      flex: 0 0 auto;
    }
  }

  .role-card {
    scroll-margin-top: 0.5rem;
  }

  .role-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    margin-top: 2rem;
  }

  .role-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: var(--shadow-sm), var(--card-inner-highlight);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition:
      transform var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease;
  }

  .role-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .role-card__header {
    display: grid;
    gap: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    padding-bottom: 1rem;
  }

  .role-card__badge {
    font-size: var(--text-xs);
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .role-card__title {
    margin: 0;
    font-size: var(--text-lg);
    font-family: var(--sans);
    font-weight: 750;
    color: var(--text);
  }

  .role-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .role-card__title a:hover,
  .role-card__title a:focus-visible {
    text-decoration: underline;
  }

  .role-card__tagline {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.45;
  }

  .role-card__steps {
    display: grid;
    gap: 0.75rem;
  }

  .role-card__steps-heading {
    font-size: var(--text-xs);
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }

  .role-card__step-list {
    list-style: decimal;
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 1rem;
  }

  .role-card__step-item {
    font-size: var(--text-sm);
    color: var(--text);
  }

  .role-card__step-title {
    display: block;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .role-card__step-desc {
    margin: 0 0 0.35rem 0;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.4;
  }

  .role-card__step-link {
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .role-card__step-link:hover {
    text-decoration: underline;
    color: var(--accent-strong);
  }

  /* Targeted direct tracks */
  .direct-tracks {
    margin: 3.5rem 0 2rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .direct-track {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .direct-track h2 {
    margin: 0;
    font-size: var(--text-lg);
    font-family: var(--sans);
    font-weight: 700;
    color: var(--text);
  }

  .direct-track p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.45;
  }

  .direct-track__links {
    margin-top: auto;
    padding-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .fast-path-section {
    margin: 3.5rem 0 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    display: grid;
    gap: 2rem;
    scroll-margin-top: 1rem;
  }

  .fast-path-header h2 {
    margin: 0.5rem 0 0.25rem;
    font-size: var(--text-xl);
  }

  .fast-path-header p {
    margin: 0;
    font-size: var(--text-sm);
  }

  .fast-path-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  .fast-path-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fast-path-card__badge {
    font-size: var(--text-xs);
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .fast-path-card h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--text);
  }

  .fast-path-card__owner {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .fast-path-card__desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text);
    line-height: 1.45;
  }

  .fast-path-link {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--accent);
    text-decoration: none;
  }

  .fast-path-link:hover {
    text-decoration: underline;
    color: var(--accent-strong);
  }

  .fast-path-details {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 840px) {
    .fast-path-details {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .fast-path-code pre {
    margin: 0.5rem 0;
    max-height: 280px;
    overflow-x: auto;
    font-size: var(--text-xs);
  }

  /* Receipt semantic annotations */
  .receipt-guarantees {
    margin: 0.75rem 0;
    display: grid;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--muted);
    line-height: 1.4;
  }

  .receipt-guarantee {
    background: var(--panel);
    border-left: 2px solid var(--accent);
    padding: 0.4rem 0.65rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .receipt-guarantee strong {
    color: var(--text);
  }

  .deliverables-list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .deliverables-list li {
    display: grid;
    gap: 0.2rem;
    font-size: var(--text-sm);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }

  .deliverables-list a {
    color: var(--accent);
    text-decoration: none;
  }

  .deliverables-list a:hover {
    text-decoration: underline;
  }

  /* Repository core surfaces index */
  .repository-sections {
    margin: 4rem 0 2rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    display: grid;
    gap: 1.5rem;
  }

  .repository-sections__header h2 {
    margin: 0.25rem 0 0.25rem;
    font-size: var(--text-xl);
  }

  .repository-sections__header p {
    margin: 0;
    font-size: var(--text-sm);
  }

  .repository-sections__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }

  .section-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--text);
    transition:
      border-color var(--motion-fast) ease,
      transform var(--motion-fast) ease;
  }

  .section-card:hover,
  .section-card:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .section-card__tag {
    font-size: var(--text-xs);
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }

  .section-card__title {
    margin: 0;
    font-size: var(--text-base);
    font-family: var(--sans);
    font-weight: 700;
    color: var(--text);
  }

  .section-card:hover .section-card__title {
    color: var(--accent);
  }

  .section-card__desc {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted);
    line-height: 1.4;
  }
</style>
