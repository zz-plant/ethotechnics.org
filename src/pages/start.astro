---
import BaseLayout from "../layouts/BaseLayout.astro";
import { roles, rolePermalink } from "../content/roles";
import RosettaStone from "../components/RosettaStone.astro";
import { useCasesContent } from "../content/use-cases";

// The same four conditions /use-cases tests a system against.
const { test: applicability } = useCasesContent;

const pageTitle = "Start: role paths";
const pageDescription =
  "Pick the role that describes your work and get the standards, tools, and checklists that apply to it.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2026-01-09T00:00:00.000Z"
  mainClass="page page--wide"
>
  <header class="start-hero container">
    <div class="start-hero__layout">
      <div class="start-hero__main">
        <span class="pill pill--ghost">Start</span>
        <h1 class="page-title">Find your path through Ethotechnics</h1>
        <p class="page-lede">
          Pick the role closest to your work to see the standards, tools, and
          first steps that apply to it.
        </p>
        <p class="small muted">
          Or start from
          <a href="/triage#symptoms">a symptom you see</a>{" "}·{" "}
          <a href="#translation">an industry term</a>{" "}·{" "}
          <a href="#fast-path">the one-sprint plan</a>
        </p>

        <div class="panel panel--glass start-applicability">
          <p class="eyebrow">Does this apply to your system?</p>
          <p>{applicability.lead}</p>
          <ol class="start-applicability__test">
            {applicability.conditions.map((condition) => <li>{condition}</li>)}
          </ol>
          <p class="small">
            <a href="/use-cases">Which systems this is for</a>: six kinds of
            automated decision the standards are built for, where to start in
            each, and six where the framework does less.
          </p>
        </div>

        <div class="panel panel--glass start-applicability">
          <p class="eyebrow">If a system decided about you</p>
          <p>
            Three checks: can the decision be challenged, can the appeal change
            the outcome, and who can reverse it.
            <a href="/diagnostics/self-defense-tools"
              >Check a decision about you</a
            >
          </p>
        </div>

        <div class="panel panel--glass start-applicability">
          <p class="eyebrow">If an AI agent acts for you</p>
          <p>
            Three checks: when its permission ends, what it does without asking,
            and what you can check it against that it does not write.
            <a href="/use-cases/examples/personal-agent"
              >Check an agent that acts for you</a
            >
          </p>
        </div>
      </div>
    </div>
  </header>

  {
    /* A section, not a main: BaseLayout already renders the page's only
       <main>, and a second one nested inside it is invalid and gives screen
       readers two main landmarks to choose between. */
  }
  <section class="container">
    <div class="stack-xs role-section-header">
      <p class="eyebrow">Start by role</p>
      <h2>Find the guidance for your work</h2>
    </div>

    {
      /* Each card names who the role is and links to its page. The role page
         opens on that role's first steps; listing all seven sets of them here
         as well made this page a copy of seven others. */
    }
    <div class="role-grid">
      {
        roles.map((role) => (
          <article class="role-card" id={role.id}>
            <div class="role-card__header">
              <span class="role-card__badge">{role.label}</span>
              <h2 class="role-card__title">
                <a href={rolePermalink(role.id)}>
                  {role.who.replace(/\.$/, "")}
                </a>
              </h2>
              <p class="role-card__tagline">{role.tagline}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="time-ladder stack-sm">
      <div class="time-ladder__header">
        <p class="eyebrow">Start by time available</p>
        <h2>Half an hour, an hour, or a sprint</h2>
      </div>
      <div class="grid grid--three">
        <article class="card stack-xs">
          <span class="pill pill--ghost">30 minutes</span>
          <h3>Delegation audit</h3>
          <p class="small muted">
            Answer six questions about one workflow. See which permissions
            nobody can justify, and whether its decisions can be undone.
          </p>
          <p class="small">
            <a href="/diagnostics/delegation-audit"
              >Run the delegation audit &rarr;</a
            >
          </p>
        </article>
        <article class="card stack-xs">
          <span class="pill pill--ghost">1 hour</span>
          <h3>Rehearse stopping the system in 30 seconds</h3>
          <p class="small muted">
            Three drills: can the people who run the system stop it without
            penalty, can its decisions be reversed and the people harmed repaid,
            and who absorbs the cost when it strains.
          </p>
          <p class="small">
            <a href="/evals#finite">Open the drills &rarr;</a>
          </p>
        </article>
        <article class="card stack-xs">
          <span class="pill pill--ghost">1 sprint</span>
          <h3>The basics</h3>
          <p class="small muted">
            An appeal path that reaches the rule, a decision log that records
            dissent, and a named person who can halt the system, each with an
            owner and an effort estimate.
          </p>
          <p class="small">
            <a href="#fast-path">See the plan &rarr;</a>
          </p>
        </article>
      </div>
    </div>

    <!-- Industry translation guide -->
    <section id="translation" class="start-translation stack-sm">
      <div class="start-translation__header">
        <p class="eyebrow">Vocabulary crosswalk</p>
        <h2>Industry translation guide</h2>
        <p class="section-lead">
          Compare common AI terms with the controls and records the standards
          ask for. Each card names a check you can make.
        </p>
      </div>
      <RosettaStone />
    </section>

    <!-- Fast-path adoption (one sprint) -->
    <section id="fast-path" class="fast-path-section">
      <div class="fast-path-header">
        <span class="pill pill--ghost">Adoption plan</span>
        <h2>Adopt the basics in one sprint</h2>
        <p class="muted">
          Three safeguards with owners and effort estimates, a record format for
          each decision, and four things to ship.
        </p>
      </div>

      <div class="fast-path-grid">
        <div class="fast-path-card">
          <span class="fast-path-card__badge">2 days</span>
          <h3>An appeal path that reaches the rule</h3>
          <p class="fast-path-card__owner">
            Support / Trust, with the rule's owner
          </p>
          <p class="fast-path-card__desc">
            Gives people a way to challenge a decision inside the product, and
            counts upheld challenges by rule. A set number sends the rule back
            to its owner for review.
          </p>
          <a href="/mechanisms/patterns/appeal-paths" class="fast-path-link"
            >Open mechanism &rarr;</a
          >
        </div>
        <div class="fast-path-card">
          <span class="fast-path-card__badge">2 days</span>
          <h3>Decision log with dissent</h3>
          <p class="fast-path-card__owner">Product / Policy</p>
          <p class="fast-path-card__desc">
            Records why a decision was made and who disagreed, so changes are
            visible.
          </p>
          <a href="/mechanisms/patterns/decision-log" class="fast-path-link"
            >Open mechanism &rarr;</a
          >
        </div>
        <div class="fast-path-card">
          <span class="fast-path-card__badge">1 day</span>
          <h3>A named person who can halt it</h3>
          <p class="fast-path-card__owner">Ops / Reliability</p>
          <p class="fast-path-card__desc">
            Gives a named person a tested way to halt the automation while a
            correction is made.
          </p>
          <a href="/mechanisms/patterns/kill-switch" class="fast-path-link"
            >Open mechanism &rarr;</a
          >
        </div>
      </div>

      <div class="fast-path-details">
        <div class="fast-path-code">
          <p class="eyebrow">Example receipt</p>
          <pre
            class="code-block"
            tabindex="0"
            role="region"
            aria-label="Example receipt"><code>{`{
  "schema_version": "1.0.0",
  "receipt_id": "RCP-2026-0842",
  "issued_at": "2026-04-11T18:12:09Z",
  "owner": { "name": "Risk Operations", "role": "System owner" },
  "action": { "class": "WRITE", "description": "Eligibility update", "reversible": true },
  "clocks": { "ack": { "hours": 2 }, "review": { "hours": 24 }, "remedy": { "hours": 72 } },
  "appeal_path": { "url": "/appeals/eligibility", "channel": "in-product form" }
}`}</code></pre>
          <div class="receipt-guarantees">
            <div class="receipt-guarantee">
              <strong>Owner:</strong> Names the role that can reverse the action.
            </div>
            <div class="receipt-guarantee">
              <strong>Reversible:</strong> Says whether the decision can be undone
              without losing anyone's rights or records.
            </div>
            <div class="receipt-guarantee">
              <strong>Deadlines:</strong> Sets hard limits: acknowledge in 2 hours,
              review in 24, fix in 72. Missing one is a breach.
            </div>
            <div class="receipt-guarantee">
              <strong>Appeal path:</strong> Gives the person affected a direct link
              to appeal, not a general support queue.
            </div>
          </div>
          <p class="small muted">
            Check receipts against the <a
              href="/standards/agent-receipt-schema.json"
              >published receipt schema</a
            > so tools can read them.
          </p>
        </div>

        <div class="fast-path-deliverables">
          <p class="eyebrow">Sprint deliverables</p>
          <ul class="deliverables-list">
            <li>
              <a href="/standards/agent-receipt-schema.json"
                ><strong>Receipt schema</strong></a
              >
              <span
                >Implement the canonical receipt payload and validate it in CI.</span
              >
            </li>
            <li>
              <a href="/use-cases/examples/automated-eligibility-denial"
                ><strong>Worked example</strong></a
              >
              <span
                >Ship at least one end-to-end scenario with receipts, clocks,
                and remedies.</span
              >
            </li>
            <li>
              <a href="/mechanisms/patterns/admission-gate"
                ><strong>Admission gate</strong></a
              >
              <span
                >Record the decision to deploy as an authorization, with its
                evidence and outcome.</span
              >
            </li>
            <li>
              <a href="/agents/spec"><strong>Safety Object Model</strong></a>
              <span
                >Publish a machine-readable description of the system's
                safeguards, checked in CI.</span
              >
            </li>
          </ul>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .start-hero {
    padding-block: var(--space-4) var(--space-5);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  }

  .start-hero__layout {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .start-hero__main {
    display: grid;
    gap: var(--space-2);
  }

  .role-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    margin: var(--space-6) 0 var(--space-8);
  }

  .role-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-container);
    box-shadow: var(--shadow-sm), var(--card-inner-highlight);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    transition:
      transform var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease;
  }

  .role-card__header {
    display: grid;
    gap: var(--space-2);
  }

  .role-card__badge {
    font-size: var(--text-xs);
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .role-card__title {
    margin: 0;
    font-size: var(--text-lg);
    font-family: var(--sans);
    font-weight: 750;
    color: var(--text);
  }

  .role-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .role-card__title a:hover,
  .role-card__title a:focus-visible {
    text-decoration: underline;
  }

  .role-card__tagline {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.45;
  }

  .fast-path-section {
    margin: var(--space-8) 0 var(--space-6);
    padding: clamp(var(--space-5), 3vw, var(--space-6));
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    scroll-margin-top: 1rem;
  }

  .fast-path-section > *,
  .fast-path-details > * {
    min-width: 0;
  }

  .fast-path-header h2 {
    margin: var(--space-2) 0 var(--space-1);
    font-size: var(--text-xl);
  }

  .fast-path-header p {
    margin: 0;
    font-size: var(--text-sm);
  }

  .fast-path-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  .fast-path-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-container-compact);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .fast-path-card__badge {
    font-size: var(--text-xs);
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .fast-path-card h3 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--text);
  }

  .fast-path-card__owner {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .fast-path-card__desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text);
    line-height: 1.45;
  }

  .fast-path-link {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--accent);
    text-decoration: none;
  }

  .fast-path-link:hover {
    text-decoration: underline;
    color: var(--accent-strong);
  }

  .fast-path-details {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 840px) {
    .fast-path-details {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  .fast-path-code pre {
    margin: var(--space-2) 0;
    max-height: 280px;
    overflow-x: auto;
    font-size: var(--text-xs);
  }

  .fast-path-code pre:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  /* Receipt semantic annotations */
  .receipt-guarantees {
    margin: var(--space-3) 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--muted);
    line-height: 1.4;
  }

  .receipt-guarantee {
    background: var(--panel);
    border-left: 2px solid var(--accent);
    padding: var(--space-2) var(--space-3);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .receipt-guarantee strong {
    color: var(--text);
  }

  .deliverables-list {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .deliverables-list li {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }

  .deliverables-list a {
    color: var(--accent);
    text-decoration: none;
  }

  .deliverables-list a:hover {
    text-decoration: underline;
  }

  .start-applicability {
    margin-top: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
  }

  .start-applicability__test {
    margin: var(--space-2) 0 var(--space-3);
    padding-inline-start: 1.25em;
    display: grid;
    gap: var(--space-1);
  }

  .time-ladder {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .time-ladder__header {
    margin-bottom: var(--space-4);
  }

  .role-section-header {
    margin-bottom: var(--space-4);
  }

  .start-translation {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .start-translation__header {
    margin-bottom: var(--space-4);
  }
</style>
