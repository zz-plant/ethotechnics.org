---
import BaseLayout from "../layouts/BaseLayout.astro";
import { roles, rolePermalink, type RoleId } from "../content/roles";
import { Icon } from "astro-icon/components";
import SectionIllustration from "../components/SectionIllustration.astro";

/**
 * One glyph per audience. The page asks the reader who they are and then gave
 * them seven text cards to recognise themselves in; a mark for what each role
 * holds turns a scroll into a scan. Lucide, like the rest of the chrome.
 */
const roleIcons: Record<RoleId, string> = {
  engineering: "lucide:code-2",
  policy: "lucide:scale",
  audit: "lucide:file-search",
  operations: "lucide:life-buoy",
  design: "lucide:pen-tool",
  research: "lucide:flask-conical",
  executive: "lucide:briefcase",
};

const pageTitle = "Start — Ethotechnics role paths";
const pageDescription =
  "Seven audiences, one page each. Pick the one that describes your work and get the standards, diagnostics, and checklists that bear on it.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2026-01-09T00:00:00.000Z"
  mainClass="page page--wide"
>
  <header class="start-hero container">
    <div class="start-hero__layout">
      <div class="start-hero__main">
        <span class="pill pill--ghost">Start</span>
        <h1 class="page-title">Find your path through Ethotechnics</h1>
        <p class="page-lede">
          Seven audiences, each with its own page. Pick the one closest to your
          work to see the standards, diagnostics, and first steps that apply to
          it.
        </p>
      </div>
      <div class="start-hero__illustration">
        <SectionIllustration section="start" size="sm" />
      </div>
    </div>
  </header>

  {
    /* A section, not a main: BaseLayout already renders the page's only
       <main>, and a second one nested inside it is invalid and gives screen
       readers two main landmarks to choose between. */
  }
  <section class="container">
    <nav class="role-chips" aria-label="Jump to a role">
      {
        roles.map((role) => (
          <a class="role-chip" href={`#${role.id}`}>
            <Icon name={roleIcons[role.id]} class="role-chip__icon" />
            <span>{role.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="role-grid">
      {
        roles.map((role) => (
          <article class="role-card" id={role.id}>
            <div class="role-card__header">
              <span class="role-card__glyph" aria-hidden="true">
                <Icon name={roleIcons[role.id]} />
              </span>
              <span class="role-card__badge">{role.label.toUpperCase()}</span>
              <h2 class="role-card__title">
                <a href={rolePermalink(role.id)}>{role.who}</a>
              </h2>
              <p class="role-card__tagline">{role.tagline}</p>
            </div>

            {role.orientation?.length ? (
              <div class="role-card__steps">
                <span class="role-card__steps-heading">Where to start</span>
                <ol class="role-card__step-list">
                  {role.orientation.map((step) => (
                    <li class="role-card__step-item">
                      <div class="role-card__step-content">
                        <strong class="role-card__step-title">
                          {step.title}
                        </strong>
                        <p class="role-card__step-desc">{step.description}</p>
                        <a href={step.ctaHref} class="role-card__step-link">
                          {step.ctaLabel} &rarr;
                        </a>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            ) : null}

            <p class="role-card__more">
              <a href={rolePermalink(role.id)}>
                Everything for {role.label.toLowerCase()} &rarr;
              </a>
            </p>
          </article>
        ))
      }
    </div>

    <!-- Delegation entry point -->
    <section class="matrix-banner">
      <div class="matrix-banner__content">
        <h2>Not sure what the system has been allowed to do?</h2>
        <p>
          Take one workflow and check what has been delegated, on what evidence,
          and whether the delegation is still justified. The audit asks plain
          questions and reports what has no authorizer behind it.
        </p>
      </div>
      <div class="matrix-banner__links">
        <a href="/diagnostics/delegation-audit" class="button"
          >Run a delegation audit</a
        >
        <a href="/method" class="button">Read the method</a>
      </div>
    </section>

    <!-- Self-defense entry point for affected individuals -->
    <section class="matrix-banner">
      <div class="matrix-banner__content">
        <h2>A system decided something about you?</h2>
        <p>
          Three checks for people decided about by automated systems: can the
          decision be appealed, who holds authority to reverse it, and what
          evidence must be preserved?
        </p>
      </div>
      <div class="matrix-banner__links">
        <a href="/diagnostics/self-defense-tools" class="button"
          >Self-defense diagnostic</a
        >
        <a href="/triage" class="button">Incident triage</a>
      </div>
    </section>

    <!-- The two routes kept out of the front-door collapse. Neither is an
         entry point, and both were unreachable until now, which rather
         undercut the case for keeping them. -->
    <section class="matrix-banner">
      <div class="matrix-banner__content">
        <h2>Already decided to adopt?</h2>
        <p>
          Two routes assume you are past the question of whether. The fast path
          is a one-sprint adoption plan; Finite is a training environment for
          rehearsing a halt before you need one.
        </p>
      </div>
      <div class="matrix-banner__links">
        <a href="#fast-path" class="button">Adoption plan (one sprint)</a>
        <a href="/evals#finite" class="button">Finite: stoppability drills</a>
      </div>
    </section>

    <!-- Fast-path adoption (one sprint) -->
    <section id="fast-path" class="fast-path-section">
      <div class="fast-path-header">
        <span class="pill pill--ghost">Adoption plan</span>
        <h2>Fast-path adoption: one sprint</h2>
        <p class="muted">
          Three mechanisms with owners and effort estimates, a receipt schema, and four release deliverables.
        </p>
      </div>

      <div class="fast-path-grid">
        <div class="fast-path-card">
          <span class="fast-path-card__badge">1 day</span>
          <h3>Kill switch</h3>
          <p class="fast-path-card__owner">Ops / Reliability</p>
          <p class="fast-path-card__desc">Stops runaway automation in seconds.</p>
          <a href="/mechanisms/patterns/kill-switch" class="fast-path-link">Open mechanism &rarr;</a>
        </div>
        <div class="fast-path-card">
          <span class="fast-path-card__badge">2 days</span>
          <h3>Decision log with dissent</h3>
          <p class="fast-path-card__owner">Product / Policy</p>
          <p class="fast-path-card__desc">Records rationale and dissent, so governance cannot drift silently.</p>
          <a href="/mechanisms/patterns/decision-log" class="fast-path-link">Open mechanism &rarr;</a>
        </div>
        <div class="fast-path-card">
          <span class="fast-path-card__badge">2 days</span>
          <h3>In-product appeal path</h3>
          <p class="fast-path-card__owner">Support / Trust</p>
          <p class="fast-path-card__desc">Prevents contestability regressions and shortens recovery time.</p>
          <a href="/mechanisms/patterns/appeal-paths" class="fast-path-link">Open mechanism &rarr;</a>
        </div>
      </div>

      <div class="fast-path-details">
        <div class="fast-path-code">
          <p class="eyebrow">Canonical receipt payload</p>
          <pre class="code-block"><code>{`{
  "schema_version": "1.0.0",
  "receipt_id": "RCP-2026-0842",
  "issued_at": "2026-04-11T18:12:09Z",
  "owner": { "name": "Risk Operations", "role": "System owner" },
  "action": { "class": "WRITE", "description": "Eligibility update", "reversible": true },
  "clocks": { "ack": { "hours": 2 }, "review": { "hours": 24 }, "remedy": { "hours": 72 } },
  "appeal_path": { "url": "/appeals/eligibility", "channel": "in-product form" }
}`}</code></pre>
          <p class="small muted">
            Validate against the <a href="/standards/agent-receipt-schema.json">canonical receipt schema</a> so tooling can parse receipts automatically.
          </p>
        </div>

        <div class="fast-path-deliverables">
          <p class="eyebrow">Sprint deliverables</p>
          <ul class="deliverables-list">
            <li>
              <a href="/standards/agent-receipt-schema.json"><strong>Receipt schema</strong></a>
              <span>Implement the canonical receipt payload and validate it in CI.</span>
            </li>
            <li>
              <a href="/examples/automated-eligibility-denial"><strong>Worked example</strong></a>
              <span>Ship at least one end-to-end scenario with receipts, clocks, and remedies.</span>
            </li>
            <li>
              <a href="/evidence-packs"><strong>Release gate binding</strong></a>
              <span>Copy the release gate checklist into your deployment template.</span>
            </li>
            <li>
              <a href="/agents/spec"><strong>Safety Object Model</strong></a>
              <span>Publish the machine-readable governance profile for CI validation.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Quick Navigation Matrix -->
    <section class="matrix-banner">
      <div class="matrix-banner__content">
        <h2>Go straight to a section</h2>
      </div>
      <div class="matrix-banner__links">
        <a href="/standards" class="button">Standards (numbered clauses)</a>
        <a href="/mechanisms" class="button"
          >Mechanisms (MEC specifications)</a
        >
        <a href="/diagnostics" class="button"
          >Diagnostics (interactive tools)</a
        >
        <a href="/casebook" class="button">Casebook (scored failures)</a>
        <a href="/glossary" class="button">Knowledge (glossary and taxonomy)</a>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .start-hero {
    padding-block: 1rem 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  }

  .start-hero__layout {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .start-hero__layout {
      grid-template-columns: 1fr auto;
      gap: 2.5rem;
    }
  }

  .start-hero__main {
    display: grid;
    gap: 0.5rem;
  }

  .start-hero__illustration {
    display: flex;
    justify-content: center;
  }

  .role-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .role-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--panel);
    font-family: var(--sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--motion-fast) ease,
      background-color var(--motion-fast) ease;
  }

  .role-chip:hover,
  .role-chip:focus-visible {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--panel));
  }

  .role-chip__icon {
    width: 1rem;
    height: 1rem;
    color: var(--accent-strong);
  }

  @media (max-width: 640px) {
    .role-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      scrollbar-width: none;
    }
    .role-chip {
      flex: 0 0 auto;
    }
  }

  .role-card {
    scroll-margin-top: 0.5rem;
  }

  .role-card__glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent-strong);
    margin-bottom: 0.5rem;
  }

  .role-card__glyph svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .role-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    margin-top: 2rem;
  }

  .role-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: var(--shadow-sm), var(--card-inner-highlight);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition:
      transform var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease;
  }

  .role-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .role-card__header {
    display: grid;
    gap: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    padding-bottom: 1rem;
  }

  .role-card__badge {
    font-size: 0.68rem;
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .role-card__title {
    margin: 0;
    font-size: 1.2rem;
    font-family: var(--sans);
    font-weight: 750;
    color: var(--text);
  }

  .role-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .role-card__title a:hover,
  .role-card__title a:focus-visible {
    text-decoration: underline;
  }

  .role-card__tagline {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.45;
  }

  /* Every card ends with the same link, so a role with no orientation steps
     still has an obvious way in rather than looking like a dead card. */
  .role-card__more {
    margin: auto 0 0;
    padding-top: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .role-card__steps {
    display: grid;
    gap: 0.75rem;
  }

  .role-card__steps-heading {
    font-size: 0.72rem;
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .role-card__step-list {
    list-style: decimal;
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 1rem;
  }

  .role-card__step-item {
    font-size: var(--text-sm);
    color: var(--text);
  }

  .role-card__step-title {
    display: block;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .role-card__step-desc {
    margin: 0 0 0.35rem 0;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .role-card__step-link {
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .role-card__step-link:hover {
    text-decoration: underline;
    color: var(--accent-strong);
  }

  .matrix-banner {
    margin: 3.5rem 0 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--surface-emphasis);
    border: 1px solid var(--border);
    display: grid;
    gap: 1.25rem;
  }

  .matrix-banner__content h2 {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
  }

  .matrix-banner__content p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .matrix-banner__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .fast-path-section {
    margin: 3.5rem 0 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    display: grid;
    gap: 2rem;
    scroll-margin-top: 1rem;
  }

  .fast-path-header h2 {
    margin: 0.5rem 0 0.25rem;
    font-size: 1.4rem;
  }

  .fast-path-header p {
    margin: 0;
    font-size: var(--text-sm);
  }

  .fast-path-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  .fast-path-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fast-path-card__badge {
    font-size: 0.68rem;
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .fast-path-card h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--text);
  }

  .fast-path-card__owner {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .fast-path-card__desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text);
    line-height: 1.45;
  }

  .fast-path-link {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--accent);
    text-decoration: none;
  }

  .fast-path-link:hover {
    text-decoration: underline;
    color: var(--accent-strong);
  }

  .fast-path-details {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 840px) {
    .fast-path-details {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .fast-path-code pre {
    margin: 0.5rem 0;
    max-height: 280px;
    overflow-x: auto;
    font-size: var(--text-xs);
  }

  .deliverables-list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .deliverables-list li {
    display: grid;
    gap: 0.2rem;
    font-size: var(--text-sm);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }

  .deliverables-list a {
    color: var(--accent);
    text-decoration: none;
  }

  .deliverables-list a:hover {
    text-decoration: underline;
  }
</style>
