---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  COVERAGE_LABELS,
  checkableProperties,
  coverageOf,
  type Coverage,
} from "../../content/checkable-properties";

const pageTitle = "What we can actually check — Ethotechnics";
const pageDescription =
  "Every governance property this project claims to check, which of the two instruments can observe it, and which properties have no probe at all.";

const ORDER: Coverage[] = ["both", "live-only", "emitted-only", "none"];

const counted = (coverage: Coverage) =>
  checkableProperties.filter((property) => coverageOf(property) === coverage)
    .length;

const probeCount = checkableProperties.reduce(
  (total, property) => total + property.probes.length,
  0,
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  mainClass="page page--wide"
  publishedTime="2026-09-07T00:00:00.000Z"
>
  <section class="stack-lg">
    <p class="eyebrow">Coverage</p>
    <h1>What we can actually check</h1>
    <p class="section-lead">
      Two instruments here check things. The Tier 1 harness probes a running
      system through an adapter. The record conformance checker reads a stream
      of emitted records afterwards. They were built separately and they
      overlap, so this page states the claims rather than the tools: {
        checkableProperties.length
      } governance properties, {probeCount} probes between them, and {
        counted("none")
      } properties with no probe at all.
    </p>
    <p class="muted">
      Whether a property is checked from one side or both is not a detail of
      implementation. A live probe is available to the operator; a record probe
      is available to whoever holds the records. A property only checkable from
      inside is a property the outside world has to take on trust.
    </p>
  </section>

  <section
    class="stack-md coverage-matrix"
    aria-labelledby="coverage-matrix-title"
  >
    <h2 id="coverage-matrix-title">Every property, both sides</h2>
    <p class="muted">
      One row per claim. A filled cell is a probe that exists; an empty one is a
      side nobody can check from. Rows with neither are shaded — they are the
      framework's claims that are argued for and not yet falsifiable here.
    </p>
    <div class="mapping-table__wrapper">
      <table class="mapping-table mapping-table--stack coverage-matrix__table">
        <thead>
          <tr>
            <th scope="col">Property</th>
            <th scope="col"
              >Live probe<br /><span class="muted"
                >against a running system</span
              ></th
            >
            <th scope="col"
              >Record probes<br /><span class="muted"
                >from an emitted stream</span
              ></th
            >
            <th scope="col">Laws</th>
            <th scope="col">What the missing side would need</th>
          </tr>
        </thead>
        <tbody>
          {
            ORDER.flatMap((coverage) =>
              checkableProperties
                .filter((property) => coverageOf(property) === coverage)
                .map((property) => {
                  const live = property.probes.filter(
                    (p) => p.observes === "live",
                  );
                  const emitted = property.probes.filter(
                    (p) => p.observes === "emitted",
                  );
                  return (
                    <tr id={property.id} data-coverage={coverage}>
                      <th scope="row">
                        <strong>{property.title}</strong>
                        <span class="coverage-matrix__badge">
                          {COVERAGE_LABELS[coverage]}
                        </span>
                      </th>
                      <td data-label="Live probe">
                        {live.length > 0 ? (
                          live.map((probe) => (
                            <div class="coverage-matrix__probe">
                              <code>{probe.id}</code>
                              <span class="coverage-matrix__probe-what">
                                {probe.what}
                              </span>
                            </div>
                          ))
                        ) : (
                          <span class="coverage-matrix__empty">none</span>
                        )}
                      </td>
                      <td data-label="Record probes">
                        {emitted.length > 0 ? (
                          emitted.map((probe) => (
                            <div class="coverage-matrix__probe">
                              <code>{probe.id}</code>
                              <span class="coverage-matrix__probe-what">
                                {probe.what}
                              </span>
                            </div>
                          ))
                        ) : (
                          <span class="coverage-matrix__empty">none</span>
                        )}
                      </td>
                      <td data-label="Laws">
                        <p class="pill-list pill-list--wrap">
                          {property.laws.map((law) => (
                            <a
                              class="pill pill--ghost"
                              href={`/standards/laws#${law}`}
                            >
                              {law.replace("law-", "").toUpperCase()}
                            </a>
                          ))}
                        </p>
                      </td>
                      <td
                        data-label="What the missing side would need"
                        class="coverage-matrix__gap"
                      >
                        {property.gap ?? "—"}
                      </td>
                    </tr>
                  );
                }),
            )
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="stack-lg">
    <h2>Why this page exists</h2>
    <p>
      A check that nobody can map back to a claim is a number. A claim nobody
      can map to a check is an assertion. The catalogue behind this page is
      enforced by a test: every harness check id and every conformance finding
      id must belong to exactly one property here, or the build fails. Adding an
      instrument without saying what it establishes is not possible; dropping a
      property because nothing checks it would be visible.
    </p>
    <p class="muted">
      Source: <code>src/content/checkable-properties.ts</code>.
    </p>
  </section>
</BaseLayout>
