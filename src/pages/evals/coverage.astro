---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  COVERAGE_LABELS,
  checkableProperties,
  coverageOf,
  type Coverage,
} from "../../content/checkable-properties";

const pageTitle = "What we can actually check — Ethotechnics";
const pageDescription =
  "Every governance property this project claims to check, which of the two instruments can observe it, and which properties have no probe at all.";

const ORDER: Coverage[] = ["both", "live-only", "emitted-only", "none"];

const groups = ORDER.map((coverage) => ({
  coverage,
  label: COVERAGE_LABELS[coverage],
  properties: checkableProperties.filter(
    (property) => coverageOf(property) === coverage,
  ),
})).filter((group) => group.properties.length > 0);

const counted = (coverage: Coverage) =>
  checkableProperties.filter((property) => coverageOf(property) === coverage)
    .length;

const probeCount = checkableProperties.reduce(
  (total, property) => total + property.probes.length,
  0,
);

const GROUP_NOTES: Record<Coverage, string> = {
  both: "A live probe and a record probe both bear on the claim. These are the properties where an operator's own result and an outsider's reading of the records can disagree — which is the only configuration where either is worth much.",
  "live-only":
    "Checkable by whoever can run code against the system. A counterparty holding only records cannot verify these, so a vendor's own result is the only evidence there is.",
  "emitted-only":
    "Checkable by anyone holding a record stream, including people the operator did not choose. These are the claims that survive the operator losing interest.",
  none: "Named, argued for, and not yet falsifiable here. Listing them next to the rest is the point: a framework that only publishes its checkable claims looks stronger than it is.",
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  mainClass="page page--wide"
  publishedTime="2026-09-07T00:00:00.000Z"
>
  <section class="stack-lg">
    <p class="eyebrow">Coverage</p>
    <h1>What we can actually check</h1>
    <p class="section-lead">
      Two instruments here check things. The Tier 1 harness probes a running
      system through an adapter. The record conformance checker reads a stream
      of emitted records afterwards. They were built separately and they
      overlap, so this page states the claims rather than the tools: {
        checkableProperties.length
      } governance properties, {probeCount} probes between them, and {
        counted("none")
      } properties with no probe at all.
    </p>
    <p class="muted">
      Whether a property is checked from one side or both is not a detail of
      implementation. A live probe is available to the operator; a record probe
      is available to whoever holds the records. A property only checkable from
      inside is a property the outside world has to take on trust.
    </p>
  </section>

  {
    groups.map((group) => (
      <section class="stack-lg coverage-group">
        <h2>
          {group.label}{" "}
          <span class="muted small">({group.properties.length})</span>
        </h2>
        <p class="muted">{GROUP_NOTES[group.coverage]}</p>
        <div class="stack-lg">
          {group.properties.map((property) => (
            <article class="card" id={property.id}>
              <h3>{property.title}</h3>
              <p>{property.claim}</p>
              {property.probes.length > 0 && (
                <ul class="card__list">
                  {property.probes.map((probe) => (
                    <li>
                      <strong>
                        {probe.observes === "live"
                          ? `Harness ${probe.id}`
                          : `Records: ${probe.id}`}
                      </strong>{" "}
                      — {probe.what}
                    </li>
                  ))}
                </ul>
              )}
              {property.gap && (
                <p class="muted small">
                  <strong>Unprobed:</strong> {property.gap}
                </p>
              )}
              <p class="pill-list pill-list--wrap">
                {property.laws.map((law) => (
                  <a class="pill pill--ghost" href={`/standards/laws#${law}`}>
                    {law.replace("law-", "Law ").toUpperCase()}
                  </a>
                ))}
              </p>
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <section class="stack-lg">
    <h2>Why this page exists</h2>
    <p>
      A check that nobody can map back to a claim is a number. A claim nobody
      can map to a check is an assertion. The catalogue behind this page is
      enforced by a test: every harness check id and every conformance finding
      id must belong to exactly one property here, or the build fails. Adding an
      instrument without saying what it establishes is not possible; dropping a
      property because nothing checks it would be visible.
    </p>
    <p class="muted">
      Source: <code>src/content/checkable-properties.ts</code>.
    </p>
  </section>
</BaseLayout>
