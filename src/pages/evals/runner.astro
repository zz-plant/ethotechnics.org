---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvalRunnerWidget from "../../features/eval-runner/EvalRunner";

const pageTitle = "Governance Eval Runner — Ethotechnics";
const pageDescription =
  "Step through governance eval test cases, capture evidence, and generate a scored report.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  mainClass="page page--wide"
  publishedTime="2026-07-27T00:00:00.000Z"
>
  <section class="stack-lg">
    <p class="eyebrow">Eval runner</p>
    <h1>Governance eval runner</h1>
    <p class="section-lead">
      Step through test cases one at a time. Score each one, capture evidence,
      and generate a report with aggregate score and grade.
    </p>
    <p class="muted">
      In Phase 1, all scoring is manual. Each test case includes a prompt,
      system context, pass criteria, fail indicators, and a scoring rubric. The
      runner does not call any AI — it structures the review process and
      computes results from your manual scores.
    </p>
  </section>

  <EvalRunnerWidget client:visible />
</BaseLayout>
