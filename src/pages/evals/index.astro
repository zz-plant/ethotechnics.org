---
import InlineScript from "../../components/InlineScript.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import FiniteSection from "../../components/FiniteSection.astro";
import EvalStackFigure from "../../components/EvalStackFigure.astro";
import { evalsContent } from "../../content/evals";
import { evalTestCases } from "../../content/eval-test-cases";
import { tier1Checks } from "../../harness/checks";

const machineCaseCount = tier1Checks.length;
const draftSuiteCount = evalsContent.suites.filter(
  (suite) => suite.status === "draft",
).length;

const {
  pageTitle,
  pageDescription,
  permalink,
  anchorLinks,
  suites,
  evaluationStack,
} = evalsContent;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": permalink,
  name: pageTitle,
  description: pageDescription,
  url: new URL(permalink, Astro.site ?? Astro.url.origin).toString(),
  hasPart: suites.map((suite) => ({
    "@type": "CreativeWork",
    name: suite.title,
    description: suite.description,
    url: new URL(
      `/evals/${suite.slug}`,
      Astro.site ?? Astro.url.origin,
    ).toString(),
    version: suite.version,
  })),
};
const structuredDataJson = JSON.stringify(structuredData, null, 2);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="collection"
>
  <PageIntro
    eyebrow="Evals"
    title="Governance eval suites"
    description={`Suites that test whether a deployed system's authority is still valid, who carries its burden, and whether it can be stopped, its decisions appealed and reversed, and the harm repaired within a stated time limit. ${machineCaseCount} of the ${evalTestCases.length} cases run automatically; a reviewer scores the rest against a written rubric. ${draftSuiteCount} of the ${evalsContent.suites.length} suites are drafts.`}
    anchorLinks={anchorLinks}
  >
    <Fragment slot="actions">
      <a class="button ghost" href="/evals/coverage">What the evals can check</a
      >
      <a class="button ghost" href="/use-cases#model-testing"
        >Evals test the deployment, not the model</a
      >
    </Fragment>
  </PageIntro>

  <SectionBlock
    id="stack"
    eyebrow="Evaluation stack"
    title={evaluationStack.title}
    description={evaluationStack.description}
  >
    <EvalStackFigure detail />
  </SectionBlock>

  {
    /* The one list of suites. A second section listed the same sixteen as
       cards grouped by layer, under layer headings that restated the stack
       above; the description each card carried now sits in its row. */
  }
  <SectionBlock
    id="register"
    title="The suite register"
    description="Each suite tests one property at one layer of the stack. Evaluate at the highest layer capable of producing the failure you care about; a clean result at a lower layer is not evidence about a higher one."
  >
    <div
      class="mapping-table__wrapper"
      tabindex="0"
      role="region"
      aria-label="The suite register"
    >
      <table class="mapping-table mapping-table--stack catalogue-table">
        <thead>
          <tr>
            <th scope="col">Suite</th>
            <th scope="col">Layer</th>
            <th scope="col" class="catalogue-table__num">Cases</th>
            <th scope="col" class="catalogue-table__num">Automated</th>
            <th scope="col">Scoring</th>
          </tr>
        </thead>
        <tbody>
          {
            suites.map((suite) => {
              const cases = evalTestCases.filter(
                (tc) => tc.suiteId === suite.id,
              );
              const machine = tier1Checks.filter(
                (c) => c.suiteId === suite.id,
              ).length;
              const layer = evaluationStack.layers.find(
                (l) => l.id === suite.layer,
              );
              return (
                <tr>
                  <th scope="row">
                    <a href={`/evals/${suite.slug}`}>{suite.title}</a>
                    <span class="catalogue-table__summary">
                      {suite.description}
                    </span>
                  </th>
                  <td data-label="Layer">{layer?.title ?? suite.layer}</td>
                  <td data-label="Cases" class="catalogue-table__num">
                    {cases.length}
                  </td>
                  <td data-label="Automated" class="catalogue-table__num">
                    {machine > 0 ? machine : "—"}
                  </td>
                  <td data-label="Scoring">
                    {suite.scoringMethod.type.replace(/-/g, " ")}
                    <span class="muted">
                      {" "}
                      · pass at {suite.scoringMethod.passingScore}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </SectionBlock>

  <SectionBlock
    id="methodology"
    eyebrow="Methodology"
    title="How evals are scored"
    description="Most cases are scored by a human reviewer against a written rubric, using evidence the reviewer collects."
  >
    <div class="grid grid--three">
      <div class="panel">
        <p class="eyebrow">Scoring anchors</p>
        <ul class="card__list">
          <li>
            <strong>Binary:</strong> pass or fail.
          </li>
          <li><strong>0–3:</strong> Absent → Partial → Adequate → Strong.</li>
          <li>
            <strong>0–5:</strong> Absent → Minimal → Basic → Adequate → Strong → Exemplary.
          </li>
        </ul>
        <p class="small muted">
          One set of anchors serves every case, so "minor gaps" is the
          reviewer's call. Whether two reviewers score the same system the same
          way has not been measured.
        </p>
      </div>
      <div class="panel">
        <p class="eyebrow">Scoring methods</p>
        <ul class="card__list">
          <li>
            <strong>Weighted average:</strong> Each test case contributes according
            to its weight. The overall score must meet the passing threshold.
          </li>
          <li>
            <strong>Min-threshold:</strong> All test cases must score at or above
            the minimum threshold. A single critical failure fails the suite.
          </li>
          <li>
            <strong>All-must-pass:</strong> Every test case must pass. Used where
            one failure disqualifies the system.
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Manual scoring</p>
        <p class="muted">
          A human reviewer runs each test case, collects evidence, and assigns a
          score from the rubric. The runner on this site does not call a model.
          The {machineCaseCount} automated cases run through a separate harness.
        </p>
      </div>
    </div>
  </SectionBlock>

  <SectionBlock
    id="coverage"
    eyebrow="Coverage"
    title="What these evals can show, and what nothing here checks"
    description="The suites are one of two ways this site checks a system. Neither covers every claim the framework makes."
  >
    <p>
      {machineCaseCount} of these cases can be answered by machine, and a separate
      checker grades the decision records a system writes. <a
        href="/evals/coverage">What we can actually check</a
      >
      maps each check to the governance property it is evidence for, says whether
      it runs against the live system or its records, and lists the properties nothing
      checks.
    </p>
  </SectionBlock>

  <SectionBlock
    id="run"
    eyebrow="Run an eval"
    title="Run a governance eval suite"
    description="The runner steps a reviewer through each test case, records evidence, and produces a scored report."
  >
    <p>
      <a class="button primary" href="/evals/runner"> Open eval runner </a>
    </p>
    <ul class="card__list">
      <li>Pick one suite, or run all of them for a full assessment.</li>
      <li>
        Each test case presents a prompt and system context for the reviewer.
      </li>
      <li>Score each test case against its rubric.</li>
      <li>Attach evidence and notes for each test case.</li>
      <li>
        Generate a scored report with an aggregate score, a grade, and
        recommendations.
      </li>
    </ul>
  </SectionBlock>

  <FiniteSection />

  <InlineScript type="application/ld+json" code={structuredDataJson} />
</BaseLayout>
