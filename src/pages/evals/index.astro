---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import { evalsContent } from "../../content/evals";
import { evalTestCases } from "../../content/eval-test-cases";

const {
  pageTitle,
  pageDescription,
  permalink,
  anchorLinks,
  panelCopy,
  suites,
} = evalsContent;

const suiteTestCaseCounts = new Map(
  suites.map((suite) => [
    suite.id,
    evalTestCases.filter((tc) => tc.suiteId === suite.id).length,
  ]),
);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": permalink,
  name: pageTitle,
  description: pageDescription,
  url: new URL(permalink, Astro.site ?? Astro.url.origin).toString(),
  hasPart: suites.map((suite) => ({
    "@type": "CreativeWork",
    name: suite.title,
    description: suite.description,
    url: new URL(`/evals/${suite.slug}`, Astro.site ?? Astro.url.origin).toString(),
    version: suite.version,
  })),
};
const structuredDataJson = JSON.stringify(structuredData, null, 2);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="collection"
>
  <PageIntro
    eyebrow="Evals"
    title={panelCopy.title}
    description={panelCopy.description}
    permalink={permalink}
    anchorLinks={anchorLinks}
    panelCopy={panelCopy}
  />

  <SectionBlock
    id="suites"
    eyebrow="Available suites"
    title="Governance eval suites"
    description="Each suite tests a specific governability dimension. Run them individually or combine for a full assessment."
  >
    <CardGrid className="grid--two">
      {
        suites.map((suite) => {
          const testCount = suiteTestCaseCounts.get(suite.id) ?? 0;

          return (
            <CardItem
              eyebrow={suite.category}
              title={suite.title}
              description={suite.description}
            >
              <p class="muted small">
                <span class={`status-badge status-badge--${suite.status}`}>
                  {suite.status}
                </span>
                · {testCount} test case{testCount === 1 ? "" : "s"}
                · Est. {suite.estimatedTime}
              </p>
              <a slot="footer" class="muted" href={`/evals/${suite.slug}`}>
                Open suite
              </a>
            </CardItem>
          );
        })
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="methodology"
    eyebrow="Methodology"
    title="How evals are scored"
    description="Phase 1 scoring is manual and evidence-based. Each test case is evaluated by a human reviewer using a defined rubric."
    variant="alt"
  >
    <div class="grid grid--three">
      <div class="panel">
        <p class="eyebrow">Scoring anchors</p>
        <ul class="card__list">
          <li><strong>Binary:</strong> Pass/fail — condition is met or not.</li>
          <li><strong>0–3:</strong> Absent → Partial → Adequate → Strong.</li>
          <li><strong>0–5:</strong> Absent → Minimal → Basic → Adequate → Strong → Exemplary.</li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Scoring methods</p>
        <ul class="card__list">
          <li><strong>Weighted average:</strong> Each test case contributes according to its weight. Overall score must meet the passing threshold.</li>
          <li><strong>Min-threshold:</strong> All test cases must score at or above the minimum threshold. Single critical failure fails the suite.</li>
          <li><strong>All-must-pass:</strong> Every test case must pass. Used for high-stakes suites.</li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Manual scoring</p>
        <p class="muted">
          In Phase 1, all evals are run manually. A human reviewer runs each test case, captures evidence, and assigns scores using the rubric. Automated runner support is planned for Phase 2.
        </p>
      </div>
    </div>
  </SectionBlock>

  <SectionBlock
    id="run"
    eyebrow="Run an eval"
    title="Run a governance eval suite"
    description="Use the eval runner to step through test cases, capture evidence, and generate a scored report."
  >
    <p>
      <a class="button primary" href="/evals/runner">
        Open eval runner
      </a>
    </p>
    <ul class="card__list">
      <li>Select a suite or run all suites for a full governability assessment.</li>
      <li>Each test case presents a prompt and system context for the reviewer.</li>
      <li>Score each test case using the provided rubric anchors.</li>
      <li>Attach evidence and notes for each test case.</li>
      <li>Generate a scored report with aggregate score, grade, and recommendations.</li>
    </ul>
  </SectionBlock>

  <script
    type="application/ld+json"
    set:html={structuredDataJson}
    is:inline
  />
</BaseLayout>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    margin: 0 0.2rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .status-badge--draft {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent);
  }

  .status-badge--stable {
    background: color-mix(in srgb, #2d8a4a 16%, transparent);
    color: #2d8a4a;
  }
</style>
