---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { diagnosticsContent } from "../../content/diagnostics";
import { getRole, roles, rolePermalink } from "../../content/roles";
import { getStandardBySlug } from "../../content/standards";

/**
 * Resolved per request rather than prerendered, matching
 * /mechanisms/patterns/[slug]. Under `output: "server"` the prerendered
 * dynamic routes on this site currently build to a placeholder rather than
 * their HTML (see docs/planning/prerender-finding-2026-09.md); this route
 * takes the shape that is known to serve correctly.
 */
const role = getRole(Astro.params.role ?? "");
if (!role) return new Response("Role not found", { status: 404 });

// "Research — Ethotechnics" was also the research programme's title. A role
// page is a path through the material, and its title now says so.
const pageTitle = `${role.label}: role path`;
const pageDescription = role.tagline;

// What to attend to and what to have in place were two sections of three
// and four bullets each. They share one section, a column each.
const hasFocus = Boolean(role.guide?.focusAreas.length);
const hasChecklist = Boolean(role.adoptionChecklist?.length);
const practiceTitle =
  hasFocus && hasChecklist
    ? "What to attend to, and what to have in place"
    : hasFocus
      ? "What to attend to"
      : "What to have in place";

const anchorLinks = [
  role.orientation?.length
    ? { href: "#first-moves", label: "Where to start" }
    : null,
  role.featuredDiagnostics?.length ||
  role.featuredStandards?.length ||
  role.guide?.keyLinks.length
    ? { href: "#tools", label: "What to open" }
    : null,
  role.guide || role.adoptionChecklist?.length
    ? { href: "#practice", label: practiceTitle }
    : null,
].filter((link): link is { href: string; label: string } => link !== null);

const others = roles.filter((entry) => entry.id !== role.id);

// The heading says what the steps are for, not how many there are.
const firstMovesTitle = "First steps, in order";

const diagnosticTitle = (slug: string) =>
  diagnosticsContent.tools.find((tool) => tool.slug === slug)?.title ??
  slug.replaceAll("-", " ");

const standardLabel = (slug: string) => {
  const standard = getStandardBySlug(slug);
  return standard ? `${standard.id}: ${standard.title}` : slug;
};

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Start", url: "/start" },
  { name: role.label, url: rolePermalink(role.id) },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2026-09-07T00:00:00.000Z"
  breadcrumbItems={breadcrumbItems}
>
  <PageIntro
    eyebrow="For your role"
    title={role.label}
    description={role.tagline}
    anchorLinks={anchorLinks}
  >
    <Fragment slot="actions">
      <a class="button ghost" href="/use-cases">Which systems this is for</a>
    </Fragment>
  </PageIntro>

  {
    role.orientation?.length && (
      <SectionBlock
        id="first-moves"
        eyebrow="Where to start"
        title={firstMovesTitle}
      >
        <ol class="step-list stack-md">
          {role.orientation.map((step) => (
            <li class="card stack-sm">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
              <p>
                <a class="button ghost button--compact" href={step.ctaHref}>
                  {step.ctaLabel}
                </a>
              </p>
            </li>
          ))}
        </ol>
      </SectionBlock>
    )
  }

  {
    /* One section for everything the role should open. Diagnostics and
       standards used to sit here and a reading list in a second section
       further down, which also linked the hubs the header already reaches. */
  }
  {
    (role.featuredDiagnostics?.length ||
      role.featuredStandards?.length ||
      role.guide?.keyLinks.length) && (
      <SectionBlock
        id="tools"
        title="What to run, satisfy, and read"
        description="The diagnostics that show risk in this role's work, the standards that apply to it, and the reading behind them."
      >
        <div class="grid grid--three">
          {role.featuredDiagnostics?.length ? (
            <div class="card stack-sm">
              <p class="eyebrow">Diagnostics</p>
              <ul class="card__list">
                {role.featuredDiagnostics.map((slug) => (
                  <li>
                    <a href={`/diagnostics/${slug}`}>{diagnosticTitle(slug)}</a>
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
          {role.featuredStandards?.length ? (
            <div class="card stack-sm">
              <p class="eyebrow">Standards</p>
              <ul class="card__list">
                {role.featuredStandards.map((slug) => (
                  <li>
                    <a href={`/standards/${slug}`}>{standardLabel(slug)}</a>
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
          {role.guide?.keyLinks.length ? (
            <div class="card stack-sm">
              <p class="eyebrow">Reading</p>
              <ul class="card__list">
                {role.guide.keyLinks.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                    {link.note && <span class="muted"> — {link.note}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
        </div>
      </SectionBlock>
    )
  }

  {
    (hasFocus || hasChecklist) && (
      <SectionBlock id="practice" title={practiceTitle} variant="alt">
        <div class:list={[{ "grid grid--two": hasFocus && hasChecklist }]}>
          {hasFocus && (
            <div id="focus" class="stack-sm">
              {hasChecklist && <p class="eyebrow">The parts of the method</p>}
              <ul class="card__list">
                {role.guide?.focusAreas.map((area) => (
                  <li>{area}</li>
                ))}
              </ul>
            </div>
          )}
          {hasChecklist && (
            <div id="adopt" class="stack-sm">
              {hasFocus && <p class="eyebrow">Once you adopt</p>}
              <p class="small muted">Each line either exists or does not.</p>
              <ul class="card__list">
                {role.adoptionChecklist?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </SectionBlock>
    )
  }

  <SectionBlock eyebrow="Other roles" title="If that was not you">
    <ul class="card__list">
      {
        others.map((entry) => (
          <li>
            <a href={rolePermalink(entry.id)}>{entry.label}</a>
            <span class="muted"> — {entry.who}</span>
          </li>
        ))
      }
    </ul>
  </SectionBlock>
</BaseLayout>
