---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { tier1Checks } from "../../harness/checks";
import { evalsContent } from "../../content/evals";
import { evalTestCases } from "../../content/eval-test-cases";

const machineAnswerable = tier1Checks.map((check) => {
  const suite = evalsContent.suites.find((s) => s.id === check.suiteId);
  const testCase = evalTestCases.find((tc) => tc.id === check.id);
  return {
    ...check,
    suiteTitle: suite?.title ?? check.suiteId,
    href: suite ? `/evals/${suite.slug}` : "/evals",
    layer: testCase?.layer ?? suite?.layer ?? "",
  };
});

const pageTitle = "Measurement tiers — Ethotechnics Institute";
const pageDescription =
  "Five measures: whether challenges change the rule, what the system costs people, and whether it can be reversed and halted. Each has three evidence levels.";

const mpis = [
  {
    id: "rule-change",
    title: "Rule change after upheld challenges",
    summary:
      "Share of rules that crossed a set number of upheld challenges and were then revised or kept with a published reason, and how long that took.",
    tiers: [
      {
        tier: "Tier 0",
        evidence:
          "Upheld challenges recorded with the rule that produced each decision.",
      },
      {
        tier: "Tier 1",
        evidence:
          "A count by rule sent to each rule's owner, with the owner's answer and its date.",
      },
      {
        tier: "Tier 2",
        evidence:
          "A sample of rule changes traced back to the challenges that prompted them, checked by someone outside the team.",
      },
    ],
    gaming:
      "Coding each upheld challenge as a one-off exception so no rule ever reaches the threshold.",
    detection:
      "Join exception codes to rule identifiers, and count a rule's one-off exceptions toward its total anyway.",
  },
  {
    id: "appeal-success",
    title: "Appeal success rate",
    summary:
      "Share of contested decisions that result in reversal or remedy. A high rate is evidence the rule is wrong, not proof the appeal path works.",
    tiers: [
      {
        tier: "Tier 0",
        evidence: "Appeal intake records with outcomes and timestamps.",
      },
      {
        tier: "Tier 1",
        evidence: "Reviewer roster coverage and SLA compliance for appeals.",
      },
      {
        tier: "Tier 2",
        evidence: "External audit sampling of appeal outcomes for consistency.",
      },
    ],
    gaming:
      "Redirecting appeals to off-platform channels so they are not counted.",
    detection:
      "Check for a mismatch between receipts issued and appeals recorded.",
  },
  {
    id: "burden-ratio",
    title: "Burden ratio",
    summary:
      "Relative time cost imposed on impacted people versus internal operators.",
    tiers: [
      {
        tier: "Tier 0",
        evidence:
          "Journey maps with time cost logs for entry, exit, and appeal flows.",
      },
      {
        tier: "Tier 1",
        evidence: "Time-on-task analytics with segmentation by user cohort.",
      },
      {
        tier: "Tier 2",
        evidence: "Independent usability studies verifying time cost deltas.",
      },
    ],
    gaming:
      "Measuring only successful flows while ignoring drop-offs or abandoned cases.",
    detection:
      "Require abandonment rates and cross-check them with support tickets.",
  },
  {
    id: "reversibility",
    title: "Reversibility rate",
    summary:
      "Percent of automated decisions that can be reversed without collateral harm.",
    tiers: [
      {
        tier: "Tier 0",
        evidence: "Decision logs with reversal flags and rollbacks executed.",
      },
      {
        tier: "Tier 1",
        evidence:
          "Appeal outcomes segmented by decision type and reversal latency.",
      },
      {
        tier: "Tier 2",
        evidence:
          "Quarterly audits that test reversal paths on randomly sampled cases.",
      },
    ],
    gaming:
      "Counting only low-stakes cases while excluding high-impact reversals.",
    detection:
      "Sample by impact tier and check for missing high-severity cases.",
  },
  {
    id: "time-to-halt",
    title: "Time-to-halt (TTH)",
    summary: "Elapsed time from detection to a confirmed automation halt.",
    tiers: [
      {
        tier: "Tier 0",
        evidence:
          "System logs showing halt trigger and halt completion timestamps.",
      },
      {
        tier: "Tier 1",
        evidence:
          "Drill reports with median and p95 halt times by team and system.",
      },
      {
        tier: "Tier 2",
        evidence:
          "Incident postmortems verifying production halt times under load.",
      },
    ],
    gaming:
      "Halt tests run on low-traffic sandboxes instead of production paths.",
    detection:
      "Compare drill environment IDs against the production system inventory.",
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro
    eyebrow="Measurement tiers"
    title="Measurement tiers and how each measure is gamed"
    description={pageDescription}
    anchorLinks={[
      ...mpis.map((mpi) => ({ href: `#${mpi.id}`, label: mpi.title })),
      { href: "#harness", label: "Tier 1 harness" },
    ]}
  />

  <SectionBlock
    eyebrow="How to use"
    title="Apply the tiers to every measure"
    description="Five measures, the first the one the others serve. Tier 0 is the baseline. Each higher tier needs stronger evidence than the one below it."
  >
    <ul class="muted">
      <li>Tier 0 shows the system records the measure at all.</li>
      <li>Tier 1 shows people run drills and review the results.</li>
      <li>
        Tier 2 shows the measure holds in real incidents and in independent audit samples.
      </li>
    </ul>
  </SectionBlock>

  {
    mpis.map((mpi, index) => (
      <SectionBlock
        id={mpi.id}
        eyebrow="Measure"
        title={mpi.title}
        description={mpi.summary}
        variant={index % 2 === 1 ? "alt" : undefined}
      >
        <h3>Evidence at each tier</h3>
        <ul class="muted">
          {mpi.tiers.map((tier) => (
            <li>
              <strong>{tier.tier}:</strong> {tier.evidence}
            </li>
          ))}
        </ul>
        <h3>How it is gamed</h3>
        <p class="muted">{mpi.gaming}</p>
        <h3>How to detect the gaming</h3>
        <p class="muted">{mpi.detection}</p>
      </SectionBlock>
    ))
  }

  <SectionBlock
    id="harness"
    eyebrow="Tier 1 harness"
    title="Eval cases a machine can answer"
    description={`Of the ${evalTestCases.length} eval cases, ${machineAnswerable.length} are timed or yes-or-no questions about a running system. The Tier 1 harness answers them without a human reviewer. If the connection to a system cannot answer one, the harness reports it as unsupported. That is a finding about the system, never a pass.`}
  >
    <ul class="muted">
      {
        machineAnswerable.map((check) => (
          <li>
            <strong>{check.id}</strong> {check.title} ·{" "}
            <a href={check.href}>{check.suiteTitle}</a>
            {check.layer && <> · {check.layer} layer</>}
          </li>
        ))
      }
    </ul>
    <p class="muted">
      The harness is one of two ways this site checks a system. <a
        href="/evals/coverage">What we can actually check</a
      > maps each of these {machineAnswerable.length} cases, and every finding the
      record conformance checker raises, to the governance property it is evidence
      for. It also lists the properties neither tool reaches.
    </p>
  </SectionBlock>
</BaseLayout>
