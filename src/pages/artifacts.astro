---
import BaseLayout from "../layouts/BaseLayout.astro";
import { artifacts } from "../content/institute-site";
---

<BaseLayout
  title="Governance artifacts you can adopt as-is"
  description="Operational defaults for ownership, reversibility, and burden limits."
>
  <section class="stack-lg institute-screen">
    <h1>Governance artifacts you can adopt as-is</h1>
    <p>
      These are operational defaults, not guidance.<br />
      Each artifact assigns ownership, enforces reversibility, and limits claimant burden.
    </p>
    <ul class="artifact-grid">
      {artifacts.map((artifact) => (
        <li class="card stack-sm">
          <h2>{artifact.name}</h2>
          <p class="muted small">Operational governance artifact</p>
          <a class="button" href={`/artifact/${artifact.slug}`}>
            View {artifact.name} details
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
