---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  artifacts,
  type InstituteArtifact,
} from "../../content/institute-site";

const slug = Astro.params.slug;
const artifact =
  (Astro.props.artifact as InstituteArtifact | undefined) ??
  artifacts.find((candidate) => candidate.slug === slug);

if (!artifact) return new Response("Artifact not found", { status: 404 });
---

<BaseLayout
  title={artifact.name}
  description={artifact.description[0]}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <section class="stack-lg institute-screen">
    <h1>{artifact.name}</h1>
    {artifact.description.map((line) => <p>{line}</p>)}

    <h2>What this enforces</h2>
    <ul>
      {artifact.enforcesBullets.map((bullet) => <li>{bullet}</li>)}
    </ul>

    <h2>How to use</h2>
    <ol>
      {artifact.howToSteps.map((step) => <li>{step}</li>)}
    </ol>

    <p>
      <a class="button primary" href={artifact.downloadUrl}>Download template</a
      >
    </p>
    <p class="small muted">{artifact.finalLine}</p>
  </section>
</BaseLayout>
