---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  artifacts,
  type InstituteArtifact,
} from "../../content/institute-site";

const slug = Astro.params.slug;
const artifact =
  (Astro.props.artifact as InstituteArtifact | undefined) ??
  artifacts.find((candidate) => candidate.slug === slug);

if (!artifact) return new Response("Artifact not found", { status: 404 });

/**
 * The artifact, as text you can take away.
 *
 * Every downloadUrl in the register is "#", so the page's primary control was
 * a Download button that went nowhere, on the one page type whose whole job is
 * handing over a document. This builds the document out of what the artifact
 * already states -- its obligations and its steps -- so the reader can read it
 * before taking it, and copying it gives exactly what is on the screen.
 */
const templateText = [
  `# ${artifact.name}`,
  "",
  ...artifact.description,
  "",
  "## What this enforces — record how each one is met",
  "",
  ...artifact.enforcesBullets.flatMap((bullet) => [
    `- [ ] ${bullet}`,
    "      Evidence:",
  ]),
  "",
  "## How to use",
  "",
  ...artifact.howToSteps.map((step, index) => `${index + 1}. ${step}`),
  "",
  artifact.finalLine,
].join("\n");
---

<BaseLayout
  title={artifact.name}
  description={artifact.description[0]}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <section class="stack-lg institute-screen">
    <h1>{artifact.name}</h1>
    {artifact.description.map((line) => <p>{line}</p>)}

    <h2>What this enforces</h2>
    <ul>
      {artifact.enforcesBullets.map((bullet) => <li>{bullet}</li>)}
    </ul>

    <h2>How to use</h2>
    <ol>
      {artifact.howToSteps.map((step) => <li>{step}</li>)}
    </ol>

    <h2 id="the-template">The template</h2>
    <pre class="artifact-template"><code>{templateText}</code></pre>
    <p class="small muted">{artifact.finalLine}</p>
  </section>
</BaseLayout>
