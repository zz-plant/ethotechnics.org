---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  artifacts,
  type InstituteArtifact,
} from "../../content/institute-site";

/**
 * The five templates, each in full on this one page.
 *
 * Each used to have its own page, which repeated the card on this one and
 * added the steps and the template text. They now sit here under an anchor
 * per artifact, and the old /artifacts/<slug> paths redirect to it.
 *
 * The template text is built from what the artifact already states -- its
 * obligations and its steps -- so copying it gives exactly what is on the
 * screen.
 */
const templateText = (artifact: InstituteArtifact) =>
  [
    `# ${artifact.name}`,
    "",
    ...artifact.description,
    "",
    "## What it commits you to — record how each one is met",
    "",
    ...artifact.enforcesBullets.flatMap((bullet) => [
      `- [ ] ${bullet}`,
      "      Evidence:",
    ]),
    "",
    "## How to use",
    "",
    ...artifact.howToSteps.map((step, index) => `${index + 1}. ${step}`),
    "",
    artifact.finalLine,
  ].join("\n");

const entries = artifacts.map((artifact) => ({
  ...artifact,
  template: templateText(artifact),
}));
---

<BaseLayout
  title="Governance artifacts you can adopt as-is"
  description="Five templates that set operational defaults for a named decision owner, a reversal clock, freeze authority, appeals, and harm receipts."
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <section class="stack-lg institute-screen">
    <h1>Governance artifacts you can adopt as-is</h1>
    <p>
      Five templates. Each one asks you to name an owner, set a clock, or limit
      what a claimant has to prove, and records that you did. A template
      enforces nothing on its own; it gives someone a record to hold you to.
    </p>
    <nav aria-label="The five templates">
      <ol class="artifact-index">
        {
          artifacts.map((artifact) => (
            <li>
              <a href={`#${artifact.slug}`}>{artifact.name}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      entries.map((artifact) => (
        <article id={artifact.slug} class="card stack-sm artifact-entry">
          <h2>{artifact.name}</h2>
          {artifact.description.map((line) => (
            <p>{line}</p>
          ))}

          <h3>What it commits you to</h3>
          <ul class="artifact-grid__enforces">
            {artifact.enforcesBullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>

          <h3>How to use</h3>
          <ol class="artifact-entry__steps">
            {artifact.howToSteps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>

          <details class="artifact-entry__template">
            <summary>The template, as text to copy</summary>
            <pre class="artifact-template" set:text={artifact.template} />
          </details>
          <p class="small muted">{artifact.finalLine}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>
