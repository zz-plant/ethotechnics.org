---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";

const entry = (await getCollection("incidents")).find(
  (candidate) => candidate.id === Astro.params.slug,
);
if (!entry) return new Response("Not found", { status: 404 });
const {
  title,
  description,
  incident,
  governanceFailures,
  signalsToWatch,
  remediationChecklist,
  sources,
} = entry.data;

const pageTitle = `${title} — Composite`;

// Four sections of about 35 words each followed the scenario: what was
// missing, the signals, the fixes, and the records to start from. They are one
// section now. The three lists sit side by side rather than as rows of a gap,
// signal, and fix table: in two of the three scenarios the items at the same
// position are about different things.
---

<BaseLayout
  title={pageTitle}
  description={description}
  publishedTime={entry.data.published}
>
  <PageIntro
    eyebrow="Composite scenario"
    title={title}
    description={description}
    anchorLinks={[
      { href: "#incident", label: "The scenario" },
      { href: "#gaps", label: "Gaps, signals, and fixes" },
    ]}
  />

  <SectionBlock
    id="incident"
    eyebrow="The scenario"
    title="Where governance broke down"
    description="A composite. It combines patterns common to many systems and reports on no named institution. For failures a court, an inquiry, or a regulator established, see the casebook."
    className="section--banded"
  >
    <CardGrid className="grid--two">
      <CardItem
        title="Drawn from"
        description={incident.sector}
        descriptionTone="default"
      />
      <CardItem
        title="Headline"
        description={incident.headline}
        descriptionTone="default"
      />
      <CardItem
        title="Impact"
        description={incident.impact}
        descriptionTone="default"
      />
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="gaps"
    title="What was missing, how it would have shown, and the fix"
    variant="alt"
  >
    <CardGrid className="grid--three">
      <CardItem title="Gaps" description="Each let the harm continue.">
        <ul class="incident-list">
          {governanceFailures.map((failure) => <li>{failure}</li>)}
        </ul>
      </CardItem>
      <CardItem
        title="Signals"
        description="Each is a number a running system can record before the harm grows."
      >
        <ul class="incident-list">
          {signalsToWatch.map((signal) => <li>{signal}</li>)}
        </ul>
      </CardItem>
      <CardItem
        title="Fixes"
        description="Each needs a named owner and a date."
      >
        <ul class="incident-list">
          {remediationChecklist.map((item) => <li>{item}</li>)}
        </ul>
      </CardItem>
    </CardGrid>
    <div class="incident-records">
      <h3>Records to start from</h3>
      <p class="muted">
        These are this site's templates and schemas for the records the scenario
        was missing, not its sources.
      </p>
      <ul class="incident-list">
        {
          sources.map((source) => (
            <li>
              <a href={source.href}>{source.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </SectionBlock>
</BaseLayout>

<style>
  .incident-list {
    margin: 0;
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }

  .incident-records {
    display: grid;
    gap: var(--space-2);
    max-width: 72ch;
    margin-top: var(--space-6);
  }

  .incident-records > * {
    margin: 0;
  }
</style>
