---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";

const entry = (await getCollection("incidents")).find(
  (candidate) => candidate.id === Astro.params.slug,
);
if (!entry) return new Response("Not found", { status: 404 });
const {
  title,
  description,
  incident,
  governanceFailures,
  signalsToWatch,
  remediationChecklist,
  sources,
} = entry.data;

const pageTitle = `${title} — Composite`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  publishedTime={entry.data.published}
>
  <PageIntro
    eyebrow="Composite scenario"
    title={title}
    description={description}
    anchorLinks={[
      { href: "#incident", label: "The scenario" },
      { href: "#failures", label: "Governance failures" },
      { href: "#signals", label: "Signals to watch" },
      { href: "#remediation", label: "Remediation checklist" },
      { href: "#sources", label: "Templates" },
    ]}
  />

  <SectionBlock
    id="incident"
    eyebrow="The scenario"
    title="Where governance broke down"
    description="A composite. It combines patterns common to many systems and reports on no named institution. For failures a court, an inquiry, or a regulator established, see the casebook."
    className="section--banded"
  >
    <CardGrid className="grid--two">
      <CardItem
        title="Drawn from"
        description={incident.sector}
        descriptionTone="default"
      />
      <CardItem
        title="Headline"
        description={incident.headline}
        descriptionTone="default"
      />
      <CardItem
        title="Impact"
        description={incident.impact}
        descriptionTone="default"
      />
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="failures"
    eyebrow="Governance failures"
    title="What was missing"
    description="The structural gaps that let the harm continue."
    variant="alt"
  >
    <CardGrid>
      {
        governanceFailures.map((failure) => (
          <CardItem description={failure} descriptionTone="default" />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="signals"
    eyebrow="Signals to watch"
    title="Signals that would have shown it"
    description="Each is a number a running system can record before the harm grows."
  >
    <CardGrid>
      {
        signalsToWatch.map((signal) => (
          <CardItem description={signal} descriptionTone="default" />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="remediation"
    eyebrow="Remediation checklist"
    title="Fixes"
    description="Each fix needs a named owner and a date."
    variant="alt"
  >
    <CardGrid>
      {
        remediationChecklist.map((item) => (
          <CardItem description={item} descriptionTone="default" />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="sources"
    eyebrow="Templates"
    title="Records to start from"
    description="The site's own templates and schemas for the records this scenario was missing. They are not sources for the scenario, which is a composite."
  >
    <CardGrid className="grid--two">
      {
        sources.map((source) => (
          <CardItem title={source.label} descriptionTone="muted">
            <div slot="footer" class="card__footer">
              <a class="button ghost button--compact" href={source.href}>
                Open template
              </a>
            </div>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>
</BaseLayout>
