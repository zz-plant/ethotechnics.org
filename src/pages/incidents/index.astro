---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { incidentLessons, incidentLessonsIntro } from "../../content/incidents";
import { postMarketWorkflow } from "../../content/crosswalks";

const { pageTitle, pageDescription, eyebrow, title, description } =
  incidentLessonsIntro;
const enhancedDescription = `${description} The workflow below also serves post-market monitoring and incident reporting.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonAlternates={[
    {
      href: "/api/post-market-monitoring.json",
      title: "Post-market workflow JSON",
    },
  ]}
>
  <PageIntro
    eyebrow={eyebrow}
    title={title}
    description={enhancedDescription}
    anchorLinks={[
      { href: "#post-market-workflow", label: "Post-market workflow" },
      ...incidentLessons.map((lesson) => ({
        href: `#${lesson.slug}`,
        label: lesson.title,
      })),
    ]}
  />

  <SectionBlock
    id="post-market-workflow"
    eyebrow="Post-market monitoring"
    title="Incident reporting workflow"
    description="Five stages, from intake to closure, each with the record it must produce."
    variant="alt"
  >
    <ol class="muted">
      {
        postMarketWorkflow.map((step) => (
          <li>
            <strong>{step.stage}:</strong> {step.outcome}
          </li>
        ))
      }
    </ol>
    <p class="muted">
      Machine-readable workflow objects are available at
      {" "}
      <a href="/api/post-market-monitoring.json"
        >/api/post-market-monitoring.json</a
      >.
    </p>
  </SectionBlock>

  <SectionBlock
    eyebrow="Incident lessons"
    title="Browse the retrospectives."
    description="Each card gives the headline, sector, and timeframe. The lesson page holds the full remediation checklist."
    className="section--banded"
  >
    <CardGrid className="grid--two">
      {
        incidentLessons.map((lesson) => (
          <CardItem
            id={lesson.slug}
            title={lesson.title}
            description={lesson.summary}
            descriptionTone="default"
          >
            <ul class="muted">
              <li>{lesson.incident.sector}</li>
              <li>{lesson.incident.timeframe}</li>
            </ul>
            <div slot="footer" class="card__footer">
              <a
                class="button ghost button--compact"
                href={`/incidents/${lesson.slug}`}
              >
                Open lesson
              </a>
            </div>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>
</BaseLayout>
