---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { navSections } from "../content/navigation";

// Names and descriptions come from the header's navigation model, so a
// destination is called the same thing here as everywhere else.
const navLink = (href: string) => {
  const link = navSections
    .flatMap((section) => section.links)
    .find((candidate) => candidate.href === href);
  if (!link?.description) {
    throw new Error(
      `404 page links to ${href}, which navigation.ts does not list`,
    );
  }
  return link;
};

const fromNav = (href: string, icon: string) => {
  const { label, description } = navLink(href);
  return { title: label, description, href, icon };
};

// The person a system decided about comes first: a dead end is the worst
// place to lose them.
const quickLinks = [
  fromNav("/diagnostics/self-defense-tools", "lucide:shield"),
  fromNav("/standards", "lucide:book-open"),
  {
    title: "Diagnostics",
    description:
      "Checks to run on your own workflow, workload ratings, or decision log.",
    href: "/diagnostics",
    icon: "lucide:activity",
  },
  fromNav("/casebook", "lucide:file-text"),
  fromNav("/glossary", "lucide:list-tree"),
];
---

<BaseLayout
  title="Page not found"
  description="No page exists at this address. Search the site or return to the home page."
  robots="noindex, nofollow"
>
  <div class="page-404">
    <div class="page-404__hero">
      <p class="eyebrow page-404__eyebrow">Error 404</p>
      <h1 class="page-404__title">Page not found</h1>
      <p class="page-404__description">
        Nothing on ethotechnics.org lives at this address. The page may have
        moved. Search the site, or start from one of the pages below.
      </p>
      <div class="page-404__actions">
        <a href="/" class="button primary">
          <Icon name="lucide:home" class="page-404__btn-icon" />
          <span>Return home</span>
        </a>
        <a href="/search" class="button" data-search-proxy-trigger>
          <Icon name="lucide:search" class="page-404__btn-icon" />
          <span>Search the site</span>
        </a>
      </div>
    </div>

    <section class="page-404__recovery" aria-labelledby="recovery-heading">
      <h2 id="recovery-heading" class="eyebrow">Places to start</h2>
      <div class="page-404__grid">
        {
          quickLinks.map((item) => (
            <a href={item.href} class="card page-404__card">
              <div class="page-404__card-header">
                <Icon name={item.icon} class="page-404__card-icon" />
                <h3>{item.title}</h3>
              </div>
              <p class="muted">{item.description}</p>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-404 {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-5) 0 var(--space-7);
    max-width: 900px;
    margin: 0 auto;
  }

  .page-404__hero {
    display: grid;
    gap: var(--space-4);
    text-align: center;
    justify-items: center;
    padding: var(--space-6) var(--space-4);
    background: var(--surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .page-404__eyebrow {
    color: var(--status-warning-bright);
    letter-spacing: 0.08em;
  }

  .page-404__title {
    font-size: var(--text-hero);
    line-height: 1.1;
    color: var(--text);
    margin: 0;
  }

  .page-404__description {
    font-size: var(--text-lede);
    color: var(--muted);
    max-width: 600px;
    line-height: 1.5;
    margin: 0;
  }

  .page-404__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-3);
  }

  .page-404__btn-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .page-404__recovery {
    display: grid;
    gap: var(--space-4);
  }

  .page-404__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-4);
  }

  .page-404__card {
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-container);
    align-content: start;
  }

  .page-404__card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .page-404__card-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--accent);
    flex-shrink: 0;
  }

  .page-404__card h3 {
    font-size: var(--text-body);
    font-weight: 650;
    margin: 0;
    color: var(--text);
  }

  .page-404__card p {
    font-size: var(--text-sm);
    line-height: 1.45;
    margin: 0;
  }
</style>
