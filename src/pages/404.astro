---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

const quickLinks = [
  {
    title: "Standards Index",
    description: "Normative standards, contestability frameworks, and audit rules.",
    href: "/standards",
    icon: "lucide:book-open",
  },
  {
    title: "Diagnostics & Tools",
    description: "Interactive calculators, capacity forecasters, and evaluation runners.",
    href: "/diagnostics",
    icon: "lucide:activity",
  },
  {
    title: "Glossary of Terms",
    description: "Canonical definitions for ethical technology and accountable systems.",
    href: "/glossary",
    icon: "lucide:list-tree",
  },
  {
    title: "Field Notes",
    description: "Dispatches, incident analyses, and case studies from the field.",
    href: "/field-notes",
    icon: "lucide:file-text",
  },
];
---

<BaseLayout
  title="Page Not Found — 404"
  description="The signal has been lost. Return to base or search the archives."
  robots="noindex, nofollow"
>
  <div class="page-404">
    <div class="page-404__hero">
      <p class="eyebrow page-404__eyebrow">404 — Signal Lost</p>
      <h1 class="page-404__title">Coordinates Not Found</h1>
      <p class="page-404__description">
        The path you requested does not correspond to a known sector or artifact of the Ethotechnics Institute.
      </p>
      <div class="page-404__actions">
        <a href="/" class="button primary">
          <Icon name="lucide:home" class="page-404__btn-icon" />
          <span>Return Home</span>
        </a>
        <a href="/search" class="button" data-search-trigger>
          <Icon name="lucide:search" class="page-404__btn-icon" />
          <span>Search Archives (⌘K)</span>
        </a>
      </div>
    </div>

    <section class="page-404__recovery" aria-labelledby="recovery-heading">
      <h2 id="recovery-heading" class="eyebrow">Explore Key Sectors</h2>
      <div class="page-404__grid">
        {quickLinks.map((item) => (
          <a href={item.href} class="card page-404__card">
            <div class="page-404__card-header">
              <Icon name={item.icon} class="page-404__card-icon" />
              <h3>{item.title}</h3>
            </div>
            <p class="muted">{item.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-404 {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-4) 0 var(--space-7);
    max-width: 900px;
    margin: 0 auto;
  }

  .page-404__hero {
    display: grid;
    gap: var(--space-3);
    text-align: center;
    justify-items: center;
    padding: var(--space-5) var(--space-3);
    background: var(--surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .page-404__eyebrow {
    color: var(--status-warning-bright);
    letter-spacing: 0.08em;
  }

  .page-404__title {
    font-size: var(--text-hero);
    line-height: 1.1;
    color: var(--text);
    margin: 0;
  }

  .page-404__description {
    font-size: var(--text-lede);
    color: var(--muted);
    max-width: 600px;
    line-height: 1.5;
    margin: 0;
  }

  .page-404__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }

  .page-404__btn-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .page-404__recovery {
    display: grid;
    gap: var(--space-3);
  }

  .page-404__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-3);
  }

  .page-404__card {
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    align-content: start;
  }

  .page-404__card-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .page-404__card-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--accent);
    flex-shrink: 0;
  }

  .page-404__card h3 {
    font-size: var(--text-body);
    font-weight: 650;
    margin: 0;
    color: var(--text);
  }

  .page-404__card p {
    font-size: var(--text-sm);
    line-height: 1.45;
    margin: 0;
  }
</style>

