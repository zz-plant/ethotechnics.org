---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import SymptomTriage from "../../components/SymptomTriage.astro";
import VerdictMark from "../../components/VerdictMark.astro";
import { stateVariables } from "../../content/casebook";
import {
  artifacts,
  failureFooterLine,
  failureStates,
  type InstituteArtifact,
} from "../../content/institute-site";
import { incidentLessons, incidentLessonsIntro } from "../../content/incidents";
import { getStandardBySlug } from "../../content/standards";
import {
  failureChoiceLabels,
  failureFirstMoves,
  failurePriorityBadges,
} from "../../content/triage";
import { pickMatchedCase, variableForTopic } from "../../utils/next-step";
import { selfTestQuestions } from "../../utils/self-test";

/**
 * Incident triage. This grid used to sit in the middle of the home page,
 * where a first-time reader met seven severity badges before knowing what
 * the site was. Someone in the middle of an incident is sent here directly.
 *
 * Each failure was a page of its own at /triage/<slug>. The seven shared the
 * three-stage workflow, its stage descriptions, "the rule" and the footer
 * line: 66 to 85% of each page was its siblings' text, and each was linked
 * only from this grid. They are sections here now (id = the old slug, and
 * /triage/<slug> redirects to it). What differs per failure stays in its
 * section: the two-line description, the first move, the record that opens
 * each stage, and the public case. The workflow is stated once.
 */
const artifactBySlug = new Map(
  artifacts.map((artifact) => [artifact.slug, artifact]),
);

// Which record opens which stage. A failure names three records; each stage
// prefers its own, and takes the next unused one when the failure lacks it.
const stagePreferences = [
  { key: "triage", title: "Triage", prefers: "decision-record-template" },
  { key: "stabilize", title: "Stabilize", prefers: "halt-authority-table" },
  { key: "evidence", title: "Evidence", prefers: "harm-receipt-format" },
] as const;

const stagesFor = (artifactSlugs: string[]) => {
  const available = artifactSlugs
    .map((slug) => artifactBySlug.get(slug))
    .filter((artifact): artifact is InstituteArtifact => Boolean(artifact));
  const used = new Set<string>();
  return stagePreferences.flatMap((stage) => {
    const artifact =
      available.find(
        (candidate) =>
          candidate.slug === stage.prefers && !used.has(candidate.slug),
      ) ?? available.find((candidate) => !used.has(candidate.slug));
    if (!artifact) return [];
    used.add(artifact.slug);
    return [{ ...stage, artifact }];
  });
};

// Standard names come from the register: the labels here were written by
// hand and named STD-01 "Deadlines for decisions and reversals".
const standardLabel = (href: string) => {
  const standard = getStandardBySlug(href.split("/").pop() ?? "");
  if (!standard) throw new Error(`Triage links an unknown standard: ${href}`);
  return `Review ${standard.id}: ${standard.title}`;
};

const workflowStages = [
  {
    title: "Triage",
    description:
      "Record what failed and the decision involved, before logs rotate and memories fade.",
    diagnosticsHref: "/diagnostics/self-defense-tools#governable",
    diagnosticsLabel: "Check whether the decision can be challenged",
    standardsHref: "/standards/std-02-contestability-recourse",
  },
  {
    title: "Stabilize",
    description:
      "Halt or narrow the harmful flow while the owner and the escalation path are in place.",
    diagnosticsHref: "/diagnostics/delegation-audit",
    diagnosticsLabel: "Check what the system is allowed to decide",
    // STD-03 (justice SLOs) has no page yet; STD-06 carries the published
    // thresholds and breach actions.
    standardsHref: "/standards/std-06-human-impact-safety-case",
  },
  {
    title: "Evidence",
    description:
      "Gather the records and the evidence pack, so each repair the organization owes can be checked against its deadline.",
    diagnosticsHref: "/diagnostics/record-conformance",
    diagnosticsLabel: "Check record conformance",
    standardsHref: "/standards/std-01-temporal-rights",
  },
];

// The public case each failure page closed on. The seed is the old page path,
// so each failure keeps the case it showed as a page.
const failureSections = failureStates
  .map((state) => {
    const pick = pickMatchedCase(
      variableForTopic(state.slug, state.title),
      undefined,
      `/triage/${state.slug}`,
    );
    return {
      state,
      stages: stagesFor(state.artifactSlugs ?? []),
      pick,
      variableLabel: pick
        ? (stateVariables.find((item) => item.id === pick.finding.variable)
            ?.label ?? pick.finding.variable)
        : "",
      question: pick
        ? selfTestQuestions.find(
            (item) => item.variable === pick.finding.variable,
          )?.question
        : undefined,
    };
  })
  .filter((section) => section.stages.length > 0);

// Each worked example works through one of the seven failures; the failure's
// section links to it, and it links back.
const exampleByFailure = new Map(
  incidentLessons.map((lesson) => [lesson.failure, lesson]),
);
const failureTitle = (slug: string) =>
  failureChoiceLabels[slug] ??
  failureStates.find((state) => state.slug === slug)?.title ??
  slug;

// The badges already lead with a severity word; this is what lets the grid
// show it. Seven triage cards whose whole job is "how bad is this" rendered
// Critical, High and Medium in identical neutral grey, so severity was
// legible only by reading each card.
const failureSeverity = (badge?: string): string | undefined => {
  const level = badge?.split("·")[0]?.trim().toLowerCase();
  return level === "critical" || level === "high" || level === "medium"
    ? level
    : undefined;
};

const failureChoiceIcons: Record<string, string[]> = {
  "decision-appealed": [
    "M4 5.5h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8l-4 3v-3",
    "M8.5 10h7",
    "M8.5 13h4.5",
  ],
  "model-wrong": ["M10 4.5l6.8 11.8H3.2z", "M10 8.5v3.5", "M10 14.3h.01"],
  "queue-stuck": ["M10 5a5 5 0 1 1-5 5", "M10 7.5v3", "M10 10.5h2.2"],
  "user-harmed": [
    "M10 16.5s-5.5-3.1-5.5-7a3.2 3.2 0 0 1 5.5-2.3 3.2 3.2 0 0 1 5.5 2.3c0 3.9-5.5 7-5.5 7",
    "M7.9 9.4l4.2 4.2",
    "M12.1 9.4 7.9 13.6",
  ],
  "no-owner": [
    "M10 11a2.2 2.2 0 1 0-2.2-2.2A2.2 2.2 0 0 0 10 11z",
    "M5.5 15.5a4.5 4.5 0 0 1 9 0",
    "M14.2 5.8l3.2 3.2",
    "M17.4 5.8l-3.2 3.2",
  ],
  "cant-explain": [
    "M10 16.5a7 7 0 1 0-7-7",
    "M10 12.4v-.4a2 2 0 1 1 2-2",
    "M10 14.7h.01",
  ],
  "cant-stop": ["M4.5 4.5h11v11h-11z", "M8 8h4v4H8z"],
};
---

<BaseLayout
  title="Incident triage for automated decision systems — Ethotechnics"
  description="Something is going wrong with an automated decision system. Pick the closest failure: what to do first, who owns follow-up, what evidence to keep."
  publishedTime="2026-09-23T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Incident triage"
    title="What is going wrong right now?"
    description="Choose the closest failure. Each one starts with what to do now and names the record that opens each stage. The workflow is the same for all seven, and ends by asking whether the case is one of many the same rule produced."
    anchorLinks={[]}
  />

  <section id="failure-intake" class="container stack-lg">
    <h2 id="failure-intake-heading" class="sr-only">Failure modes</h2>
    <ul class="failure-grid" aria-labelledby="failure-intake-heading">
      {
        failureStates.map((state) => {
          const iconPaths = failureChoiceIcons[state.slug] ?? [
            "M5 10h10",
            "M11 6l4 4-4 4",
          ];
          return (
            <li>
              <a class="button failure-grid__button" href={`#${state.slug}`}>
                <span class="failure-grid__label">
                  <span class="failure-grid__title">
                    <span class="failure-grid__state-icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 20 20"
                        role="presentation"
                        focusable="false"
                      >
                        {iconPaths.map((pathValue) => (
                          <path d={pathValue} />
                        ))}
                      </svg>
                    </span>
                    <span>
                      {failureChoiceLabels[state.slug] ?? state.shortLabel}
                    </span>
                  </span>
                  <span
                    class="failure-grid__priority small"
                    data-severity={failureSeverity(
                      failurePriorityBadges[state.slug],
                    )}
                  >
                    {failurePriorityBadges[state.slug] ?? "Review now"}
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="small muted">
      These routes are for a live case: a person, a queue, or a decision that
      needs attention now.
    </p>
  </section>

  <div data-route-metrics="home-to-failure-pathway" hidden></div>

  <section id="workflow" class="container stack-lg section">
    <h2>Response workflow (triage → stabilize → evidence), then the rule</h2>
    <p class="section-lead">
      Every failure below runs through the same three stages. In each one,
      capture evidence and timestamps in the stage's record, and confirm who the
      case escalates to before starting other work on it.
    </p>
    <ol class="stack-sm">
      {
        workflowStages.map((stage) => (
          <li class="card stack-sm">
            <h3>{stage.title}</h3>
            <p class="muted">{stage.description}</p>
            <p class="muted small">
              Next checks:{" "}
              <a href={stage.diagnosticsHref}>{stage.diagnosticsLabel}</a> ·
              <a href={stage.standardsHref}>
                {standardLabel(stage.standardsHref)}
              </a>
            </p>
          </li>
        ))
      }
    </ol>

    <div class="card stack-sm">
      <p class="eyebrow">The rule</p>
      <h3>Is this case one of many?</h3>
      <p class="muted">
        Fixing this case does not fix the rule that produced it. Count the cases
        the same rule produced that were challenged and upheld, and send the
        count to whoever owns the rule, with a date for an answer: a revised
        rule, or a published reason for keeping it.
      </p>
      <p class="muted small">
        Next checks:{" "}
        <a href="/mechanisms/patterns/policy-review-triggers"
          >Policy review triggers (MEC-14)</a
        > ·
        <a href="/research/theory/exception-learning"
          >Why exceptions are evidence about the rule</a
        >
      </p>
    </div>

    <p class="small muted">{failureFooterLine}</p>
  </section>

  {
    failureSections.map(({ state, stages, pick, variableLabel, question }) => (
      <section id={state.slug} class="container stack-sm section">
        <p class="eyebrow">
          {failurePriorityBadges[state.slug] ?? "Review now"}
        </p>
        <h2>{state.title}</h2>
        <p>{state.descriptionLine1}</p>
        <p>{state.descriptionLine2}</p>
        <div class="panel stack-sm">
          <p class="eyebrow">Start here</p>
          <p>
            {failureFirstMoves[state.slug] ??
              "Assign the accountable owner now."}
          </p>
          <p class="muted">
            Start with the
            <strong>{stages[0]?.artifact.name.toLowerCase()}</strong>.
            {stages[0]?.artifact.description[0]}
          </p>
        </div>
        <h3>The record that opens each stage</h3>
        <ol class="stack-sm">
          {stages.map((stage) => (
            <li>
              {stage.title}:{" "}
              <a
                href={`/artifacts#${stage.artifact.slug}`}
                data-route-action={`failure-${stage.key}-${stage.artifact.slug}`}
              >
                {stage.artifact.name}
              </a>
            </li>
          ))}
        </ol>
        {pick && (
          <p class="muted">
            Where this broke in public:{" "}
            <a href={`/casebook/${pick.entry.slug}`}>{pick.entry.title}</a>.{" "}
            {variableLabel}:{" "}
            <VerdictMark verdict={pick.finding.verdict} labelled />.
            {question && ` The question it failed: ${question}`}
          </p>
        )}
        {exampleByFailure.has(state.slug) && (
          <p class="muted">
            Worked example:{" "}
            <a href={`#${exampleByFailure.get(state.slug)?.slug}`}>
              {exampleByFailure.get(state.slug)?.title}
            </a>
          </p>
        )}
        <p class="small muted">
          <a href="#workflow">The workflow for every failure</a> ·
          <a href="#failure-intake">All seven failures</a>
        </p>
      </section>
    ))
  }

  <section id="worked-examples" class="container stack-lg section">
    <div class="stack-sm">
      <p class="eyebrow">Composite scenarios</p>
      <h2>{incidentLessonsIntro.title}</h2>
      <p class="section-lead">{incidentLessonsIntro.description}</p>
    </div>
    {
      incidentLessons.map((lesson) => (
        <article id={lesson.slug} class="stack-md">
          <div class="stack-sm">
            <p class="eyebrow">
              Drawn from {lesson.incident.sector.toLowerCase()}
            </p>
            <h3>{lesson.title}</h3>
            <p>{lesson.summary}</p>
            <p class="small muted">
              The failure it works through:{" "}
              <a href={`#${lesson.failure}`}>{failureTitle(lesson.failure)}</a>
            </p>
          </div>
          <CardGrid className="grid--two">
            <CardItem
              headingLevel="h4"
              title="What happened"
              description={lesson.incident.headline}
              descriptionTone="default"
            />
            <CardItem
              headingLevel="h4"
              title="Who it landed on"
              description={lesson.incident.impact}
              descriptionTone="default"
            />
          </CardGrid>
          <CardGrid className="grid--three">
            <CardItem
              headingLevel="h4"
              title="Gaps"
              description="Each let the harm continue."
            >
              <ul class="incident-list">
                {lesson.governanceFailures.map((failure) => (
                  <li>{failure}</li>
                ))}
              </ul>
            </CardItem>
            <CardItem
              headingLevel="h4"
              title="Signals"
              description="Each is a number a running system can record before the harm grows."
            >
              <ul class="incident-list">
                {lesson.signalsToWatch.map((signal) => (
                  <li>{signal}</li>
                ))}
              </ul>
            </CardItem>
            <CardItem
              headingLevel="h4"
              title="Fixes"
              description="Each needs a named owner and a date."
            >
              <ul class="incident-list">
                {lesson.remediationChecklist.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </CardItem>
          </CardGrid>
          <div class="incident-records">
            <h4>Records to start from</h4>
            <ul class="incident-list">
              {lesson.sources.map((source) => (
                <li>
                  <a href={source.href}>{source.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
    <p class="muted">
      The stages for reporting a real incident after release are in the
      <a href="/standards/enforceable-governance-crosswalks#post-market"
        >post-market workflow</a
      >.
    </p>
  </section>

  {
    /* The symptom matrix lived on /start as a second way to route by symptom.
       It belongs with the live-case routes: one page answers "something is
       wrong", whether it is one case or a pattern. */
  }
  <section id="symptoms" class="container stack-sm section">
    <p class="eyebrow">A pattern, not one case</p>
    <h2>When the same failure keeps recurring</h2>
    <p class="section-lead">
      Match what you keep seeing to a diagnostic, a standard, and a scored
      public failure.
    </p>
    <SymptomTriage />
  </section>
  <script>
    import "../../client/route-metrics.ts";
  </script>
</BaseLayout>

<style>
  .incident-list {
    margin: 0;
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }

  .incident-records {
    display: grid;
    gap: var(--space-2);
    max-width: 72ch;
  }

  .incident-records > * {
    margin: 0;
  }
</style>
