---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PatternFilter from "../../components/PatternFilter.astro";
import ScholarlyMeta from "../../components/ScholarlyMeta.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { glossaryEntryPermalink } from "../../utils/glossary";
import { itemList } from "../../utils/seo/schema";

const libraryEntry = (await getEntry("library", "library"))!;
const {
  pageTitle,
  pageDescription,
  permalink,
  patterns,
  recommended,
  publication,
} = libraryEntry.data;
const glossaryEntry = (await getEntry("glossary", "glossary"))!;
const glossaryContent = glossaryEntry.data;
const glossaryHref = (slug: string) => glossaryEntryPermalink(slug);
type GlossaryStarterTerm = (typeof glossaryContent.starterTerms)[number];
const patternUrl = (slug: string) =>
  new URL(`/mechanisms/patterns/${slug}`, Astro.site ?? Astro.url).toString();
const pageSchema = {
  page: {
    mainEntity: itemList(
      patterns.entries.map((pattern) => ({
        "@type": "TechArticle",
        "@id": `${patternUrl(pattern.slug)}#article`,
        name: pattern.title,
        identifier: pattern.code,
        description: pattern.summary,
        url: patternUrl(pattern.slug),
        keywords: pattern.filters,
      })),
    ),
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonAlternates={[{ href: "/api/mechanisms.json", title: "Mechanisms JSON" }]}
  schema={pageSchema}
>
  <PageIntro
    eyebrow="Mechanisms"
    title="Mechanisms"
    description={pageDescription}
    anchorLinks={[
      { href: "#mechanisms", label: "Mechanism catalog" },
      { href: "#references", label: "References" },
    ]}
  />
  <SectionBlock id="mechanisms" title="Mechanism catalog">
    {
      /* The three starters used to get a card section of their own below the
         catalog, which lists the same three. One line names them here. */
    }
    <p class="mechanisms__links">
      <span>New to mechanisms? Start with three:</span>
      {recommended.items.map((item) => <a href={item.href}>{item.title}</a>)}
    </p>
    <div class="pattern-filter__anchors" aria-hidden="true">
      {
        patterns.filters.map((filter) => (
          <span class="pattern-filter__anchor" id={filter.slug} />
        ))
      }
    </div>
    <PatternFilter filters={patterns.filters} entries={patterns.entries} />
  </SectionBlock>

  <SectionBlock
    id="references"
    eyebrow="References"
    title="Glossary and the Agent Safety Object Model"
    description="Defined terms, each with its own permalink, and a machine-readable model that ties system actions to the mechanisms that govern them."
  >
    <div class="grid grid--two">
      <div>
        <p class="eyebrow">Glossary starter terms</p>
        <CardGrid>
          {
            glossaryContent.starterTerms.map((term: GlossaryStarterTerm) => (
              <CardItem
                id={term.id}
                eyebrow="Glossary term"
                title={term.label}
                description={term.description}
              >
                <a slot="footer" class="muted" href={glossaryHref(term.id)}>
                  Permalink to {term.label} &rarr;
                </a>
              </CardItem>
            ))
          }
        </CardGrid>
        <p class="muted glossary__cta">
          Full glossary: <a href={glossaryContent.permalink}>/glossary</a>
        </p>
      </div>
      <div>
        <p class="eyebrow">Agent Safety Object Model</p>
        <p class="muted">
          The
          {" "}
          <a href="/agents/spec">Agent Safety Object Model</a>
          {" "}
          ties action classes, receipts, and halt authority to specific mechanisms.
        </p>
        <ul class="muted">
          <li>
            Map MEC-01 (decision log), MEC-05 (kill switch), and MEC-06 (appeal
            paths) into the model.
          </li>
          <li>Declare time limits and approvals for each class of action.</li>
          <li>Attach the evidence pack each clause asks for.</li>
        </ul>
      </div>
    </div>
  </SectionBlock>

  <CitationBlock
    title={pageTitle}
    permalink={permalink}
    publication={publication}
    variant="compact"
  >
    <ScholarlyMeta bare publication={publication} permalink={permalink} />
  </CitationBlock>
</BaseLayout>
