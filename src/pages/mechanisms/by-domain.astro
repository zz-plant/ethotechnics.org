---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { libraryContent } from "../../content/library";

const pageTitle = "Mechanisms by domain — Ethotechnics";
const pageDescription =
  "Programmatic index of mechanism patterns grouped by governance, friction, and policy domains.";
const permalink = "/mechanisms/by-domain";

const mechanismDomains = [
  {
    slug: "governance",
    title: "Governance",
    summary:
      "Controls for oversight, accountability, and transparent stewardship.",
  },
  {
    slug: "friction",
    title: "Friction",
    summary:
      "Controls that make high-risk actions pause, explain, and escalate.",
  },
  {
    slug: "policy",
    title: "Policy",
    summary:
      "Controls that bind standards into operational and legal pathways.",
  },
] as const;

// Authority and dependence group mechanisms by the state variable they govern.
// They cut across the three pattern filters, so their membership is listed here
// rather than derived from `pattern.filters`.
const crossCuttingDomains = [
  {
    slug: "authority",
    title: "Authority",
    summary:
      "Controls that keep delegated authority scoped, evidenced, and renewable.",
    patternSlugs: [
      "authority-grant-register",
      "policy-review-triggers",
      "intervention-specification",
      "capability-catalog",
      "expansion-review",
    ],
  },
  {
    slug: "dependence",
    title: "Dependence",
    summary:
      "Controls that keep withdrawal, substitution, and contestation possible as reliance grows.",
    patternSlugs: [
      "withdrawal-rehearsal",
      "dependency-ledger",
      "reversibility-audit-logs",
      "stoppability-testing",
    ],
  },
] as const;

const patternsByDomain = [
  ...mechanismDomains.map((domain) => ({
    domain,
    patterns: libraryContent.patterns.entries.filter((pattern) =>
      pattern.filters.includes(domain.slug),
    ),
  })),
  ...crossCuttingDomains.map(({ patternSlugs, ...domain }) => ({
    domain,
    patterns: patternSlugs
      .map((patternSlug) =>
        libraryContent.patterns.entries.find(
          (pattern) => pattern.slug === patternSlug,
        ),
      )
      .filter((pattern) => pattern !== undefined),
  })),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  openGraphType="website"
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Programmatic index"
    title="Mechanisms by domain"
    description={pageDescription}
    permalink={permalink}
    anchorLinks={patternsByDomain.map(({ domain }) => ({
      href: `#${domain.slug}`,
      label: domain.title,
    }))}
  />

  {
    patternsByDomain.map(({ domain, patterns }) => (
      <SectionBlock
        id={domain.slug}
        eyebrow="Mechanism domain"
        title={domain.title}
        description={domain.summary}
      >
        {patterns.length > 0 ? (
          <ul>
            {patterns.map((pattern) => (
              <li>
                <a href={`/mechanisms/patterns/${pattern.slug}`}>
                  {pattern.title}
                </a>
                <span class="muted"> — {pattern.summary}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">
            No mapped mechanisms published for this domain yet.
          </p>
        )}
      </SectionBlock>
    ))
  }
</BaseLayout>
