---
import TaxonomyEntryPage from "../../components/TaxonomyEntryPage.astro";
import { getTaxonomyBranch } from "../../content/taxonomy";

// The route is mounted at /experience, so the taxonomy slug it addresses is
// the branch root plus whatever the URL carried after it.
const entry = getTaxonomyBranch("experience").find(
  (candidate) =>
    candidate.slug !== "experience" &&
    candidate.slug.split("/").slice(1).join("/") === Astro.params.slug,
);
if (!entry) return new Response("Experience entry not found", { status: 404 });
---

<TaxonomyEntryPage entry={entry} basePath="/experience" eyebrow="Domain" />
