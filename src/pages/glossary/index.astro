---
import InlineScript from "../../components/InlineScript.astro";
import "../../styles/components/glossary.css";
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import ScholarlyMeta from "../../components/ScholarlyMeta.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { glossaryEntryPermalink } from "../../utils/glossary";
import { normalizeGlossaryHeading } from "../../utils/glossary-helpers";
import {
  buildGlossaryIndexEntries,
  buildGlossaryIndexFacets,
  buildGlossaryStructuredDataPayload,
  filterGlossaryIndexEntries,
} from "../../content/page-data/glossary-routes";
import { explainerLinks } from "../../content/page-data/glossary-page";
import {
  glossaryDomainFilters,
  glossaryMeasurabilityFilters,
  glossaryPhaseFilters,
} from "../../utils/glossary-metadata";

const glossaryEntry = (await getEntry("glossary", "glossary"))!;

const {
  pageTitle,
  pageDescription,
  permalink,
  publication,
  categories,
  starterTerms,
} = glossaryEntry.data;
// The page's two parts. The thirteen glossary sections used to follow as a
// second listing of every term, behind a section map that listed them twice
// more; the index's "By section" tab now does that job.
const anchorLinks = [
  { href: "#glossary-index", label: "A–Z index" },
  { href: "#explainer-links", label: "Explainers" },
];
const sectionFilters = categories.map((category) => ({
  id: category.id,
  label: normalizeGlossaryHeading(category.heading),
  count: category.entries.length,
}));
const domainFilters = glossaryDomainFilters;
const phaseFilters = glossaryPhaseFilters;
const measurabilityFilters = glossaryMeasurabilityFilters;
const entryIndex = buildGlossaryIndexEntries(categories);
const entryLetter = (title: string) => title.trim().charAt(0).toUpperCase();
// The A–Z index renders as letter groups; entryIndex is already sorted.
const letterGroups = entryIndex.reduce<
  { letter: string; entries: typeof entryIndex }[]
>((groups, entry) => {
  const letter = entryLetter(entry.title);
  const last = groups.at(-1);
  if (last && last.letter === letter) {
    last.entries.push(entry);
  } else {
    groups.push({ letter, entries: [entry] });
  }
  return groups;
}, []);
const { statusFilters, glossaryLetters } = buildGlossaryIndexFacets(
  categories,
  entryIndex,
);
const siteBase = Astro.site ? Astro.site.toString() : Astro.url.origin;
// Links on this page are root-relative. Written as absolute URLs, the 386
// terms listed twice carried "https://ethotechnics.org" 800 times.
const explainerLinksWithGlossary = explainerLinks.map((link) => ({
  ...link,
  glossaryHref: glossaryEntryPermalink(link.glossarySlug),
}));
const searchQuery = Astro.url.searchParams.get("query")?.trim() ?? "";
const normalizedQuery = searchQuery.toLowerCase();
const hasSearchQuery = normalizedQuery.length > 0;
// ?section= is the glossary section a link asked for. It filters on the
// server too, so the list renders filtered before any script runs.
const sectionParam = (Astro.url.searchParams.get("section") ?? "")
  .split(",")
  .filter((id) => categories.some((category) => category.id === id));
const inSection = (categoryId: string) =>
  sectionParam.length === 0 || sectionParam.includes(categoryId);
const filteredEntries = filterGlossaryIndexEntries(
  entryIndex,
  searchQuery,
).filter((entry) => inSection(entry.categoryId));
const totalEntries = entryIndex.length;
const visibleEntries = filteredEntries.length;

const structuredData = buildGlossaryStructuredDataPayload({
  pageTitle,
  pageDescription,
  permalink,
  categories,
  publication,
  siteBase,
});
const glossaryKeywordsNode = structuredData["@graph"].find(
  (item) => item["@type"] === "CollectionPage",
) as { keywords?: string[] } | undefined;
const glossaryKeywordsContent =
  glossaryKeywordsNode?.keywords?.join(", ") ?? "";
const structuredDataJson = JSON.stringify(structuredData);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  enableGlossaryHighlights={false}
  jsonAlternates={[{ href: "/api/glossary.json", title: "Glossary JSON" }]}
  pageSchema="route"
>
  <Fragment slot="head">
    <meta name="keywords" content={glossaryKeywordsContent} />
  </Fragment>
  <PageIntro
    eyebrow="Glossary"
    title="Ethotechnics glossary"
    description={pageDescription}
    anchorLinks={anchorLinks}
  />
  <SectionBlock
    id="glossary-index"
    title="All terms, A to Z"
    description={`${entryIndex.length} terms, each with its own page.`}
    className="glossary-catalog"
  >
    <div class="glossary-filter">
      <div class="glossary-filter__controls">
        <label class="glossary-filter__label" for="glossary-filter">
          <span class="glossary-filter__label-text">Filter glossary terms</span>
          <input
            id="glossary-filter"
            name="query"
            type="search"
            inputmode="search"
            placeholder="Filter terms (e.g., consent)"
            autocomplete="off"
            value={searchQuery}
            data-search-index="/glossary/search-index.json"
          />
        </label>
        <div class="glossary-filter__tabs" role="tablist">
          <button
            class="glossary-filter__tab is-active"
            type="button"
            role="tab"
            aria-selected="true"
            data-glossary-tab="all"
          >
            All entries <span data-glossary-total>{totalEntries}</span>
          </button>
          <button
            class="glossary-filter__tab"
            type="button"
            role="tab"
            aria-selected="false"
            data-glossary-tab="section"
          >
            By section
          </button>
          <button
            class="glossary-filter__tab"
            type="button"
            role="tab"
            aria-selected="false"
            data-glossary-tab="domains"
          >
            By domain
          </button>
          <button
            class="glossary-filter__tab"
            type="button"
            role="tab"
            aria-selected="false"
            data-glossary-tab="phases"
          >
            By phase
          </button>
          <button
            class="glossary-filter__tab"
            type="button"
            role="tab"
            aria-selected="false"
            data-glossary-tab="measurability"
          >
            By measurability
          </button>
        </div>
      </div>
      <p class="glossary-filter__starters" id="starter-terms">
        <span class="muted">Start with</span>
        {
          starterTerms.map((term, index) => (
            <>
              <a
                href={glossaryEntryPermalink(term.id)}
                title={term.description}
              >
                {term.label}
              </a>
              {index < starterTerms.length - 1 && (
                <span class="glossary-filter__sep" aria-hidden="true">
                  ·
                </span>
              )}
            </>
          ))
        }
      </p>
      <div class="glossary-filter__panels">
        <div
          class="glossary-filter__panel"
          role="tabpanel"
          data-glossary-panel="all"
        >
          <p class="muted small">
            Search across all terms or narrow by section, domain, phase, or
            measurability.
          </p>
        </div>
        <fieldset
          class="glossary-filter__panel"
          role="tabpanel"
          data-glossary-panel="section"
          hidden
        >
          <legend>Filter by section</legend>
          <div class="glossary-filter__chips">
            {
              sectionFilters.map((section) => (
                <label class="glossary-filter__chip">
                  <input
                    type="checkbox"
                    value={section.id}
                    checked={sectionParam.includes(section.id)}
                    data-glossary-filter="section"
                    data-glossary-label={section.label}
                  />
                  <span class="glossary-filter__chip-label">
                    {section.label}
                  </span>
                  <span
                    class="glossary-filter__chip-count"
                    data-glossary-count
                  />
                </label>
              ))
            }
          </div>
        </fieldset>
        <fieldset
          class="glossary-filter__panel"
          role="tabpanel"
          data-glossary-panel="domains"
          hidden
        >
          <legend>Filter by domain</legend>
          <div class="glossary-filter__chips">
            {
              domainFilters.map((domain) => (
                <label class="glossary-filter__chip">
                  <input
                    type="checkbox"
                    value={domain.id}
                    data-glossary-filter="domains"
                    data-glossary-label={domain.label}
                  />
                  <span class="glossary-filter__chip-label">
                    {domain.label}
                  </span>
                  <span
                    class="glossary-filter__chip-count"
                    data-glossary-count
                  />
                </label>
              ))
            }
          </div>
        </fieldset>
        <fieldset
          class="glossary-filter__panel"
          role="tabpanel"
          data-glossary-panel="phases"
          hidden
        >
          <legend>Filter by phase</legend>
          <div class="glossary-filter__chips">
            {
              phaseFilters.map((phase) => (
                <label class="glossary-filter__chip">
                  <input
                    type="checkbox"
                    value={phase.id}
                    data-glossary-filter="phases"
                    data-glossary-label={phase.label}
                  />
                  <span class="glossary-filter__chip-label">{phase.label}</span>
                  <span
                    class="glossary-filter__chip-count"
                    data-glossary-count
                  />
                </label>
              ))
            }
          </div>
        </fieldset>
        <fieldset
          class="glossary-filter__panel"
          role="tabpanel"
          data-glossary-panel="measurability"
          hidden
        >
          <legend>Filter by measurability</legend>
          <div class="glossary-filter__chips">
            {
              measurabilityFilters.map((option) => (
                <label class="glossary-filter__chip">
                  <input
                    type="checkbox"
                    value={option.id}
                    data-glossary-filter="measurability"
                    data-glossary-label={option.label}
                  />
                  <span class="glossary-filter__chip-label">
                    {option.label}
                  </span>
                  <span
                    class="glossary-filter__chip-count"
                    data-glossary-count
                  />
                </label>
              ))
            }
          </div>
        </fieldset>
        {
          statusFilters.length > 0 && (
            <fieldset
              class="glossary-filter__panel glossary-filter__panel--status"
              role="tabpanel"
              data-glossary-panel="status"
            >
              <legend>Filter by status</legend>
              <div class="glossary-filter__chips">
                {statusFilters.map((status) => (
                  <label class="glossary-filter__chip">
                    <input
                      type="checkbox"
                      value={status}
                      data-glossary-filter="status"
                      data-glossary-label={status}
                    />
                    <span class="glossary-filter__chip-label">{status}</span>
                    <span
                      class="glossary-filter__chip-count"
                      data-glossary-count
                    />
                  </label>
                ))}
              </div>
            </fieldset>
          )
        }
      </div>
      <div class="glossary-filter__active" data-glossary-active hidden>
        <p class="muted">Active filters:</p>
        <div class="glossary-filter__active-chips"></div>
      </div>
      <div class="glossary-filter__status">
        <p
          class="muted small glossary-filter__count"
          aria-live="polite"
          aria-atomic="true"
          data-total={totalEntries}
        >
          Showing {visibleEntries} of {totalEntries} terms
          {hasSearchQuery && ` for “${searchQuery}”`}
        </p>
        <div class="glossary-filter__actions">
          <button
            class="glossary-filter__text-button glossary-filter__clear"
            type="button"
            data-clear-filter
          >
            Clear filter
          </button>
        </div>
      </div>
    </div>
    <nav class="glossary-index__letters" aria-label="Filter by letter">
      <button
        class="pill pill--ghost is-active"
        type="button"
        data-glossary-letter="all"
        aria-pressed="true"
      >
        All
      </button>
      {
        glossaryLetters.map((letter) => (
          <button
            class="pill pill--ghost"
            type="button"
            data-glossary-letter={letter}
            aria-pressed="false"
          >
            {letter}
          </button>
        ))
      }
    </nav>
    <nav class="glossary-index" aria-label="Glossary index">
      {
        letterGroups.map((group) => (
          <section
            class="glossary-index__group"
            hidden={
              !group.entries.some(
                (entry) =>
                  inSection(entry.categoryId) &&
                  entry.searchText.includes(normalizedQuery),
              )
            }
            data-glossary-group={group.letter}
            aria-labelledby={`glossary-letter-${group.letter}`}
          >
            <h3
              class="glossary-index__letter"
              id={`glossary-letter-${group.letter}`}
            >
              {group.letter}
            </h3>
            {group.entries.map((entry) => {
              const matchesQuery = entry.searchText.includes(normalizedQuery);
              const entryClasses = [
                "glossary-index__item",
                ...((hasSearchQuery && !matchesQuery) ||
                !inSection(entry.categoryId)
                  ? ["is-hidden"]
                  : []),
              ].join(" ");

              return (
                <a
                  class={entryClasses}
                  id={entry.id}
                  href={glossaryEntryPermalink(entry.id)}
                  data-glossary-entry-link
                  data-section={entry.categoryId}
                  data-domains={entry.domains.join(" ") || undefined}
                  data-phases={entry.phases.join(" ") || undefined}
                  data-measurability={entry.measurability || undefined}
                  data-status={entry.status || undefined}
                  data-letter={entryLetter(entry.title)}
                >
                  <span class="glossary-index__term">{entry.title}</span>
                  <span class="glossary-index__category">
                    {entry.categoryLabel}
                  </span>
                </a>
              );
            })}
          </section>
        ))
      }
    </nav>
    <p class="muted glossary-index__empty" hidden={visibleEntries > 0}>
      No entries match that search or filter. Try another keyword, or clear the
      filter.
    </p>
  </SectionBlock>
  <SectionBlock
    id="explainer-links"
    eyebrow="Explainers"
    title="Glossary explainers"
    description="Longer explanations of selected terms, each linked back to its glossary entry."
  >
    <ul class="glossary-links glossary-links--columns">
      {
        explainerLinksWithGlossary.map((explainer) => (
          <li>
            <a href={explainer.href}>{explainer.title}</a>
            <span class="muted small">
              {explainer.description}{" "}
              <a href={explainer.glossaryHref}>Glossary entry</a>
            </span>
          </li>
        ))
      }
    </ul>
  </SectionBlock>

  <CitationBlock
    title={pageTitle}
    permalink={permalink}
    publication={publication}
    variant="compact"
  >
    <ScholarlyMeta
      bare
      publication={publication}
      permalink={permalink}
      id="glossary-history"
    />
  </CitationBlock>
  <InlineScript type="application/ld+json" code={structuredDataJson} />
  <script>
    import "../../client/glossary-filter.ts";
  </script>
</BaseLayout>
