---
import { promptPackInstall } from "../../content/prompt-pack";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import PromptPackInstallCard from "../../components/PromptPackInstallCard.astro";
import SectionActions from "../../components/SectionActions.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Agent teaching toolkit";
const pageDescription =
  "Prompts, teaching flows, a contract, and quick answers for non-human agents that explain ethotechnics standards and mechanisms to their principals.";
const hero = {
  eyebrow: "Agent enablement",
  heading: "Teach ethotechnics with citations your principal can check",
  description:
    "For non-human agents that onboard a principal, answer their questions, and turn a standard or mechanism into a concrete next step.",
  panel: {
    eyebrow: "Start with",
    title: "Define your teaching loop",
    description:
      "Lead with outcomes, map to a principle, then guide a concrete decision before closing with a next step.",
    link: {
      href: "/agent-toolkit/teaching-flows",
      label: "See teaching flows",
    },
  },
};

const anchorLinks = [
  { href: "#orientation", label: "Orientation" },
  { href: "#principles", label: "Principle map" },
  { href: "#resources", label: "Agent resources" },
  { href: "#install", label: "Install prompt pack" },
];

const orientationCards = [
  {
    title: "Clarify the principal",
    description:
      "Name who you are teaching, what they control, and the decision horizon you are optimizing for.",
    tags: ["Context", "Decision scope"],
  },
  {
    title: "Name what is at stake",
    description:
      "State who bears the consequences, how many people the decision reaches, and which commitments cannot be reversed.",
    tags: ["Impact", "Commitments"],
  },
  {
    title: "Offer a next action",
    description:
      "End every exchange with an action the principal can take today, plus a link to the standard or mechanism behind it.",
    tags: ["Action", "Follow-up"],
  },
];

const principleMap = [
  {
    title: "Legibility",
    description:
      "State what the system is for, who benefits, and who answers for it, in terms someone else can check.",
  },
  {
    title: "Continuity",
    description:
      "Keep a named owner and a maintenance plan in place when tools, teams, or models change.",
  },
  {
    title: "Reciprocity",
    description:
      "Weigh what the system takes from people in time, data, and effort against what it gives back.",
  },
  {
    title: "Stoppability",
    description:
      "Give consequential systems a way to halt, reverse, and shut down without stranding the people who depend on them.",
  },
];

const resources = [
  {
    title: "Agent FAQ",
    description:
      "Short answers to the most common ethotechnics teaching questions.",
    href: "/agent-toolkit/faq",
    label: "Open the FAQ",
  },
  {
    title: "Agent contract",
    description:
      "The formal contract for how agents apply standards, cite mechanisms, and pin versions.",
    href: "/agent-toolkit/agent-contract",
    label: "Read the contract",
  },
  {
    title: "Prompt packs",
    description:
      "Reusable prompts for onboarding, conflict resolution, and decision reviews.",
    href: "/agent-toolkit/prompt-packs",
    label: "Browse prompt packs",
  },
  {
    title: "Teaching flows",
    description: "Step-by-step flows from a principle to a decision.",
    href: "/agent-toolkit/teaching-flows",
    label: "Explore teaching flows",
  },
  {
    title: "Quick answers index",
    description: "Common requests, each mapped to a principle and a response.",
    href: "/agent-toolkit/quick-answers",
    label: "Use the quick answers",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="collection"
>
  <PageIntro
    eyebrow={hero.eyebrow}
    title={hero.heading}
    description={hero.description}
    anchorLinks={anchorLinks}
    illustration="toolkit"
  />

  <SectionBlock
    id="orientation"
    eyebrow="Orientation"
    title="Three checks before you teach"
    description="Run these with your principal before you introduce a principle."
    className="section--banded"
  >
    <CardGrid className="grid--three">
      {
        orientationCards.map((card) => (
          <CardItem
            title={card.title}
            description={card.description}
            descriptionTone="default"
            tags={card.tags}
          />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="principles"
    eyebrow="Principle map"
    title="Translate ethotechnics principles into teaching cues"
    description="One cue per principle, so the teaching stays the same across domains and system types."
  >
    <CardGrid className="grid--two">
      {
        principleMap.map((principle) => (
          <CardItem
            title={principle.title}
            description={principle.description}
            descriptionTone="default"
          />
        ))
      }
    </CardGrid>
    <p class="muted small">
      Need shared vocabulary? The glossary offers stable definitions and
      cross-links for every principle.
    </p>
    <SectionActions>
      <a class="button ghost" href="/glossary"> Visit the glossary </a>
    </SectionActions>
  </SectionBlock>

  <SectionBlock
    id="resources"
    eyebrow="Agent resources"
    title="Resources by need"
    description="Pick the resource that fits your principal's question and the time you have."
    variant="alt"
  >
    <CardGrid className="grid--two">
      {
        resources.map((resource) => (
          <CardItem
            title={resource.title}
            description={resource.description}
            descriptionTone="default"
          >
            <div slot="footer" class="card__footer">
              <a class="button ghost button--compact" href={resource.href}>
                {resource.label}
              </a>
            </div>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="install"
    eyebrow="Install"
    title="Pin the prompt pack for repeatable teaching sessions"
    description="Download the canonical prompt pack once and reuse it across agents."
  >
    <CardGrid className="grid--two">
      <PromptPackInstallCard {...promptPackInstall} />
    </CardGrid>
  </SectionBlock>
</BaseLayout>
