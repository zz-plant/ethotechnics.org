---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import ScholarlyMeta from "../../components/ScholarlyMeta.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import UseCaseFit from "../../components/UseCaseFit.astro";
import {
  createImplementationPublication,
  implementationExampleAnchorLinks,
} from "../../content/implementation-examples";

const pageTitle = "Loan approval systems: implementation comparison";
const pageDescription =
  "Credit scoring governed two ways: oversight added on top, or reasons, a named owner who answers by a date, and upheld challenges that reach the scoring rule.";
const permalink = "/examples/loan-approval";
const anchorLinks = implementationExampleAnchorLinks;
const publication = createImplementationPublication(
  permalink,
  "Published the loan approval implementation comparison.",
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Implementation example"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="overview"
    eyebrow="Overview"
    title="Where governance breaks down"
    description="Loan approval systems are fast, consequential, and hard to contest once downstream damage starts."
  >
    <p>
      Standard governance focuses on fairness audits, documentation, and
      periodic review. In the <a href="/casebook/apple-card">Apple Card case</a
      >, the model was examined and cleared. The failure was elsewhere:
      applicants had no reasons and no route to challenge a limit. Ethotechnics
      asks whether an applicant gets reasons and an answer to a challenge by a
      set date, and whether a pattern of upheld challenges changes the scoring
      rule.
    </p>
  </SectionBlock>

  <SectionBlock
    id="standard"
    eyebrow="Standard governance"
    title="What standard AI governance implements"
    description="Oversight layers that sit on top of existing credit scoring pipelines."
    variant="alt"
  >
    <ul class="card__list">
      <li>
        Quarterly bias and fairness audits against protected characteristics.
      </li>
      <li>
        Governance committee reviews, documentation, and compliance sign-offs.
      </li>
      <li>Manual review for high-risk or edge-case applications.</li>
      <li>
        Explainability outputs showing key factors (income, credit history,
        DTI).
      </li>
      <li>Audit trails and reporting for regulatory readiness.</li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="ethotechnics"
    eyebrow="Ethotechnics implementation"
    title="What changes when governance becomes infrastructure"
    description="The scoring rule has an owner, and upheld challenges reach it."
  >
    <ul class="card__list">
      <li>
        An applicant who is refused, or offered a lower limit, gets the specific
        reasons for that decision.
      </li>
      <li>
        A challenge goes to a named owner who can change the decision and must
        answer by a stated date. That is what
        <a href="/glossary/contestability">contestability</a> means here.
      </li>
      <li>
        Upheld challenges are counted by scoring rule. The count goes to the
        rule's owner, who reviews the rule and records what changed.
      </li>
      <li>
        A named person can halt decisions from one rule while it is reviewed.
        The halt contains the harm. The review changes the rule.
        <a href="/explainers/time-to-halt">Time-to-halt</a> measures how long the
        halt takes.
      </li>
      <li>
        When a decision is <a href="/glossary/reversibility">reversed</a>, the
        applicant's offer and credit file are restored, including any mark the
        refusal left.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="checklist"
    eyebrow="Implementation checklist"
    title="Signals to verify before launch"
    description="Each check confirms that a wrong decision reaches the scoring rule and is reversed by a date."
  >
    <ul class="muted">
      <li>Name the owner of each scoring rule, and who can halt it.</li>
      <li>Set p95 and p99 time-to-halt targets.</li>
      <li>
        Give applicants a challenge route with a named owner and an answer date.
      </li>
      <li>Count upheld challenges by rule, and name who receives the count.</li>
      <li>
        Record each reversal and halt drill in the
        <a href="/glossary/repair-log">repair log</a>.
      </li>
    </ul>
  </SectionBlock>

  <UseCaseFit slug="loan-approval" />

  <div id="citations">
    <ScholarlyMeta publication={publication} permalink={permalink} />
    <CitationBlock
      title={pageTitle}
      permalink={permalink}
      publication={publication}
      summaryLabel="Cite this implementation example"
    />
  </div>
</BaseLayout>
