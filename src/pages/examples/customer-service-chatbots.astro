---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import ScholarlyMeta from "../../components/ScholarlyMeta.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import UseCaseFit from "../../components/UseCaseFit.astro";
import {
  createImplementationPublication,
  implementationExampleAnchorLinks,
} from "../../content/implementation-examples";

const pageTitle = "Customer service chatbots: implementation comparison";
const pageDescription =
  "Support chatbots governed two ways: escalation only on low confidence, or a person on request, a reply time, a named halt, and failed requests counted by flow.";
const permalink = "/examples/customer-service-chatbots";
const anchorLinks = implementationExampleAnchorLinks;
const publication = createImplementationPublication(
  permalink,
  "Published the customer service chatbot implementation comparison.",
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Implementation example"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="overview"
    eyebrow="Overview"
    title="Where governance breaks down"
    description="Customer support automation can trap users in loops when escalation is a fallback instead of a right."
  >
    <p>
      Standard governance emphasizes transparency, hand-offs, and monitoring
      dashboards. Ethotechnics makes reaching a person a right the bot cannot
      refuse, and counts the requests it fails as evidence about how it is
      built, not only as tickets to close.
    </p>
  </SectionBlock>

  <SectionBlock
    id="standard"
    eyebrow="Standard governance"
    title="What standard AI governance implements"
    description="Process-driven controls that prioritize system performance over user exit speed."
    variant="alt"
  >
    <ul class="card__list">
      <li>Disclosure that the user is speaking with an automated system.</li>
      <li>Confidence-based escalation to human agents for complex cases.</li>
      <li>Logging and review for quality assurance and bias monitoring.</li>
      <li>
        Complaint intake and escalation pathways for post-incident review.
      </li>
      <li>Regular audits of hand-off effectiveness and anomaly detection.</li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="ethotechnics"
    eyebrow="Ethotechnics implementation"
    title="What changes when governance becomes infrastructure"
    description="Reaching a person is a right, and the requests the bot fails are counted against its design."
  >
    <ul class="card__list">
      <li>
        A customer can ask for a person at any point, not only when the bot's
        confidence is low. The bot passes on the conversation with its history.
      </li>
      <li>
        Each hand-off names the team that owns the case and the time by which
        they will reply. That is what
        <a href="/glossary/contestability">contestability</a> means here.
      </li>
      <li>
        Requests the bot failed to resolve or hand off are counted by flow. The
        count goes to the owner of that flow, who records what changed.
      </li>
      <li>
        A named staff member can switch off one bot flow while it is reviewed.
        Switching it off contains the harm. Changing the flow fixes it.
        <a href="/explainers/time-to-halt">Time-to-halt</a> measures how long the
        switch-off takes.
      </li>
      <li>
        When the bot gave wrong advice or wrongly refused a request, the
        customer is contacted and the outcome is corrected.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="checklist"
    eyebrow="Implementation checklist"
    title="Signals to verify before launch"
    description="Confirm that a customer can reach a person, and that the bot's failures reach its owner."
  >
    <ul class="muted">
      <li>
        Show a control that reaches a person, with no penalty and no lost
        history.
      </li>
      <li>
        Publish the reply time for a hand-off in the confirmation the customer
        receives.
      </li>
      <li>Name the staff member who can switch off each bot flow.</li>
      <li>
        Document how wrong advice or a wrongly refused request is corrected.
      </li>
      <li>
        Count failed requests by flow, and record what changed in response.
      </li>
    </ul>
  </SectionBlock>

  <UseCaseFit slug="customer-service-chatbots" />

  <div id="citations">
    <ScholarlyMeta publication={publication} permalink={permalink} />
    <CitationBlock
      title={pageTitle}
      permalink={permalink}
      publication={publication}
      summaryLabel="Cite this implementation example"
    />
  </div>
</BaseLayout>
