---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import ScholarlyMeta from "../../components/ScholarlyMeta.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import UseCaseFit from "../../components/UseCaseFit.astro";
import {
  createImplementationPublication,
  implementationExampleAnchorLinks,
} from "../../content/implementation-examples";

const pageTitle =
  "FHIR resources for healthcare interop: implementation comparison";
const pageDescription =
  "Denials, appeals, repair status, and pending clocks as FHIR resources shared by payers, providers, and regulators, compared with case notes that stay behind.";
const permalink = "/examples/fhir-resources";
const anchorLinks = implementationExampleAnchorLinks;
const publication = createImplementationPublication(
  permalink,
  "Published the FHIR interoperability implementation comparison.",
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Implementation example"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  {
    /* The profile set this example builds on is withdrawn. The example still
       shows how the artifacts map onto FHIR resources, which is why it is
       here rather than retired, but a reader arriving from search needs to
       know which standard to implement against. */
  }
  <aside class="callout" aria-label="Standard status">
    <p class="eyebrow">Superseded profile set</p>
    <p class="muted small">
      This example maps onto <a href="/standards/fhir-profile-set">STD-04</a>,
      withdrawn in February 2026 and replaced by{" "}
      <a href="/standards/w3c-vc-schemas">STD-05</a>. Implement against STD-05;
      the resource mapping below still holds.
    </p>
  </aside>

  <SectionBlock
    id="overview"
    eyebrow="Overview"
    title="Why FHIR has to carry refusal and repair"
    description="A denial and its repair have to travel with the decision."
  >
    <p>
      FHIR is how U.S. healthcare systems move data between payers, providers,
      and regulators. If a denial and its repair are not in the data that moves,
      they are lost when the decision passes from one organization to the next.
    </p>
    <p class="muted">
      Ethotechnics treats a denial, its appeal, and its repair as records that
      travel with the decision. Each system that receives the decision can see
      who owns it, when an appeal must be answered, and whether the harm was
      repaired.
    </p>
  </SectionBlock>

  <SectionBlock
    id="standard"
    eyebrow="Standard governance"
    title="What standard AI governance implements"
    description="Process notes and case logs that do not travel with the clinical record."
    variant="alt"
  >
    <ul class="card__list">
      <li>
        Decisioning logic captured in payer- or provider-specific case systems.
      </li>
      <li>Denials stored as narrative notes or PDF attachments.</li>
      <li>Appeals tracked in separate customer service workflows.</li>
      <li>
        Repair actions logged internally without interoperable status data.
      </li>
      <li>
        Regulators left to reconstruct timelines from siloed audit trails.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="ethotechnics"
    eyebrow="Ethotechnics implementation"
    title="What changes when FHIR is the control plane"
    description="FHIR profiles that carry a denial, its appeal, and its repair with the decision."
  >
    <ul class="card__list">
      <li>
        Custom FHIR profiles for <strong>Decision</strong>, <strong
          >Denial</strong
        >,
        <strong>Appeal</strong>, <strong>RepairStatus</strong>, and
        <strong>PendingClock</strong> resources.
      </li>
      <li>
        A Denial resource names the clinical decision, the reason codes, and the
        person or body that owns the decision.
      </li>
      <li>
        An Appeal resource carries its status, the date it must be answered by,
        who it escalates to, and the evidence attached.
      </li>
      <li>
        An upheld Appeal points to the denial rule it overturned. A payer or a
        regulator can then count upheld appeals by rule and send the count to
        the rule's owner.
      </li>
      <li>
        A RepairStatus update reaches every system that received the decision,
        including the provider's record system and the regulator.
      </li>
      <li>
        A PendingClock resource shows each organization how long a decision or a
        repair has waited, and its deadline.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="checklist"
    eyebrow="Implementation checklist"
    title="Signals to verify before launch"
    description="Confirm that a denial, its appeal, and its repair survive the move between organizations."
  >
    <ul class="muted">
      <li>
        Register the profiles and confirm they validate in payer and provider
        systems.
      </li>
      <li>
        Map denial reasons to standardized codes and publish them through the
        Denial resource.
      </li>
      <li>
        Confirm a change in Appeal status reaches downstream systems within the
        stated time.
      </li>
      <li>
        Expose PendingClock resources through TEFCA-compatible exchange
        endpoints.
      </li>
      <li>
        Count upheld appeals by denial rule, and publish RepairStatus updates
        for regulators and care teams.
      </li>
    </ul>
  </SectionBlock>

  <UseCaseFit slug="fhir-resources" />

  <div id="citations">
    <ScholarlyMeta publication={publication} permalink={permalink} />
    <CitationBlock
      title={pageTitle}
      permalink={permalink}
      publication={publication}
      summaryLabel="Cite this implementation example"
    />
    <p class="muted" style="margin-top:var(--space-5)">
      See also: <a href="/standards">Standards</a> &middot; <a
        href="/mechanisms">Mechanisms</a
      >
    </p>
  </div>
</BaseLayout>
