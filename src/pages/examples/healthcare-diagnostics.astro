---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import ScholarlyMeta from "../../components/ScholarlyMeta.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import UseCaseFit from "../../components/UseCaseFit.astro";
import {
  createImplementationPublication,
  implementationExampleAnchorLinks,
} from "../../content/implementation-examples";

const pageTitle = "Healthcare diagnostic AI: implementation comparison";
const pageDescription =
  "Diagnostic AI governed two ways: lifecycle review, or overrides counted against the model's rule, patient challenges answered by a date, and a named halt.";
const permalink = "/examples/healthcare-diagnostics";
const anchorLinks = implementationExampleAnchorLinks;
const publication = createImplementationPublication(
  permalink,
  "Published the healthcare diagnostic implementation comparison.",
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Implementation example"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="overview"
    eyebrow="Overview"
    title="Where governance breaks down"
    description="Diagnostic AI can reinforce inequities when real-time overrides are slow or informal."
  >
    <p>
      Standard governance emphasizes validation, monitoring, and clinician
      oversight. Ethotechnics asks who can override a recommendation, how fast a
      wrong one is reversed, and whether clinicians' overrides are counted as
      evidence against the model's rule instead of absorbed one patient at a
      time. No healthcare case has been scored yet.
    </p>
  </SectionBlock>

  <SectionBlock
    id="standard"
    eyebrow="Standard governance"
    title="What standard AI governance implements"
    description="Lifecycle controls that often move slower than clinical decision windows."
    variant="alt"
  >
    <ul class="card__list">
      <li>Pre-deployment validation and ongoing bias monitoring.</li>
      <li>Explainability layers to surface contributing clinical factors.</li>
      <li>Governance committees that can review and update models.</li>
      <li>Clinician override protocols for exceptions and edge cases.</li>
      <li>Periodic retraining when disparate impact is detected.</li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="ethotechnics"
    eyebrow="Ethotechnics implementation"
    title="What changes when governance becomes infrastructure"
    description="Clinicians' overrides are recorded and counted against the model's rule."
  >
    <ul class="card__list">
      <li>
        A named clinician can override any recommendation. The override is
        recorded with its reason.
      </li>
      <li>
        Overrides are counted by model rule. The count goes to the model's
        owner, who reviews the rule and records what changed.
      </li>
      <li>
        A patient can challenge a risk classification. A named owner answers by
        a stated date and can change it. That is what
        <a href="/glossary/contestability">contestability</a> means here.
      </li>
      <li>
        A named person can halt the model in one workflow while it is reviewed.
        The halt contains the harm. The review changes the rule.
        <a href="/explainers/time-to-halt">Time-to-halt</a> measures how long the
        halt takes.
      </li>
      <li>
        When a recommendation is <a href="/glossary/reversibility">reversed</a>,
        care it delayed is rescheduled and the delay is recorded.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="checklist"
    eyebrow="Implementation checklist"
    title="Signals to verify before launch"
    description="Confirm who can override and halt, and where the overrides go, before clinical deployment."
  >
    <ul class="muted">
      <li>
        Name who can halt the model in each workflow, and how they are told.
      </li>
      <li>Set a time-to-halt target for each diagnostic workflow.</li>
      <li>
        Give patients a challenge route with a named owner and an answer date.
      </li>
      <li>
        Publish the <a href="/glossary/safety-valve">safety valve</a> procedure for
        pausing the model.
      </li>
      <li>
        Count overrides by rule, and record whether care delayed by a wrong
        recommendation was restored.
      </li>
    </ul>
  </SectionBlock>

  <UseCaseFit slug="healthcare-diagnostics" />

  <div id="citations">
    <ScholarlyMeta publication={publication} permalink={permalink} />
    <CitationBlock
      title={pageTitle}
      permalink={permalink}
      publication={publication}
      summaryLabel="Cite this implementation example"
    />
  </div>
</BaseLayout>
