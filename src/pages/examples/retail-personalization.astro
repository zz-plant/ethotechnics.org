---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import ScholarlyMeta from "../../components/ScholarlyMeta.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import UseCaseFit from "../../components/UseCaseFit.astro";
import {
  createImplementationPublication,
  implementationExampleAnchorLinks,
} from "../../content/implementation-examples";

const pageTitle = "Retail personalization: implementation comparison";
const pageDescription =
  "Recommendation systems governed two ways: review gates, or an off switch, plus reasons and an answered challenge where targeting sets a price or an offer.";
const permalink = "/examples/retail-personalization";
const anchorLinks = implementationExampleAnchorLinks;
const publication = createImplementationPublication(
  permalink,
  "Published the retail personalization implementation comparison.",
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Implementation example"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="overview"
    eyebrow="Overview"
    title="Where governance breaks down"
    description="Personalization can quietly compound bias when users lack direct control over targeting loops."
  >
    <p>
      Standard governance emphasizes data exclusions and ethical reviews. Most
      recommendations decide nothing about a person's status, access, money, or
      risk, so there is little to contest and the framework does less here. It
      applies where personalization sets a price, a credit offer, or who is
      shown a job. There the person needs reasons, and a challenge that can
      change the targeting rule.
    </p>
  </SectionBlock>

  <SectionBlock
    id="standard"
    eyebrow="Standard governance"
    title="What standard AI governance implements"
    description="Policy constraints and review gates with limited runtime authority."
    variant="alt"
  >
    <ul class="card__list">
      <li>Exclude sensitive attributes such as gender or age.</li>
      <li>Cross-functional ethical reviews before deployment.</li>
      <li>Transparency notices about data usage and tracking.</li>
      <li>Human oversight for high-impact recommendation changes.</li>
      <li>Periodic audits for demographic skew or unintended patterns.</li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="ethotechnics"
    eyebrow="Ethotechnics implementation"
    title="What changes when governance becomes infrastructure"
    description="Where targeting sets a price, an offer, or who sees a job, it is treated as a decision about a person."
  >
    <ul class="card__list">
      <li>
        A person can turn personalization off, and it stays off. Turning it off
        does not cost them a price or an offer they would otherwise get.
      </li>
      <li>
        Where targeting sets a price, a credit offer, or who is shown a job, the
        person can see the main reasons it applied to them.
      </li>
      <li>
        A challenge to that price or offer goes to a named owner who answers by
        a stated date. That is what
        <a href="/glossary/contestability">contestability</a> means here.
      </li>
      <li>
        Upheld challenges are counted by targeting rule. The count goes to the
        rule's owner, who reviews the rule and records what changed.
      </li>
      <li>
        The owner can halt one targeting rule while it is reviewed, and a
        rollback target says how long it takes to undo a targeting change.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="checklist"
    eyebrow="Implementation checklist"
    title="Signals to verify before launch"
    description="Confirm a person can turn targeting off, and can challenge a price or an offer it set."
  >
    <ul class="muted">
      <li>Show a control that turns personalization off and keeps it off.</li>
      <li>Publish the answer date for a challenge to a price or offer.</li>
      <li>Name who can halt a targeting rule.</li>
      <li>
        Measure <a href="/glossary/time-to-restore">time-to-restore</a> for mistaken
        targeting changes.
      </li>
      <li>
        Count upheld challenges by rule, and log each rollback in the repair
        log.
      </li>
    </ul>
  </SectionBlock>

  <UseCaseFit slug="retail-personalization" />

  <div id="citations">
    <ScholarlyMeta publication={publication} permalink={permalink} />
    <CitationBlock
      title={pageTitle}
      permalink={permalink}
      publication={publication}
      summaryLabel="Cite this implementation example"
    />
  </div>
</BaseLayout>
