---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import ScholarlyMeta from "../../components/ScholarlyMeta.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import UseCaseFit from "../../components/UseCaseFit.astro";
import {
  createImplementationPublication,
  implementationExampleAnchorLinks,
} from "../../content/implementation-examples";

const pageTitle = "Government public services: implementation comparison";
const pageDescription =
  "Benefits automation governed two ways: review after harm, or named rule owners, upheld challenges counted against the rule, an outside halt, and repair first.";
const permalink = "/examples/public-services";
const anchorLinks = implementationExampleAnchorLinks;
const publication = createImplementationPublication(
  permalink,
  "Published the public services implementation comparison.",
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Implementation example"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="overview"
    eyebrow="Overview"
    title="Where governance breaks down"
    description="Public services can move faster than appeals, leaving residents without immediate recourse."
  >
    <p>
      Standard governance relies on sandboxes, impact assessments, and advisory
      boards. Two scored cases show what they miss.
      <a href="/casebook/robodebt">Robodebt</a> treated a tribunal's repeated findings
      of unlawfulness as individual outcomes, not as evidence against the scheme.
      In the
      <a href="/casebook/toeslagenaffaire">Dutch childcare benefits scandal</a>,
      a fraud risk score was treated as a finding and its reasons were withheld
      from the people it flagged. Ethotechnics requires that an upheld challenge
      reach whoever owns the rule, that someone outside the operator can force a
      halt, and that restoration comes before restart.
    </p>
  </SectionBlock>

  <SectionBlock
    id="standard"
    eyebrow="Standard governance"
    title="What standard AI governance implements"
    description="Program oversight that often arrives after harm is already done."
    variant="alt"
  >
    <ul class="card__list">
      <li>Regulatory sandbox pilots before full deployment.</li>
      <li>Impact assessments with public comment windows.</li>
      <li>Ethics and oversight boards for advisory review.</li>
      <li>Clear accountability structures for policy owners.</li>
      <li>Monitoring dashboards and periodic audits.</li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="ethotechnics"
    eyebrow="Ethotechnics implementation"
    title="What changes when governance becomes infrastructure"
    description="Each eligibility rule has an owner, and upheld challenges are counted against it."
  >
    <ul class="card__list">
      <li>
        Each eligibility or debt rule names the official who owns it and can
        change it.
      </li>
      <li>
        A resident who challenges a decision gets the reasons and an answer by a
        stated date. That is what <a href="/glossary/contestability"
          >contestability</a
        > means here.
      </li>
      <li>
        Each upheld challenge is counted against the rule that produced it. The
        count goes to the rule's owner, who must review the rule and record what
        changed.
      </li>
      <li>
        A body outside the agency, named in advance, can force a halt. A halt
        contains the harm. It does not fix the rule. <a
          href="/glossary/stoppability">Stoppability</a
        > drills test that the halt works.
      </li>
      <li>
        Before the rule runs again, wrongly cut benefits are restored and
        wrongly raised debts are withdrawn.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="checklist"
    eyebrow="Implementation checklist"
    title="Signals to verify before launch"
    description="Confirm that a wrong decision reaches the rule's owner, and that the people harmed are restored."
  >
    <ul class="muted">
      <li>Publish the owner of each rule, and who can force a halt.</li>
      <li>
        Set the date by which a challenge is answered, a <a
          href="/explainers/time-to-halt">time-to-halt</a
        > target, and a <a href="/glossary/time-to-restore">time-to-restore</a> target.
      </li>
      <li>Count upheld challenges by rule, and name who receives the count.</li>
      <li>
        Document how benefits are restored and debts withdrawn before restart.
      </li>
      <li>Run a halt drill and publish the result.</li>
    </ul>
  </SectionBlock>

  <UseCaseFit slug="public-services" />

  <div id="citations">
    <ScholarlyMeta publication={publication} permalink={permalink} />
    <CitationBlock
      title={pageTitle}
      permalink={permalink}
      publication={publication}
      summaryLabel="Cite this implementation example"
    />
  </div>
</BaseLayout>
