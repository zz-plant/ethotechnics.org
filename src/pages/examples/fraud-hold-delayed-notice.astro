---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import UseCaseFit from "../../components/UseCaseFit.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import GlossaryAnchorsBlock from "../../components/GlossaryAnchorsBlock.astro";

const pageTitle = "Fraud hold with delayed notice — Worked example";
const pageDescription =
  "A fraud hold whose notice is delayed up to 24 hours for investigation. The receipt is issued at once and the 1-, 12-, and 48-hour clocks keep running.";

const receiptPayload = `{
  "schema_version": "1.0.0",
  "receipt_id": "RCP-2026-1284",
  "issued_at": "2026-06-04T12:09:55Z",
  "owner": { "name": "Fraud Operations", "role": "System owner" },
  "subject": { "id": "acct-55129", "type": "account" },
  "action": { "class": "WRITE", "description": "Place fraud hold", "reversible": true },
  "decision": { "decision_type": "fraud_hold", "reason_codes": ["VELOCITY", "DEVICE-MISMATCH"] },
  "clocks": { "ack": { "hours": 1 }, "review": { "hours": 12 }, "remedy": { "hours": 48 } },
  "notice": { "delayed": true, "delay_hours": 24 },
  "appeal_path": { "url": "/appeals/fraud-hold", "channel": "secure inbox" }
}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Worked example"
    title="Fraud hold with delayed notice"
    description={pageDescription}
    anchorLinks={[
      { href: "#receipt", label: "Receipt" },
      { href: "#clocks", label: "Clocks" },
      { href: "#exceptions", label: "Exceptions" },
      { href: "#remedy", label: "Remedy" },
      { href: "#bindings", label: "Bindings" },
      { href: "#fit", label: "Where this fits" },
      { href: "#glossary-anchors", label: "Glossary anchors" },
    ]}
  />

  <SectionBlock
    id="receipt"
    eyebrow="Receipt"
    title="The receipt is written even when notice is delayed"
    description="The receipt is written when the hold is placed. Only the notice to the account holder waits for the investigation."
  >
    <pre class="code-block">{receiptPayload}</pre>
  </SectionBlock>

  <SectionBlock
    id="clocks"
    eyebrow="Clocks"
    title="Short clocks for fraud holds"
    description="The clocks start when the hold is placed, not when notice goes out."
    variant="alt"
  >
    <CardGrid className="grid--three">
      <CardItem title="Ack clock" description="1 hour">
        <p class="muted">
          The owner acknowledges the hold and assigns a reviewer.
        </p>
      </CardItem>
      <CardItem title="Review clock" description="12 hours">
        <p class="muted">
          A person reviews the hold and keeps it, narrows it, or removes it.
        </p>
      </CardItem>
      <CardItem title="Remedy clock" description="48 hours">
        <p class="muted">
          The hold is released, or the account holder is told and given limited
          access.
        </p>
      </CardItem>
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="exceptions"
    eyebrow="Exceptions"
    title="Delayed notice must be justified and bounded"
    description="Each delay is logged as an exception."
  >
    <ul class="muted">
      <li>Notice can be delayed only while a fraud investigation is open.</li>
      <li>Notice must go out within 24 hours of the hold.</li>
      <li>
        A steward reviews each delay, and it is logged in the
        <a href="/exceptions">Exceptions framework</a>.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="remedy"
    eyebrow="Remedy"
    title="Release or compensate within 48 hours"
    description="The notice shows the remedy the moment it is delivered."
    variant="alt"
  >
    <ul class="muted">
      <li>
        If fraud is not confirmed, the hold is released and access restored.
      </li>
      <li>
        If more verification is needed, the account holder keeps limited access
        in the meantime.
      </li>
      <li>
        Compensation for lost access is paid and recorded against the decision
        log entry.
      </li>
      <li>
        Each hold released without confirmed fraud is counted against the rule
        that placed it, here VELOCITY or DEVICE-MISMATCH. The count goes to
        Fraud Operations, which owns the rules. When the count passes a set
        number, it reviews the rule and records what changed.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="bindings"
    eyebrow="Bindings"
    title="Tie the hold to enforceable artifacts"
    description="Bindings and evidence packs give an auditor the record of each hold."
  >
    <ul class="muted">
      <li>
        Require receipts in the <a href="/evidence-packs">evidence pack</a> for each
        release.
      </li>
      <li>
        Link the evidence in the <a href="/evidence-packs"
          >STD-01 and STD-02 packs</a
        >.
      </li>
      <li>
        Apply the
        <a href="/anti-weaponization">anti-weaponization constraints</a> to delayed
        notice.
      </li>
    </ul>
  </SectionBlock>

  <UseCaseFit slug="fraud-hold-delayed-notice" />

  <GlossaryAnchorsBlock />
</BaseLayout>
