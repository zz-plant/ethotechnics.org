---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import GlossaryAnchorsBlock from "../../components/GlossaryAnchorsBlock.astro";

const pageTitle = "Automated eligibility denial — Worked example";
const pageDescription =
  "An automated eligibility denial on an income mismatch, with a receipt, a named owner, an appeal path, and 4, 48, and 120-hour clocks.";

const receiptPayload = `{
  "schema_version": "1.0.0",
  "receipt_id": "RCP-2026-1124",
  "issued_at": "2026-05-06T08:27:41Z",
  "owner": { "name": "Eligibility Operations", "role": "System owner" },
  "subject": { "id": "app-99114", "type": "application" },
  "action": { "class": "WRITE", "description": "Deny eligibility", "reversible": true },
  "decision": { "decision_type": "eligibility_denial", "reason_codes": ["INCOME-MISMATCH"] },
  "clocks": { "ack": { "hours": 4 }, "review": { "hours": 48 }, "remedy": { "hours": 120 } },
  "appeal_path": { "url": "/appeals/eligibility", "channel": "in-product form" }
}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Worked example"
    title="Automated eligibility denial"
    description={pageDescription}
    anchorLinks={[
      { href: "#receipt", label: "Receipt" },
      { href: "#clocks", label: "Clocks" },
      { href: "#exceptions", label: "Exceptions" },
      { href: "#remedy", label: "Remedy" },
      { href: "#bindings", label: "Bindings" },
      { href: "#glossary-anchors", label: "Glossary anchors" },
    ]}
  />

  <SectionBlock
    id="receipt"
    eyebrow="Receipt"
    title="Receipt issued at decision time"
    description="The receipt names the reason code, the owner, and the appeal route, so the applicant can contest the denial."
  >
    <pre class="code-block">{receiptPayload}</pre>
  </SectionBlock>

  <SectionBlock
    id="clocks"
    eyebrow="Clocks"
    title="Visible acknowledgment, review, and remedy clocks"
    description="Applicants and reviewers see the same clocks."
    variant="alt"
  >
    <CardGrid className="grid--three">
      <CardItem title="Ack clock" description="4 hours">
        <p class="muted">
          Owner confirms responsibility and shares a review ETA.
        </p>
      </CardItem>
      <CardItem title="Review clock" description="48 hours">
        <p class="muted">
          Human reviewer validates the denial or flags an exception.
        </p>
      </CardItem>
      <CardItem title="Remedy clock" description="120 hours">
        <p class="muted">
          Reversal, compensation, or safe fallback is delivered.
        </p>
      </CardItem>
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="exceptions"
    eyebrow="Exceptions"
    title="Exceptions must preserve the appeal path"
    description="An exception can delay the remedy. It cannot close the appeal."
  >
    <ul class="muted">
      <li>
        Data-quality exceptions require a documented re-verification plan.
      </li>
      <li>Legal exceptions require steward sign-off and review cadence.</li>
      <li>
        Exceptions are logged in the <a href="/exceptions"
          >Exceptions framework</a
        >.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="remedy"
    eyebrow="Remedy"
    title="Remedy path is mandatory"
    description="The applicant can see the remedy, it runs on the 120-hour clock, and it names the next step."
    variant="alt"
  >
    <ul class="muted">
      <li>Reverse the denial when verification succeeds.</li>
      <li>Offer assisted review for high-burden applicants.</li>
      <li>Provide clear next steps and evidence requests.</li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="bindings"
    eyebrow="Bindings"
    title="Bind eligibility decisions to enforceable controls"
    description="Each denial record carries its evidence pack and is checked at a release gate."
  >
    <ul class="muted">
      <li>
        Use <a href="/evidence-packs">release gates</a> for decision records.
      </li>
      <li>
        Attach <a href="/evidence-packs">evidence packs</a> to denial records.
      </li>
      <li>
        Add <a href="/anti-weaponization">anti-weaponization constraints</a> for burden
        checks.
      </li>
    </ul>
  </SectionBlock>

  <GlossaryAnchorsBlock />
</BaseLayout>
