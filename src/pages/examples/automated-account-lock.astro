---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import UseCaseFit from "../../components/UseCaseFit.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import GlossaryAnchorsBlock from "../../components/GlossaryAnchorsBlock.astro";

const pageTitle = "Automated account lock & eligibility flip — Worked example";
const pageDescription =
  "A fraud model locks an account. The worked example traces the receipt, the named owner, the 2-, 24-, and 72-hour clocks, the exceptions, and the remedy.";

const receiptPayload = `{
  "schema_version": "1.0.0",
  "receipt_id": "RCP-2026-0441",
  "issued_at": "2026-02-14T14:03:22Z",
  "owner": {
    "name": "Risk Operations",
    "role": "System owner",
    "contact": "risk-ops@company.example",
    "on_call": true
  },
  "subject": {
    "id": "usr-103991",
    "type": "account"
  },
  "action": {
    "class": "WRITE",
    "description": "Lock account access for review",
    "reversible": true,
    "tools": ["fraud_model", "account_admin_api"]
  },
  "decision": {
    "decision_type": "account_lock",
    "reason_codes": ["FRAUD-THRESHOLD", "VELOCITY-SPIKE"],
    "inputs": ["score:0.93", "velocity:4.2x"]
  },
  "clocks": {
    "ack": { "hours": 2 },
    "review": { "hours": 24 },
    "remedy": { "hours": 72 }
  },
  "appeal_path": {
    "url": "/appeals/account-lock",
    "channel": "in-app form",
    "expected_response": "Human review within 24 hours"
  },
  "evidence_pack": {
    "href": "/evidence-packs/std-02#std-02-2-1",
    "standard_refs": ["STD-01.1.1", "STD-02.2.1"]
  }
}`;

const timeline = [
  {
    title: "Trigger and receipt",
    detail:
      "The fraud model's score crosses the threshold and the account is locked. The system issues a receipt to the account holder and logs the decision.",
  },
  {
    title: "Acknowledgment clock",
    detail:
      "Within 2 hours, Risk Operations acknowledges the case, confirms who owns it, and tells the account holder when review will finish.",
  },
  {
    title: "Review clock",
    detail:
      "Within 24 hours, a person reviews the lock. They keep it, record an exception, or reverse it.",
  },
  {
    title: "Remedy clock",
    detail:
      "Within 72 hours, the account holder gets a remedy: the account unlocked, compensation, or a fallback that keeps essential access open.",
  },
];

const artifacts = [
  {
    title: "Decision log entry",
    description:
      "The MEC-01 record of the model's output, any reviewer's dissent, and the outcome of review.",
    href: "/mechanisms/patterns/decision-log",
  },
  {
    title: "Evidence pack list",
    description:
      "The evidence for the STD-01 and STD-02 clauses on contestability and remedy.",
    href: "/evidence-packs",
  },
  {
    title: "Appeal intake record",
    description:
      "The MEC-06 record of the dispute, with the decision's context and trace filled in.",
    href: "/mechanisms/patterns/appeal-paths",
  },
  {
    title: "Exception log",
    description:
      "An exception entry with an end date, if the lock is tied to a security or legal hold.",
    href: "/exceptions",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Worked example"
    title="Automated account lock & eligibility flip"
    description={pageDescription}
    anchorLinks={[
      { href: "#overview", label: "Overview" },
      { href: "#receipt", label: "Receipt" },
      { href: "#owner", label: "Owner + authority" },
      { href: "#clocks", label: "Clocks" },
      { href: "#exceptions", label: "Exception handling" },
      { href: "#remedy", label: "Remedy path" },
      { href: "#artifacts", label: "Generated artifacts" },
      { href: "#fit", label: "Where this fits" },
      { href: "#glossary-anchors", label: "Glossary anchors" },
    ]}
  />

  <SectionBlock
    id="overview"
    eyebrow="Overview"
    title="The scenario, step by step"
    description="A fraud model locks an account after unusual activity. The system still issues a receipt, names who can reverse the lock, and delivers a remedy within set times."
  >
    <ol class="muted">
      {
        timeline.map((step) => (
          <li>
            <strong>{step.title}:</strong> {step.detail}
          </li>
        ))
      }
    </ol>
  </SectionBlock>

  <SectionBlock
    id="receipt"
    eyebrow="Receipt"
    title="A receipt issued to the account holder at the time of the lock"
    description="The receipt records that a decision happened, who owns it, and how to contest it."
    variant="alt"
  >
    <pre class="code-block">{receiptPayload}</pre>
    <p class="muted">
      The receipt includes the clause references (STD-01.1.1, STD-02.2.1), the
      appeal path, and a link to the evidence pack used in review. Match your
      payload to the{" "}
      <a href="/standards/agent-receipt-schema.json">canonical receipt schema</a
      >.
    </p>
  </SectionBlock>

  <SectionBlock
    id="owner"
    eyebrow="Owner + authority"
    title="Named owner and escalation authority"
    description="The lock has a named owner, and the ownership carries a deadline."
  >
    <ul class="muted">
      <li>
        <strong>Owner:</strong> Risk Operations, which must acknowledge the case.
      </li>
      <li>
        <strong>Authority:</strong> The on-call fraud steward, who can reverse the
        lock without a manager's approval.
      </li>
      <li>
        <strong>Escalation:</strong> The Security and Legal Review Board, if the case
        meets the criteria for an irreversible action or a legal hold.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="clocks"
    eyebrow="Clocks"
    title="Acknowledgment, review, and remedy clocks"
    description="The person locked out can see each clock. Each clock is logged in the decision record."
    variant="alt"
  >
    <CardGrid className="grid--three">
      <CardItem title="Ack clock" description="2 hours">
        <p class="muted">
          The owner confirms who has the case and when review will finish.
        </p>
      </CardItem>
      <CardItem title="Review clock" description="24 hours">
        <p class="muted">
          A person reviews the lock and keeps it, records an exception, or
          reverses it.
        </p>
      </CardItem>
      <CardItem title="Remedy clock" description="72 hours">
        <p class="muted">
          The account is unlocked, the holder is compensated, or essential
          access is kept open.
        </p>
      </CardItem>
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="exceptions"
    eyebrow="Exception handling"
    title="Bounded exceptions for security or legal holds"
    description="Exceptions never erase the receipt or clocks. They only delay specific actions."
  >
    <ul class="muted">
      <li>
        <strong>Security exception:</strong> The lock can stay in place. The acknowledgment
        and review clocks still run, and can be extended by at most 72 hours.
      </li>
      <li>
        <strong>Legal hold:</strong> The remedy can be delayed. The account holder
        must still be able to read statements and see pending withdrawals.
      </li>
      <li>
        <strong>Escalation:</strong> Each exception is logged in the
        {" "}
        <a href="/exceptions">Exceptions register</a>
        {" "}
        with the date a steward will next review it.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="remedy"
    eyebrow="Remedy path"
    title="Remedy is visible, reversible, and time-bound"
    description="The remedy path gives the contest somewhere to land, and limits the harm the lock does while it stands."
    variant="alt"
  >
    <ul class="muted">
      <li>
        <strong>Primary remedy:</strong> If no fraud is confirmed, the account is
        unlocked and eligibility restored within the remedy clock.
      </li>
      <li>
        <strong>Alternative remedy:</strong> If the lock must stand, the holder gets
        limited access and a place in a manual review queue.
      </li>
      <li>
        <strong>Compensation:</strong> Credits for the time the account was locked,
        recorded against the decision log entry.
      </li>
      <li>
        <strong>Repeated reversals:</strong> Each lock reversed on review is counted
        against the rule that triggered it, here FRAUD-THRESHOLD or VELOCITY-SPIKE.
        The count goes to Risk Operations, which owns the rule. When the count passes
        a set number, Risk Operations reviews the threshold and records what changed.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="artifacts"
    eyebrow="Generated artifacts"
    title="Decision log, evidence packs, and appeal record"
    description="These records show that the decision followed the policy. The policy alone cannot show that."
  >
    <CardGrid className="grid--two">
      {
        artifacts.map((artifact) => (
          <CardItem title={artifact.title} description={artifact.description}>
            <a slot="footer" class="muted" href={artifact.href}>
              Open artifact
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <UseCaseFit slug="automated-account-lock" />

  <GlossaryAnchorsBlock />
</BaseLayout>
