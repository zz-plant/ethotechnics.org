---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import ScholarlyMeta from "../../components/ScholarlyMeta.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import UseCaseFit from "../../components/UseCaseFit.astro";
import {
  createImplementationPublication,
  implementationExampleAnchorLinks,
} from "../../content/implementation-examples";

const pageTitle = "Financial fraud detection: implementation comparison";
const pageDescription =
  "Fraud detection governed two ways: accuracy controls, or freeze receipts with a reason, owner, and date, wrongful freezes counted by rule, and time-to-restore.";
const permalink = "/examples/financial-fraud-detection";
const anchorLinks = implementationExampleAnchorLinks;
const publication = createImplementationPublication(
  permalink,
  "Published the financial fraud detection implementation comparison.",
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Implementation example"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="overview"
    eyebrow="Overview"
    title="Where governance breaks down"
    description="Fraud systems often optimize detection rates while leaving restoration slow and opaque."
  >
    <p>
      Standard governance emphasizes compliance logging and human review of
      flagged activity. In the
      <a href="/casebook/toeslagenaffaire">Dutch childcare benefits scandal</a>,
      a fraud risk score was treated as a finding, and the people it flagged
      could not see why. Ethotechnics measures how fast a legitimate customer
      recovers access, and whether a pattern of wrongful flags reaches whoever
      owns the rule.
    </p>
  </SectionBlock>

  <SectionBlock
    id="standard"
    eyebrow="Standard governance"
    title="What standard AI governance implements"
    description="Controls focused on detection accuracy and regulatory reporting."
    variant="alt"
  >
    <ul class="card__list">
      <li>
        Real-time monitoring with automated alerts for suspicious patterns.
      </li>
      <li>Audit logs aligned to AML and compliance requirements.</li>
      <li>Human review queues for flagged transactions or accounts.</li>
      <li>Explanations that list triggering factors for the freeze.</li>
      <li>Ownership structures for compliance escalation and review.</li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="ethotechnics"
    eyebrow="Ethotechnics implementation"
    title="What changes when governance becomes infrastructure"
    description="Each freeze has an owner and a date, and wrongful freezes are counted against the rule that made them."
  >
    <ul class="card__list">
      <li>
        Each freeze issues a receipt with the reason, the owner, and the date by
        which the customer will get an answer. That is what
        <a href="/glossary/contestability">contestability</a> means here.
      </li>
      <li>
        The owner can lift the freeze. If no fraud is confirmed by that date,
        the freeze is lifted.
      </li>
      <li>
        <a href="/glossary/time-to-restore">Time-to-restore</a>, from freeze to
        restored access for a legitimate customer, is measured alongside
        detection accuracy.
      </li>
      <li>
        Freezes lifted as wrongful are counted by detection rule. The count goes
        to the rule's owner, who reviews the rule and records what changed.
      </li>
      <li>
        A named person can halt one detection rule while it is reviewed. The
        halt contains the harm. The review changes the rule. Each restoration,
        with any fees or missed payments repaid, is entered in the
        <a href="/glossary/repair-log">repair log</a>.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="checklist"
    eyebrow="Implementation checklist"
    title="Signals to verify before launch"
    description="Prove that a wrongful freeze is lifted by a date, and that the count reaches the rule's owner."
  >
    <ul class="muted">
      <li>Set a time-to-restore target for customers frozen in error.</li>
      <li>
        Give customers a way to challenge a freeze, answered by a stated date.
      </li>
      <li>Name who can halt a detection rule, and how they are alerted.</li>
      <li>Publish the receipt fields: reason, owner, and answer date.</li>
      <li>
        Count wrongful freezes by rule, and record whether fees and downstream
        losses were repaid.
      </li>
    </ul>
  </SectionBlock>

  <UseCaseFit slug="financial-fraud-detection" />

  <div id="citations">
    <ScholarlyMeta publication={publication} permalink={permalink} />
    <CitationBlock
      title={pageTitle}
      permalink={permalink}
      publication={publication}
      summaryLabel="Cite this implementation example"
    />
  </div>
</BaseLayout>
