---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { diagnosticsContent } from "../../content/diagnostics";
import { fieldNotesContent } from "../../content/fieldNotes";
import { glossaryTerms } from "../../content/glossary";
import { navSections } from "../../content/navigation";

const pageTitle = "Site search — Ethotechnics";
const pageDescription =
  "Search standards, diagnostics, glossary entries, and field notes in one place.";
type SearchEntry = {
  title: string;
  description: string;
  href: string;
  category: string;
  tags?: string[];
};

const navEntries: SearchEntry[] = navSections.flatMap((section) =>
  section.links.map((link) => ({
    title: link.label,
    description: link.description ?? section.description,
    href: link.href,
    category: section.heading,
  })),
);
const diagnosticEntries: SearchEntry[] = diagnosticsContent.tools.map(
  (tool) => ({
    title: tool.title,
    description: tool.description,
    href: `/diagnostics/${tool.slug}`,
    category: "Diagnostics",
    tags: [tool.deliveryType, tool.estimatedTime],
  }),
);
const glossaryEntries: SearchEntry[] = glossaryTerms.map((term) => ({
  title: term.term,
  description: term.definition,
  href: `/glossary/${term.slug}`,
  category: "Glossary",
  tags: term.appliesTo,
}));
const fieldNoteEntries: SearchEntry[] = fieldNotesContent.entries.map(
  (entry) => ({
    title: entry.title,
    description: entry.summary,
    href: `${fieldNotesContent.permalink}#${entry.slug}`,
    category: "Field Notes",
    tags: entry.relatedTerms,
  }),
);

const entries = [
  ...navEntries,
  ...diagnosticEntries,
  ...glossaryEntries,
  ...fieldNoteEntries,
];
const uniqueEntries = new Map<string, SearchEntry>();
const navCategoryPriority = [
  ...navSections
    .map((section) => section.heading)
    .filter((heading) => heading !== "Start"),
  "Start",
];
const navCategoryRanks = new Map(
  navCategoryPriority.map((category, index) => [category, index]),
);
const getCategoryRank = (category: string) =>
  navCategoryRanks.get(category) ?? navCategoryRanks.size;
const pickPreferredEntry = (current: SearchEntry, next: SearchEntry) =>
  getCategoryRank(next.category) < getCategoryRank(current.category)
    ? next
    : current;
entries.forEach((entry) => {
  const existing = uniqueEntries.get(entry.href);
  if (!existing) {
    uniqueEntries.set(entry.href, entry);
    return;
  }
  uniqueEntries.set(entry.href, pickPreferredEntry(existing, entry));
});
const searchEntries = Array.from(uniqueEntries.values());
const suggestions = searchEntries
  .map((entry) => entry.title)
  .sort((a, b) => a.localeCompare(b, "en", { sensitivity: "base" }));
const categoryFilters = Array.from(
  new Set(searchEntries.map((entry) => entry.category)),
).sort((a, b) => a.localeCompare(b, "en", { sensitivity: "base" }));
const quickSearchSuggestions = [
  "Diagnostics",
  "Standards",
  "Glossary",
  "Contestability",
  "Evidence pack readiness",
  "Field notes",
];
const starterQueries = [
  "appeals",
  "rollback",
  "incident memo",
  "time-to-halt",
  "anti-weaponization",
  "ownership",
];
const buildSearchText = (entry: SearchEntry) =>
  [entry.title, entry.description, entry.category, entry.tags?.join(" ")]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="collection"
  robots="noindex, nofollow"
>
  <div data-site-search>
    <PageIntro
      eyebrow="Search"
      title="Search the site"
      description={pageDescription}
      permalink="/search"
      anchorLinks={[{ href: "#search", label: "Search" }]}
      panelCopy={{
        eyebrow: "Scope",
        title: "One search bar for the full catalog.",
        description:
          "Search standards, diagnostics, the glossary, and field notes with URL-based queries for easy sharing.",
      }}
    >
      <div slot="aside" class="panel page-intro__search-panel">
        <p class="muted">Quick search</p>
        <p class="muted small">
          Jump straight into frequent topics or paste a query in the main search
          field to refine with filters.
        </p>
        <ul class="pill-list pill-list--wrap site-search__suggestions">
          {
            quickSearchSuggestions.map((suggestion) => (
              <li>
                <a
                  class="pill-list__button"
                  href={`/search?q=${encodeURIComponent(suggestion)}`}
                >
                  {suggestion}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </PageIntro>

    <SectionBlock
      id="search"
      eyebrow="Search"
      title="Find standards, diagnostics, and field notes."
      description="Search is URL-based, so you can share queries with ?q= in the address bar."
    >
      <div class="site-search">
        <div class="site-search__controls">
          <label for="site-search" class="site-search__label">
            <span class="muted small">
              Search across the entire Ethotechnics catalog.
            </span>
            <div class="site-search__input-row">
              <input
                id="site-search"
                class="site-search__input"
                type="search"
                inputmode="search"
                placeholder="Search terms, diagnostics, standards, or field notes"
                autocomplete="off"
                list="site-search-suggestions"
                data-site-search-input
              />
              <button
                class="button button--ghost button--compact"
                type="button"
                data-site-search-clear-query
                aria-label="Clear search query"
                hidden
              >
                Clear search
              </button>
            </div>
          </label>
          <datalist id="site-search-suggestions">
            {suggestions.map((suggestion) => <option value={suggestion} />)}
          </datalist>
          <div class="site-search__starters">
            <p class="muted small">Starter queries</p>
            <ul class="pill-list pill-list--wrap">
              {
                starterQueries.map((query) => (
                  <li>
                    <a
                      class="pill-list__button"
                      href={`/search?q=${encodeURIComponent(query)}`}
                    >
                      {query}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="site-search__filters">
            <p class="muted small">Filter by collection</p>
            <ul class="pill-list pill-list--wrap">
              {
                categoryFilters.map((category) => (
                  <li class="pill-list__item">
                    <button
                      class="pill-list__button"
                      type="button"
                      data-site-search-filter
                      data-filter-value={category}
                      aria-pressed="false"
                    >
                      {category}
                    </button>
                  </li>
                ))
              }
            </ul>
            <div class="site-search__filter-actions">
              <button
                class="button button--ghost"
                type="button"
                data-site-search-clear
              >
                Clear filters
              </button>
              <p class="muted small" data-site-search-active>
                Viewing all collections.
              </p>
            </div>
          </div>
          <p
            class="muted small"
            role="status"
            aria-live="polite"
            data-site-search-status
          >
            Showing {searchEntries.length} results.
          </p>
          <p class="muted small" data-site-search-ranking-note hidden>
            Showing ranked matches based on title, collection, and tag overlap.
          </p>
          <p class="muted small" data-site-search-context>
            Active query: none. Filters: all collections.
          </p>
        </div>
        <div class="site-search__results">
          {
            searchEntries.map((entry) => (
              <article
                class="card site-search__item"
                data-site-search-item
                data-search={buildSearchText(entry)}
                data-title={entry.title.toLowerCase()}
                data-category={entry.category}
                data-tags={entry.tags?.join(" ").toLowerCase() ?? ""}
              >
                <p class="eyebrow site-search__item-meta">
                  <span>{entry.category}</span>
                  <span
                    class="site-search__top-badge"
                    data-site-search-top-badge
                    hidden
                  >
                    Top match
                  </span>
                </p>
                <h3>
                  <a href={entry.href}>{entry.title}</a>
                </h3>
                <p class="muted">{entry.description}</p>
                {entry.tags?.length ? (
                  <ul class="pill-list pill-list--wrap">
                    {entry.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                ) : null}
              </article>
            ))
          }
          <p class="muted" data-site-search-empty hidden>
            No results yet. Try another keyword or clear the search query.
          </p>
        </div>
      </div>
    </SectionBlock>
    <script>
      import "../../scripts/site-search.ts";
    </script>
    <noscript>
      <p class="card card--flat" style="margin-top: 1rem; padding: 1.5rem;">
        Search filtering requires JavaScript. All {searchEntries.length} results are
        shown below. Use your browser's find (⌘F / Ctrl+F) to search.
      </p>
    </noscript>
  </div>
</BaseLayout>
