---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import StateVariableGlyph from "../../components/StateVariableGlyph.astro";
import VerdictMark from "../../components/VerdictMark.astro";
import CasebookFailureChart from "../../components/CasebookFailureChart.astro";
import TimeToHaltBars from "../../components/TimeToHaltBars.astro";
import {
  casebookContent,
  cases,
  learningVerdictLabels,
  stateVariables,
} from "../../content/casebook";

const { pageTitle, pageDescription, eyebrow, title, description } =
  casebookContent;

// The scores and the record were two sections over the same five cases: a
// matrix of six marks, the halt time, and the after-the-failure verdict, then
// a list that gave each case's record and repeated its failed safeguards.
// Each case now appears once, its record above its row of marks. The failure
// chart below carries the per-safeguard counts the matrix footer gave.
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="collection"
>
  <PageIntro
    eyebrow={eyebrow}
    title={title}
    description={description}
    anchorLinks={[
      { href: "#cases", label: "The cases, scored" },
      { href: "#reading", label: "How to read a score" },
    ]}
  >
    <Fragment slot="actions">
      <a class="button ghost" href="/use-cases">Which systems this is for</a>
    </Fragment>
  </PageIntro>

  <SectionBlock
    id="cases"
    title="What the record established and where the safeguards broke"
    description="Standing, the right of the people affected to challenge a decision and be answered, held in none of the five. Correction held once, at Apple Card, where the issuer changed its own policies without a court, though it took a regulator to prompt it."
    variant="alt"
  >
    <p class="casebook-legend small muted" aria-label="Legend">
      <VerdictMark verdict="held" labelled /> in place and working ·
      <VerdictMark verdict="drifted" labelled /> in place but out of step with what
      it should track ·
      <VerdictMark verdict="failed" labelled /> absent, or its absence is what the
      inquiry found
    </p>
    <p class="small muted">
      <strong>After the failure</strong> — did the institution change?
      <strong>{learningVerdictLabels.learned}</strong> = it changed the rule, category,
      or workflow that produced the errors ·{" "}
      <strong>{learningVerdictLabels.partial}</strong> = some change, late or imposed
      from outside ·{" "}
      <strong>{learningVerdictLabels.absorbed}</strong> = the errors were corrected;
      the process that produced them was not.
      <a href="/research/theory/exception-learning">Read the theory</a>
    </p>

    <ol class="casebook-list">
      {
        cases.map((entry) => (
          <li class="casebook-list__item" id={entry.slug}>
            <div class="casebook-list__head">
              <h3>
                <a href={`/casebook/${entry.slug}`}>{entry.title} &rarr;</a>
              </h3>
              <p class="casebook-list__meta small muted">
                {entry.jurisdiction} · {entry.period}
              </p>
            </div>
            <p class="casebook-list__system">{entry.system}</p>
            <dl class="casebook-scores">
              {stateVariables.map((variable) => {
                const finding = entry.findings.find(
                  (item) => item.variable === variable.id,
                );
                return (
                  <div class="casebook-scores__cell">
                    <dt title={variable.question}>
                      <StateVariableGlyph
                        variable={variable.id}
                        label={variable.label}
                      />
                    </dt>
                    <dd>
                      {finding && (
                        <a
                          href={`/casebook/${entry.slug}#${variable.id}`}
                          class="casebook-scores__link"
                          aria-label={`${entry.title}, ${variable.label}: ${finding.verdict}`}
                        >
                          <VerdictMark verdict={finding.verdict} labelled />
                        </a>
                      )}
                    </dd>
                  </div>
                );
              })}
              <div class="casebook-scores__cell casebook-scores__cell--after">
                <dt>After the failure</dt>
                <dd>
                  <a
                    href={`/casebook/${entry.slug}#learning`}
                    class="casebook-scores__link"
                  >
                    {learningVerdictLabels[entry.learningOutcome.verdict]}
                  </a>
                </dd>
              </div>
            </dl>
            <dl class="casebook-list__facts">
              <div>
                <dt>Scale</dt>
                <dd>{entry.scale}</dd>
              </div>
              <div>
                <dt>Time to halt</dt>
                <dd>{entry.timeToHalt}</dd>
              </div>
              <div>
                <dt>Errors carried by</dt>
                <dd>{entry.errorsCarriedBy}</dd>
              </div>
              <div>
                <dt>Halted by</dt>
                <dd>{entry.haltedBy}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ol>

    <TimeToHaltBars />

    <CasebookFailureChart />
  </SectionBlock>

  <SectionBlock
    id="reading"
    eyebrow="Method"
    title="How to read a score"
    description="A score is a claim about one safeguard at the time of the harm, made from the primary record. It is not a finding of fault, and it is not a measurement of the system today."
    variant="alt"
  >
    <dl class="casebook-reading">
      <div>
        <dt><VerdictMark verdict="held" labelled /></dt>
        <dd>
          The safeguard was written down and still matched what it was meant to
          check. Capability was declared; authority named its limits; the
          evidence was the kind that could justify the action taken.
        </dd>
      </div>
      <div>
        <dt><VerdictMark verdict="drifted" labelled /></dt>
        <dd>
          The safeguard existed but stopped matching what it was meant to check.
          Authority that outlived the evidence it was issued on. A capability
          that grew about fiftyfold while the review capacity beside it stayed
          still.
        </dd>
      </div>
      <div>
        <dt><VerdictMark verdict="failed" labelled /></dt>
        <dd>
          The safeguard was absent, or its absence is what the inquiry found. A
          right to challenge that won individual cases but never changed the
          system that decided them. Evidence that the party relying on it never
          held.
        </dd>
      </div>
    </dl>
    <p>
      Every finding is linked to the clauses it falls under and to the law it
      applies. If a case is scored wrongly, the primary sources are listed on
      its page; <a href="/participate">tell us</a> which one we misread.
    </p>
    <p>
      The last column is not a safeguard. It records what happened after the
      failure: whether the institution changed the rule, category, or workflow
      that produced the errors, or corrected the errors and left that process as
      it was. A case can score badly on the safeguards and still end in change,
      or score well and still end with the process unchanged. The
      <a href="/research/theory/exception-learning"
        >theory essay on exception learning</a
      > explains the difference.
    </p>
    <p class="small muted">
      For three composite scenarios, written as remediation checklists and drawn
      from no single institution, see the
      <a href="/incidents">composite scenarios</a>.
    </p>
  </SectionBlock>
</BaseLayout>

<style>
  /* A case's six marks and its after-the-failure verdict share one grid, so
     a safeguard sits in the same place from case to case. Two columns on a
     phone, three on a tablet, one row on a wide screen. */
  .casebook-scores {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
    max-width: 60rem;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--border) 85%, transparent);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .casebook-scores__cell {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .casebook-scores dt {
    font-family: var(--sans);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-label-wide);
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 650;
  }

  .casebook-scores dd {
    margin: 0;
  }

  .casebook-scores__link {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    font-family: var(--sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  /* The verdict is inline-flex, so the link's underline does not reach it. */
  .casebook-scores__link:hover,
  .casebook-scores__link:focus-visible,
  .casebook-scores__link:hover :global(.verdict__label),
  .casebook-scores__link:focus-visible :global(.verdict__label) {
    text-decoration: underline;
  }

  .casebook-scores__cell--after {
    grid-column: 1 / -1;
    padding-top: var(--space-3);
    border-top: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  }

  @media (min-width: 560px) {
    .casebook-scores {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .casebook-scores {
      grid-template-columns: repeat(6, minmax(0, 1fr)) minmax(9rem, 1.4fr);
    }

    .casebook-scores__cell--after {
      grid-column: auto;
      padding: 0 0 0 var(--space-4);
      border-top: 0;
      border-left: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    }
  }
</style>
