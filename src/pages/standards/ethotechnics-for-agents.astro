---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import PromptPackInstallCard from "../../components/PromptPackInstallCard.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import SummaryCallout from "../../components/SummaryCallout.astro";
import {
  actionClassRows,
  anchorLinks,
  controlChecklist,
  practiceSections,
  promptPackInstall,
  signalIntegrityRows,
  summaryJumpLinks,
  summaryRelatedLinks,
  summaryTakeaways,
} from "../../content/page-data/ethotechnics-for-agents";
import { readFile } from "node:fs/promises";

const pageTitle = "Ethotechnics for Agents";
const pageDescription =
  "This page is for teams building and operating automated systems. Mechanism-first safety practice for turning ethics goals into enforceable agent controls.";
const permalink = "/standards/ethotechnics-for-agents";
const agentReceiptSchema = await readFile(
  new URL("../../../public/standards/agent-receipt-schema.json", import.meta.url),
  "utf-8",
);

const agentSafetyObjectModel = await readFile(
  new URL("../../../public/agents/spec.json", import.meta.url),
  "utf-8",
);

---

<BaseLayout
  title={`${pageTitle} \u2014 Standards`}
  description={pageDescription}
>
  <PageIntro
    eyebrow="Practice"
    title={pageTitle}
    description={pageDescription}
    permalink={permalink}
    anchorLinks={anchorLinks}
    panelCopy={{
      eyebrow: "Status",
      title: "Active",
      description:
        "Scope: autonomous and semi-autonomous agents, workflow automation, and decision engines. Related: STD-01 and STD-02.",
    }}
  />

  <SummaryCallout
    eyebrow="Reading guide"
    title="Fast orientation for long-form standards"
    description="Use this summary to skim the framework before diving into the full requirements."
    takeaways={summaryTakeaways}
    relatedLinks={summaryRelatedLinks}
    jumpLinks={summaryJumpLinks}
  />

  <SectionBlock
    id="who-this-is-for"
    eyebrow="Audience"
    title="Who this is for"
    description="Make it explicit who the practice is designed to serve."
    variant="alt"
  >
    <p>
      This is for teams building and operating agents. Agents don\u2019t follow ethics; systems
      constrain agents.
    </p>
  </SectionBlock>

  <SectionBlock
    id="overview"
    eyebrow="Practice snapshot"
    title="Mechanism-first safety practice"
    description="A doctrine for making safety enforceable in agent systems."
  >
    <dl class="standard-definitions">
      <div>
        <dt>Status</dt>
        <dd>Active</dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd>Autonomous and semi-autonomous agents, workflow automation, decision engines.</dd>
      </div>
      <div>
        <dt>Related</dt>
        <dd>
          <a href="/standards/std-01-temporal-rights">STD-01: The Temporal Bill of Rights</a>
          <br />
          <a href="/standards/std-02-contestability-recourse">
            STD-02: Contestability &amp; Recourse
          </a>
        </dd>
      </div>
    </dl>
  </SectionBlock>

  <SectionBlock
    id="what-this-is"
    eyebrow="What this is"
    title="Ethotechnics is not a philosophy."
    description="It is a mechanism-first discipline for building safe agent systems."
    variant="alt"
  >
    <p>
      Ethotechnics is a mechanism-first discipline for turning safety and ethics goals into
      concrete design and operational decisions for agents\u2014things that can be specified, built,
      tested, audited, and owned.
    </p>
    <p>This practice exists to answer a single question:</p>
    <p class="standard-article-quote">
      \u201cWhat must be true, structurally, for an agent to be safe to operate?\u201d
    </p>
  </SectionBlock>

  <SectionBlock
    id="core-premise"
    eyebrow="Core premise"
    title="Agents are actors, and humans live with the outcomes."
    description="Any acting system must define constraints and recourse for both operators and affected people."
  >
    <p>Any system that can act must define:</p>
    <ul class="standard-clauses">
      <li>What it can do.</li>
      <li>Under what conditions it can do it.</li>
      <li>Who can stop it.</li>
      <li>How failure is detected and contained.</li>
      <li>How operators and affected users can contest outcomes.</li>
    </ul>
    <p>
      If a safety claim cannot be expressed as a constraint, control surface, or measurable
      signal, it is not enforceable.
    </p>
  </SectionBlock>

  <SectionBlock
    id="knowing-differently"
    eyebrow="Why this changes the conversation"
    title="An infrastructure for knowing differently"
    description="This standard changes what teams can ask, prove, and contest."
  >
    <p>
      This infrastructure makes ethics operational. It shifts review conversations from
      <em>declared intent</em> to <em>enforceable system behavior</em>: who can act, who can stop,
      what clocks run, where reversal paths exist, and how those paths stay legible to people
      affected by decisions.
    </p>
    <ul class="standard-clauses">
      <li>From values-only claims to testable controls and receipts.</li>
      <li>From one-off explanation to repeatable governance evidence.</li>
      <li>From private judgment calls to shared, auditable decision objects for teams and the public.</li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="epistemic-obstacles"
    eyebrow="Epistemology in practice"
    title="Obstacles this standard is built to overcome"
    description="Common ways teams think they know enough, and the controls that correct them."
    variant="alt"
  >
    <div class="grid grid--two">
      <div class="panel">
        <p class="eyebrow">Obstacle</p>
        <ul class="muted">
          <li><strong>Intent theater:</strong> policy statements substitute for enforceability.</li>
          <li><strong>Explainability decoy:</strong> narratives stand in for real recourse people can use.</li>
          <li><strong>Memory loss:</strong> incidents are discussed, then forgotten in delivery.</li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Countermeasure in this practice</p>
        <ul class="muted">
          <li>Action classes + approval gates + accountable owners.</li>
          <li>Contestability surfaces with live appeals and hard clocks that humans can actually access.</li>
          <li>Receipts, decision logs, and linked evidence packs for cumulative learning.</li>
        </ul>
      </div>
    </div>
  </SectionBlock>

  <SectionBlock
    id="receipt-schema"
    eyebrow="P0 artifact"
    title="Canonical agent receipt schema (JSON)"
    description="Receipts are the universal integration point. Make them stable and versioned."
    variant="alt"
  >
    <p>
      Publish a single canonical schema and emit it everywhere a decision happens. The canonical
      JSON schema lives at{" "}
      <a href="/standards/agent-receipt-schema.json">/standards/agent-receipt-schema.json</a>.
    </p>
    <p class="muted">
      Required fields: schema version, receipt ID, owner, subject, action class, decision inputs,
      clocks, appeal path, and evidence pack anchors.
    </p>
    <p class="muted">Related decision artifacts:</p>
    <ul class="muted">
      <li>
        <a href="/standards/decision-record.schema.json">Decision record schema</a>
      </li>
      <li>
        <a href="/standards/appeal-event.schema.json">Appeal event schema</a>
      </li>
      <li>
        <a href="/standards/pause-reversal.schema.json">Pause & reversal schema</a>
      </li>
      <li>
        <a href="/standards/burden-hours.schema.json">Burden hours schema</a>
      </li>
      <li>
        <a href="/standards/repair-sla.schema.json">Repair SLA schema</a>
      </li>
    </ul>
    <pre class="code-block">{agentReceiptSchema}</pre>
    <div class="grid grid--two">
      <div class="panel">
        <p class="eyebrow">Field guide</p>
        <ul class="muted">
          <li>
            <strong>owner:</strong> names the accountable human team or steward.
          </li>
          <li>
            <strong>action.class:</strong> ties the decision to approvals and reversibility.
          </li>
          <li>
            <strong>clocks:</strong> makes acknowledgment, review, and remedy enforceable.
          </li>
          <li>
            <strong>appeal_path:</strong> gives the impacted person a live contestation route.
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">What breaks if missing</p>
        <ul class="muted">
          <li>Missing owner: no accountable steward to respond within clocks.</li>
          <li>Missing action class: approvals and reversibility checks cannot run.</li>
          <li>Missing clocks: remedies become optional rather than enforceable.</li>
          <li>Missing evidence links: audits cannot trace proof back to clauses.</li>
        </ul>
      </div>
    </div>
  </SectionBlock>

  <SectionBlock
    id="action-taxonomy"
    eyebrow="P0 artifact"
    title="Action-class taxonomy template"
    description="Define allowed actions, reversibility, and default approval gates."
  >
    <p>
      Action classes make enforcement legible. Attach reversibility, clocks, and approvals to each
      class so teams can ship controls quickly.
    </p>
    <div class="mapping-table__wrapper">
      <table class="mapping-table mapping-table--compare">
        <caption class="visually-hidden">Action-class taxonomy template</caption>
        <thead>
          <tr>
            <th>Action class</th>
            <th>Examples</th>
            <th>Reversible?</th>
            <th>Default controls</th>
          </tr>
        </thead>
        <tbody>
          {actionClassRows.map((row) => (
            <tr>
              <td data-label="Action class">{row.actionClass}</td>
              <td data-label="Examples">{row.examples}</td>
              <td data-label="Reversible?">{row.reversibility}</td>
              <td data-label="Default controls">{row.controls}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted">
      Mark any irreversible class as approval-gated by default and attach the Hard Clock + Kill
      switch to production runs.
    </p>
  </SectionBlock>

  <SectionBlock
    id="contestability-surface"
    eyebrow="P1 artifact"
    title="Contestability surface: minimum shipping spec"
    description="Define the UI patterns, copy, and escalation ladder that make contestation real."
    variant="alt"
  >
    <div class="grid grid--two">
      <div class="panel">
        <p class="eyebrow">Minimum UI patterns</p>
        <ul class="muted">
          <li>Decision log view with timestamp, owner, and action class.</li>
          <li>Undo or revert controls where possible, plus fallback remedies.</li>
          <li>\u201cDon\u2019t do this again\u201d preference toggle tied to policy.</li>
          <li>Inline appeal button that opens a pre-filled dispute form.</li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Copy requirements</p>
        <ul class="muted">
          <li>\u201cWhy this happened\u201d field with reason codes and inputs used.</li>
          <li>State the decision owner and how to reach a reviewer.</li>
          <li>Provide clock timelines: acknowledge, review, remedy.</li>
          <li>Explain what changes if the appeal is upheld.</li>
        </ul>
      </div>
    </div>
    <div class="grid grid--two">
      <div class="panel">
        <p class="eyebrow">Evidence upload constraints</p>
        <ul class="muted">
          <li>Accept files, links, and inline statements (max 25 MB per file).</li>
          <li>Capture timestamps and author identity for each submission.</li>
          <li>Log evidence hashes in the receipt for auditability.</li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Default escalation ladder</p>
        <ul class="muted">
          <li>Tier 1: on-call owner review within 24 hours.</li>
          <li>Tier 2: risk steward review within 72 hours.</li>
          <li>Tier 3: independent escalation board within 7 days.</li>
        </ul>
      </div>
    </div>
  </SectionBlock>

  <SectionBlock
    id="exception-policy"
    eyebrow="P1 artifact"
    title="Agent exception policy (explicit and bounded)"
    description="Tie the agent practice to the bounded exceptions framework."
  >
    <ul class="standard-clauses">
      <li>Agents may suppress notice only under fraud, security, or abuse exceptions.</li>
      <li>
        Even under exceptions, the system must still issue receipts, name owners, and run clocks.
      </li>
      <li>Exceptions expire on defined cadences and require steward review to renew.</li>
      <li>
        Use the{" "}
        <a href="/exceptions">Exceptions framework</a>
        {" "}
        and link receipt payloads to the canonical schema.
      </li>
    </ul>
  </SectionBlock>

  {practiceSections.map((section, index) => (
    <SectionBlock
      id={section.id}
      eyebrow={section.eyebrow}
      title={section.title}
      description={section.summary}
      variant={index % 2 === 0 ? "alt" : undefined}
    >
      <div class="grid grid--two">
        <div>
          <p class="eyebrow">Required specifications</p>
          <ul class="standard-clauses">
            {section.requirements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        {section.signals ? (
          <div>
            <p class="eyebrow">Required signals</p>
            <ul class="standard-clauses">
              {section.signals.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ) : (
          <div class="panel">
            <p class="eyebrow">Required signals</p>
            <p class="muted">Define measurable signals that prove containment or recovery.</p>
          </div>
        )}
      </div>

      <div class="grid grid--two">
        <div class="panel">
          <p class="eyebrow">Mapped mechanisms</p>
          <ul class="muted">
            {section.mechanisms.map((mechanism) => (
              <li>
                <a href={mechanism.href}>{mechanism.title}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="panel">
          <p class="eyebrow">Coverage gaps</p>
          <ul class="muted">
            {section.gaps.map((gap) => (
              <li>{gap}</li>
            ))}
          </ul>
        </div>
      </div>
    </SectionBlock>
  ))}

  <SectionBlock
    id="signal-integrity"
    eyebrow="P1 artifact"
    title="Anti-gaming guidance for required signals"
    description="Assume teams will optimize metrics. Instrument what detects gaming."
    variant="alt"
  >
    <table class="mapping-table">
      <thead>
        <tr>
          <th>Signal</th>
          <th>How teams fake it</th>
          <th>Detect gaming</th>
          <th>Tier 0 / 1 / 2 measurement</th>
        </tr>
      </thead>
      <tbody>
        {signalIntegrityRows.map((row) => (
          <tr>
            <td>{row.signal}</td>
            <td>{row.gaming}</td>
            <td>{row.detection}</td>
            <td>{row.tiers}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="muted">
      Pair with
      {" "}
      <a href="/measurement-tiers">Measurement tiers</a>
      {" "}
      to set the minimum acceptable signal maturity.
    </p>
  </SectionBlock>

  <SectionBlock
    id="control-checklist"
    eyebrow="P2 artifact"
    title="Control checklist for deployment gates"
    description="Use this as a go/no-go gate for agent rollout."
  >
    <p>Copy-paste this checklist into your deployment template or runbook.</p>
    <pre class="code-block">{controlChecklist}</pre>
  </SectionBlock>

  <SectionBlock
    id="safety-object-model"
    eyebrow="P2 artifact"
    title="Agent Safety Object Model (machine-readable)"
    description="A minimal JSON index that CI systems can validate."
    variant="alt"
  >
    <p>
      Publish a machine-readable index at{" "}
      <a href="/agents/spec.json">/agents/spec.json</a>
      {" "}
      so deployment pipelines can confirm required governance artifacts exist. The readable spec
      lives at{" "}
      <a href="/agents/spec">/agents/spec</a>.
    </p>
    <pre class="code-block">{agentSafetyObjectModel}</pre>
  </SectionBlock>

  <SectionBlock
    id="boundaries"
    eyebrow="Boundary"
    title="What this practice does\u2014and does not\u2014do"
    description="Mechanism-first safety does not erase tradeoffs, but it makes them enforceable."
  >
    <p>
      This discipline does not eliminate tradeoffs or value conflicts. It keeps safety grounded in
      permissions, controls, ownership, contestability, and recovery\u2014the parts of the system that
      can actually be improved.
    </p>
    <p>
      If a system lacks clear constraints, control surfaces, or named owners, it has not yet
      translated ethics into operations.
    </p>
  </SectionBlock>

  <SectionBlock
    id="fast-path"
    eyebrow="Fast path"
    title="Minimum viable integration (<1 sprint)"
    description="Do this first to make agent systems enforceable quickly."
    variant="alt"
  >
    <ol class="standard-clauses">
      <li>
        Ship{" "}
        <a href="/mechanisms/patterns/decision-log">MEC-01 Decision Log</a>
        {" "}
        with dissent and owner sign-off.
      </li>
      <li>
        Implement{" "}
        <a href="/mechanisms/patterns/kill-switch">MEC-05 Kill switch</a>
        {" "}
        with rollback criteria and on-call authority.
      </li>
      <li>
        Embed{" "}
        <a href="/mechanisms/patterns/appeal-paths">MEC-06 Appeal paths</a>
        {" "}
        in the UI with clocks and escalation ladder.
      </li>
      <li>
        Emit receipts using the canonical schema + publish clocks in UI.
      </li>
      <li>
        Register action classes with reversible/irreversible flags and approvals.
      </li>
      <li>
        Publish the{" "}
        <a href="/agents/spec">Agent Safety Object Model</a>
        {" "}
        for machine-verifiable controls.
      </li>
    </ol>
    <p class="muted">
      Keep onboarding and diagnostics prompts versioned alongside your integration checklist.
    </p>
    <div class="grid grid--two">
      <PromptPackInstallCard {...promptPackInstall} />
    </div>
  </SectionBlock>

  <SectionBlock
    id="referenced-by"
    eyebrow="Referenced by"
    title="Where this practice is enforced"
    description="Cross-links keep practices, bindings, and evidence packs aligned."
  >
    <div class="grid grid--three">
      <div class="panel">
        <p class="eyebrow">Used in examples</p>
        <ul class="muted">
          <li>
            <a href="/examples/automated-account-lock">Automated account lock</a>
          </li>
          <li>
            <a href="/examples/fraud-hold-delayed-notice">Fraud hold with delayed notice</a>
          </li>
          <li>
            <a href="/examples/irreversible-payment-compensation">
              Irreversible payment with compensation
            </a>
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Required by bindings</p>
        <ul class="muted">
          <li>
            <a href="/bindings#release-gates">Release gate checklist</a>
          </li>
          <li>
            <a href="/bindings#procurement">Procurement clauses</a>
          </li>
          <li>
            <a href="/bindings#runbooks">Runbook snippets</a>
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Verified by evidence packs</p>
        <ul class="muted">
          <li>
            <a href="/evidence-packs/std-01">STD-01 Evidence Pack</a>
          </li>
          <li>
            <a href="/evidence-packs/std-02">STD-02 Evidence Pack</a>
          </li>
          <li>
            <a href="/validators">Validators (VAL-01–VAL-03)</a>
          </li>
        </ul>
      </div>
    </div>
    <p class="muted">
      Search IDs: STD-01 v1.0, STD-02 v0.9, STD-01.1.1, STD-02.2.1, MEC-01, MEC-05,
      MEC-06, VAL-01, VAL-02, VAL-03.
    </p>
  </SectionBlock>
</BaseLayout>
