---
import StandardsLayout from "../../components/StandardsLayout.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import { derivePublicationMetadata } from "../../utils/publication";
import {
  euAiActArticleCoverage,
  evidencePackMinimumSet,
  governanceCrosswalks,
  postMarketWorkflow,
  resolveClause,
} from "../../content/crosswalks";

type FrameworkCard = {
  framework: string;
  anchor: string;
  mappedControlId: string;
  mappedControlIds?: string[];
  standardReference: string;
  status: "Partial: listed clauses only" | "Supporting evidence only";
  whatEthotechnicsCovers: string;
  buyerAuditorChecks: string[];
  firstMove: string;
  detailedLinks: Array<{ label: string; href: string }>;
};

const pageTitle = "Framework map for buyers and auditors";
const pageDescription =
  "Ethotechnics controls mapped to EU AI Act, NIST AI RMF, ISO/IEC, SOC 2, and IEC 61508 obligations, with buyer checks and evidence requests.";
const permalink = "/standards/enforceable-governance-crosswalks";

const publication = derivePublicationMetadata({
  permalink,
  published: "2026-02-15T00:00:00Z",
  updated: "2026-10-06T00:00:00Z",
  version: "v0.4.0",
  authorName: "Ethotechnics Institute",
  changelogSummary:
    "Replaced the “Ready now” status, which read as a compliance verdict, with “Partial: listed clauses only”. Added the EU AI Act article by article, with the clauses behind each and what they leave to the operator. Corrected NIST AI RMF subcategories and ISO/IEC 42001 clause titles that did not match the frameworks.",
});

const findControl = (controlId: string) => {
  const control = governanceCrosswalks.find(
    (entry) => entry.controlId === controlId,
  );
  if (!control) {
    throw new Error(`Missing control mapping for ${controlId}`);
  }
  return control;
};

const toCrosswalkDetailHref = (controlId: string) =>
  `/standards/crosswalk/${controlId.toLowerCase()}`;

const frameworkCards: FrameworkCard[] = [
  {
    framework: "EU AI Act (high-risk context)",
    anchor: "#eu-ai-act",
    mappedControlId: "CTRL-03",
    mappedControlIds: ["CTRL-01", "CTRL-02", "CTRL-03", "CTRL-04"],
    standardReference: "Articles 9, 12, 14, and 72 in part; not Article 73",
    status: "Partial: listed clauses only",
    whatEthotechnicsCovers:
      "Parts of risk management, record-keeping, human oversight, and post-market monitoring. No clause covers serious-incident reporting under Article 73.",
    buyerAuditorChecks: [
      "Named owner for incident-reporting clocks and regulator submissions.",
      "Decision-level records retained with version context.",
      "Documented stop authority and oversight rota for high-risk actions.",
    ],
    firstMove:
      "Read the article table below and assign an owner to each gap, starting with Article 73 incident reporting.",
    detailedLinks: [
      { label: "EU AI Act article table", href: "#eu-ai-act-articles" },
      { label: "EU AI Act critique and dates", href: "/standards/eu-ai-act" },
      { label: "Incident lessons hub", href: "/incidents" },
    ],
  },
  {
    framework: "NIST AI RMF 1.0",
    anchor: "#nist",
    mappedControlId: "CTRL-02",
    standardReference: "MANAGE 1.1, MANAGE 1.3, MEASURE 2.5",
    status: "Partial: listed clauses only",
    whatEthotechnicsCovers:
      "Operational governance controls mapped to release gates, pre-release validation, and mitigation ownership.",
    buyerAuditorChecks: [
      "Current risk register slice tied to system version and owner.",
      "Validation thresholds defined before launch (not after incidents).",
      "Mitigation backlog includes due dates and accountable humans.",
    ],
    firstMove:
      "Ask for the last launch decision's test results, with each threshold dated before its test ran (STD-06 §2.1 and §2.2).",
    detailedLinks: [
      {
        label: "NIST subcategories mapped to clauses",
        href: "/standards/nist-ai-rmf#clause-map",
      },
      {
        label: "STD-06 human-impact safety case",
        href: "/standards/std-06-human-impact-safety-case",
      },
    ],
  },
  {
    framework: "ISO/IEC 42001",
    anchor: "#iso42001",
    mappedControlId: "CTRL-02",
    mappedControlIds: ["CTRL-02", "CTRL-03"],
    standardReference: "Clauses 6.1, 8.1, 8.2, 9.1, 10.1",
    status: "Partial: listed clauses only",
    whatEthotechnicsCovers:
      "Lifecycle controls for an AI management system (AIMS): planning, operation, monitoring, and continual improvement.",
    buyerAuditorChecks: [
      "Policy record references operational controls and review cadence.",
      "Internal audits sample real evidence artifacts, not only policy PDFs.",
      "Corrective actions are linked to incident and remediation logs.",
    ],
    firstMove:
      "Cross-check your AIMS internal-audit scope against evidence-pack artifacts and owners.",
    detailedLinks: [
      { label: "ISO/IEC 42001 overview", href: "/standards/iso-iec-42001" },
      { label: "Evidence packs", href: "/evidence-packs" },
    ],
  },
  {
    framework: "ISO/IEC 27001",
    anchor: "#iso27001",
    mappedControlId: "CTRL-04",
    standardReference: "Annex A control families + ISMS records",
    status: "Supporting evidence only",
    whatEthotechnicsCovers:
      "Traceability, retention, and reconstruction controls that support ISMS evidence, but org-specific Annex A controls remain local.",
    buyerAuditorChecks: [
      "Access control and key management ownership are documented in your ISMS.",
      "Retention periods in Ethotechnics records align with ISMS policy.",
      "Exception handling is approved and logged with expiry dates.",
    ],
    firstMove:
      "Map Ethotechnics decision records into your existing Annex A control matrix.",
    detailedLinks: [
      {
        label: "Governance capability explainer",
        href: "/explainers/governance-capability",
      },
      { label: "Mechanisms catalog", href: "/mechanisms" },
    ],
  },
  {
    framework: "SOC 2 (AICPA TSC)",
    anchor: "#soc2",
    mappedControlId: "CTRL-01",
    standardReference: "CC-series (security, availability, integrity)",
    status: "Supporting evidence only",
    whatEthotechnicsCovers:
      "Human oversight, escalation, and change-control evidence that supports common SOC 2 control expectations.",
    buyerAuditorChecks: [
      "Control owner matrix includes response-time commitments.",
      "Change approvals include model-version context and rollback path.",
      "Audit trail supports challenge-response testing during fieldwork.",
    ],
    firstMove:
      "Bind oversight drill records to your SOC 2 control narratives before the next audit cycle.",
    detailedLinks: [
      {
        label: "Citing the standards in contracts",
        href: "/standards/where-this-binds",
      },
      {
        label: "Failure postmortem template",
        href: "/standards/pm-01-failure-postmortem-template",
      },
    ],
  },
  {
    framework: "IEC 61508",
    anchor: "#iec61508",
    mappedControlId: "CTRL-01",
    standardReference: "Safety lifecycle obligations",
    status: "Supporting evidence only",
    whatEthotechnicsCovers:
      "Stop authority and incident-route controls that support safety operations, while SIL determination and hardware safety remain implementation-specific.",
    buyerAuditorChecks: [
      "Safety-case assumptions are explicit and version-controlled.",
      "Escalation paths define human authority at each hazard tier.",
      "Post-incident closure includes residual risk statement.",
    ],
    firstMove:
      "Use Ethotechnics controls as governance overlays inside your existing safety lifecycle artifacts.",
    detailedLinks: [
      {
        label: "STD-06 human-impact safety case",
        href: "/standards/std-06-human-impact-safety-case",
      },
      { label: "Incident memo template", href: "/standards/incident-memo" },
    ],
  },
];

const keyTakeaways = [
  "Checked on 2026-10-06 against the Ethotechnics clause register, the EU AI Act as amended by Regulation (EU) 2026/1744, and NIST AI 100-1.",
  "“Partial: listed clauses only” means Ethotechnics clauses bear on part of each framework clause listed, and the rest stays with you. “Supporting evidence only” means Ethotechnics records can serve as evidence inside controls your organization owns.",
  "No row is a determination of legal compliance. Each links to control briefs that name the Ethotechnics clauses a contract can cite and the records to request.",
];
---

<StandardsLayout
  title={pageTitle}
  description={pageDescription}
  permalink={permalink}
  seoTitle={`${pageTitle} — Standards`}
  eyebrow="Crosswalk"
  anchorLinks={[
    { href: "#guide", label: "Guide" },
    { href: "#summary", label: "Using a crosswalk row" },
    { href: "#controls", label: "Crosswalk" },
    { href: "#eu-ai-act-articles", label: "EU AI Act by article" },
    { href: "#framework-cards", label: "Framework cards" },
    { href: "#post-market", label: "Post-market" },
    { href: "#citations", label: "Citation" },
  ]}
  publishedTime="2025-06-01T00:00:00.000Z"
  modifiedTime="2026-10-06T00:00:00.000Z"
  jsonAlternates={[{ href: "/api/crosswalks.json", title: "Crosswalks JSON" }]}
>
  <SectionBlock
    id="guide"
    eyebrow="Start here"
    title="Plain-language guide"
    description="Answers for procurement and audit, without reading every standards document first."
  >
    <ul>
      {keyTakeaways.map((item) => <li>{item}</li>)}
    </ul>
  </SectionBlock>

  <SectionBlock
    id="summary"
    title="Using a crosswalk row"
    description="Pick a framework, check its status, take the first step, then request the listed evidence."
    variant="alt"
  >
    <ol>
      <li>
        Read the status. For the EU AI Act, read the <a
          href="#eu-ai-act-articles">article table</a
        > too: it says what each clause leaves to you.
      </li>
      <li>Name the person accountable for the first step.</li>
      <li>
        Request evidence artifacts before contract sign-off or audit close.
      </li>
    </ol>
  </SectionBlock>

  <SectionBlock
    id="controls"
    eyebrow="Overview"
    title="Framework-by-framework crosswalk"
    description="One row per framework: the Ethotechnics control it maps to, what that control covers, and how much is left to you."
  >
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Framework</th>
            <th scope="col">Status</th>
            <th scope="col">Ethotechnics control and framework clauses</th>
            <th scope="col">What Ethotechnics covers</th>
            <th scope="col">First step</th>
            <th scope="col">Details</th>
          </tr>
        </thead>
        <tbody>
          {
            frameworkCards.map((framework) => (
              <tr>
                <th scope="row">{framework.framework}</th>
                <td>
                  <span
                    class:list={{
                      badge: true,
                      "badge--partial":
                        framework.status === "Partial: listed clauses only",
                      "badge--evidence":
                        framework.status === "Supporting evidence only",
                    }}
                  >
                    {framework.status}
                  </span>
                </td>
                <td>
                  <strong>{framework.mappedControlId}</strong>:{" "}
                  {findControl(framework.mappedControlId).obligation}
                  <br />
                  <span class="muted">{framework.standardReference}</span>
                </td>
                <td>{framework.whatEthotechnicsCovers}</td>
                <td>{framework.firstMove}</td>
                <td>
                  <a href={toCrosswalkDetailHref(framework.mappedControlId)}>
                    Open control brief
                  </a>
                  <br />
                  <a href={framework.anchor}>Open framework details</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </SectionBlock>

  <SectionBlock
    id="eu-ai-act-articles"
    eyebrow="EU AI Act"
    title="Article by article"
    description="For each article the map cites: the Ethotechnics clauses that bear on it, what they require that the article also asks for, and what they leave to you."
    variant="alt"
  >
    <div class="mapping-table__wrapper">
      <table class="mapping-table mapping-table--stack">
        <thead>
          <tr>
            <th scope="col">Article</th>
            <th scope="col">Clauses</th>
            <th scope="col">What the clauses cover</th>
            <th scope="col">What they leave to you</th>
          </tr>
        </thead>
        <tbody>
          {
            euAiActArticleCoverage.map((row) => (
              <tr>
                <th scope="row">
                  {row.article}
                  <br />
                  <span class="muted">{row.title}</span>
                </th>
                <td data-label="Clauses">
                  {row.clauseIds.length > 0
                    ? row.clauseIds.map((clauseId, index) => {
                        const resolved = resolveClause(clauseId);
                        return (
                          <>
                            {resolved ? (
                              <a href={resolved.href}>{resolved.label}</a>
                            ) : (
                              <span>{clauseId}</span>
                            )}
                            {index < row.clauseIds.length - 1 && (
                              <span>, </span>
                            )}
                          </>
                        );
                      })
                    : "None"}
                </td>
                <td data-label="What the clauses cover">{row.covers}</td>
                <td data-label="What they leave to you">{row.leaves}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="muted">
      Articles 9, 12, and 14 sit in Chapter III, Section 2, which applies to
      Annex III systems from 2 December 2027 and to Annex I systems from 2
      August 2028. The <a href="/standards/eu-ai-act#timeline">EU AI Act page</a
      > lists every application date and its source.
    </p>
  </SectionBlock>

  <SectionBlock
    id="framework-cards"
    eyebrow="Details"
    title="Framework details"
    description="Each card lists the checks and evidence requests to put in a procurement packet or an audit walkthrough."
  >
    <div class="framework-details">
      {
        frameworkCards.map((item) => {
          const mappedControls = (
            item.mappedControlIds ?? [item.mappedControlId]
          ).map((controlId) => findControl(controlId));
          const evidenceArtifacts = [
            ...new Set(
              mappedControls.flatMap((control) => control.evidenceArtifacts),
            ),
          ];
          const operationalSurfaces = [
            ...new Set(
              mappedControls.map((control) => control.operationalSurface),
            ),
          ];
          return (
            <details id={item.anchor.replace("#", "")}>
              <summary>{item.framework}</summary>
              <p>
                <strong>Status:</strong> {item.status}
              </p>
              <p>
                <strong>Mapped Ethotechnics controls:</strong>{" "}
                {mappedControls.map((control, index) => (
                  <>
                    <span>
                      <a href={toCrosswalkDetailHref(control.controlId)}>
                        {control.controlId}
                      </a>{" "}
                      — {control.obligation}
                    </span>
                    {index < mappedControls.length - 1 && <span>; </span>}
                  </>
                ))}
              </p>
              <p>
                <strong>Framework reference:</strong> {item.standardReference}
              </p>
              <p>{item.whatEthotechnicsCovers}</p>
              <p>
                <strong>What a buyer or auditor should check:</strong>
              </p>
              <ul>
                {item.buyerAuditorChecks.map((check) => (
                  <li>{check}</li>
                ))}
              </ul>
              <p>
                <strong>Evidence to request first:</strong>
              </p>
              <ul>
                {evidenceArtifacts.map((artifact) => (
                  <li>{artifact}</li>
                ))}
              </ul>
              <p>
                <strong>Where it shows up in operations:</strong>{" "}
                {operationalSurfaces.map((surface, index) => (
                  <>
                    <a href="/mechanisms">{surface}</a>
                    {index < operationalSurfaces.length - 1 && <span> · </span>}
                  </>
                ))}
              </p>
              <p>
                <strong>Related pages:</strong>{" "}
                {item.detailedLinks.map((link, index) => (
                  <>
                    <a href={link.href}>{link.label}</a>
                    {index < item.detailedLinks.length - 1 && <span> · </span>}
                  </>
                ))}
              </p>
            </details>
          );
        })
      }
    </div>
    <p>
      Pair these controls with the <a href="/evidence-packs">evidence packs</a>
      before launch and after any major incident.
    </p>
  </SectionBlock>

  <SectionBlock
    id="post-market"
    eyebrow="Post-market"
    title="Incident reporting as its own governance process"
    description="Monitoring after release needs a route, a clock, and an export to the regulator. Without them it ends up buried in retrospectives."
    variant="alt"
  >
    <ol>
      {
        postMarketWorkflow.map((step) => (
          <li>
            <strong>{step.stage}:</strong> {step.outcome}
          </li>
        ))
      }
    </ol>
    <p class="muted">
      This is a process outline, not a standard clause. The deadlines for
      reporting a serious incident come from EU AI Act Article 73, not from
      Ethotechnics.
    </p>
    <p><strong>Evidence pack minimum:</strong></p>
    <ul>
      {evidencePackMinimumSet.map((item) => <li>{item}</li>)}
    </ul>
  </SectionBlock>

  <SectionBlock
    id="citations"
    eyebrow="Citation"
    title="Reference this crosswalk"
    description="Cite the permalink and version in policy, procurement, and audit documents, so they point at a fixed text."
  >
    <CitationBlock
      title={pageTitle}
      permalink={permalink}
      publication={publication}
    />
    <p class="muted" style="margin-top:var(--space-5)">
      See also: <a href="/standards">Standards</a> &middot; <a
        href="/mechanisms">Mechanisms</a
      >
    </p>
  </SectionBlock>
</StandardsLayout>

<style>
  .badge {
    display: inline-block;
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .badge--partial {
    background: color-mix(in srgb, var(--accent) 18%, var(--surface));
    border-color: color-mix(in srgb, var(--accent) 60%, var(--border));
  }

  .badge--evidence {
    background: color-mix(in srgb, var(--gold) 22%, var(--surface));
    border-color: color-mix(in srgb, var(--gold) 55%, var(--border));
  }

  .framework-details {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .framework-details details {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    background: color-mix(in srgb, var(--surface) 95%, white 5%);
  }

  .framework-details summary {
    cursor: pointer;
    font-weight: 600;
  }
</style>
