---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import StandardStatusSummary from "../../components/StandardStatusSummary.astro";
import { derivePublicationMetadata } from "../../utils/publication";

const pageTitle =
  "STD-03 — Justice SLOs (Targets, Budgets, and Breach Actions)";
const permalink = "/standards/std-03-justice-slos";
const siteBase = Astro.site ? Astro.site.toString() : Astro.url.origin;
const breadcrumbItems = [
  { name: "Home", url: new URL("/", siteBase).toString() },
  { name: "Standards", url: new URL("/standards", siteBase).toString() },
  {
    name: "Justice SLOs (Targets, Budgets, and Breach Actions)",
    url: new URL("/standards/std-03-justice-slos", siteBase).toString(),
  },
];

const standardFields = [
  {
    title: "Metric",
    description:
      "The justice metric the objective covers: time-to-restore, time-to-halt, appeal passage rate, user burden ratio, or irreversibility index.",
  },
  {
    title: "Target, budget, or ceiling",
    description:
      "The numeric threshold, set for each harm class or workflow class.",
  },
  {
    title: "Measurement window",
    description:
      "The window and the statistic, for example weekly p95 or rolling 30-day p99.",
  },
  {
    title: "Breach action",
    description:
      "What happens when the threshold is missed: a safe pause, a circuit breaker, a rollback lane, or added staff.",
  },
  {
    title: "Owner",
    description:
      "The named person accountable for the objective, who can pause the workflow or order the remedy.",
  },
  {
    title: "Public surface",
    description:
      "Where the public can see the metric, any breach, and what was done about it.",
  },
];

const metricLinks = [
  {
    title: "Time-to-restore (TTR)",
    description:
      "How long it takes to reverse a harm and return a person to their prior state.",
    href: "/glossary/time-to-restore",
  },
  {
    title: "Time-to-halt (TTH)",
    description:
      "The time between a harmful process starting and the system stopping it.",
    href: "/glossary/time-to-halt",
  },
  {
    title: "Appeal passage rate",
    description:
      "The share of appeals resolved in the person's favor, for each decision class.",
    href: "/glossary/appeal-passage-rate",
  },
  {
    title: "User burden ratio",
    description:
      "How much work a person must do to correct or get past the system's errors.",
    href: "/glossary/user-burden-ratio",
  },
  {
    title: "Irreversibility index",
    description: "The share of the system's actions that cannot be undone.",
    href: "/glossary/irreversibility-index",
  },
];

const breachPlaybook = [
  "Safe pause for the affected workflow class.",
  "An ethical circuit breaker trips and the case escalates.",
  "A rollback lane opens, or the workflow moves to manual handling for a set period.",
  "Added staff or a dedicated remediation queue.",
];

const pageUrl = Astro.site
  ? new URL("/standards/std-03-justice-slos", Astro.site).toString()
  : "/standards/std-03-justice-slos";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": pageUrl,
  headline: "STD-03 — Justice SLOs (Targets, Budgets, and Breach Actions)",
  description:
    "A draft standard: each justice metric needs a numeric threshold, a measurement window, a breach action, and a named owner.",
  url: pageUrl,
  datePublished: "2026-01-01",
  dateModified: "2026-10-06",
  version: "0.6.1",
  identifier: "STD-03",
  publisher: {
    "@type": "Organization",
    name: "Ethotechnics Institute",
    url: Astro.site ? new URL("/", Astro.site).toString() : "/",
  },
  isPartOf: {
    "@type": "CollectionPage",
    name: "Standards — Ethotechnics Institute",
    url: Astro.site
      ? new URL("/standards", Astro.site).toString()
      : "/standards",
  },
  hasPart: [
    ...standardFields.map((field) => ({
      "@type": "CreativeWork",
      name: field.title,
      description: field.description,
    })),
    ...metricLinks.map((metric) => ({
      "@type": "CreativeWork",
      name: metric.title,
      description: metric.description,
    })),
  ],
};
const structuredDataJson = JSON.stringify(structuredData, null, 2);

const publication = derivePublicationMetadata({
  permalink,
  published: "2026-01-01T00:00:00Z",
  updated: "2026-10-06T00:00:00Z",
  version: "v0.6.1",
  changelogSummary:
    "Editorial revision: one name, justice SLO, used throughout, and each metric defined. No requirement changed.",
});
---

<BaseLayout
  title="STD-03 — Justice SLOs (Targets, Budgets, and Breach Actions)"
  description="A draft standard: each justice metric, such as time-to-halt, needs a target, a measurement window, a breach action, and a named owner."
  publishedTime="2025-06-01T00:00:00.000Z"
  mainClass="page page--wide standard-document"
  enableGlossaryHighlights={false}
  breadcrumbItems={breadcrumbItems}
  pageSchema="route"
>
  <StandardStatusSummary slug="std-03-justice-slos" />

  <article class="standard-document">
    <header class="standard-header">
      <div>
        <p class="standard-header__id">STANDARD STD-03</p>
        <h1 class="standard-header__title">
          Justice SLOs (Targets, Budgets, and Breach Actions)
        </h1>
      </div>
      <dl class="standard-header__meta">
        <div>
          <dt>Document ID</dt>
          <dd>STD-03</dd>
        </div>
        <div>
          <dt>Version</dt>
          <dd>0.6.1 (draft for review)</dd>
        </div>
        <div>
          <dt>Effective date</dt>
          <dd>TBD (proposed 2026)</dd>
        </div>
        <div>
          <dt>Authority</dt>
          <dd>Ethotechnics Institute</dd>
        </div>
      </dl>
    </header>

    <div class="standard-body">
      <div class="standard-main">
        <section class="standard-section">
          <h2>Standard intent</h2>
          <p>
            A justice service-level objective (justice SLO) is a target for how
            a system treats the people it decides about: how fast it stops a
            harm, how fast it reverses one, how often an appeal succeeds. This
            standard requires every justice SLO to carry an explicit target,
            budget, or ceiling, and a breach action. Without them, the objective
            is a word in a report. With them, missing it obliges someone to act.
          </p>
        </section>

        <section class="standard-section">
          <h2>Required fields for every justice SLO</h2>
          <p>
            Each justice SLO must record these six fields, so anyone can tell in
            advance what counts as a breach and what follows one.
          </p>
          <dl class="standard-definitions">
            {
              standardFields.map((field) => (
                <div>
                  <dt>{field.title}</dt>
                  <dd>{field.description}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="standard-section">
          <h2>Required metric coverage</h2>
          <p>
            Every consequential workflow class must publish a target, budget, or
            ceiling for each of these five metrics.
          </p>
          <div class="grid grid--two">
            {
              metricLinks.map((metric) => (
                <article class="panel">
                  <p class="eyebrow">Metric</p>
                  <p>
                    <strong>
                      <a href={metric.href}>{metric.title}</a>
                    </strong>
                  </p>
                  <p class="muted">{metric.description}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section class="standard-section">
          <h2>Breach actions</h2>
          <p>
            Breach actions must be defined in advance, rehearsed, and executed
            immediately when thresholds are missed.
          </p>
          <div class="grid grid--two">
            {
              breachPlaybook.map((action) => (
                <div class="panel">
                  <p>{action}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section class="standard-section">
          <h2>Ownership and public surface</h2>
          <p>
            Each justice SLO must name an accountable owner with authority to
            pause the workflow, roll it back, or staff the remedy. The public
            surface must show how long the process takes and link to the
            decision records, so the people affected can check that a breach
            action happened.
          </p>
        </section>
      </div>

      <aside class="standard-sidebar">
        <div class="standard-sidebar__panel">
          <p class="standard-sidebar__eyebrow">Requirements in brief</p>
          <ul>
            <li>Targets, budgets, or ceilings set by workflow class.</li>
            <li>Measurement windows defined (p95, weekly, rolling).</li>
            <li>Breach actions wired to pause, rollback, or escalation.</li>
            <li>Named owner with authority to remediate.</li>
          </ul>
        </div>
        <div class="standard-sidebar__panel">
          <p class="standard-sidebar__eyebrow">Key terms</p>
          <ul>
            <li>
              <a href="/glossary/irreversibility-budget"
                >Irreversibility budget</a
              >
            </li>
            <li>
              <a href="/glossary/burden-ceiling">Burden ceiling</a>
            </li>
            <li>
              <a href="/glossary/ethical-circuit-breakers">
                Ethical circuit breakers
              </a>
            </li>
            <li>
              <a href="/glossary/graceful-rollback-lanes">
                Graceful rollback lanes
              </a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
  <script type="application/ld+json" set:html={structuredDataJson} is:inline />
  <CitationBlock
    title={pageTitle}
    permalink={permalink}
    publication={publication}
  />
</BaseLayout>
