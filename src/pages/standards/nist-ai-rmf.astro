---
import StandardsLayout from "../../components/StandardsLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { derivePublicationMetadata } from "../../utils/publication";

const pageTitle = "NIST AI Risk Management Framework (AI RMF 1.0)";
const pageDescription =
  "Ethotechnics-style critique of the NIST AI Risk Management Framework and its voluntary governance model.";
const permalink = "/standards/nist-ai-rmf";
const publishedTime = "2026-02-22T00:00:00Z";
const modifiedTime = "2026-03-04T00:00:00Z";
const version = "v1.0.0";
const lastUpdated = "2026-02-22";
const anchorLinks = [
  { href: "#overview", label: "What it is" },
  { href: "#operational-templates", label: "Operational templates path" },
  { href: "#critique", label: "Ethotechnics critique" },
  { href: "#failure-mode", label: "Failure mode" },
];
const publication = derivePublicationMetadata({
  permalink,
  published: publishedTime,
  updated: modifiedTime,
  version,
});
---

<StandardsLayout
  title={pageTitle}
  description={pageDescription}
  permalink={permalink}
  seoTitle="NIST AI RMF operational templates | Ethotechnics"
  eyebrow="Adopted standard"
  anchorLinks={anchorLinks}
  version={version}
  lastUpdated={lastUpdated}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  panelCopy={{
    eyebrow: "Ethotechnics read",
    title: "Process evidence vs. runtime control",
    description:
      "Good risk management can coexist with slow or missing rollback authority.",
  }}
>

  <SectionBlock
    id="overview"
    eyebrow="Overview"
    title="What it is"
    description="A voluntary risk management framework organized around Govern, Map, Measure, Manage."
  >
    <p>
      The AI RMF is explicitly not a checklist. It emphasizes mapping risks,
      measuring performance, and managing controls across the AI lifecycle.
    </p>
  </SectionBlock>

  <SectionBlock
    id="operational-templates"
    eyebrow="Operational templates"
    title="Use this NIST path to operationalize controls"
    description="Use one linked route so teams move from interpretation to implementation without losing traceability."
  >
    <ol class="muted">
      <li>
        <strong>Explainer:</strong>
        <a href="/standards/nist-ai-rmf">NIST AI RMF overview and critique</a>.
      </li>
      <li>
        <strong>Mechanism template:</strong>
        <a href="/standards/std-01-mapping-artifact">STD-01 mapping artifact</a>
        for control-to-evidence mapping.
      </li>
      <li>
        <strong>Downloadable artifact:</strong>
        <a href="/bundles/diagnostic-export-kit">Diagnostic export kit</a> for
        shareable readouts and audit packets.
      </li>
      <li>
        <strong>Clinic/signup:</strong>
        <a href="/participate">Request a governance clinic</a> to validate your
        operational template set.
      </li>
    </ol>
  </SectionBlock>

  <SectionBlock
    id="critique"
    eyebrow="Ethotechnics critique"
    title="Where the framework falls short"
    variant="alt"
  >
    <ul class="card__list">
      <li>
        <strong>Risk framing privileges prediction over control:</strong> “Map/Measure”
        improves anticipation and documentation but does not force operational reversibility.
      </li>
      <li>
        <strong>Voluntary + profile-driven:</strong> Organizations can adopt maturity-shaped
        artifacts without building hard stop or rollback infrastructure.
      </li>
      <li>
        <strong>Governance becomes management activity:</strong> The RMF supports internal
        practice but does not require demonstrations that a running system can be halted quickly.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="failure-mode"
    eyebrow="Failure mode"
    title="Excellent process evidence + slow repair"
    description="The harmed person still carries the time and coordination burden."
  >
    <p>
      The failure mode is a well-documented process that still leaves people
      exposed while the institution “manages risk” on a slow clock.
    </p>
  </SectionBlock>
  <CitationBlock title={pageTitle} permalink={permalink} publication={publication} />
</StandardsLayout>
