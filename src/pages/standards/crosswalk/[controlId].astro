---
import PageIntro from "../../../components/PageIntro.astro";
import CitationBlock from "../../../components/CitationBlock.astro";
import SectionBlock from "../../../components/SectionBlock.astro";
import {
  governanceCrosswalks,
  resolveClause,
} from "../../../content/crosswalks";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { derivePublicationMetadata } from "../../../utils/publication";

type FrameworkMatch = {
  framework: string;
  citation: string;
};

// Server-rendered like the other detail routes: prerendering under the
// Cloudflare adapter writes "[object Object]" in place of the page
// (docs/planning/prerender-finding-2026-09.md).
const control = governanceCrosswalks.find(
  (candidate) =>
    candidate.controlId.toLowerCase() === Astro.params.controlId?.toLowerCase(),
);

if (!control) {
  return new Response("Crosswalk control not found", { status: 404 });
}

const frameworks: FrameworkMatch[] = [
  { framework: "EU AI Act", citation: control.euAiAct },
  { framework: "NIST AI RMF", citation: control.nistAiRmf },
  { framework: "ISO/IEC 42001", citation: control.iso42001 },
];

const clauses = control.clauseIds.map((clauseId) => ({
  clauseId,
  resolved: resolveClause(clauseId),
}));

const pageTitle = `${control.controlId} crosswalk brief`;
const seoTitle = `${control.controlId} crosswalk: ${control.topic}`;
const pageDescription = control.metaDescription;
const permalink = `/standards/crosswalk/${control.controlId.toLowerCase()}`;

const publication = derivePublicationMetadata({
  permalink,
  published: "2025-06-01T00:00:00Z",
  updated: "2026-10-06T00:00:00Z",
});
---

<BaseLayout
  title={seoTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
  modifiedTime="2026-10-06T00:00:00.000Z"
  structuredDataType="tech-article"
  breadcrumbItems={[
    { name: "Home", url: new URL("/", Astro.url).toString() },
    { name: "Standards", url: new URL("/standards", Astro.url).toString() },
    {
      name: "Framework map for buyers and auditors",
      url: new URL(
        "/standards/enforceable-governance-crosswalks",
        Astro.url,
      ).toString(),
    },
    { name: control.controlId, url: Astro.url.toString() },
  ]}
>
  <PageIntro
    eyebrow="Crosswalk control"
    title={`${control.controlId} implementation brief`}
    description={control.obligation}
    anchorLinks={[
      { href: "#clauses", label: "Clauses to cite" },
      { href: "#framework-mapping", label: "Framework mapping" },
      { href: "#evidence", label: "Evidence artifacts" },
      {
        href: "#operational-surface",
        label: "Where it shows up in operations",
      },
    ]}
  />

  <SectionBlock
    id="clauses"
    eyebrow="Clauses to cite"
    title="The Ethotechnics clauses behind this control"
    description="The clauses a contract or audit plan can cite, at their current versions, with the evidence each names."
  >
    <div class="mapping-table__wrapper">
      <table class="mapping-table mapping-table--stack">
        <thead>
          <tr>
            <th scope="col">Clause</th>
            <th scope="col">Requirement</th>
            <th scope="col">Evidence</th>
          </tr>
        </thead>
        <tbody>
          {
            clauses.map(({ clauseId, resolved }) => (
              <tr>
                <th scope="row">
                  {resolved ? (
                    <a href={resolved.href}>{resolved.citation}</a>
                  ) : (
                    clauseId
                  )}
                </th>
                <td data-label="Requirement">
                  {resolved
                    ? `${resolved.clause.requirementLevel}: when ${resolved.clause.condition}, ${resolved.clause.obligation}.`
                    : "Not in the clause register."}
                </td>
                <td data-label="Evidence">
                  {resolved && (
                    <ul class="clause-evidence">
                      {resolved.clause.evidenceRequired.map((item) => (
                        <li>
                          <code>{item}</code>
                        </li>
                      ))}
                    </ul>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {
      control.notCovered && (
        <p>
          <strong>Not covered:</strong> {control.notCovered}
        </p>
      )
    }
    <p class="muted">
      The <a href="/standards/where-this-binds">sample contract clause</a> shows the
      form. The <a
        href="/standards/enforceable-governance-crosswalks#eu-ai-act-articles"
        >EU AI Act table</a
      > gives the same clauses article by article.
    </p>
  </SectionBlock>

  <SectionBlock
    id="framework-mapping"
    eyebrow="Framework mapping"
    title="Where this control corresponds to a framework"
    description="The framework obligations these clauses bear on. A technical correspondence, not a determination of legal compliance."
    variant="alt"
  >
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Framework</th>
            <th scope="col">Mapped requirement</th>
          </tr>
        </thead>
        <tbody>
          {
            frameworks.map((item) => (
              <tr>
                <th scope="row">{item.framework}</th>
                <td>{item.citation}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </SectionBlock>

  <SectionBlock
    id="evidence"
    eyebrow="Evidence"
    title="Artifacts to request before sign-off"
    description="These artifacts make the obligation inspectable rather than policy-only."
  >
    <ul>
      {control.evidenceArtifacts.map((artifact) => <li>{artifact}</li>)}
    </ul>
  </SectionBlock>

  <SectionBlock
    id="operational-surface"
    eyebrow="Where it shows up in operations"
    title="Where this control should live in the system"
    description="The owner-visible control point for day-to-day operations and incident response."
    variant="alt"
  >
    <p>{control.operationalSurface}</p>
  </SectionBlock>
  <CitationBlock
    title={pageTitle}
    permalink={permalink}
    publication={publication}
  />
</BaseLayout>

<style>
  .clause-evidence {
    margin: 0;
    padding-left: var(--space-4);
  }

  .clause-evidence code {
    overflow-wrap: anywhere;
  }
</style>
