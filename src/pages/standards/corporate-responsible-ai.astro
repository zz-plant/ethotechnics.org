---
import StandardsLayout from "../../components/StandardsLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { derivePublicationMetadata } from "../../utils/publication";

const pageTitle = "Corporate responsible AI programs";
const pageDescription =
  "An Ethotechnics critique of internal responsible AI programs: ethics boards and review gates answer to the company, not to the people a system decides about.";
const permalink = "/standards/corporate-responsible-ai";
const anchorLinks = [
  { href: "#critique", label: "Ethotechnics critique" },
  { href: "#failure-mode", label: "Failure mode" },
];
const publication = derivePublicationMetadata({
  permalink,
  published: "2025-06-01T00:00:00Z",
  updated: "2026-10-06T00:00:00Z",
  changelogSummary:
    "Removed the overview, which described responsible AI programs to the people who run them.",
});
---

<StandardsLayout
  title={pageTitle}
  description={pageDescription}
  permalink={permalink}
  seoTitle={`${pageTitle} — Standards critique`}
  eyebrow="Corporate programs"
  anchorLinks={anchorLinks}
  publishedTime="2025-06-01T00:00:00.000Z"
  modifiedTime="2026-10-06T00:00:00.000Z"
>
  <SectionBlock
    id="critique"
    eyebrow="Ethotechnics critique"
    title="Where the programs fall short"
    variant="alt"
  >
    <ul class="card__list">
      <li>
        <strong>Centralized review becomes a bottleneck:</strong> At scale, boards
        either slow the business or become routinized and symbolic.
      </li>
      <li>
        <strong>Judgment-based governance is fragile:</strong> Under deadline pressure,
        discretionary controls degrade first while the system keeps running.
      </li>
      <li>
        <strong>The affected party lacks standing:</strong> Governance is inward-facing,
        not power the public can exercise.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="failure-mode"
    eyebrow="Failure mode"
    title="Ethics theater under pressure"
    description="Good principles and sincere people, and no standing for the people downstream."
  >
    <p>
      The failure mode is a well-intended program that collapses into symbolic
      oversight when incentives conflict with restraint.
    </p>
  </SectionBlock>
  <CitationBlock
    title={pageTitle}
    permalink={permalink}
    publication={publication}
  />
</StandardsLayout>
