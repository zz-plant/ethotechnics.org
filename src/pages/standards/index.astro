---
import InlineScript from "../../components/InlineScript.astro";
import "../../styles/components/standards.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import { implementationExamples } from "../../content/implementation-examples";
import { getCollection } from "astro:content";
import { standardsContent } from "../../content/standards";
import { documentClauseIds } from "../../utils/clause-registry";
import {
  buildStandardsCardViewModels,
  buildStandardsGroupingAndFilters,
  buildStandardsStructuredDataPayload,
} from "../../content/page-data/standards-index";

const lastUpdated = "2026-08-14";

// Clause counts come from the documents, not the registry: the registry is a
// second hand writing the same clauses and it drifts (see clause-registry.ts).
const clauseCounts = new Map(
  (await getCollection("standards")).map((entry) => [
    entry.id,
    documentClauseIds(entry.body ?? "").length,
  ]),
);

const { pageTitle, pageDescription, anchorLinks, standards, doctrine } =
  standardsContent;
const listedStandards = standards.filter(
  (standard) => standard.listedOnSite !== false,
);
const { adoptedStandards, implementationExampleCards } =
  buildStandardsCardViewModels({
    standards,
    doctrine,
    implementationExamples,
  });
// The lane (core, implementation, reference) rides in the register as a tag.
// It used to be a second, filterable list of the same standards.
const { standardsLaneById } = buildStandardsGroupingAndFilters(standards);
const laneLabel = (id: string) => {
  const lane = standardsLaneById.get(id);
  return lane ? lane.charAt(0).toUpperCase() + lane.slice(1) : undefined;
};
const evidencePackIds = ["STD-01", "STD-02", "STD-06", "STD-08", "STD-09"];
const structuredData = buildStandardsStructuredDataPayload({
  standardsContent,
  adoptedStandards,
  siteUrl: Astro.site,
});
const structuredDataJson = JSON.stringify(structuredData, null, 2);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  modifiedTime={lastUpdated}
  structuredDataType="collection"
  jsonAlternates={[{ href: "/api/standards.json", title: "Standards JSON" }]}
>
  <PageIntro
    eyebrow="Standards"
    title="Standards"
    description={pageDescription}
    anchorLinks={anchorLinks}
    anchorLinksSummary="Show full standards outline"
  >
    <Fragment slot="actions">
      <a class="button primary" href="/standards/std-01-temporal-rights">
        Open STD-01
      </a>
      <a class="button ghost" href="/standards/std-02-contestability-recourse">
        Open STD-02
      </a>
      <a
        class="button ghost"
        href="/standards/enforceable-governance-crosswalks"
      >
        Open crosswalks
      </a>
    </Fragment>
  </PageIntro>
  <SectionBlock
    id="register"
    eyebrow="Register"
    title="Every standard, in one table"
    description="Identifier, lane, status, version, how many clauses it carries, and where its evidence pack lives. The lanes are core rights and obligations, implementation templates, and reference formats."
  >
    <div class="mapping-table__wrapper">
      <table class="mapping-table catalogue-table standards-register">
        <thead>
          <tr>
            <th scope="col">Standard</th>
            <th scope="col">Title</th>
            <th scope="col">Status</th>
            <th scope="col">Version</th>
            <th scope="col" class="catalogue-table__num">Clauses</th>
            <th scope="col">Evidence pack</th>
          </tr>
        </thead>
        <tbody>
          {
            listedStandards.map((standard) => {
              const clauses = clauseCounts.get(standard.slug) ?? 0;
              const packSlug = standard.id.toLowerCase();
              const lane = laneLabel(standard.id);
              return (
                <tr>
                  <th scope="row" class="standards-register__id">
                    <a href={`/standards/${standard.slug}`}>{standard.id}</a>
                  </th>
                  <td class="standards-register__title">
                    <a
                      class="standards-register__name"
                      href={`/standards/${standard.slug}`}
                    >
                      {standard.title}
                    </a>
                    {lane && <span class="standards-register__lane">{lane}</span>}
                    <span class="standards-register__summary">
                      {standard.description}
                      {standard.deprecatedBy &&
                        standard.deprecatedBy.length > 0 && (
                          <>
                            {" "}
                            Replaced by{" "}
                            {standard.deprecatedBy.map(
                              (replacement, index, all) => (
                                <>
                                  <a href={`/standards/${replacement.slug}`}>{replacement.id}</a>{index === all.length - 1 ? "." : ", "}
                                </>
                              ),
                            )}
                          </>
                        )}
                    </span>
                  </td>
                  <td class="standards-register__status">
                    <span
                      class={`catalogue-table__status catalogue-table__status--${standard.status.toLowerCase()}`}
                    >
                      {standard.status}
                    </span>
                  </td>
                  <td class="standards-register__version">
                    <span class="standards-register__meta-label">v</span>{standard.version}
                  </td>
                  <td
                    class:list={[
                      "catalogue-table__num standards-register__clauses",
                      { "standards-register__clauses--none": clauses === 0 },
                    ]}
                  >
                    {clauses > 0 ? clauses : "—"}
                    {clauses > 0 && (
                      <span class="standards-register__meta-label">
                        {clauses === 1 ? " clause" : " clauses"}
                      </span>
                    )}
                  </td>
                  <td class="standards-register__pack">
                    {evidencePackIds.includes(standard.id) ? (
                      <a href={`/evidence-packs/${packSlug}`}>
                        {standard.id} pack
                      </a>
                    ) : (
                      <span class="muted">
                        <span class="standards-register__dash">—</span>
                        <span class="standards-register__meta-label">
                          No evidence pack
                        </span>
                      </span>
                    )}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </SectionBlock>

  <SectionBlock
    id="goal-chooser"
    eyebrow="Where to start"
    title="Start from what you have to do"
    description="Where to start if you are writing policy, preparing for an audit, or overseeing a build."
  >
    <CardGrid className="grid--three">
      <CardItem
        title="Draft policy language"
        description="The core axioms and the comparison below give you the terms, and the requirements that can be enforced, to write into policy."
      >
        <a slot="footer" class="muted" href="/standards/core-axioms"
          >Start with core axioms</a
        >
      </CardItem>
      <CardItem
        title="Prepare for audit"
        description="The STD-01 minimum binding set lists the least each right requires. The evidence packs list the records that show it is met."
      >
        <a
          slot="footer"
          class="muted"
          href="/standards/std-01-minimum-binding-set"
        >
          Review minimum binding set
        </a>
      </CardItem>
      <CardItem
        title="Oversee implementation"
        description="Implementation examples show each standard as the stop rules, clocks, and records a delivery team builds."
      >
        <a slot="footer" class="muted" href="#implementation-examples"
          >Open implementation examples</a
        >
      </CardItem>
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="status-assignment"
    eyebrow="Status model"
    title="How status is assigned"
    description="Each status has entry conditions, listed below. They say what a standard needs before it can move to that status."
  >
    <CardGrid className="grid--three">
      <CardItem
        title="Draft"
        description="Under active review. Clauses may still change."
      >
        <ul class="muted small">
          <li>At least 1 internal standards editor review.</li>
          <li>Core test fixtures run and pass for referenced mechanisms.</li>
          <li>Open changelog entry documenting known gaps.</li>
        </ul>
      </CardItem>
      <CardItem
        title="Stable"
        description="Settled enough to cite in production policy and procurement requirements."
      >
        <ul class="muted small">
          <li>
            Minimum 2 independent reviewers (one external to the author team).
          </li>
          <li>
            Evidence tests and implementation checks completed with receipts.
          </li>
          <li>
            Stable criteria satisfied and recorded in publication metadata.
          </li>
        </ul>
      </CardItem>
      <CardItem
        title="Deprecated"
        description="Not for new adoptions. A replacement is linked when one exists."
      >
        <ul class="muted small">
          <li>Deprecation vote recorded by standards council.</li>
          <li>
            Replacement standard identified and linked by <code
              >deprecated_by</code
            >.
          </li>
          <li>Migration note added in changelog before status changes.</li>
        </ul>
      </CardItem>
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="doctrine"
    eyebrow="Foundations"
    title="Foundations and references"
    description="The axioms and laws the standards are written against, and the reference documents that apply them."
  >
    <CardGrid className="grid--two">
      {
        doctrine.map((item) => (
          <CardItem
            eyebrow={item.eyebrow}
            title={item.title}
            description={item.description}
          >
            <a slot="footer" class="muted" href={item.href}>
              {item.ctaLabel}
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="adopted-standards"
    eyebrow="Existing frameworks"
    title="Where widely adopted frameworks fall short"
    description="For each of the most cited AI governance frameworks, what it leaves out when a system has to be stopped or reversed."
  >
    <CardGrid className="grid--two">
      {
        adoptedStandards.map((item) => (
          <CardItem
            eyebrow={item.eyebrow}
            title={item.title}
            description={item.description}
          >
            <a slot="footer" class="muted" href={item.href}>
              Read critique
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="comparison"
    eyebrow="Standards comparison"
    title="How Ethotechnics differs from existing AI governance standards"
    description="A side-by-side comparison for regulators, operators, and risk owners."
  >
    <p class="eyebrow">The landscape</p>
    <p>
      Four frameworks dominate AI governance today, and one data protection
      law already governs automated decisions. Each addresses a different part
      of the problem:
    </p>
    <ul class="card__list">
      <li>
        <strong>NIST AI RMF</strong> — A voluntary risk management framework (Govern,
        Map, Measure, Manage). Strong on risk identification and documentation. Does
        not require operational stop authority or recovery time targets.
      </li>
      <li>
        <strong>EU AI Act</strong> — A risk-tiered regulatory regime requiring human
        oversight, conformity assessment, and post-market monitoring. Compliance is
        document-mediated; oversight obligations do not impose stoppability drills
        or restoration SLAs.
      </li>
      <li>
        <strong>ISO/IEC 42001</strong> — A management system standard for AI. Governance
        effort is certified, but certification can coexist with slow or missing rollback
        authority.
      </li>
      <li>
        <strong>OECD AI Principles</strong> — Values-oriented guidelines adopted by
        governments. Non-binding by design; accountability becomes interpretive after
        harm.
      </li>
      <li>
        <strong>GDPR, Article 22</strong> — Limits solely automated decisions with
        legal or similarly significant effects. Where a contract or the person's
        consent allows one, the controller must offer at least human
        intervention, a chance to state a view, and a way to contest the
        decision. The right attaches to that one decision. Nothing in Article 22
        makes a run of successful contests a reason to revise the rule.
      </li>
    </ul>
    <p>
      These frameworks improve documentation, oversight, and monitoring. They
      leave one question undertreated: when a running system is shown to be
      harming people, does anyone have to act on that evidence, quickly, without
      the harmed person carrying the burden? Acting can mean halting it,
      reversing its decisions, repairing the harm, or changing the rule that
      produced it.
    </p>

    <p class="eyebrow">TL;DR</p>
    <ul class="card__list">
      <li>
        Ethotechnics centers what happens once a system is shown to be wrong,
        and how long harm runs, over documentation.
      </li>
      <li>
        Governance is a runtime control plane, not a post-hoc review process.
      </li>
      <li>Oversight is only real when authority and clocks are enforceable.</li>
    </ul>
    <p>
      Most AI governance standards in use today are built to answer: “Did you
      manage risk responsibly?” Ethotechnics is built to answer a different
      question: “When this system is harming someone, does the evidence reach
      someone who has to change it?” The difference is in mechanics, not
      values.
    </p>
    <p>
      In consequential systems the dominant failure mode is now temporal.
      Decisions occur at machine speed. Reversal occurs at institutional speed.
      Harm compounds in the gap.
    </p>
    <p class="muted">
      Ethotechnics treats governability as an operational capability with
      measurable performance properties.
    </p>

    <p class="eyebrow">Comparison matrix</p>
    <div class="mapping-table__wrapper">
      <table class="mapping-table mapping-table--compare">
        <thead>
          <tr>
            <th scope="col">Dimension</th>
            <th scope="col">Prevailing standards</th>
            <th scope="col">Ethotechnics</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Governance object</th>
            <td data-label="Prevailing standards">Risk &amp; compliance</td>
            <td data-label="Ethotechnics">Runtime governability</td>
          </tr>
          <tr>
            <th scope="row">Typical artifacts</th>
            <td data-label="Prevailing standards"
              >Registers, assessments, policies</td
            >
            <td data-label="Ethotechnics"
              >Stop rules, clocks, restoration paths</td
            >
          </tr>
          <tr>
            <th scope="row">Oversight</th>
            <td data-label="Prevailing standards">Advisory review, HITL</td>
            <td data-label="Ethotechnics"
              >Enforceable authority + veto rights</td
            >
          </tr>
          <tr>
            <th scope="row">Measurement</th>
            <td data-label="Prevailing standards">Process maturity</td>
            <td data-label="Ethotechnics">Recovery time + time-in-harm</td>
          </tr>
          <tr>
            <th scope="row">Challenge</th>
            <td data-label="Prevailing standards"
              >A right to contest one decision</td
            >
            <td data-label="Ethotechnics"
              >An objection owes a revision or a reasoned refusal, on a clock</td
            >
          </tr>
          <tr>
            <th scope="row">Monitoring</th>
            <td data-label="Prevailing standards">Visibility</td>
            <td data-label="Ethotechnics"
              >Visibility + compelled intervention</td
            >
          </tr>
          <tr>
            <th scope="row">Enforcement</th>
            <td data-label="Prevailing standards"
              >External (audits, regulators)</td
            >
            <td data-label="Ethotechnics"
              >Built-in constraints + internal stop power</td
            >
          </tr>
          <tr>
            <th scope="row">Ethics framing</th>
            <td data-label="Prevailing standards">Principle optimization</td>
            <td data-label="Ethotechnics">Constraint satisfaction</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div
      id="governance-by-control"
      class="grid grid--three"
      style="margin-top: var(--space-6);"
    >
      <div class="panel stack-sm">
        <p class="eyebrow">1. Runtime control plane</p>
        <p class="small muted">
          Policies describe intent; control planes constrain behavior. Rather
          than inventories, risk registers, and post-hoc paperwork, Ethotechnics
          enforces explicit stop conditions, exercised rollback paths, and safe
          degradation modes during system execution.
        </p>
      </div>

      <div class="panel stack-sm">
        <p class="eyebrow">2. Mechanical stop authority</p>
        <p class="small muted">
          Oversight is symbolic unless it is exercisable on a clock. Rather than
          advisory ethics committees or perfunctory review gates, Ethotechnics
          requires named operational roles with independent authority to halt
          automated decisions without needing consensus.
        </p>
      </div>

      <div class="panel stack-sm">
        <p class="eyebrow">3. Temporal performance bounds</p>
        <p class="small muted">
          Time is the primary ethical resource. When decisions occur at machine
          speed, reversal cannot run at institutional speed. Systems cannot run
          faster than their appeal paths, and pending states must not become
          unbounded holding cells.
        </p>
      </div>
    </div>

    <p>
      Existing standards and Ethotechnics agree that governance matters. The
      question Ethotechnics adds is whether evidence that a system is harming
      someone compels action, quickly and reliably, without the harmed person
      carrying the burden: a halt, a reversal, a repair, or a changed rule.
    </p>
    <p class="muted">
      That is the difference between governance as documentation and governance
      as capability.
    </p>
  </SectionBlock>

  <SectionBlock
    id="comparison-versions"
    eyebrow="Other framings"
    title="The same comparison for a regulator, a board, and a workshop"
    description="Three short framings of the comparison above, each for a different reader."
  >
    <div class="grid grid--three">
      <div class="panel">
        <p class="eyebrow">Regulator-facing brief</p>
        <p>
          A neutral, statute-adjacent framing that treats Ethotechnics as a
          governance control requirement.
        </p>
        <ul class="card__list">
          <li>
            Defines governance as runtime capability (stop, pause, reverse,
            contest) with auditable evidence.
          </li>
          <li>
            Prioritizes measured recovery time over documentation completeness.
          </li>
          <li>
            Positions external oversight as verification of control-plane
            efficacy rather than sole enforcement.
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Board-level comparison</p>
        <p>
          Risk, liability, and incident exposure framing for executive review.
        </p>
        <ul class="card__list">
          <li>
            Identifies stoppability gaps as direct liability exposure and
            escalation risk.
          </li>
          <li>
            Treats recovery time as an operational KPI with reputational and
            regulatory impacts.
          </li>
          <li>
            Maps control-plane failures to incident severity, cost, and
            remediation timelines.
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Diagrammatic version</p>
        <p>
          The policy stack and the control plane, side by side, for workshops
          and audits.
        </p>
        <pre
          class="code-block">{`Policy stack → policies → reviews → audits → reports
Control plane → stop rules → clocks → rollback → restoration`}</pre>
        <p class="muted">
          The first line is enforced from outside the running system. The second
          is enforced inside it.
        </p>
      </div>
    </div>
  </SectionBlock>

  <SectionBlock
    id="implementation-examples"
    eyebrow="Implementation examples"
    title="Examples by domain"
    description="For each domain, conventional governance beside the same system built with stop rules, clocks, and restoration paths."
  >
    <CardGrid className="grid--two">
      {
        implementationExampleCards.map((item) => (
          <CardItem title={item.title} description={item.description}>
            <a slot="footer" class="muted" href={item.href}>
              {item.ctaLabel}
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="referenced-by"
    eyebrow="Referenced by"
    title="Where the standards are cited"
    description="The worked examples, release checklist, and evidence packs that cite these standards."
  >
    <div class="grid grid--three">
      <div class="panel">
        <p class="eyebrow">Used in examples</p>
        <ul class="muted">
          <li>
            <a href="/examples/automated-account-lock">Automated account lock</a
            >
          </li>
          <li>
            <a href="/examples/content-moderation-takedown"
              >Content moderation takedown</a
            >
          </li>
          <li>
            <a href="/examples/automated-eligibility-denial"
              >Automated eligibility denial</a
            >
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Required at release</p>
        <ul class="muted">
          <li>
            <a href="/evidence-packs">Release gate checklist</a>
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Verified by evidence packs</p>
        <ul class="muted">
          <li>
            <a href="/evidence-packs/std-01">STD-01 Evidence Pack</a>
          </li>
          <li>
            <a href="/evidence-packs/std-02">STD-02 Evidence Pack</a>
          </li>
          <li>
            <a href="/evidence-packs">All evidence packs</a>
          </li>
          <li>
            <a href="/validators">Validators (VAL-01–VAL-03)</a>
          </li>
        </ul>
      </div>
    </div>
    <p class="muted">
      Search IDs: STD-01 v1.0, STD-02 v1.2, STD-03 v0.6, STD-01.1.1, STD-02.2.1,
      VAL-01, VAL-02, VAL-03.
    </p>
  </SectionBlock>

  <InlineScript type="application/ld+json" code={structuredDataJson} />

</BaseLayout>
