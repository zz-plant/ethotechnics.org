---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CardGrid from "../../../components/CardGrid.astro";
import CardItem from "../../../components/CardItem.astro";
import CitationBlock from "../../../components/CitationBlock.astro";
import PageIntro from "../../../components/PageIntro.astro";
import ScholarlyMeta from "../../../components/ScholarlyMeta.astro";
import SectionBlock from "../../../components/SectionBlock.astro";
import {
  createImplementationPublication,
  implementationExamples,
} from "../../../content/implementation-examples";

const pageTitle =
  "Implementation examples: Ethotechnics vs standard AI governance";
const pageDescription =
  "Seven domains where Ethotechnics changes the system's architecture instead of adding oversight on top of it.";
const permalink = "/standards/implementation-examples";
const anchorLinks = [
  { href: "#overview", label: "Overview" },
  { href: "#comparison-map", label: "Comparison map" },
  { href: "#domains", label: "Domains" },
  { href: "#how-to-use", label: "How to use" },
  { href: "#citations", label: "Cite this page" },
];

const publication = createImplementationPublication(
  permalink,
  "Published the domain comparison playbook with seven scenario pages.",
);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro
    eyebrow="Implementation examples"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="overview"
    eyebrow="Overview"
    title="What these examples show"
    description="Standard governance and the Ethotechnics implementation, side by side, in each domain."
  >
    <p>
      Standard AI governance tends to add oversight processes to existing
      systems. Ethotechnics requires re-architecting the system so that
      stoppability, contestability, and reversibility are embedded in runtime
      behavior. These comparisons make the difference concrete by focusing on
      decision velocity, intervention authority, and recovery time.
    </p>
    <p class="muted">
      The pages translate a policy requirement into specific controls, runbooks,
      and architectural constraints.
    </p>
  </SectionBlock>

  <SectionBlock
    id="comparison-map"
    eyebrow="Comparison map"
    title="Choose an example by risk shape"
    description="Match your system's risk to a domain, and check the listed controls first."
  >
    <div class="mapping-table__wrapper">
      <table class="mapping-table mapping-table--compare">
        <thead>
          <tr>
            <th scope="col">If your system risk looks like…</th>
            <th scope="col">Open this example first</th>
            <th scope="col">What to validate immediately</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"
              >Fast, high-volume user decisions with weak recourse</th
            >
            <td>
              <a
                href="/standards/implementation-examples/customer-service-chatbots"
              >
                Customer service chatbots
              </a>
            </td>
            <td
              >Guaranteed human handoff and a measurable time-to-halt trigger.</td
            >
          </tr>
          <tr>
            <th scope="row"
              >Denial or eligibility automation that can lock people out</th
            >
            <td>
              <a href="/standards/implementation-examples/loan-approval">
                Loan approval systems
              </a>
            </td>
            <td
              >Appeal receipts, deadline clocks, and authority to reverse
              outcomes.</td
            >
          </tr>
          <tr>
            <th scope="row"
              >Safety-critical recommendations with clinical impact</th
            >
            <td>
              <a
                href="/standards/implementation-examples/healthcare-diagnostics"
              >
                Healthcare diagnostic AI
              </a>
            </td>
            <td
              >Plural oversight paths and immediate reversibility at runtime.</td
            >
          </tr>
          <tr>
            <th scope="row"
              >Account protection that can cause service lockouts</th
            >
            <td>
              <a
                href="/standards/implementation-examples/financial-fraud-detection"
              >
                Financial fraud detection
              </a>
            </td>
            <td
              >Time-to-restore SLOs plus visible repair logs for legitimate
              users.</td
            >
          </tr>
        </tbody>
      </table>
    </div>
    <p class="muted">
      Each example ends with a checklist of the clocks, receipts, and halt
      authority to build before launch.
    </p>
  </SectionBlock>

  <SectionBlock
    id="domains"
    eyebrow="Domains"
    title="Domain-by-domain implementation comparisons"
    description="Each page lists what standard governance implements, what Ethotechnics changes, and what to verify before launch."
    variant="alt"
  >
    <CardGrid className="grid--two">
      {
        implementationExamples.map((domain) => (
          <CardItem
            title={domain.title}
            description={domain.summary}
            tags={domain.tags}
          >
            <a
              slot="footer"
              class="button ghost button--compact"
              href={`/standards/implementation-examples/${domain.slug}`}
            >
              View comparison
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="how-to-use"
    eyebrow="How to use"
    title="Turn the comparison into implementation work"
    description="Each page moves from baseline controls to runtime mechanisms to a pre-launch checklist."
  >
    <ul class="muted">
      <li>
        Start with the standard governance block to capture baseline controls,
        audits, and committee processes.
      </li>
      <li>
        Translate the Ethotechnics block into enforceable runtime mechanisms
        like
        <a href="/glossary/stoppability"> stoppability</a>,
        <a href="/glossary/contestability"> contestability</a>, and
        <a href="/glossary/reversibility"> reversibility</a>.
      </li>
      <li>
        Use the implementation checklist to define specific receipts, clocks,
        and escalation paths for your system.
      </li>
    </ul>
  </SectionBlock>

  <div id="citations">
    <ScholarlyMeta publication={publication} permalink={permalink} />
    <CitationBlock
      title={pageTitle}
      permalink={permalink}
      publication={publication}
      summaryLabel="Cite this implementation guide"
    />
  </div>
</BaseLayout>
