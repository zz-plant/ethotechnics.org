---
import StandardsLayout from "../../components/StandardsLayout.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { derivePublicationMetadata } from "../../utils/publication";

const pageTitle = "OECD AI Principles";
const pageDescription =
  "An Ethotechnics critique of the OECD AI Principles: non-binding by design, they ask AI actors to be accountable and set no duty anyone can enforce.";
const permalink = "/standards/oecd-ai-principles";
const anchorLinks = [
  { href: "#critique", label: "Ethotechnics critique" },
  { href: "#failure-mode", label: "Failure mode" },
  { href: "#clause-map", label: "Principles to clauses" },
];
const publication = derivePublicationMetadata({
  permalink,
  published: "2025-06-01T00:00:00Z",
  updated: "2026-10-06T00:00:00Z",
  changelogSummary:
    "Replaced a quotation the 2024 text of the principles does not contain with the wording of principle 1.4(b). Added a table of the principles an Ethotechnics clause makes testable, and removed the overview.",
});

// Wording checked against the OECD Recommendation on Artificial Intelligence,
// OECD/LEGAL/0449, as revised on 3 May 2024.
const clauseMap = [
  {
    principle: "1.3(iv)",
    asks: "Provide information that enables those adversely affected by an AI system to challenge its output.",
    clauses: [
      {
        label: "STD-02 §2.2",
        href: "/standards/std-02-contestability-recourse",
      },
      {
        label: "STD-07 §4.2",
        href: "/standards/std-07-revisable-delegation-record#articles",
      },
    ],
    adds: "The appeal path names the authority that holds reversal power, and an objection gets a revision or a reasoned refusal within a stated clock.",
  },
  {
    principle: "1.4(b)",
    asks: "Mechanisms, as appropriate, so a system that risks undue harm can be overridden, repaired, or decommissioned safely as needed.",
    clauses: [
      {
        label: "STD-06 §1.3",
        href: "/standards/std-06-human-impact-safety-case",
      },
      {
        label: "STD-06 §5.6",
        href: "/standards/std-06-human-impact-safety-case",
      },
    ],
    adds: "One owner who can halt the deployment, and a withdrawal path rehearsed on a published cadence.",
  },
  {
    principle: "1.5(b)",
    asks: "Traceability of datasets, processes, and decisions, to enable analysis of outputs and responses to inquiry.",
    clauses: [
      {
        label: "STD-02 §5.3",
        href: "/standards/std-02-contestability-recourse",
      },
      {
        label: "STD-07 §1.2",
        href: "/standards/std-07-revisable-delegation-record#articles",
      },
    ],
    adds: "An audit trail from each contested decision to its evidence, reviewers, and outcome, in records that are never edited.",
  },
];
---

<StandardsLayout
  title={pageTitle}
  description={pageDescription}
  permalink={permalink}
  seoTitle={`${pageTitle} — Standards critique`}
  eyebrow="Adopted standard"
  anchorLinks={anchorLinks}
  publishedTime="2025-06-01T00:00:00.000Z"
  modifiedTime="2026-10-06T00:00:00.000Z"
>
  <SectionBlock
    id="critique"
    eyebrow="Ethotechnics critique"
    title="Where the principles fall short"
    variant="alt"
  >
    <ul class="card__list">
      <li>
        <strong>Non-binding by design:</strong> Nothing in the principles can be tested,
        so a program can claim after it has caused harm that it followed them, and
        no one can show it did not.
      </li>
      <li>
        <strong>No allocation of power:</strong> The principles rarely say who must
        answer a challenge, who can halt a system, or on what clock.
      </li>
      <li>
        <strong>Intervention without mechanism:</strong> Principle 1.4(b) asks for
        mechanisms, “as appropriate,” so a harmful system can be overridden, repaired,
        or decommissioned “as needed.” It does not require a tested stop path, a restoration
        deadline, or a limit on how long a case can stay pending.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="failure-mode"
    eyebrow="Failure mode"
    title="Legible virtue + uncorrected errors"
    description="Good narratives and training, and no one bound to act on what goes wrong."
  >
    <p>
      The dominant failure mode is a system that sounds responsible on paper
      while the evidence of its errors reaches no one who has to change it.
    </p>
  </SectionBlock>
  <SectionBlock
    id="clause-map"
    eyebrow="Principles to clauses"
    title="Where an Ethotechnics clause makes a principle testable"
    description="Each row names the principle, the clause that bears on it, and what the clause requires that the principle leaves open."
    variant="alt"
  >
    <div class="mapping-table__wrapper">
      <table class="mapping-table mapping-table--stack">
        <thead>
          <tr>
            <th scope="col">Principle</th>
            <th scope="col">What it asks</th>
            <th scope="col">Clause</th>
            <th scope="col">What the clause adds</th>
          </tr>
        </thead>
        <tbody>
          {
            clauseMap.map((row) => (
              <tr>
                <th scope="row">{row.principle}</th>
                <td data-label="What it asks">{row.asks}</td>
                <td data-label="Clause">
                  {row.clauses.map((clause, index) => (
                    <>
                      <a href={clause.href}>{clause.label}</a>
                      {index < row.clauses.length - 1 && <span>, </span>}
                    </>
                  ))}
                </td>
                <td data-label="What the clause adds">{row.adds}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="muted">
      Principle text from the <a
        href="https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0449"
        >OECD Recommendation on Artificial Intelligence</a
      >, as revised in 2024, paraphrased.
    </p>
  </SectionBlock>
  <CitationBlock
    title={pageTitle}
    permalink={permalink}
    publication={publication}
  />
</StandardsLayout>
