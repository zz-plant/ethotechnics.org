---
import "../../styles/components/standards.css";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import StandardsLayout from "../../components/StandardsLayout.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { minimumViableContestabilityContent } from "../../content/minimum-viable-contestability";

const {
  pageTitle,
  pageDescription,
  permalink,
  anchorLinks,
  summary,
  sections,
  textOnly,
} = minimumViableContestabilityContent;
const version = "1.0";
const lastUpdated = "2025-01-01";
---

<StandardsLayout
  title={pageTitle}
  description={pageDescription}
  permalink={permalink}
  eyebrow="Standard"
  anchorLinks={anchorLinks}
  version={version}
  lastUpdated={lastUpdated}
  seoTitle={`${pageTitle} — Ethotechnics`}
>
  <SectionBlock
    id="summary"
    eyebrow="One-screen summary"
    title={summary.title}
    description={summary.description}
  >
    <CardGrid className="grid--two">
      {
        summary.items.map((item) => (
          <CardItem title={item.title} description={item.description} />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="standard"
    eyebrow="Baseline requirements"
    title="Eight baseline commitments make contestability real."
    description="Each commitment below is the minimum, with the evidence a reviewer can check."
    variant="alt"
  >
    {
      sections.map((section, index) => (
        <section id={section.id} class="standard-section stack-sm">
          <p class="eyebrow">Section {index + 1}</p>
          <h3>{section.title}</h3>
          <p class="muted">{section.summary}</p>
          <div class="grid grid--two">
            <div class="panel">
              <p class="eyebrow">Requirements</p>
              <ul class="muted">
                {section.requirements.map((requirement) => (
                  <li>{requirement}</li>
                ))}
              </ul>
            </div>
            <div class="panel">
              <p class="eyebrow">Evidence</p>
              <ul class="muted">
                {section.evidence.map((evidence) => (
                  <li>{evidence}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      ))
    }
  </SectionBlock>

  <SectionBlock
    id="text"
    eyebrow="Plain text"
    title={textOnly.title}
    description={textOnly.description}
  >
    <div class="panel">
      <p class="muted">{summary.description}</p>
      <ol class="muted">
        {
          sections.map((section) => (
            <li>
              <strong>{section.title}:</strong> {section.summary} Requirements:{" "}
              {section.requirements.join(" ")}
            </li>
          ))
        }
      </ol>
    </div>
  </SectionBlock>
</StandardsLayout>
