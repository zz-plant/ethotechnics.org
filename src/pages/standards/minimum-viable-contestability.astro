---
import "../../styles/components/standards.css";
import StandardsLayout from "../../components/StandardsLayout.astro";
import ClauseCitations from "../../components/ClauseCitations.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { minimumViableContestabilityContent } from "../../content/minimum-viable-contestability";

const { pageTitle, pageDescription, permalink, anchorLinks, sections } =
  minimumViableContestabilityContent;
const version = "1.0.1";
const lastUpdated = "2026-10-06";
---

<StandardsLayout
  title={pageTitle}
  description={pageDescription}
  permalink={permalink}
  eyebrow="Standard"
  anchorLinks={anchorLinks}
  version={version}
  lastUpdated={lastUpdated}
  seoTitle={`${pageTitle} — Ethotechnics`}
>
  {
    /* A "one-screen summary" gave the eight commitments as cards, under an
       h2 that repeated the h1, and the next section opened each commitment
       with the same line reworded. The outline above lists the eight. */
  }
  <SectionBlock
    id="standard"
    eyebrow="Baseline requirements"
    title="Eight commitments a system must meet before its decisions can be challenged"
    description="Each commitment is the minimum of the STD-02 clauses it cites, with the evidence a reviewer can check."
  >
    <p class="muted">
      The definition: <a href="/explainers/contestability"
        >What is AI contestability?</a
      > A case where the model was cleared and the route to challenge it was not:
      <a href="/casebook/apple-card">Apple Card credit limits</a>.
    </p>
    {
      sections.map((section, index) => (
        <section id={section.id} class="standard-section stack-sm">
          <p class="eyebrow">Section {index + 1}</p>
          <h3>{section.title}</h3>
          <p class="muted">{section.summary}</p>
          <ClauseCitations cites={section.cites} />
          <div class="grid grid--two">
            <div class="panel">
              <p class="eyebrow">Requirements</p>
              <ul class="muted">
                {section.requirements.map((requirement) => (
                  <li>{requirement}</li>
                ))}
              </ul>
            </div>
            <div class="panel">
              <p class="eyebrow">Evidence</p>
              <ul class="muted">
                {section.evidence.map((evidence) => (
                  <li>{evidence}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      ))
    }
  </SectionBlock>
</StandardsLayout>
