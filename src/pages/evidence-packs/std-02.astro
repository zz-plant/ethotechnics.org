---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import SearchIds from "../../components/SearchIds.astro";
import { standardClauses } from "../../content/standards";

const pageTitle = "STD-02 Evidence Pack — Ethotechnics Institute";
const pageDescription =
  "What to show for STD-02 challenges, review clocks, and remedies at three tiers, from a working appeal path to proof under incident load, and what auditors ask.";

const clauses = standardClauses["STD-02"];
const clauseAnchor = (id: string) =>
  id.toLowerCase().replace(/[^a-z0-9]+/g, "-");

const tiers = [
  {
    tier: "Tier 0 (minimum)",
    description: "Proof the appeal path exists and is reachable in-product.",
    evidence: "UI links, receipt payloads, and appeal intake records.",
  },
  {
    tier: "Tier 1 (operational)",
    description: "Proof that challenges are reviewed and clocks are honored.",
    evidence:
      "Reviewer rosters, appeal outcomes, and clock compliance dashboards.",
  },
  {
    tier: "Tier 2 (resilient)",
    description:
      "Proof that the challenge route survives scale, incident load, and exceptions.",
    evidence: "Postmortems, exception audits, and throughput stress tests.",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Evidence pack"
    title="STD-02 evidence pack"
    description={pageDescription}
    anchorLinks={[
      { href: "#tiers", label: "Tiered model" },
      { href: "#clauses", label: "Clause evidence list" },
      { href: "#anti-weaponization", label: "Anti-weaponization evidence" },
      { href: "#anti-fraud", label: "How teams fake this" },
      { href: "#auditors", label: "What auditors ask" },
    ]}
  />

  <SectionBlock
    id="tiers"
    eyebrow="Tiered evidence model"
    title="Tier 0 to Tier 2 minimum"
    description="Begin with Tier 0 to prove access, then move up to resilience evidence."
  >
    <ul class="muted">
      {
        tiers.map((tier) => (
          <li>
            <strong>{tier.tier}:</strong> {tier.description}{" "}
            <span class="muted">{tier.evidence}</span>
          </li>
        ))
      }
    </ul>
    <p class="muted">
      Receipt payloads should conform to the{" "}
      <a href="/standards/agent-receipt-schema.json">Agent Receipt schema</a>,
      so an auditor's tools can read them.
    </p>
  </SectionBlock>

  <SectionBlock
    id="clauses"
    title="Evidence packs per clause"
    description="The evidence each STD-02 clause asks for, from the clause register."
    variant="alt"
  >
    <ul class="standard-clauses">
      {
        clauses.map((clause) => (
          <li id={clauseAnchor(clause.id)}>
            <strong>{clause.id}</strong> ({clause.displayId}) — when{" "}
            {clause.condition}, {clause.obligation}.
            <br />
            <span class="muted">
              Evidence: {clause.evidenceRequired.join(", ")}
            </span>
          </li>
        ))
      }
    </ul>
  </SectionBlock>

  <SectionBlock
    id="anti-weaponization"
    eyebrow="Anti-weaponization evidence"
    title="Evidence requirements for AW-01 through AW-04"
    description="The evidence each anti-weaponization constraint asks for, alongside the STD-02 clauses."
  >
    <ul class="muted">
      <li>
        <strong>AW-01:</strong> Burden remediation plan tied to challenge metrics.
      </li>
      <li>
        <strong>AW-02:</strong> Appeal path regression tests + public replacement
        notice.
      </li>
      <li>
        <strong>AW-03:</strong> Receipts + clock compliance for automated downgrades.
      </li>
      <li>
        <strong>AW-04:</strong> Assisted channel logs with escalation outcomes.
      </li>
    </ul>
    <p class="muted">
      Pair this with
      {" "}
      <a href="/diagnostics#anti-weaponization">diagnostics checks</a>
      {" "}
      to validate AW compliance.
    </p>
  </SectionBlock>

  <SectionBlock
    id="anti-fraud"
    eyebrow="How teams fake this"
    title="Common compliance theater patterns"
    description="Ways an appeal path can exist on paper and fail in use."
  >
    <ul class="muted">
      <li>Appeal links exist but lead to dead ends or generic inboxes.</li>
      <li>
        Review clocks are defined but not visible to the people the decisions
        are about.
      </li>
      <li>
        Manual review happens, but there is no audit trail of outcomes or
        reversals.
      </li>
      <li>
        Exception paths are used to avoid remedies without any expiry or review
        cadence.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="auditors"
    eyebrow="What auditors ask"
    title="Audit questions to prepare for"
    description="Provide clause-linked evidence and decision logs in response."
    variant="alt"
  >
    <ul class="muted">
      <li>
        Show appeal outcomes for the last quarter and the median review time.
      </li>
      <li>
        Demonstrate how many remedies were delivered within the remedy clock.
      </li>
      <li>
        Provide evidence that exception classes are time-bounded and reviewed.
      </li>
      <li>
        Show how decision logs reference evidence packs for contested decisions.
      </li>
      <li>
        Show, for each decision class, how many challenges were upheld, and what
        changed in the rule after them, or the STD-07 reconsideration record
        that kept it.
      </li>
    </ul>
  </SectionBlock>

  {/* IDs a site search should match to this page. */}
  <SearchIds
    ids={[
      "STD-02",
      "STD-02.2.1",
      "STD-02.3.1",
      "AW-01",
      "AW-02",
      "AW-03",
      "AW-04",
      "VAL-02",
      "VAL-03",
    ]}
  />
</BaseLayout>
