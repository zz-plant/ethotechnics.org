---
import { getCollection } from "astro:content";
import { micromark } from "micromark";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import SearchIds from "../../components/SearchIds.astro";
import { standardClauses } from "../../content/standards";

const entry = (await getCollection("evidencePacks")).find(
  (candidate) => candidate.id === Astro.params.slug,
);
if (!entry) return new Response("Not found", { status: 404 });
const { title, description, checklists, published, updated, searchIds } =
  entry.data;
const sections = entry.data.sections.map((section, index) => ({
  ...section,
  id: section.id ?? `section-${index}`,
}));
const clauses = standardClauses[entry.data.standardId] ?? [];
const clauseAnchor = (id: string) =>
  id.toLowerCase().replace(/[^a-z0-9]+/g, "-");

const pageTitle = `${title} — Ethotechnics Institute`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  publishedTime={published}
  modifiedTime={updated}
>
  <PageIntro
    eyebrow="Evidence pack"
    title={title}
    description={description}
    anchorLinks={[
      ...sections.map((section) => ({
        href: `#${section.id}`,
        label: section.title,
      })),
      { href: "#referenced-by", label: "Referenced by" },
    ]}
  />

  {
    sections.map((section, index) => (
      <SectionBlock
        id={section.id}
        eyebrow={section.required ? "Required" : "Optional"}
        title={section.title}
        description={
          section.required
            ? "Required by the standard, once adopted."
            : "Optional deeper evidence."
        }
        variant={index % 2 === 0 ? "default" : "alt"}
      >
        <div set:html={micromark(section.content)} />
        {section.clauseEvidence && (
          <ul class="standard-clauses">
            {clauses.map((clause) => (
              <li id={clauseAnchor(clause.id)}>
                <strong>{clause.id}</strong> ({clause.displayId}) — when{" "}
                {clause.condition}, {clause.obligation}.
                <br />
                <span class="muted">
                  Evidence: {clause.evidenceRequired.join(", ")}
                </span>
              </li>
            ))}
          </ul>
        )}
      </SectionBlock>
    ))
  }

  {
    (checklists ?? []).map((checklist, index) => (
      <SectionBlock
        id={index === 0 ? "referenced-by" : `referenced-by-${index}`}
        eyebrow="Referenced by"
        title={checklist.title}
        description="The standards, bindings, and validators this pack supports."
        variant="alt"
      >
        <div class="grid grid--three">
          {checklist.items.map((item) => (
            <div class="panel">
              <div class="muted" set:html={micromark(item)} />
            </div>
          ))}
        </div>
      </SectionBlock>
    ))
  }
  {searchIds && <SearchIds ids={searchIds} />}
</BaseLayout>
