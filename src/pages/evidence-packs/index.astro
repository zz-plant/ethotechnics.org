---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";

const evidencePacks = await getCollection("evidencePacks");

const pageTitle = "Evidence Packs";
const pageDescription =
  "Tiered evidence requirements for each standard with audit guidance and compliance theater detection.";

const anchorLinks = [{ href: "#evidence-packs", label: "All evidence packs" }];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro
    eyebrow="Evidence packs"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
    illustration="evidence-packs"
  />

  <SectionBlock
    id="evidence-packs"
    eyebrow="All evidence packs"
    title={`Evidence packs for ${evidencePacks.length} standards`}
    description="Each pack includes tiered evidence, clause-level requirements, anti-fraud patterns, and auditor questions."
  >
    <CardGrid className="grid--two">
      {
        evidencePacks
          .sort((a, b) => a.data.title.localeCompare(b.data.title))
          .map((entry) => (
            <CardItem
              title={entry.data.title}
              description={entry.data.description}
            >
              <a
                slot="footer"
                class="button ghost button--compact"
                href={entry.data.permalink}
              >
                Open evidence pack
              </a>
            </CardItem>
          ))
      }
    </CardGrid>
  </SectionBlock>

  <p class="muted" style="margin-top:2rem">
    See also: <a href="/standards">Standards</a> &middot; <a
      href="/agent-toolkit/prompt-packs">Bindings</a
    > &middot; <a href="/validators">Validators</a>
  </p>
</BaseLayout>
