---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import SummaryCallout from "../../components/SummaryCallout.astro";

const evidencePacks = await getCollection("evidencePacks");

const pageTitle = "Evidence Packs";
const pageDescription = "Tiered evidence requirements for each standard with audit guidance and compliance theater detection.";
const permalink = "/evidence-packs";

const anchorLinks = [
  { href: "#evidence-packs", label: "All evidence packs" },
];

const takeaways = [
  "Each pack uses a Tier 0–2 model so you can scale proof from baseline to resilience.",
  "Anti-fraud patterns help auditors catch hollow compliance before it ships.",
  "Cross-links keep evidence packs aligned with standards, bindings, and validators.",
];

const relatedLinks = [
  { href: "/standards", label: "Standards" },
  { href: "/bindings", label: "Bindings" },
  { href: "/validators", label: "Validators" },
];

const summaryLinks = [
  { href: "#evidence-packs", label: "Browse all" },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro
    eyebrow="Evidence packs"
    title={pageTitle}
    description={pageDescription}
    permalink={permalink}
    anchorLinks={anchorLinks}
    panelCopy={{
      eyebrow: "Proof-carrying compliance",
      title: "Tiered evidence for enforceable standards",
      description: "Evidence packs translate clause obligations into artifact inventories, test batteries, and auditor-ready exports.",
    }}
  />

  <SummaryCallout
    title="Evidence pack wayfinding"
    description="Start with the pack for the standard you're implementing, then layer in higher-tier proof."
    takeaways={takeaways}
    relatedLinks={relatedLinks}
    jumpLinks={summaryLinks}
  />

  <SectionBlock
    id="evidence-packs"
    eyebrow="All evidence packs"
    title={`Evidence packs for ${evidencePacks.length} standards`}
    description="Each pack includes tiered evidence, clause-level requirements, anti-fraud patterns, and auditor questions."
  >
    <CardGrid className="grid--two">
      {
        evidencePacks
          .sort((a, b) => a.data.title.localeCompare(b.data.title))
          .map((entry) => (
            <CardItem
              title={entry.data.title}
              description={entry.data.description}
            >
              <a slot="footer" class="button ghost button--compact" href={entry.data.permalink}>
                Open evidence pack
              </a>
            </CardItem>
          ))
      }
    </CardGrid>
  </SectionBlock>

  <p class="muted" style="margin-top:2rem">
    See also: <a href="/standards">Standards</a> &middot; <a href="/bindings">Bindings</a> &middot; <a href="/validators">Validators</a>
  </p>
</BaseLayout>