---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import SearchIds from "../../components/SearchIds.astro";
import agentSafetyObjectModel from "../../data/agents-spec.json";

const pageTitle = "Agent Safety Object Model";
const pageDescription =
  "A JSON schema that declares an AI agent's autonomy level, action classes, override authority, receipts, and clocks, with what breaks when a field is missing.";
const version = "v1.1.2";
const lastUpdated = "2026-10-06";
const anchorLinks = [
  { href: "#example", label: "Example object" },
  { href: "#fields", label: "Field guide" },
  { href: "#usage", label: "Usage" },
];

const agentSafetyObjectModelText = JSON.stringify(
  agentSafetyObjectModel,
  null,
  2,
);

const fieldGuide = [
  {
    field: "schema_version",
    example: "1.1.0",
    purpose:
      "Versions the contract so CI, validators, and auditors parse it consistently.",
    failure: "Tooling cannot validate or diff the model when versions drift.",
  },
  {
    field: "agent_id",
    example: "agent-risk-ops-v2",
    purpose:
      "Provides a stable identifier that ties receipts, incidents, and evidence packs to one system.",
    failure:
      "Evidence is orphaned; audits cannot trace decisions back to the agent.",
  },
  {
    field: "autonomy_level",
    example: "execute_with_guardrails",
    purpose:
      "Defines whether the agent drafts, recommends, or executes actions.",
    failure:
      "Release gates cannot infer approval requirements or escalation scope.",
  },
  {
    field: "action_classes",
    example: "READ / WRITE / TRANSFER",
    purpose:
      "Lists allowed actions, their reversibility, and default approvals.",
    failure:
      "Receipts are ambiguous and controls cannot bind to irreversible actions.",
  },
  {
    field: "stop_override_authority",
    example: "Risk Operations / Risk Steward",
    purpose: "Names the owner, on-call role, and kill-switch authority.",
    failure:
      "No one can halt automation inside the halt deadline during an incident.",
  },
  {
    field: "receipt_schema",
    example: "/standards/agent-receipt-schema.json",
    purpose: "Specifies the receipt contract emitted by tools.",
    failure:
      "Receipts become incomparable, breaking audits and evidence packs.",
  },
  {
    field: "clocks",
    example: "ack 2h / review 24h / remedy 72h",
    purpose: "Publishes acknowledgment, review, and remedy timers.",
    failure:
      "Contestability becomes unenforceable without time-bound obligations.",
  },
  {
    field: "evidence_pack_references",
    example: "STD-01 + STD-02 packs",
    purpose: "Links the model to proof bundles for audits.",
    failure: "Compliance claims lack evidence anchors.",
  },
  {
    field: "required_signals",
    example: "unsafe_action_rate",
    purpose:
      "Lists the signals that must be monitored to prove control efficacy.",
    failure: "Safety claims cannot be measured or validated.",
  },
  {
    field: "mapped_mechanisms",
    example: "MEC-01, MEC-05, MEC-06",
    purpose: "Connects the model to enforced mechanisms and runbooks.",
    failure:
      "Controls exist only on paper, and no mechanism runs in production.",
  },
];
---

<BaseLayout
  title={`${pageTitle} — Ethotechnics`}
  description={pageDescription}
  publishedTime="2026-02-22T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Agent specification"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
    version={version}
    lastUpdated={lastUpdated}
  >
    <Fragment slot="actions">
      <a class="button ghost" href="/use-cases#agents"
        >Standards and checks for agents</a
      >
      <a class="button ghost" href="/standards/std-08-delegation"
        >STD-08 Delegation</a
      >
    </Fragment>
  </PageIntro>

  {
    /* The page printed the example object twice, a short copy and the full
       one, each under its own version caveat, after an overview that linked
       the page to itself. One copy, one caveat, the files beside it. */
  }
  <SectionBlock
    id="example"
    title="The object, by example"
    description="This example is in the v1.1.0 shape and fails the v2.0.0 schema; a v2.0.0 instance that validates is linked below. In v2.0.0 four references are required (capability catalog, dependency record, intervention specification, substrate profile), a grant reference replaces approval_required for each action class, and an intervention reference replaces stop_override_authority. Replace the IDs and clocks with your system's values."
    variant="alt"
  >
    <ul class="muted">
      <li>
        Example that validates against v2.0.0:
        <a href="/standards/examples/agent-safety-object-model.example.json"
          >/standards/examples/agent-safety-object-model.example.json</a
        >
      </li>
      <li>
        Object model schema, v2.0.0:
        <a href="/standards/agent-safety-object-model.schema.json"
          >/standards/agent-safety-object-model.schema.json</a
        >
      </li>
      <li>
        This example as JSON: <a href="/agents/spec.json">/agents/spec.json</a>
      </li>
    </ul>
    <pre class="code-block">{agentSafetyObjectModelText}</pre>
    <p class="muted">
      Every field has a type in the JSON Schema, so a validator can check it in
      CI. Keep the JSON human-readable so reviewers can inspect it in change
      requests and audits.
    </p>
  </SectionBlock>

  <SectionBlock
    id="fields"
    title="Each field, and what breaks without it"
    description="An omitted field leaves an audit or a release gate with nothing to check."
  >
    <div
      class="mapping-table__wrapper"
      tabindex="0"
      role="region"
      aria-label="Each field, and what breaks without it"
    >
      <table class="mapping-table">
        <thead>
          <tr>
            <th>Field</th>
            <th>Purpose</th>
            <th>Example</th>
            <th>What breaks if missing</th>
          </tr>
        </thead>
        <tbody>
          {
            fieldGuide.map((item) => (
              <tr>
                <td>{item.field}</td>
                <td>{item.purpose}</td>
                <td>{item.example}</td>
                <td>{item.failure}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </SectionBlock>

  <SectionBlock
    id="usage"
    title="Where to use it"
    description="Bind the schema to deployment gates and audit workflows."
    variant="alt"
  >
    <ul class="muted">
      <li>
        Record the decision to deploy each agent release with the
        <a href="/mechanisms/patterns/admission-gate">MEC-22 admission gate</a>.
      </li>
      <li>
        Map action classes to the controls in <a
          href="/standards/ethotechnics-for-agents">Ethotechnics for Agents</a
        >.
      </li>
      <li>
        Link receipts and clocks to <a href="/evidence-packs">evidence packs</a> for
        audits.
      </li>
    </ul>
  </SectionBlock>

  {/* IDs a site search should match to this page. */}
  <SearchIds
    ids={[
      "ASOM 1.1.0",
      "STD-01",
      "STD-02",
      "STD-01.1.1",
      "STD-02.2.1",
      "MEC-01",
      "MEC-05",
      "MEC-06",
      "VAL-01",
      "VAL-02",
      "VAL-03",
    ]}
  />
</BaseLayout>
