---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { API_ENDPOINTS } from "../../utils/api/api-endpoints";

const pageTitle = "Reference API & ontology";
const pageDescription =
  "Data objects, JSON schemas, OpenAPI and AsyncAPI specs, and read-only JSON endpoints for Ethotechnics standards, clauses, and mechanisms.";
const anchorLinks = [
  { href: "#objects", label: "Objects and schemas" },
  { href: "#interoperability", label: "Interoperability specs" },
  { href: "#endpoints", label: "Files and endpoints" },
  { href: "#versioning", label: "Versioning" },
];

const canonicalObjects = [
  {
    name: "Standard",
    description: "Top-level standard metadata, version, and published clauses.",
  },
  {
    name: "Clause",
    description:
      "One requirement of a standard, with a stable clause ID (for example, \u00a73.2).",
  },
  {
    name: "Mechanism",
    description:
      "Reusable enforcement spec with tags, artifacts, and implementation notes.",
  },
  {
    name: "Validator",
    description:
      "Diagnostic definition with inputs, thresholds, and output schema.",
  },
  {
    name: "Finding",
    description:
      "Canonical diagnostic artifact linking gaps to clauses and fixes.",
  },
  {
    name: "Diagnostic result",
    description:
      "Generated report card, risk statement, and remediation recommendations.",
  },
  {
    name: "Evidence pack",
    description: "The evidence a clause asks a system to be able to show.",
  },
  {
    name: "Crosswalk control",
    description:
      "Control-level mapping across the EU AI Act, NIST AI RMF, and ISO/IEC 42001.",
  },
  {
    name: "Post-market stage",
    description:
      "Operational incident reporting stages with expected outcomes and references.",
  },
  {
    name: "Anti-pattern",
    description:
      "Negative examples that look compliant but fail the clause intent.",
  },
  {
    name: "Diagram",
    description:
      "A small figure that explains one term or clause. Diagrams are not exported yet.",
  },
  {
    name: "Agent safety object model",
    description:
      "Machine-readable profile for autonomy level, action classes, and receipts; v2.0.0 points each action class at its authority grant.",
  },
  {
    name: "Capability catalog",
    description:
      "What a grantee can discover it could do. Confers no authority and contains no permission fields.",
  },
  {
    name: "Authority grant",
    description:
      "A lease on consequential action: scope, evidence basis, state (allowed, review_required, suspended, revoked), and state history.",
  },
  {
    name: "Policy record",
    description:
      "Versioned evidence behind a grant, with assumptions, review triggers, expiry, and status.",
  },
  {
    name: "Dependency record",
    description:
      "How hard withdrawal or substitution has become: dependents, reversibility at three levels, preserved capacities, and exposure score.",
  },
  {
    name: "Standing register and challenge",
    description:
      "Who may challenge which decision classes, with what evidence and procedural force; a challenge is one exercise of that standing.",
  },
  {
    name: "Intervention spec and reconsideration",
    description:
      "What a human can see, prevent, and alter (replacing 'human in the loop'), and the record of an observation changing state.",
  },
  {
    name: "Substrate profile",
    description:
      "Nine-property classification of a deployment that replaces open-versus-closed.",
  },
];

// Each object's JSON Schema, listed under the object it describes. They used
// to be a second list under the agent model, naming the same objects again.
const objectSchemas: Record<string, string[]> = {
  "Agent safety object model": [
    "/standards/agent-safety-object-model.schema.json",
  ],
  "Capability catalog": ["/standards/capability-catalog.schema.json"],
  "Authority grant": ["/standards/authority-grant.schema.json"],
  "Policy record": ["/standards/policy-record.schema.json"],
  "Dependency record": ["/standards/dependency-record.schema.json"],
  "Standing register and challenge": [
    "/standards/standing-register.schema.json",
    "/standards/challenge.schema.json",
  ],
  "Intervention spec and reconsideration": [
    "/standards/intervention-spec.schema.json",
    "/standards/reconsideration.schema.json",
  ],
  "Substrate profile": ["/standards/substrate-profile.schema.json"],
};

const interoperabilitySpecs = [
  {
    name: "Control plane OpenAPI",
    href: "/standards/ethotechnics-control-plane.openapi.yaml",
    description:
      "Endpoints your system would implement: decision retrieval, appeal intake, and (v0.3.0) capability, grant, policy, dependency, standing, challenge, and reconsideration. None of them runs on ethotechnics.org.",
  },
  {
    name: "Events AsyncAPI",
    href: "/standards/ethotechnics-events.asyncapi.yaml",
    description:
      "Deadline and repair log events, plus (v0.3.0) grant, policy, dependency, challenge, and reconsideration state events.",
  },
];

const endpoints = API_ENDPOINTS.map((endpoint) => ({
  path: `/api/${endpoint.path}`,
  description: endpoint.description,
}));
---

<BaseLayout
  title={`${pageTitle} — Ethotechnics`}
  description={pageDescription}
  mainClass="page page--wide"
  structuredDataType="collection"
>
  <PageIntro
    eyebrow="Reference API"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="objects"
    title="The object model behind the exports"
    description="The names the endpoints and schemas below use. Use the same names in integrations and audit tooling. Each v2 schema has a validating example under /standards/examples/; together the examples describe one delegation scenario."
  >
    <ul class="muted">
      {
        canonicalObjects.map((object) => (
          <li>
            <strong>{object.name}:</strong> {object.description}
            {(objectSchemas[object.name] ?? []).map((href) => (
              <>
                {" "}
                <a href={href}>{href.split("/").pop()}</a>
              </>
            ))}
          </li>
        ))
      }
    </ul>
  </SectionBlock>

  <SectionBlock
    id="interoperability"
    eyebrow="Interoperability specs"
    title="Draft contracts for decision and repair workflows"
    description="Specs that wire decisions, appeals, and clock events into tooling."
  >
    <ul class="muted">
      {
        interoperabilitySpecs.map((spec) => (
          <li>
            <strong>{spec.name}:</strong> <a href={spec.href}>{spec.href}</a> —{" "}
            {spec.description}
          </li>
        ))
      }
    </ul>
    <div>
      <p class="eyebrow">FHIR resources</p>
      <h3>FHIR resources (healthcare-specific interop)</h3>
      <ul class="muted">
        <li>
          <strong>Target:</strong> healthcare payers, providers, and regulators.
        </li>
        <li>
          <strong>Why:</strong> CMS-0057-F requires Medicare Advantage, Medicaid,
          and CHIP payers to support FHIR APIs for prior authorization by January
          2027, so denials and appeals already travel as FHIR.
        </li>
        <li>
          <strong>Status:</strong> the profile set here, STD-04, is deprecated. STD-05
          carries the same records as W3C Verifiable Credentials.
        </li>
        <li>
          <strong>What to ship:</strong> custom FHIR profiles for:
          <ul>
            <li>Decision</li>
            <li>Denial</li>
            <li>Appeal</li>
            <li>RepairStatus</li>
            <li>PendingClock</li>
          </ul>
        </li>
        <li>FHIR makes refusal and repair first-class healthcare data.</li>
      </ul>
    </div>
    <ul class="muted">
      <li>
        Decision retrieval: <code>GET /api/decisions/{`{decision_id}`}</code>
      </li>
      <li>Appeal submission: <code>POST /api/appeals</code></li>
      <li>
        Grant lease and transitions: <code>GET /api/grants/{`{grant_id}`}</code
        >,{" "}
        <code>POST /api/grants/{`{grant_id}`}/state</code>
      </li>
      <li>
        Standing and reconsideration: <code>GET /api/standing</code>,{" "}
        <code>POST /api/challenges</code>,{" "}
        <code>POST /api/reconsiderations</code>
      </li>
      <li>
        Events: <code>decision.deadline.reminder</code>,{" "}
        <code>appeal.deadline.breached</code>,{" "}
        <code>repair.log.updated</code>, <code>grant.state.changed</code>,{" "}
        <code>policy.review.triggered</code>,{" "}
        <code>dependency.threshold.crossed</code>,{" "}
        <code>challenge.opened</code>,{" "}
        <code>reconsideration.completed</code>
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="endpoints"
    title="Files and endpoints"
    description="Stable exports for tooling, audits, and archival use."
    variant="alt"
  >
    <ul class="muted">
      <li>
        The agent safety object model: the <a href="/agents/spec">spec page</a>,
        its example as JSON at <a href="/agents/spec.json">/agents/spec.json</a
        >, and the v1.1.0 instance at <a
          href="/standards/agent-safety-object-model.json"
          >/standards/agent-safety-object-model.json</a
        >, served unchanged.
      </li>
      <li>
        Receipt and remedy schemas:
        <a href="/standards/agent-receipt-schema.json">agent receipt</a>,
        <a href="/standards/decision-record.schema.json">decision record</a>,
        <a href="/standards/appeal-event.schema.json">appeal event</a>,
        <a href="/standards/pause-reversal.schema.json">pause and reversal</a>,
        <a href="/standards/burden-hours.schema.json">burden hours</a>,
        <a href="/standards/repair-sla.schema.json">repair SLA</a>, and the
        <a href="/api/schema/revisable-delegation-record.schema.json"
          >revisable delegation record</a
        > (STD-07).
      </li>
    </ul>
    <div
      class="mapping-table__wrapper"
      tabindex="0"
      role="region"
      aria-label="Files and endpoints"
    >
      <table class="mapping-table">
        <thead>
          <tr>
            <th scope="col">Endpoint</th>
            <th scope="col">Purpose</th>
          </tr>
        </thead>
        <tbody>
          {
            endpoints.map((endpoint) => (
              <tr>
                <td>
                  <a href={endpoint.path}>{endpoint.path}</a>
                </td>
                <td>{endpoint.description}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </SectionBlock>

  <SectionBlock
    id="versioning"
    title="Versions, and what is not built"
    description="Each object should carry a version, an updated timestamp, and a canonical permalink."
  >
    <ul class="muted">
      <li>Semantic versioning for standards, mechanisms, and validators.</li>
      <li>Immutable permalinks for citations in contracts and audit logs.</li>
      <li>
        Changelogs that describe material changes to rights or thresholds.
      </li>
      <li>A release index at /api/releases.json.</li>
    </ul>
    <p class="muted">
      Not built, and not scheduled: signed releases with verifiable citation
      hashes, automated schema validation for new objects, and clause mappings
      for emerging external standards. The OpenAPI and AsyncAPI drafts above are
      published.
    </p>
  </SectionBlock>
</BaseLayout>
