---
import BaseLayout from "../../layouts/BaseLayout.astro";

const operationsChecklist = [
  "Define harm intake paths with explicit triage categories.",
  "Set escalation SLAs by severity and route to named responders.",
  "Track queue age and auto-escalate stalled cases.",
  "Publish a repair log with remediation status and owner handoffs.",
];
---

<BaseLayout
  title="AI governance adoption for operations and incident response"
  description="Operations checklist for appeals triage, escalation clocks, freeze authority, and evidence-ready incident response."
  publishedTime="2026-02-21"
  modifiedTime="2026-03-04"
>
  <section class="stack-lg institute-screen">
    <h1>Adopt Ethotechnics through operations</h1>
    <p>
      Use this path when appeals, incident response, and queue management teams
      need bounded escalation and freeze authority.
    </p>
    <p>
      Ground operations runbooks in the <a href="/standards">standards set</a> and
      <a href="/failure">failure archive</a> so every intervention has a clear trigger
      and owner.
    </p>
    <h2>Operations checklist</h2>
    <ul>
      {operationsChecklist.map((item) => <li>{item}</li>)}
    </ul>
    <p><a class="button" href="/#failure-intake">Start with a failure</a></p>
  </section>
</BaseLayout>
