---
import BaseLayout from "../../layouts/BaseLayout.astro";

const policyChecklist = [
  "Bind contestability rights to explicit owner roles and response clocks.",
  "Define restitution pathways for harms that cannot be fully reversed.",
  "Set incident disclosure expectations for high-impact failures.",
  "Require sign-off authority for resume decisions after a halt.",
];
---

<BaseLayout
  title="Adopt AI governance policy controls | Ethotechnics"
  description="Policy guide for legal, compliance, and risk teams to set ownership clocks, contestability commitments, and remediation obligations."
  publishedTime="2026-02-21"
>
  <section class="stack-lg institute-screen">
    <h1>Adopt Ethotechnics through policy</h1>
    <p>
      Use this path when legal, compliance, and risk teams are setting
      ownership, reversal clocks, and contestability commitments.
    </p>
    <p>
      Pair this with the <a href="/standards">standards library</a> and
      <a href="/mechanisms">mechanisms catalog</a> to translate policy intent into
      enforceable controls.
    </p>
    <h2>Policy checklist</h2>
    <ul>
      {policyChecklist.map((item) => <li>{item}</li>)}
    </ul>
    <p><a class="button" href="/#failure-intake">Start with a failure</a></p>
  </section>
</BaseLayout>
