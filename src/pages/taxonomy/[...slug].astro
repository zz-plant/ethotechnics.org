---
import TaxonomyEntryPage from "../../components/TaxonomyEntryPage.astro";
import { taxonomyEntries } from "../../content/taxonomy";

const entry = taxonomyEntries.find(
  (candidate) => candidate.slug === Astro.params.slug,
);
if (!entry) return new Response("Taxonomy entry not found", { status: 404 });
---

<TaxonomyEntryPage
  entry={entry}
  basePath="/taxonomy"
  titleSuffix=" taxonomy — Ethotechnics Institute"
/>
