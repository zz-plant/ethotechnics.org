---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { taxonomyEntries } from "../../content/taxonomy";

const pageTitle = "Taxonomy — Ethotechnics Institute";
const pageDescription =
  "Six domains, from governance to dependence, with the capabilities and practices under each and the artifacts filed there.";
const permalink = "/taxonomy";

const siteBase = Astro.site ? Astro.site.toString() : Astro.url.origin;
const canonicalUrl = Astro.site
  ? new URL(permalink, siteBase).toString()
  : permalink;

const topLevelEntries = taxonomyEntries.filter(
  (entry) => !entry.slug.includes("/"),
);

const childEntriesFor = (rootSlug: string) =>
  taxonomyEntries.filter(
    (entry) =>
      entry.slug.startsWith(`${rootSlug}/`) &&
      entry.slug.split("/").length === 2,
  );

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  hasPart: taxonomyEntries.map((entry) => ({
    "@type": "CreativeWork",
    name: entry.title,
    identifier: entry.id,
    url: Astro.site
      ? new URL(`/taxonomy/${entry.slug}`, siteBase).toString()
      : `/taxonomy/${entry.slug}`,
  })),
};
const structuredDataJson = JSON.stringify(structuredData);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="collection"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={structuredDataJson}
      is:inline
    />
  </Fragment>
  <PageIntro
    eyebrow="Taxonomy"
    title="Ethotechnics taxonomy"
    description={pageDescription}
    anchorLinks={[
      { href: "#domains", label: "Domains" },
      { href: "#use", label: "How to use" },
    ]}
    illustration="knowledge"
  />

  <SectionBlock
    id="domains"
    eyebrow="Domains"
    title="Start with the top-level domains"
    description="Each domain page lists its owner, its readiness, its related artifacts, and the capabilities under it."
  >
    <CardGrid className="grid--two">
      {
        topLevelEntries.map((entry) => {
          const childEntries = childEntriesFor(entry.slug);

          return (
            <CardItem
              title={entry.title}
              description={entry.summary}
              descriptionTone="default"
            >
              {childEntries.length > 0 && (
                <ul class="pill-list pill-list--wrap">
                  {childEntries.map((child) => (
                    <li>
                      <a href={`/taxonomy/${child.slug}`}>{child.title}</a>
                    </li>
                  ))}
                </ul>
              )}
              <div slot="footer" class="card__footer">
                <a
                  class="button ghost button--compact"
                  href={`/taxonomy/${entry.slug}`}
                >
                  Explore {entry.title.toLowerCase()}
                </a>
              </div>
            </CardItem>
          );
        })
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="use"
    eyebrow="How to use"
    title="Reading the taxonomy"
    description="Three levels: domain, capability, and practice. Every entry names an owner, a readiness state, and related artifacts."
    variant="alt"
  >
    <ol class="muted">
      <li>
        Start at a domain to see its capabilities and the artifacts filed under
        it.
      </li>
      <li>
        Open a capability or practice page for the narrower level and its
        related artifacts.
      </li>
      <li>
        Move between parent, sibling, and child levels from any entry page.
      </li>
    </ol>
  </SectionBlock>
</BaseLayout>
