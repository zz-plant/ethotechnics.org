---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import "../../styles/components/taxonomy.css";
import { taxonomyAnchor, taxonomyEntries } from "../../content/taxonomy";

const pageTitle = "Taxonomy — Ethotechnics Institute";
const pageDescription =
  "Twenty-two governance practices in six domains, each filed under the safeguards it serves, with the artifacts that apply.";
const permalink = "/taxonomy";

const siteBase = Astro.site ? Astro.site.toString() : Astro.url.origin;
const canonicalUrl = Astro.site
  ? new URL(permalink, siteBase).toString()
  : permalink;

const topLevelEntries = taxonomyEntries.filter(
  (entry) => !entry.slug.includes("/"),
);

// Everything under a domain, in file order: each capability followed by its
// practices, so a practice row sits directly beneath the capability it
// belongs to.
const branchFor = (rootSlug: string) =>
  taxonomyEntries.filter((entry) => entry.slug.startsWith(`${rootSlug}/`));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  hasPart: taxonomyEntries.map((entry) => ({
    "@type": "DefinedTerm",
    name: entry.title,
    description: entry.summary,
    identifier: entry.id,
    url: `${canonicalUrl}#${taxonomyAnchor(entry.slug)}`,
  })),
};
const structuredDataJson = JSON.stringify(structuredData);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="collection"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={structuredDataJson}
      is:inline
    />
  </Fragment>
  <PageIntro
    eyebrow="Taxonomy"
    title="Ethotechnics taxonomy"
    description={pageDescription}
    anchorLinks={topLevelEntries.map((entry) => ({
      href: `#${taxonomyAnchor(entry.slug)}`,
      label: entry.title,
    }))}
  >
    <Fragment slot="actions">
      <a class="button ghost" href="/method#state-variables"
        >Explore safeguards &rarr;</a
      >
      <a class="button ghost" href="/method#matrix">Safeguard matrix</a>
    </Fragment>
  </PageIntro>

  {
    topLevelEntries.map((domain, index) => (
      <SectionBlock
        id={taxonomyAnchor(domain.slug)}
        eyebrow="Domain"
        title={domain.title}
        description={domain.summary}
        variant={index % 2 === 0 ? "alt" : undefined}
      >
        <p class="taxonomy-domain__meta small">
          Serves {domain.safeguards.join(", ")}. Applies:{" "}
          {domain.relatedArtifacts.flatMap((artifact, artifactIndex) => [
            artifactIndex > 0 ? " · " : "",
            <a href={artifact.href}>{artifact.label}</a>,
          ])}
        </p>
        <div class="mapping-table__wrapper">
          <table class="mapping-table mapping-table--stack taxonomy-table">
            <thead>
              <tr>
                <th scope="col">Capability or practice</th>
                <th scope="col">What it covers</th>
                <th scope="col">Serves</th>
                <th scope="col">Standards and tools</th>
              </tr>
            </thead>
            <tbody>
              {branchFor(domain.slug).map((entry) => (
                <tr
                  id={taxonomyAnchor(entry.slug)}
                  class:list={[
                    "taxonomy-table__row",
                    `taxonomy-table__row--${entry.scope.toLowerCase()}`,
                  ]}
                >
                  <th scope="row">
                    <span class="taxonomy-table__scope">{entry.scope}</span>
                    <span class="taxonomy-table__title">{entry.title}</span>
                  </th>
                  <td data-label="What it covers">{entry.summary}</td>
                  <td data-label="Serves">{entry.safeguards.join(", ")}</td>
                  <td data-label="Standards and tools">
                    <ul class="taxonomy-table__links">
                      {entry.relatedArtifacts.map((artifact) => (
                        <li>
                          <a href={artifact.href}>{artifact.label}</a>
                        </li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </SectionBlock>
    ))
  }
</BaseLayout>
