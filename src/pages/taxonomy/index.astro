---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import "../../styles/components/taxonomy.css";
import { taxonomyAnchor, taxonomyEntries } from "../../content/taxonomy";

const pageTitle = "Governance practice taxonomy — Ethotechnics Institute";
const pageDescription =
  "Twenty-two governance practices in six domains, each filed under the safeguards it serves, with the standards, mechanisms, evals, and tools that apply.";
const permalink = "/taxonomy";

const pageUrl = new URL(permalink, Astro.site ?? Astro.url).toString();
const topLevelEntries = taxonomyEntries.filter(
  (entry) => !entry.slug.includes("/"),
);

// Everything under a domain, in file order: each capability followed by its
// practices, so a practice row sits directly beneath the capability it
// belongs to.
const branchFor = (rootSlug: string) =>
  taxonomyEntries.filter((entry) => entry.slug.startsWith(`${rootSlug}/`));

// The taxonomy is a classification scheme: one term per row, each at the
// anchor of its row or section.
const termSetId = `${pageUrl}#defined-term-set`;
const pageSchema = {
  page: { mainEntity: { "@id": termSetId } },
  nodes: [
    {
      "@type": "DefinedTermSet",
      "@id": termSetId,
      name: "Practice taxonomy",
      description: pageDescription,
      url: pageUrl,
      hasDefinedTerm: taxonomyEntries.map((entry) => ({
        "@type": "DefinedTerm",
        "@id": `${pageUrl}#${taxonomyAnchor(entry.slug)}`,
        name: entry.title,
        description: entry.summary,
        identifier: entry.id,
        url: `${pageUrl}#${taxonomyAnchor(entry.slug)}`,
      })),
    },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={pageSchema}>
  <PageIntro
    eyebrow="Taxonomy"
    title="Ethotechnics taxonomy"
    description={pageDescription}
    anchorLinks={topLevelEntries.map((entry) => ({
      href: `#${taxonomyAnchor(entry.slug)}`,
      label: entry.title,
    }))}
  >
    <Fragment slot="actions">
      <a class="button ghost" href="/method#state-variables"
        >Explore safeguards</a
      >
      <a class="button ghost" href="/method#matrix">Safeguard matrix</a>
    </Fragment>
  </PageIntro>

  {
    topLevelEntries.map((domain, index) => (
      <SectionBlock
        id={taxonomyAnchor(domain.slug)}
        eyebrow="Domain"
        title={domain.title}
        description={domain.summary}
        variant={index % 2 === 0 ? "alt" : undefined}
      >
        <p class="taxonomy-domain__meta small">
          Serves {domain.safeguards.join(", ")}. Applies:{" "}
          {domain.relatedArtifacts.flatMap((artifact, artifactIndex) => [
            artifactIndex > 0 ? " · " : "",
            <a href={artifact.href}>{artifact.label}</a>,
          ])}
        </p>
        <div
          class="mapping-table__wrapper"
          tabindex="0"
          role="region"
          aria-label={domain.title}
        >
          <table class="mapping-table mapping-table--stack taxonomy-table">
            <thead>
              <tr>
                <th scope="col">Capability or practice</th>
                <th scope="col">What it covers</th>
                <th scope="col">Serves</th>
                <th scope="col">Standards, mechanisms, and tools</th>
              </tr>
            </thead>
            <tbody>
              {branchFor(domain.slug).map((entry) => (
                <tr
                  id={taxonomyAnchor(entry.slug)}
                  class:list={[
                    "taxonomy-table__row",
                    `taxonomy-table__row--${entry.scope.toLowerCase()}`,
                  ]}
                >
                  <th scope="row">
                    <span class="taxonomy-table__scope">{entry.scope}</span>
                    <span class="taxonomy-table__title">{entry.title}</span>
                  </th>
                  <td data-label="What it covers">{entry.summary}</td>
                  <td data-label="Serves">{entry.safeguards.join(", ")}</td>
                  <td data-label="Standards, mechanisms, and tools">
                    <ul class="taxonomy-table__links">
                      {entry.relatedArtifacts.map((artifact) => (
                        <li>
                          <a href={artifact.href}>{artifact.label}</a>
                        </li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </SectionBlock>
    ))
  }
</BaseLayout>
