---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { governanceContent } from "../../content/governance";
import { formatDate } from "../../utils/dates";

const {
  pageTitle,
  pageDescription,
  anchorLinks,
  howChangesAreMade,
  failureLog,
} = governanceContent;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbItems={[
    { name: "Home", url: "/" },
    { name: "About", url: "/about" },
    { name: "Governance", url: "/institute/governance" },
  ]}
>
  <PageIntro
    eyebrow="About"
    title="Governance"
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  {
    /* Until 2026-11-17 this page opened on an RFC lifecycle, open RFCs, a
       decision log and governance updates. None of it described anything
       that happened; see FE-2026-06 in the failure archive below. */
  }
  <SectionBlock
    id="how-changes-are-made"
    eyebrow="Process"
    title="How a change is made"
    className="section--banded"
  >
    <CardGrid>
      {
        howChangesAreMade.map((rule) => (
          <CardItem title={rule.title} description={rule.detail} />
        ))
      }
    </CardGrid>
    <p class="muted small">
      <a href="https://github.com/zz-plant/ethotechnics.org/commits/main"
        >The repository's history</a
      >{" "}
      is the record of every change. <a href="/record"
        >Objections and their answers</a
      >{" "}
      are listed on their own page.
    </p>
  </SectionBlock>

  <SectionBlock
    id="failure-archive"
    eyebrow="Failure archive"
    title="Where this framework's own instruments failed"
    description="The framework asks institutions to be changed by evidence of their own inadequacy. The same record is kept of the framework itself: what failed, when it was detected, and what changed because of it. An empty archive would mean the instruments had never been wrong, which is a claim no instrument earns."
    className="section--banded"
  >
    <CardGrid>
      {
        failureLog.map((entry) => (
          <CardItem
            title={`${entry.id}: ${entry.title}`}
            meta={`Detected ${formatDate(entry.detected)}`}
            description={entry.detail}
          >
            <p class="muted small">
              <strong>Changed because of it:</strong> {entry.revision}
            </p>
          </CardItem>
        ))
      }
    </CardGrid>
    <p class="muted small">
      Reading institutions through their failure histories applies to the
      framework too: the archive is part of the evidence, and{" "}
      <a href="/participate">contestations of the framework</a> belong in it.
    </p>
  </SectionBlock>
</BaseLayout>
