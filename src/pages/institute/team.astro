---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
---

<BaseLayout
  title="Institute Team and Stewardship Roles — Ethotechnics"
  description="Meet the stewards, editors, and reviewers accountable for Ethotechnics standards, mechanisms, and validator governance."
  publishedTime="2026-02-21"
>
  <PageIntro
    eyebrow="Institute"
    title="Team"
    description={"The standards program is stewarded by a cross-disciplinary team of researchers, " +
      "designers, and policy practitioners."}
    anchorLinks={[{ href: "#stewards", label: "Stewards" }]}
  />

  <SectionBlock
    id="stewards"
    eyebrow="Stewards"
    title="Standards stewardship"
    description="Named stewards ensure every publication remains transparent and accountable."
  >
    <ul class="axiom-list">
      <li>
        <strong>Standards Editor-in-Chief:</strong> Coordinates ratification cycles.
      </li>
      <li>
        <strong>Mechanisms Lead:</strong> Maintains specification sheets and assets.
      </li>
      <li>
        <strong>Validators Lead:</strong> Audits validator scoring logic and thresholds.
      </li>
      <li>
        <strong>Doctrine Council:</strong> Oversees axioms, glossary, and compliance
        guidance.
      </li>
    </ul>
  </SectionBlock>
</BaseLayout>
