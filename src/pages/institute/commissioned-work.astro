---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import CommissionedWorkComparison from "../../components/CommissionedWorkComparison.astro";
import { commissionedWorkComparisonContent } from "../../content/comparison";
import {
  commissionedWork,
  commissionedWorkMailto,
} from "../../content/commissioned-work";
import { formatDate } from "../../utils/dates";

const { provider, disclosure } = commissionedWork;
const pageTitle = "Commissioned work";
const pageDescription = `When the Institute's open standards and diagnostics are enough, and when to commission ${provider}, ${disclosure}, to evaluate a healthcare AI system.`;
const anchorLinks = [
  { href: "#positioning", label: "Institute vs. commissioned work" },
  { href: "#self-serve", label: "Stay self-serve" },
  { href: "#offers", label: "What the work covers" },
  { href: "#boundaries", label: "Engagement boundaries" },
  { href: "#contact", label: "Contact" },
];
---

<BaseLayout
  title={`${pageTitle} — Ethotechnics Institute`}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
  modifiedTime="2026-10-13T00:00:00.000Z"
  breadcrumbItems={[
    { name: "Home", url: "/" },
    { name: "About", url: "/about" },
    { name: pageTitle, url: "/institute/commissioned-work" },
  ]}
>
  <PageIntro
    eyebrow="Institute"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="positioning"
    eyebrow="Positioning"
    title="Institute vs. commissioned work"
    description={`The Institute publishes the framework. ${provider} applies it to one organization's healthcare AI system under commission.`}
  >
    <CommissionedWorkComparison content={commissionedWorkComparisonContent} />
  </SectionBlock>

  <SectionBlock
    id="self-serve"
    eyebrow="Stay self-serve"
    title="Use the Institute when the answer is already in the library"
    description="Everything below is free to use and needs no engagement."
    variant="alt"
  >
    <ul class="muted">
      <li>Run a diagnostic and file the readout it returns.</li>
      <li>
        Find the standards and first check for your kind of system on
        <a href="/use-cases">which systems this is for</a>.
      </li>
      <li>
        Cite stable permalinks in memos, contracts, audits, or decision logs.
      </li>
      <li>
        Share draft standards internally before committing to delivery changes.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="offers"
    eyebrow="Commissioned work"
    title="What the work covers"
    description={`${commissionedWork.focus}, for ${commissionedWork.clients}.`}
  >
    <ul class="muted">
      {
        commissionedWork.offers.map((offer) => (
          <li>
            <strong>{offer.name}</strong> ({offer.format}). {offer.output}
          </li>
        ))
      }
    </ul>
    <p class="small muted">
      The formats are listed under
      <a href={commissionedWork.href} rel="noopener noreferrer" target="_blank"
        >{commissionedWork.linkLabel}</a
      >, checked {formatDate(commissionedWork.checked, "prose")}. No prices are
      published. Most of the work falls under the
      <a href="/use-cases#health-coverage">health coverage and care</a> context.
    </p>
  </SectionBlock>

  <SectionBlock
    id="boundaries"
    eyebrow="Boundaries"
    title="Engagements stay aligned to published standards"
    description="Engagements apply the public standard. They do not rewrite it, and they do not certify a system."
    variant="alt"
  >
    <ul class="muted">
      <li>
        An engagement cites the same standards and mechanisms published here.
      </li>
      <li>
        An evaluation states what {provider} found. Accountability for the system
        stays with the organization that runs it.
      </li>
      <li>No page on this site reports on an engagement.</li>
    </ul>
  </SectionBlock>

  <SectionBlock id="contact" eyebrow="Contact" title={`Contact ${provider}`}>
    <p class="muted">
      Email <a href={commissionedWorkMailto()}>{commissionedWork.email}</a>.
      Include the system, the decision it makes, and any diagnostic readout you
      already have.
    </p>
  </SectionBlock>
</BaseLayout>
