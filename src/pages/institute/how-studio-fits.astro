---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionActions from "../../components/SectionActions.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import InstituteStudioComparison from "../../components/InstituteStudioComparison.astro";
import StudioBadge from "../../components/StudioBadge.astro";
import { instituteStudioComparisonContent } from "../../content/comparison";
import { studio, studioMailto } from "../../content/studio";

const pageTitle = "How Studio fits";
const pageDescription =
  "When the Institute's open standards and diagnostics are enough, and when to commission Ethotechnics Studio to evaluate a healthcare AI system.";
const anchorLinks = [
  { href: "#positioning", label: "Institute vs Studio" },
  { href: "#self-serve", label: "Stay self-serve" },
  { href: "#offers", label: "What the Studio does" },
  { href: "#boundaries", label: "Engagement boundaries" },
  { href: "#contact", label: "Contact" },
];
---

<BaseLayout
  title={`${pageTitle} — Ethotechnics Institute`}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
  modifiedTime="2026-10-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Institute"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionActions>
    <StudioBadge />
  </SectionActions>

  <SectionBlock
    id="positioning"
    eyebrow="Positioning"
    title="Institute vs. Studio"
    description="The Institute publishes the framework. The Studio applies it to one organization's healthcare AI system under commission."
  >
    <InstituteStudioComparison content={instituteStudioComparisonContent} />
  </SectionBlock>

  <SectionBlock
    id="self-serve"
    eyebrow="Stay self-serve"
    title="Use the Institute when the answer is already in the library"
    description="Everything below is free to use and needs no engagement."
    variant="alt"
  >
    <ul class="muted">
      <li>Run a diagnostic and file the readout it returns.</li>
      <li>
        Find the standards and first check for your kind of system on
        <a href="/use-cases">which systems this is for</a>.
      </li>
      <li>
        Cite stable permalinks in memos, contracts, audits, or decision logs.
      </li>
      <li>
        Share draft standards internally before committing to delivery changes.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="offers"
    eyebrow="Commissioned work"
    title="What the Studio does"
    description={`${studio.focus}, for ${studio.clients}. As listed on ethotechnics.com on ${studio.checked}.`}
  >
    <ul class="muted">
      {
        studio.offers.map((offer) => (
          <li>
            <strong>{offer.name}</strong> ({offer.format}). {offer.output}
          </li>
        ))
      }
    </ul>
    <p class="small muted">
      Prices and current availability are on
      <a href={studio.href} rel="noopener noreferrer" target="_blank"
        >ethotechnics.com</a
      >. Most of the work falls under the
      <a href="/use-cases#health-coverage">health coverage and care</a> context.
    </p>
  </SectionBlock>

  <SectionBlock
    id="boundaries"
    eyebrow="Boundaries"
    title="Studio engagements stay aligned to published standards"
    description="Engagements apply the public standard. They do not rewrite it, and they do not certify a system."
    variant="alt"
  >
    <ul class="muted">
      <li>
        Studio engagements cite the same standards and mechanisms published
        here.
      </li>
      <li>
        An evaluation states what the Studio found. Accountability for the
        system stays with the organization that runs it.
      </li>
      <li>Outcomes feed back into public artifacts when possible.</li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="contact"
    eyebrow="Contact"
    title="Contact the Studio"
    description="Book a consultation on ethotechnics.com, or email the Studio."
  >
    <p class="muted">
      Email <a href={studioMailto()}>{studio.email}</a>. Include the system, the
      decision it makes, and any diagnostic readout you already have.
    </p>
  </SectionBlock>
</BaseLayout>
