    padding-bottom: var(--space-5);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  }

  .about-hero__layout {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 800px) {
    .about-hero__layout {
      grid-template-columns: 1fr auto;
      gap: var(--space-8);
    }
  }

  .about-hero__main {
    min-width: 0;
  }

  .about-hero__flourish {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .about-hero__logo {
    width: clamp(90px, 14vw, 150px);
    height: clamp(90px, 14vw, 150px);
    color: var(--accent);
    opacity: 0.85;
    filter: drop-shadow(
      0 4px 16px color-mix(in srgb, var(--accent) 15%, transparent)
