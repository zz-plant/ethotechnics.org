---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageIntro from "../../../components/PageIntro.astro";
import SectionBlock from "../../../components/SectionBlock.astro";
import UseCaseFit from "../../../components/UseCaseFit.astro";
import CardGrid from "../../../components/CardGrid.astro";
import CardItem from "../../../components/CardItem.astro";
import WorkedExampleTerms from "../../../components/WorkedExampleTerms.astro";

const pageTitle = "Irreversible payment with compensation — Worked example";
const pageDescription =
  "A payout that cannot be reversed. The receipt is issued before release and commits to 1-, 8-, and 48-hour clocks and to compensation if the payout was wrong.";

const receiptPayload = `{
  "schema_version": "1.0.0",
  "receipt_id": "RCP-2026-1362",
  "issued_at": "2026-06-19T16:21:33Z",
  "owner": { "name": "Payments Risk", "role": "System owner" },
  "subject": { "id": "txn-22098", "type": "payment" },
  "action": { "class": "TRANSFER", "description": "Release irreversible payout", "reversible": false },
  "decision": { "decision_type": "payout_release", "reason_codes": ["RISK-LOW"] },
  "clocks": { "ack": { "hours": 1 }, "review": { "hours": 8 }, "remedy": { "hours": 48 } },
  "appeal_path": { "url": "/appeals/payout", "channel": "in-app form" }
}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Worked example"
    title="Irreversible payment with compensation"
    description={pageDescription}
    anchorLinks={[
      { href: "#receipt", label: "Receipt" },
      { href: "#clocks", label: "Clocks and exceptions" },
      { href: "#remedy", label: "Remedy" },
      { href: "#fit", label: "Where this fits" },
    ]}
  />

  <SectionBlock
    id="receipt"
    eyebrow="Receipt"
    title="Receipt issued before release"
    description="An action that cannot be undone issues its receipt before it runs."
  >
    <pre class="code-block">{receiptPayload}</pre>
  </SectionBlock>

  {
    /* Exceptions had a section of their own after this one (49 words). Each
       is a hold the clocks keep running through, so they sit under the
       clocks. */
  }
  <SectionBlock
    id="clocks"
    eyebrow="Clocks"
    title="Short review windows, and exceptions that leave them running"
    description="Each clock states when review and remedy are due."
    variant="alt"
  >
    <CardGrid className="grid--three">
      <CardItem title="Ack clock" description="1 hour">
        <p class="muted">
          The owner acknowledges the payout and names the reviewer.
        </p>
      </CardItem>
      <CardItem title="Review clock" description="8 hours">
        <p class="muted">
          A person checks the payout for fraud, sanctions, or errors.
        </p>
      </CardItem>
      <CardItem title="Remedy clock" description="48 hours">
        <p class="muted">
          Compensation is paid, or a dispute starts to recover the money.
        </p>
      </CardItem>
    </CardGrid>
    <ul class="muted">
      <li>
        An AML or legal hold can pause the payout. It leaves the receipt and the
        clocks in place.
      </li>
      <li>
        A security escalation needs a steward's sign-off and leaves an audit
        record.
      </li>
      <li>
        Each exception is logged at once in the <a href="/standards/exceptions"
          >Exceptions framework</a
        >.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="remedy"
    eyebrow="Remedy"
    title="Compensation is the default fallback"
    description="A payout that cannot be undone must have a compensation path."
  >
    <ul class="muted">
      <li>Credits or chargebacks are issued within the remedy clock.</li>
      <li>
        A person can ask for a human review, which starts within 24 hours.
      </li>
      <li>Everyone affected is told, with a link to the evidence pack.</li>
      <li>
        Each payout later found wrong is counted against the rule that cleared
        it, here RISK-LOW. The count goes to Payments Risk, which owns the rule.
        When the count passes a set number, it reviews the rule and records what
        changed.
      </li>
    </ul>
  </SectionBlock>

  <UseCaseFit slug="irreversible-payment-compensation">
    <p class="small">
      Payout checks run at each release gate. Each payout receipt carries its
      <a href="/evidence-packs">evidence pack</a> and links to its
      <a href="/mechanisms/patterns/decision-log">decision log</a> entry. Together
      they give an auditor the record of each payout.
    </p>
    <WorkedExampleTerms />
  </UseCaseFit>
</BaseLayout>
