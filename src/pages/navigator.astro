---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import SectionBlock from "../components/SectionBlock.astro";
import CircuitNavigator from "../components/CircuitNavigator.astro";
import ChainDiagram from "../components/ChainDiagram.astro";
import SafeguardEquilibriumDiagram from "../components/SafeguardEquilibriumDiagram.astro";
import SafeguardMatrix from "../components/SafeguardMatrix.astro";
import MethodStack from "../components/MethodStack.astro";

const pageTitle = "Concept navigator — Ethotechnics Institute";
const pageDescription =
  "Diagrams of the Ethotechnics method, with links to its safeguards, standards, scored cases, and diagnostic tools.";

const anchorLinks = [
  { href: "#circuits", label: "The two circuits" },
  { href: "#chain", label: "The seven-stage chain" },
  { href: "#safeguards", label: "The six safeguards" },
  { href: "#matrix", label: "Safeguard matrix" },
  { href: "#stack", label: "How the parts fit" },
  { href: "#roles", label: "By role" },
];

const roles = [
  {
    role: "The person decided about",
    exposure:
      "May lose access, income, or an opportunity because of an automated decision.",
    right:
      "A route to challenge the decision, obtain reasons, and receive a response.",
    entryStandard: "STD-02 Contestability & Recourse",
    href: "/standards/std-02-contestability-recourse",
  },
  {
    role: "The frontline operator",
    exposure:
      "Repairs errors or handles exceptions that the system’s reports may not count.",
    right: "A tested route to stop or correct the action without penalty.",
    entryStandard: "STD-06 Human Impact Safety Case",
    href: "/standards/std-06-human-impact-safety-case",
  },
  {
    role: "The risk owner",
    exposure:
      "Sets the limits on what the workflow may do and reviews whether those limits still hold.",
    right: "Expiring authority leases with review triggers.",
    entryStandard: "STD-08 Delegation",
    href: "/standards/std-08-delegation",
  },
  {
    role: "The independent regulator",
    exposure:
      "Needs to distinguish system performance from the work people do to repair its errors.",
    right: "Inspectable decision records, including reasons and objections.",
    entryStandard: "STD-07 Revisable Delegation Record",
    href: "/standards/std-07-revisable-delegation-record",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="webpage"
  publishedTime="2026-10-02T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Navigator"
    title="A visual guide to the method"
    description={pageDescription}
    anchorLinks={anchorLinks}
  >
    <Fragment slot="actions">
      <a class="button primary" href="/method">Read the method</a>
      <a class="button ghost" href="/standards">Open the standards</a>
      <a class="button ghost" href="/diagnostics">Run diagnostics</a>
    </Fragment>
  </PageIntro>

  <SectionBlock
    id="circuits"
    eyebrow="Error and correction"
    title="The two circuits"
    description="The closed circuit shows people repairing errors while the system reports success. The open circuit gives their evidence a route to someone who can change the rule."
  >
    <CircuitNavigator />
  </SectionBlock>

  <SectionBlock
    id="chain"
    eyebrow="Decision lifecycle"
    title="The seven-stage chain"
    description="The method follows a decision from evidence through correction. Reconsideration returns to the authority for the decision; correction changes the evidence used next time."
    variant="alt"
  >
    <ChainDiagram />
  </SectionBlock>

  <SectionBlock
    id="safeguards"
    eyebrow="Safeguards"
    title="The six safeguards"
    description="Check what the system can do, what it is permitted to do, and whether people can challenge and correct its decisions. The diagram shows how the six safeguards depend on one another."
  >
    <SafeguardEquilibriumDiagram />
  </SectionBlock>

  <SectionBlock
    id="matrix"
    eyebrow="Reference map"
    title="The safeguard matrix"
    description="Compare the laws, standards, scored cases, essays, and tools associated with each safeguard."
    variant="alt"
  >
    <SafeguardMatrix />
  </SectionBlock>

  <SectionBlock
    id="stack"
    eyebrow="Method structure"
    title="How the parts fit together"
    description="Select a concept to follow its links through the theory, standards, mechanisms, and evidence. Each layer specifies a different part of the method."
  >
    <MethodStack />
  </SectionBlock>

  <SectionBlock
    id="roles"
    eyebrow="Responsibilities"
    title="Navigate by role"
    description="Choose a role to see the decisions it faces and the standard to read first."
  >
    <div class="grid grid--two">
      {
        roles.map((r) => (
          <div class="card stack-sm">
            <p class="eyebrow">{r.role}</p>
            <p>
              <strong>Exposure:</strong> {r.exposure}
            </p>
            <p class="muted">
              <strong>Requirement:</strong> {r.right}
            </p>
            <p class="small">
              <a href={r.href}>{r.entryStandard} &rarr;</a>
            </p>
          </div>
        ))
      }
    </div>
  </SectionBlock>
</BaseLayout>
