---
import "../../styles/components/diagnostics.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import DiagnosticRouterDiagram from "../../components/DiagnosticRouterDiagram.astro";
import { diagnosticsContent } from "../../content/diagnostics";

const {
  pageTitle,
  pageDescription,
  permalink,
  tools,
  valueProps,
  facilitation,
  publication,
} = diagnosticsContent;
const anchorLinks = [
  { href: "#quick-triage", label: "Choose a tool" },
  { href: "#output-baseline", label: "What every output includes" },
  { href: "#how-it-works", label: "Facilitated sessions" },
  { href: "#self-defense-tools", label: "Self-defense checks" },
  { href: "#diagnostic-tools", label: "All tools" },
  { href: "#referenced-by", label: "Where diagnostics are cited" },
];
const introDescription =
  "For operators, governance teams, and auditors. " + pageDescription;
const quickTriagePrompts = [
  {
    question: "Is workload concentrating on a few people or steps?",
    description: "Score task load and rank where relief would help most.",
    href: "/diagnostics/burden-modeler",
    label: "Run Burden Modeler",
  },
  {
    question: "Are you rehearsing outage coverage or escalation ownership?",
    description:
      "Run the outage and maintenance branches and list who owns each step.",
    href: "/diagnostics/maintenance-simulator",
    label: "Run Maintenance Simulator",
  },
  {
    question: "Are you modeling capacity decay or saturation risk over time?",
    description:
      "Project capacity decay over 24 months and when remediation has to start.",
    href: "/diagnostics/capacity-forecaster",
    label: "Run Capacity Forecaster",
  },
];
const selfDefenseTools = [
  {
    title: "Is this system governable?",
    description:
      "Seven yes/no checks on whether the decision can be contested.",
    href: "/diagnostics/self-defense-tools#governable",
    label: "Run governability diagnostic",
  },
  {
    title: "Is this appeal real?",
    description:
      "Checks whether an appeal can change the outcome or only records it.",
    href: "/diagnostics/self-defense-tools#appeal-real",
    label: "Run appeal diagnostic",
  },
  {
    title: "Who holds power?",
    description: "Lists the people and levers that can reverse the outcome.",
    href: "/diagnostics/self-defense-tools#power-map",
    label: "Map power",
  },
];
const mostUsedToolSlugs = [
  "system-auditor",
  "burden-modeler",
  "capacity-forecaster",
  "maintenance-simulator",
  "maintenance-debt-calculator",
];
const mostUsedTools = mostUsedToolSlugs
  .map((slug) => tools.find((tool) => tool.slug === slug))
  .filter((tool): tool is (typeof tools)[number] => Boolean(tool));
const comparisonTools = mostUsedTools.slice(0, 3);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="collection"
>
  <div data-route-metrics="home-to-diagnostics" hidden></div>
  <PageIntro
    eyebrow="Diagnostics"
    title="Diagnostics"
    description={introDescription}
    anchorLinks={anchorLinks}
    anchorLinksSummary="More anchors"
    illustration="diagnostics"
  />
  <SectionBlock
    id="quick-triage"
    eyebrow="Triage"
    title="Three questions that route to a tool"
    description="Each question points to one diagnostic. The most-run tools follow."
    variant="alt"
  >
    <div class="panel stack-sm">
      <p class="eyebrow">Sequence</p>
      <ol class="muted">
        <li>
          Pick the question below that matches the decision in front of you.
        </li>
        <li>
          Compare two candidate tools on delivery mode, prep, and outputs.
        </li>
        <li>Run one diagnostic and send the readout link to the owners.</li>
      </ol>
    </div>
    <CardGrid className="grid--three">
      {
        quickTriagePrompts.map((prompt) => (
          <CardItem
            title={prompt.question}
            description={prompt.description}
            descriptionTone="default"
          >
            <a slot="footer" class="muted" href={prompt.href}>
              {prompt.label}
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
    <DiagnosticRouterDiagram />
    <div class="pattern-filter__anchors" aria-hidden="true">
      <span class="pattern-filter__anchor" id="most-used"></span>
    </div>
    <h3>The diagnostics run most often</h3>
    <p class="muted">If no question above fits, start with one of these.</p>
    <CardGrid className="grid--three">
      {
        mostUsedTools.map((tool) => (
          <CardItem
            meta={tool.tier}
            title={tool.title}
            description={tool.description}
            descriptionTone="default"
          >
            <p class="muted small">Best for: {tool.bestFor}</p>
            <a slot="footer" class="muted" href={tool.ctaHref}>
              {tool.ctaLabel}
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="output-baseline"
    eyebrow="What you get"
    title="What every diagnostic output includes"
    description="Every output carries the same baseline and passes the same anti-weaponization checks."
  >
    <CardGrid>
      {
        valueProps.map((item) => (
          <CardItem title={item.title} description={item.description} />
        ))
      }
    </CardGrid>

    <div class="grid grid--two" style="margin-top: 1.5rem;">
      <div class="panel stack-sm">
        <p class="eyebrow">Deliverable baseline</p>
        <ul class="muted small">
          <li>Linkable results page and a shareable PDF summary.</li>
          <li>References to the mechanisms each mitigation comes from.</li>
          <li>Facilitated follow-up when the question or risk stays unclear.</li>
        </ul>
        <p class="muted small">
          Before publishing an output about appeals or reversals, run the{" "}
          <a href="/explainers/contestability-checklist">contestability checklist</a>{" "}
          against the appeal path it describes.
        </p>
      </div>

      <div class="panel stack-sm" id="anti-weaponization">
        <p class="eyebrow">Anti-weaponization verification</p>
        <ul class="muted small">
          <li><strong>AW-01:</strong> Burden metrics include a remediation plan and staffing allocation.</li>
          <li><strong>AW-02:</strong> Appeal paths are tested for non-regression and public replacement windows.</li>
          <li><strong>AW-03:</strong> Downgrades or eligibility changes always emit receipts and clocks.</li>
          <li><strong>AW-04:</strong> High-burden flows include assisted channels or human escalation.</li>
        </ul>
        <p class="muted small">
          Reference: <a href="/anti-weaponization">Anti-weaponization constraints</a> and the <a href="/evidence-packs/std-02#anti-weaponization">evidence requirements</a>.
        </p>
      </div>
    </div>
  </SectionBlock>

  <SectionBlock
    id="how-it-works"
    eyebrow="Facilitated sessions"
    title={facilitation.title}
    description={facilitation.description}
    variant="alt"
  >
    <ol class="diagnostics__process">
      {
        facilitation.steps.map((step) => (
          <li class="diagnostics__process-step">
            <p class="eyebrow">{step.title}</p>
            <p class="muted">{step.detail}</p>
          </li>
        ))
      }
    </ol>
    <p class="muted diagnostics__footnote">{facilitation.note}</p>
  </SectionBlock>

  <SectionBlock
    id="self-defense-tools"
    eyebrow="Self-defense diagnostics"
    title="Short checks for appeal, governability, and power"
    description="Three checks for the person on the receiving end of a decision, to run before escalating."
  >
    <CardGrid className="grid--three">
      {
        selfDefenseTools.map((tool) => (
          <CardItem
            title={tool.title}
            description={tool.description}
            descriptionTone="default"
          >
            <a slot="footer" class="muted" href={tool.href}>
              {tool.label}
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="diagnostic-tools"
    eyebrow="Diagnostics menu"
    title="All diagnostics"
    description="Every diagnostic returns a linkable result and cites the mechanisms behind its recommendations."
  >
    <div class="diagnostics__comparison" aria-label="Diagnostic comparison">
      <p class="muted small">Compare three tools</p>
      <div class="diagnostics__comparison-grid">
        {
          comparisonTools.map((tool) => (
            <article class="panel diagnostics__comparison-card">
              <h3>{tool.title}</h3>
              <dl class="diagnostics__comparison-meta muted small">
                <div>
                  <dt>Time</dt>
                  <dd>{tool.estimatedTime}</dd>
                </div>
                <div>
                  <dt>Effort</dt>
                  <dd>
                    {tool.deliveryType === "studio"
                      ? "Studio-facilitated"
                      : "Self-serve"}
                  </dd>
                </div>
                <div>
                  <dt>Output</dt>
                  <dd>{tool.outputs[0]}</dd>
                </div>
              </dl>
              <a class="button ghost" href={tool.ctaHref}>
                {tool.ctaLabel}
              </a>
            </article>
          ))
        }
      </div>
    </div>
    <div class="diagnostics__filters" data-diagnostics-filters>
      <p class="muted">Filter by delivery type</p>
      <p class="muted small">Jump to a tool</p>
      <ul
        class="pill-list pill-list--wrap"
        aria-label="Diagnostic intent shortcuts"
      >
        <li>
          <a class="pill-list__button" href="/diagnostics/burden-modeler"
            >Burden modeling</a
          >
        </li>
        <li>
          <a class="pill-list__button" href="/diagnostics/system-auditor"
            >System audit</a
          >
        </li>
        <li>
          <a class="pill-list__button" href="/diagnostics/maintenance-simulator"
            >Outage simulation</a
          >
        </li>
      </ul>
      <ul
        class="pill-list pill-list--wrap"
        role="group"
        aria-label="Diagnostic delivery filters"
      >
        <li class="pill-list__item pill-list__item--active">
          <button
            class="pill-list__button"
            type="button"
            data-delivery-filter="all"
            aria-pressed="true"
          >
            All diagnostics
          </button>
        </li>
        <li class="pill-list__item">
          <button
            class="pill-list__button"
            type="button"
            data-delivery-filter="self-serve"
            aria-pressed="false"
          >
            Self-serve
          </button>
        </li>
        <li class="pill-list__item">
          <button
            class="pill-list__button"
            type="button"
            data-delivery-filter="studio"
            aria-pressed="false"
          >
            Studio-facilitated
          </button>
        </li>
      </ul>
      <p class="muted small" data-delivery-status>Showing all diagnostics.</p>
    </div>
    <CardGrid className="diagnostics__tool-grid" data-diagnostics-grid>
      {
        tools.map((tool) => {
          const isStudio = tool.deliveryType === "studio";
          const deliveryLabel = isStudio
            ? "Studio-facilitated session"
            : "Self-serve tool";
          const deliveryDetail = isStudio
            ? "Runs only in a facilitated session. Request one to use it."
            : "Runs in the browser and returns a linkable readout.";
          const primaryCtaLabel = tool.ctaLabel;

          return (
            <CardItem
              id={tool.slug}
              eyebrow="Diagnostic tool"
              title={tool.title}
              description={tool.description}
              headingLevel="h2"
              dataDelivery={tool.deliveryType}
            >
              <div class="diagnostics__card-body">
                <div>
                  <p class="muted small">
                    <strong>{deliveryLabel}</strong> · Estimated time: {tool.estimatedTime}
                  </p>
                  <p class="muted small">{deliveryDetail}</p>
                </div>
                <div class="diagnostics__output-box">
                  <span class="eyebrow">Deliverable artifact</span>
                  <p class="small"><strong>{tool.outputs.join(" · ")}</strong></p>
                </div>
                <p class="muted small">
                  <strong>When to use:</strong> {tool.bestFor}
                </p>
                <p class="muted small">
                  <strong>When to skip:</strong>{" "}
                  {isStudio
                    ? "Pick a self-serve diagnostic if you need the output today without a session."
                    : "Pick a facilitated diagnostic when nobody can say who owns the decision or what it is."}
                </p>
              </div>
              <div class="diagnostics__card-footer">
                <a
                  class="button primary"
                  href={tool.ctaHref}
                  aria-label={tool.ctaAriaLabel ?? primaryCtaLabel}
                >
                  {primaryCtaLabel}
                </a>
                <a class="diagnostics__method-link" href={`/diagnostics/${tool.slug}`}>
                  Method details &amp; examples &rarr;
                </a>
              </div>
            </CardItem>
          );
        })
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="referenced-by"
    eyebrow="Referenced by"
    title="Where diagnostics connect to enforcement"
    description="The examples, bindings, and evidence packs that cite a diagnostic output."
    variant="alt"
  >
    <div class="grid grid--three">
      <div class="panel">
        <p class="eyebrow">Used in examples</p>
        <ul class="muted">
          <li>
            <a href="/examples/automated-account-lock">Automated account lock</a
            >
          </li>
          <li>
            <a href="/examples/content-moderation-takedown"
              >Content moderation takedown</a
            >
          </li>
          <li>
            <a href="/examples/fraud-hold-delayed-notice"
              >Fraud hold with delayed notice</a
            >
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Required by bindings</p>
        <ul class="muted">
          <li>
            <a href="/incidents">Incident triggers</a>
          </li>
          <li>
            <a href="/evidence-packs">Release gate checklist</a>
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Verified by evidence packs</p>
        <ul class="muted">
          <li>
            <a href="/evidence-packs/std-01">STD-01 Evidence Pack</a>
          </li>
          <li>
            <a href="/evidence-packs/std-02">STD-02 Evidence Pack</a>
          </li>
          <li>
            <a href="/validators">Validators (VAL-01–VAL-03)</a>
          </li>
        </ul>
      </div>
    </div>
    <p class="muted">
      Toolkit:
      {" "}
      <a href="/agent-toolkit#prompts">Agent Prompt & Clause Packs</a>
      {" "}
      for stakeholder summaries, audit prompts, and procurement follow-through.
    </p>
    <p class="muted">
      Search IDs: AW-01, AW-02, AW-03, AW-04, VAL-01, VAL-02, VAL-03,
      STD-02.2.1, STD-02.3.1.
    </p>
  </SectionBlock>

  <section
    class="cta stack-md"
    aria-label="Commercial advisory and custom audits"
  >
    <div class="stack-sm">
      <p class="eyebrow">Ethotechnics Studio</p>
      <h2>Custom risk modeling and commissioned diligence</h2>
      <p class="muted">
        Ethotechnics Studio runs clinical AI safety evaluations, VC portfolio
        diligence, custom governance tooling, and independent audit
        verification.
      </p>
    </div>
    <div class="actions">
      <a
        class="button primary"
        href="https://ethotechnics.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        Engage Ethotechnics Studio →
      </a>
      <a class="button ghost" href="/participate">
        Submit community feedback
      </a>
    </div>
  </section>

  <section id="scorecards" class="section">
    <div class="section__header">
      <p class="eyebrow">Scorecards</p>
      <h2>Instruments that take numbers rather than a workflow</h2>
      <p class="muted">
        These three ask for figures you already have and return a score you can
        argue with.
      </p>
    </div>
    <ul class="card__list">
      <li>
        <a href="/audit">Ethics audit scorecard</a> — score a system against the framework's
        own criteria and see where the gaps are.
      </li>
      <li>
        <a href="/diagnostics/governance-gap-score">Governance gap score</a> — the
        distance between the governance a system has and the governance its risk implies.
      </li>
      <li>
        <a href="/diagnostics/burden-budget-worksheet"
          >Burden budget worksheet</a
        > — make the ceiling on imposed burden explicit before it is exceeded.
      </li>
    </ul>
  </section>

  <CitationBlock
    title={pageTitle}
    permalink={permalink}
    publication={publication}
    variant="compact"
  />

  <script>
    import "../../scripts/diagnostics-sticky-nav.ts";
  </script>

  <script>
    import "../../scripts/diagnostics-filter.ts";
    import "../../scripts/route-metrics.ts";
  </script>
</BaseLayout>
