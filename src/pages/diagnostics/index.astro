---
import "../../styles/components/diagnostics.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import SearchIds from "../../components/SearchIds.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { diagnosticsContent } from "../../content/diagnostics";
import { studioSummary } from "../../content/studio";
import { standardLink } from "../../content/use-cases";

const {
  pageTitle,
  pageDescription,
  permalink,
  tools,
  valueProps,
  facilitation,
  publication,
} = diagnosticsContent;
// The four tool cards sit directly under the intro, so the outline starts
// with the sections below them.
const anchorLinks = [
  { href: "#self-defense-tools", label: "If a system decided about you" },
  { href: "#output-baseline", label: "What every output includes" },
  { href: "#how-it-works", label: "Facilitated sessions" },
];
const introDescription =
  "For operators, governance teams, and auditors. Three of the four tools score what you enter about a workflow. The Record Conformance Checker grades the records a system exports.";
// The page's one list of tools. Each card is a single link to the tool; the
// card id keeps the /diagnostics#<slug> links from other pages working.
const quickTriagePrompts = [
  {
    slug: "burden-modeler",
    question: "Is workload concentrating on a few people or steps?",
    description:
      "Rate seven sources of workload with the team and see where it concentrates.",
  },
  {
    slug: "delegation-audit",
    question: "Is the system still justified in making this decision?",
    description:
      "Take one workflow through six questions and list the permissions nobody on your team can justify.",
  },
  {
    slug: "record-conformance",
    question: "Do your decision records meet the level you claim?",
    description:
      "Check the records a system exports against the published schema, and recompute the hash chain that links them.",
  },
  {
    slug: "corrective-debt-calculator",
    question: "Can the institution correct what it can decide?",
    description:
      "Answer five questions about how the system has grown and how the institution fixes its mistakes.",
  },
];
const toolCards = quickTriagePrompts.flatMap((prompt) => {
  const tool = tools.find((entry) => entry.slug === prompt.slug);
  if (!tool) {
    return [];
  }
  return [
    {
      ...prompt,
      href: tool.ctaHref,
      label: tool.ctaLabel,
      meta: [tool.tier, tool.estimatedTime].filter(Boolean).join(" · "),
    },
  ];
});
// Carried over from the decision-tree figure that used to sit beside the
// cards: the symptom each tool answers and the standard and law it reports
// against. Both render as links, since the page introduces neither.
const standardsMap = [
  {
    tool: "Workload Modeler",
    symptom:
      "Staff absorb the system's errors where nobody counts them: burnout, manual overrides, hours spent on workarounds.",
    output: "Burden score and where the load concentrates",
    standard: "STD-02",
    law: "IV",
  },
  {
    tool: "Delegation Audit",
    symptom:
      "Nobody clearly owns an outage, and nobody has rehearsed the fallback.",
    output: "Permissions nobody can justify",
    standard: "STD-08",
    law: "VI",
  },
  {
    tool: "Corrective capacity self-assessment",
    symptom:
      "The institution can fix fewer of its mistakes each year, and the system gets harder to back out of.",
    output: "Self-reported concern score",
    standard: "STD-08",
    law: "IV",
  },
  {
    tool: "Record Conformance Checker",
    symptom:
      "The records do not show who authorized each action, or whether a person can contest it.",
    output: "Conformance level the records earn",
    standard: "STD-07",
    law: "VII",
  },
].map((row) => ({
  ...row,
  standardLink: standardLink(row.standard),
  lawHref: `/standards/laws#law-${row.law.toLowerCase()}`,
}));
const selfDefenseTools = [
  {
    title: "Can this decision be challenged?",
    description:
      "Seven yes/no checks on whether you can challenge the decision.",
    href: "/diagnostics/self-defense-tools#governable",
    label: "Check the decision",
  },
  {
    title: "Can this appeal change the outcome?",
    description:
      "Checks whether an appeal can change the outcome or only records it.",
    href: "/diagnostics/self-defense-tools#appeal-real",
    label: "Check the appeal",
  },
  {
    title: "Who holds power?",
    description: "Lists the people and levers that can reverse the outcome.",
    href: "/diagnostics/self-defense-tools#power-map",
    label: "Find who can reverse it",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="collection"
>
  <div data-route-metrics="home-to-diagnostics" hidden></div>
  <PageIntro
    eyebrow="Diagnostics"
    title="Diagnostics"
    description={introDescription}
    anchorLinks={anchorLinks}
    anchorLinksSummary="More anchors"
  >
    <Fragment slot="actions">
      <a class="button ghost" href="/use-cases">Which tool for your system</a>
    </Fragment>
  </PageIntro>

  <section
    id="quick-triage"
    class="section diagnostics-start"
    aria-labelledby="quick-triage-title"
  >
    <h2 id="quick-triage-title" class="sr-only">
      Four questions, one tool each
    </h2>
    <ul class="diagnostics-start__grid">
      {
        toolCards.map((card) => (
          <li id={card.slug} class="diagnostics-start__card">
            {card.meta && <p class="diagnostics-start__meta">{card.meta}</p>}
            <h3 class="diagnostics-start__question">{card.question}</h3>
            <p class="diagnostics-start__description">{card.description}</p>
            <a class="diagnostics-start__link" href={card.href}>
              {card.label}
              <span aria-hidden="true"> &rarr;</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <SectionBlock
    id="self-defense-tools"
    eyebrow="If a system decided about you"
    title="Short checks: can you challenge it, can the appeal work, who can reverse it"
    description="Three checks for the person on the receiving end of a decision, to run before escalating."
  >
    {
      /* An "orientation" block above the tools used to address this reader
         and the operations manager in two panels, each linking tools the
         page lists again below. Its one fact of its own stays here. */
    }
    <p class="small muted">
      Ethotechnics is an open standards body, not a legal clinic. It does not
      take cases. Where you are and what was decided may already entitle you to
      the reasons, a review by a person, or a decision by a deadline; the
      standards on this site are drafts and have no legal force.
      <a href="/diagnostics/self-defense-tools#your-rights"
        >What you can ask for now</a
      >, and <a href="/explainers/language-people-can-use"
        >questions to send about the decision</a
      >.
    </p>
    <CardGrid className="grid--three">
      {
        selfDefenseTools.map((tool) => (
          <CardItem
            title={tool.title}
            description={tool.description}
            descriptionTone="default"
          >
            <a slot="footer" class="muted" href={tool.href}>
              {tool.label} &rarr;
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <details class="diagnostics-map" id="standards-map">
    <summary>How the tools map to standards</summary>
    <ul class="diagnostics-map__list">
      {
        standardsMap.map((row) => (
          <li>
            <p class="diagnostics-map__tool">{row.tool}</p>
            <dl class="diagnostics-map__facts muted small">
              <div>
                <dt>Symptom</dt>
                <dd>{row.symptom}</dd>
              </div>
              <div>
                <dt>Output</dt>
                <dd>{row.output}</dd>
              </div>
              <div>
                <dt>Standard</dt>
                <dd>
                  <a href={row.standardLink.href}>{row.standardLink.label}</a>
                  {" · "}
                  <a href={row.lawHref}>Law {row.law}</a>
                </dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ul>
  </details>

  <SectionBlock
    id="output-baseline"
    eyebrow="What you get"
    title="What every diagnostic output includes"
    description="Every output carries the same baseline and passes the same four checks against being used to cut access or raise burdens."
  >
    <CardGrid>
      {
        valueProps.map((item) => (
          <CardItem title={item.title} description={item.description} />
        ))
      }
    </CardGrid>

    <div class="grid grid--two" style="margin-top: var(--space-5);">
      <div class="panel stack-sm">
        <p class="eyebrow">Deliverable baseline</p>
        <ul class="muted small">
          <li>
            Results you can copy, link to, or export, depending on the tool.
          </li>
          <li>References to the mechanisms each mitigation comes from.</li>
          <li>
            Facilitated follow-up when the question or risk stays unclear.
          </li>
        </ul>
        <p class="muted small">
          Before publishing an output about appeals or reversals, run the{" "}
          <a href="/explainers/contestability-checklist"
            >contestability checklist</a
          >{" "}
          against the appeal path it describes.
        </p>
      </div>

      <div class="panel stack-sm" id="anti-weaponization">
        <p class="eyebrow">Checks against misuse</p>
        <p class="muted small">
          Four constraints keep a diagnostic output from being used to deny
          care, reduce access, or raise burdens.
        </p>
        <ul class="muted small">
          <li>
            <strong>AW-01:</strong> Burden metrics include a remediation plan and
            staffing allocation.
          </li>
          <li>
            <strong>AW-02:</strong> No appeal path is removed or weakened without
            a published replacement and a review window.
          </li>
          <li>
            <strong>AW-03:</strong> A cut to access or eligibility always comes with
            a receipt and a deadline for remedy.
          </li>
          <li>
            <strong>AW-04:</strong> High-burden flows include assisted channels or
            human escalation.
          </li>
        </ul>
        <p class="muted small">
          Reference: <a href="/standards/anti-weaponization"
            >Anti-weaponization constraints</a
          > and the <a href="/evidence-packs/std-02#anti-weaponization"
            >evidence requirements</a
          >.
        </p>
      </div>
    </div>
  </SectionBlock>

  <SectionBlock
    id="how-it-works"
    eyebrow="Facilitated sessions"
    title={facilitation.title}
    description={facilitation.description}
  >
    <ol class="diagnostics__process">
      {
        facilitation.steps.map((step) => (
          <li class="diagnostics__process-step">
            <p class="eyebrow">{step.title}</p>
            <p class="muted">{step.detail}</p>
          </li>
        ))
      }
    </ol>
    <p class="muted diagnostics__footnote">{facilitation.note}</p>
  </SectionBlock>

  {/* IDs a site search should match to this page. */}
  <SearchIds
    ids={[
      "AW-01",
      "AW-02",
      "AW-03",
      "AW-04",
      "VAL-01",
      "VAL-02",
      "VAL-03",
      "STD-02.2.1",
      "STD-02.3.1",
    ]}
  />

  <section
    class="cta stack-md"
    aria-label="Commissioned evaluation by Ethotechnics Studio"
  >
    <div class="stack-sm">
      <p class="eyebrow">Ethotechnics Studio</p>
      <h2>Commissioned evaluation of healthcare AI</h2>
      <p class="muted">{studioSummary}</p>
    </div>
    <div class="actions">
      <a
        class="button primary"
        href="https://ethotechnics.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit Ethotechnics Studio
      </a>
      <a class="button ghost" href="/participate">
        Submit community feedback
      </a>
    </div>
  </section>

  <section id="scorecards" class="section">
    <div class="section__header">
      <p class="eyebrow">Worksheet</p>
      <h2>An instrument that takes numbers rather than a workflow</h2>
      <p class="muted">
        It asks for figures you already have and returns a ceiling you can argue
        with.
      </p>
    </div>
    <ul class="card__list">
      <li>
        <a href="/diagnostics/burden-budget-worksheet"
          >Burden budget worksheet</a
        > — make the ceiling on imposed burden explicit before it is exceeded.
      </li>
    </ul>
  </section>

  <CitationBlock
    title={pageTitle}
    permalink={permalink}
    publication={publication}
    variant="compact"
  />

  <script>
    import "../../client/diagnostics-sticky-nav.ts";
  </script>

  <script>
    import "../../client/route-metrics.ts";
  </script>
  <p class="muted">
    <a href="/archive/retired-tools"
      >Retired tools and historical source &rarr;</a
    >
  </p>
</BaseLayout>
