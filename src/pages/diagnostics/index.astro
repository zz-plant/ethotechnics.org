---
import "../../styles/components/diagnostics.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import CitationBlock from "../../components/CitationBlock.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionActions from "../../components/SectionActions.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import StudioBadge from "../../components/StudioBadge.astro";
import SummaryCallout from "../../components/SummaryCallout.astro";
import { diagnosticsContent } from "../../content/diagnostics";
import diagnosticsFilterScript from "../../scripts/diagnostics-filter.ts?url";
import routeMetricsScript from "../../scripts/route-metrics.ts?url";

const {
  pageTitle,
  pageDescription,
  permalink,
  tools,
  valueProps,
  facilitation,
  publication,
} = diagnosticsContent;
const anchorLinks = [
  { href: "#most-used", label: "Start with most-used tools" },
  { href: "#why-diagnostics", label: "See what you get" },
  { href: "#output-baseline", label: "Review output baseline" },
  { href: "#anti-weaponization", label: "Verify anti-weaponization checks" },
  { href: "#quick-triage", label: "Choose a tool in 30 seconds" },
  { href: "#how-it-works", label: "Understand session flow" },
  { href: "#self-defense-tools", label: "Run self-defense checks" },
  { href: "#diagnostic-tools", label: "Open full tools menu" },
  { href: "#referenced-by", label: "See linked references" },
];
const introDescription =
  "This page is for operators, governance teams, and auditors who need decision-ready diagnostics. " +
  pageDescription;
const quickTriagePrompts = [
  {
    question:
      "Do you need a fast workload snapshot before teams hit burnout thresholds?",
    description: "Quantify task load and hotspot relief paths.",
    href: "/diagnostics/burden-modeler",
    label: "Run Burden Modeler",
  },
  {
    question: "Are you rehearsing outage coverage or escalation ownership?",
    description: "Simulate maintenance branches and comms coverage.",
    href: "/diagnostics/maintenance-simulator",
    label: "Run Maintenance Simulator",
  },
  {
    question: "Are you modeling capacity decay or saturation risk over time?",
    description: "Forecast long-term stability and remediation timing.",
    href: "/diagnostics/capacity-forecaster",
    label: "Run Capacity Forecaster",
  },
];
const selfDefenseTools = [
  {
    title: "Is this system governable?",
    description:
      "Seven yes/no checks to confirm whether the decision can be contested.",
    href: "/diagnostics/self-defense-tools#governable",
    label: "Run governability diagnostic",
  },
  {
    title: "Is this appeal real?",
    description: "Detect whether an appeal is substantive or performative.",
    href: "/diagnostics/self-defense-tools#appeal-real",
    label: "Run appeal diagnostic",
  },
  {
    title: "Who holds power?",
    description: "Map the people and levers that can reverse the outcome.",
    href: "/diagnostics/self-defense-tools#power-map",
    label: "Map power",
  },
];
const mostUsedToolSlugs = [
  "burden-modeler",
  "maintenance-simulator",
  "capacity-forecaster",
  "evidence-pack-readiness",
  "escalation-coverage-planner",
  "maintenance-debt-calculator",
];
const mostUsedTools = mostUsedToolSlugs
  .map((slug) => tools.find((tool) => tool.slug === slug))
  .filter((tool): tool is (typeof tools)[number] => Boolean(tool));
const comparisonTools = mostUsedTools.slice(0, 3);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredDataType="collection"
>
  <div data-route-metrics="home-to-diagnostics" hidden></div>
  <PageIntro
    eyebrow="Diagnostics"
    title="Diagnostics"
    description={introDescription}
    permalink={permalink}
    anchorLinks={anchorLinks}
    collapseAnchorLinks={false}
    collapseAnchorLinksOnMobile={true}
    anchorLinksSummary="More anchors"
  />
  <SummaryCallout
    title="Pick the fastest diagnostic first"
    description="Use the quick triage prompts to choose a tool, then compare outputs before running the full menu."
    takeaways={[
      "Each diagnostic produces a shareable, linkable report.",
      "Every output references mechanisms for remediation.",
      "Anti-weaponization checks are built into the baseline.",
    ]}
  />
  <p class="muted small">
    Recommended path: choose a diagnostic in 30 seconds, then run and share the
    output.
  </p>
  <div class="panel diagnostics__artifact-bridge stack-sm">
    <p class="eyebrow">Next required artifact</p>
    <p class="muted">
      Run one diagnostic, then attach its primary output to your incident or
      audit packet before moving on.
    </p>
    <ul class="muted small">
      <li>Burden Modeler → Burden evidence table</li>
      <li>Maintenance Simulator → Escalation coverage report</li>
      <li>Evidence-Pack Readiness → Standards evidence checklist</li>
    </ul>
  </div>
  <nav
    class="diagnostics__sticky-jump"
    aria-label="Diagnostics quick navigation"
  >
    <a
      class="button primary"
      href="#quick-triage"
      data-route-action="diagnostics-choose"
      data-sticky-link="#quick-triage">Start triage now</a
    >
    <a
      class="diagnostics__sticky-link muted small"
      href="#diagnostic-tools"
      data-route-action="diagnostics-open-menu"
      data-sticky-link="#diagnostic-tools">Need full menu? Jump to all tools</a
    >
  </nav>
  <SectionActions>
    <StudioBadge />
  </SectionActions>

  <SectionBlock
    id="most-used"
    eyebrow="Most-used diagnostics"
    title="Start with the six diagnostics teams run most often."
    description="If you are unsure where to begin, these paths handle the highest-volume governance questions first."
    variant="alt"
  >
    <CardGrid className="grid--three">
      {
        mostUsedTools.map((tool) => (
          <CardItem
            title={tool.title}
            description={tool.description}
            descriptionTone="default"
          >
            <p class="muted small">Best for: {tool.bestFor}</p>
            <a slot="footer" class="muted" href={tool.ctaHref}>
              {tool.ctaLabel}
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="quick-triage"
    eyebrow="Quick triage"
    title="Pick the fastest diagnostic path in three questions."
    description="Use these prompts to route to the right tool without the demo widget."
    variant="alt"
  >
    <div class="panel stack-sm">
      <p class="eyebrow">Start here sequence</p>
      <ol class="muted">
        <li>
          Choose one prompt below that best matches your immediate decision.
        </li>
        <li>
          Compare two candidate tools for delivery mode, prep, and outputs.
        </li>
        <li>Run one diagnostic and share the linkable output with owners.</li>
      </ol>
    </div>
    <CardGrid className="grid--three">
      {
        quickTriagePrompts.map((prompt) => (
          <CardItem
            title={prompt.question}
            description={prompt.description}
            descriptionTone="default"
          >
            <a slot="footer" class="muted" href={prompt.href}>
              {prompt.label}
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>
  <CitationBlock
    title={pageTitle}
    permalink={permalink}
    publication={publication}
    variant="compact"
  />

  <SectionBlock
    id="why-diagnostics"
    eyebrow="Why teams call us"
    title="Diagnostics turn fuzzy risk into a concrete next step."
    description="Built for visitors who need a clear answer without a long engagement."
  >
    <CardGrid>
      {
        valueProps.map((item) => (
          <CardItem title={item.title} description={item.description} />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="output-baseline"
    eyebrow="Output baseline"
    title="What every diagnostic output includes."
    description="Use the shared baseline to align teams before diving into tool specifics."
    variant="alt"
  >
    <details
      class="chunked-section diagnostics__mobile-disclosure"
      data-collapse-mobile
      open
    >
      <summary class="chunked-section__summary"
        >Open output baseline details</summary
      >
      <div class="chunked-section__body stack-sm">
        <ul class="muted">
          <li>Linkable results page and a shareable PDF summary.</li>
          <li>Mechanism language references to keep mitigations consistent.</li>
          <li>
            Optional facilitation handoff when ambiguity or risk stays high.
          </li>
        </ul>
        <p class="muted">
          Need to verify how users appeal decisions? Use the
          {" "}
          <a href="/explainers/contestability-checklist"
            >contestability checklist</a
          >
          {" "}
          before you publish outputs tied to appeals or reversals.
        </p>
        <StudioBadge />
      </div>
    </details>
  </SectionBlock>

  <SectionBlock
    id="anti-weaponization"
    eyebrow="Anti-weaponization"
    title="Diagnostics must verify AW-01 through AW-04"
    description="Every diagnostic output should include evidence that anti-weaponization clauses are honored."
  >
    <details
      class="chunked-section diagnostics__mobile-disclosure"
      data-collapse-mobile
      open
    >
      <summary class="chunked-section__summary"
        >Open anti-weaponization checklist</summary
      >
      <div class="chunked-section__body stack-sm">
        <ul class="muted">
          <li>
            AW-01: Burden metrics include a remediation plan and staffing
            allocation.
          </li>
          <li>
            AW-02: Appeal paths are tested for non-regression and public
            replacement windows.
          </li>
          <li>
            AW-03: Downgrades or eligibility changes always emit receipts and
            clocks.
          </li>
          <li>
            AW-04: High-burden flows include assisted channels or human
            escalation.
          </li>
        </ul>
        <p class="muted">
          Reference:
          {" "}
          <a href="/anti-weaponization">Anti-weaponization constraints</a>
          {" "}
          and the
          {" "}
          <a href="/evidence-packs/std-02#anti-weaponization"
            >evidence requirements</a
          >.
        </p>
      </div>
    </details>
  </SectionBlock>

  <SectionBlock
    id="how-it-works"
    eyebrow="Facilitated, but lightweight"
    title={facilitation.title}
    description={facilitation.description}
    variant="alt"
  >
    <ol class="diagnostics__process">
      {
        facilitation.steps.map((step) => (
          <li class="diagnostics__process-step">
            <p class="eyebrow">{step.title}</p>
            <p class="muted">{step.detail}</p>
          </li>
        ))
      }
    </ol>
    <p class="muted diagnostics__footnote">{facilitation.note}</p>
  </SectionBlock>

  <SectionBlock
    id="self-defense-tools"
    eyebrow="Self-defense diagnostics"
    title="Short-form checks for appeal, governability, and power."
    description="Use these three tools when you need fast answers before escalating."
  >
    <CardGrid className="grid--three">
      {
        selfDefenseTools.map((tool) => (
          <CardItem
            title={tool.title}
            description={tool.description}
            descriptionTone="default"
          >
            <a slot="footer" class="muted" href={tool.href}>
              {tool.label}
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="diagnostic-tools"
    eyebrow="Diagnostics menu"
    title="Pick the tool that matches your situation."
    description="Every diagnostic ships with a linkable result and mechanism references."
  >
    <div class="diagnostics__comparison" aria-label="Quick comparison">
      <p class="muted small">Compare before you commit</p>
      <div class="diagnostics__comparison-grid">
        {
          comparisonTools.map((tool) => (
            <article class="panel diagnostics__comparison-card">
              <h3>{tool.title}</h3>
              <dl class="diagnostics__comparison-meta muted small">
                <div>
                  <dt>Time</dt>
                  <dd>{tool.estimatedTime}</dd>
                </div>
                <div>
                  <dt>Effort</dt>
                  <dd>
                    {tool.deliveryType === "studio"
                      ? "Studio-facilitated"
                      : "Self-serve"}
                  </dd>
                </div>
                <div>
                  <dt>Output</dt>
                  <dd>{tool.outputs[0]}</dd>
                </div>
              </dl>
              <a class="button ghost" href={tool.ctaHref}>
                {tool.ctaLabel}
              </a>
            </article>
          ))
        }
      </div>
    </div>
    <div class="diagnostics__filters" data-diagnostics-filters>
      <p class="muted">Filter by delivery type</p>
      <p class="muted small">Quick intent jumps</p>
      <ul
        class="pill-list pill-list--wrap"
        aria-label="Diagnostic intent shortcuts"
      >
        <li>
          <a class="pill-list__button" href="/diagnostics/burden-modeler"
            >Planning</a
          >
        </li>
        <li>
          <a
            class="pill-list__button"
            href="/diagnostics/evidence-pack-readiness">Audit prep</a
          >
        </li>
        <li>
          <a
            class="pill-list__button"
            href="/diagnostics/escalation-coverage-planner">Incident response</a
          >
        </li>
      </ul>
      <ul
        class="pill-list pill-list--wrap"
        role="group"
        aria-label="Diagnostic delivery filters"
      >
        <li class="pill-list__item pill-list__item--active">
          <button
            class="pill-list__button"
            type="button"
            data-delivery-filter="all"
            aria-pressed="true"
          >
            All diagnostics
          </button>
        </li>
        <li class="pill-list__item">
          <button
            class="pill-list__button"
            type="button"
            data-delivery-filter="self-serve"
            aria-pressed="false"
          >
            Self-serve
          </button>
        </li>
        <li class="pill-list__item">
          <button
            class="pill-list__button"
            type="button"
            data-delivery-filter="studio"
            aria-pressed="false"
          >
            Studio-facilitated
          </button>
        </li>
      </ul>
      <p class="muted small" data-delivery-status>Showing all diagnostics.</p>
    </div>
    <CardGrid className="diagnostics__tool-grid" data-diagnostics-grid>
      {
        tools.map((tool) => {
          const isStudio = tool.deliveryType === "studio";
          const deliveryLabel = isStudio
            ? "Studio-facilitated session"
            : "Self-serve tool";
          const deliveryDetail = isStudio
            ? "Facilitation required; request a session to run this diagnostic."
            : "Run on demand and share the linkable readout immediately.";
          const primaryCtaLabel = tool.ctaLabel;

          return (
            <CardItem
              id={tool.slug}
              eyebrow="Diagnostic tool"
              title={tool.title}
              description={tool.description}
              headingLevel="h2"
              dataDelivery={tool.deliveryType}
            >
              <div class="diagnostics__card-body">
                <div>
                  <p class="muted small">{deliveryLabel}</p>
                  <p class="muted small">{deliveryDetail}</p>
                  <p class="muted small">
                    Estimated time: {tool.estimatedTime}
                  </p>
                </div>
                <p class="muted small diagnostics__best-for">{tool.bestFor}</p>
                <p class="muted small">
                  <strong>When to use:</strong> {tool.bestFor}
                </p>
                <p class="muted small">
                  <strong>When to skip:</strong>{" "}
                  {isStudio
                    ? "Choose a self-serve diagnostic if you need immediate outputs without facilitation."
                    : "Choose a studio-facilitated diagnostic when governance ownership or decision framing is unclear."}
                </p>
                <ul class="diagnostics__summary">
                  <li>
                    <p class="muted diagnostics__label">Use this when</p>
                    <ul class="pill-list pill-list--wrap">
                      {tool.readiness.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </li>
                  <li>
                    <p class="muted diagnostics__label">What you receive</p>
                    <ul class="pill-list pill-list--wrap">
                      {tool.outputs.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </li>
                  <li>
                    <p class="muted diagnostics__label">Prep checklist</p>
                    <ul class="pill-list pill-list--wrap">
                      {tool.prepChecklist.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </li>
                </ul>
              </div>
              <div class="diagnostics__card-footer">
                <SectionActions>
                  <a
                    class="button primary"
                    href={tool.ctaHref}
                    aria-label={tool.ctaAriaLabel ?? primaryCtaLabel}
                  >
                    {primaryCtaLabel}
                  </a>
                  <a class="button ghost" href={`/diagnostics/${tool.slug}`}>
                    Method details
                  </a>
                  <a
                    class="button ghost"
                    href={tool.exampleHref}
                    aria-label={`View example outputs for ${tool.title}`}
                  >
                    {tool.exampleLabel}
                  </a>
                </SectionActions>
              </div>
            </CardItem>
          );
        })
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="referenced-by"
    eyebrow="Referenced by"
    title="Where diagnostics connect to enforcement"
    description="Cross-links keep diagnostic outputs aligned with standards, bindings, and evidence packs."
    variant="alt"
  >
    <div class="grid grid--three">
      <div class="panel">
        <p class="eyebrow">Used in examples</p>
        <ul class="muted">
          <li>
            <a href="/examples/automated-account-lock">Automated account lock</a
            >
          </li>
          <li>
            <a href="/examples/content-moderation-takedown"
              >Content moderation takedown</a
            >
          </li>
          <li>
            <a href="/examples/fraud-hold-delayed-notice"
              >Fraud hold with delayed notice</a
            >
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Required by bindings</p>
        <ul class="muted">
          <li>
            <a href="/bindings#incidents">Incident triggers</a>
          </li>
          <li>
            <a href="/bindings#runbooks">Runbook snippets</a>
          </li>
          <li>
            <a href="/bindings#release-gates">Release gate checklist</a>
          </li>
        </ul>
      </div>
      <div class="panel">
        <p class="eyebrow">Verified by evidence packs</p>
        <ul class="muted">
          <li>
            <a href="/evidence-packs/std-01">STD-01 Evidence Pack</a>
          </li>
          <li>
            <a href="/evidence-packs/std-02">STD-02 Evidence Pack</a>
          </li>
          <li>
            <a href="/validators">Validators (VAL-01–VAL-03)</a>
          </li>
        </ul>
      </div>
    </div>
    <p class="muted">
      Bundles:
      {" "}
      <a href="/bundles/diagnostic-export-kit">Diagnostic Export Kit</a>
      {" "}
      for stakeholder summaries and
      {" "}
      <a href="/bundles/procurement-clause-pack">Procurement Clause Pack</a>
      {" "}
      for vendor follow-through.
    </p>
    <p class="muted">
      Search IDs: AW-01, AW-02, AW-03, AW-04, VAL-01, VAL-02, VAL-03,
      STD-02.2.1, STD-02.3.1.
    </p>
  </SectionBlock>

  <section class="cta stack-md" aria-label="Commercial advisory and custom audits">
    <div class="stack-sm">
      <p class="eyebrow">Ethotechnics Studio</p>
      <h2>Need custom risk modeling or commissioned diligence?</h2>
      <p class="muted">
        Ethotechnics Studio provides tailored clinical AI safety evaluation, VC portfolio diligence, custom governance tooling, and independent audit verification.
      </p>
    </div>
    <div class="actions">
      <a class="button primary" href="https://ethotechnics.com" target="_blank" rel="noopener noreferrer">
        Engage Ethotechnics Studio →
      </a>
      <a class="button ghost" href="/participate">
        Submit community feedback
      </a>
    </div>
  </section>

  <script is:inline>
    const stickyNav = document.querySelector(".diagnostics__sticky-jump");
    const mobileDisclosures = Array.from(
      document.querySelectorAll("[data-collapse-mobile]"),
    );

    const syncMobileDisclosures = () => {
      if (mobileDisclosures.length === 0) {
        return;
      }

      const isMobile = window.matchMedia("(max-width: 899px)").matches;

      mobileDisclosures.forEach((disclosure) => {
        if (!(disclosure instanceof HTMLDetailsElement)) {
          return;
        }

        disclosure.open = !isMobile;
      });
    };

    syncMobileDisclosures();
    window.addEventListener("resize", syncMobileDisclosures, { passive: true });

    if (stickyNav) {
      const stickyLinks = Array.from(
        stickyNav.querySelectorAll("[data-sticky-link]"),
      );
      const stickyTargets = stickyLinks
        .map((link) =>
          document.querySelector(link.getAttribute("data-sticky-link") ?? ""),
        )
        .filter(Boolean);

      const setActiveLink = (targetId) => {
        stickyLinks.forEach((link) => {
          const href = link.getAttribute("data-sticky-link");
          const isActive = href === targetId;
          link.classList.toggle("is-active", isActive);

          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      if (stickyTargets.length > 0 && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visibleEntries = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

            if (visibleEntries[0]?.target?.id) {
              setActiveLink(`#${visibleEntries[0].target.id}`);
            }
          },
          {
            rootMargin: "-30% 0px -55% 0px",
            threshold: [0.1, 0.35, 0.6],
          },
        );

        stickyTargets.forEach((target) => observer.observe(target));
      }
    }
  </script>

  <script type="module" src={diagnosticsFilterScript} is:inline></script>
  <script is:inline type="module" src={routeMetricsScript}></script>
</BaseLayout>
