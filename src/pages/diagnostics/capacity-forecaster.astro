---
import "../../styles/components/diagnostics.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiagnosticToolPage from "../../components/DiagnosticToolPage.astro";
import { diagnosticsStudioOffRampCallout } from "../../content/callouts";
import { diagnosticsContent } from "../../content/diagnostics";
import CapacityForecasterWidget from "../../features/capacity-forecaster/CapacityForecaster";

const tool = diagnosticsContent.tools.find(
  (entry) => entry.slug === "capacity-forecaster",
);

if (!tool) {
  return new Response("Diagnostic not found", {
    status: 404,
  });
}

const { publication } = diagnosticsContent;
const pageTitle = `${tool.title} — Diagnostics`;
const pageDescription = tool.description;
const permalink = `/diagnostics/${tool.slug}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
  mainClass="page page--wide"
>
  <DiagnosticToolPage
    tool={tool}
    publication={publication}
    permalink={permalink}
    overviewTitle="When to use the Technical Capacity Forecaster."
    methodologyDescription="Inputs, scoring logic, validation notes, and failure modes used in the model."
    sampleOutputTitle="Preview the forecast snapshot."
    sampleOutputDescription="The PDF summary with baseline and remediated curves and the saturation month marked."
    runSectionTitle="Start a new capacity forecast."
    runSectionDescription="Project baseline and remediated capacity side by side and export a PDF."
    studioOffRamp={diagnosticsStudioOffRampCallout}
  >
    <CapacityForecasterWidget client:visible />
  </DiagnosticToolPage>
</BaseLayout>
