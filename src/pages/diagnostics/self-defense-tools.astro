---
import "../../styles/components/diagnostics.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { useCases } from "../../content/use-cases";

const pageTitle = "Self-defense diagnostic tools";
const pageDescription =
  "Three yes/no checks for a person facing an automated decision: whether it can be challenged, whether the appeal can change the outcome, and who can reverse it.";
const permalink = "/diagnostics/self-defense-tools";

// What the law already lets the reader ask for, from the same registry that
// tells operators what to bind. The checks below ask whether a decision can be
// challenged; this says what a person can demand while they find out.
const rights = useCases.filter((entry) => entry.personCanAsk);
const anchorLinks = [
  { href: "#your-rights", label: "What you can ask for now" },
  { href: "#how-to-use", label: "How to use" },
  { href: "#governable", label: "Can this decision be challenged?" },
  { href: "#appeal-real", label: "Can the appeal change anything?" },
  { href: "#power-map", label: "Who holds power?" },
  { href: "#print", label: "Printable sheet" },
];

const tools = [
  {
    id: "governable",
    eyebrow: "Tool 1",
    title: "Can this decision be challenged?",
    description:
      "Seven yes/no questions on whether the decision has an owner, reasons, a clock, and a remedy you can reach.",
    questions: [
      "Can you name the accountable owner for this decision?",
      "Do you have the exact reasons and evidence used?",
      "Is there a clock for when a response is due?",
      "Can you reach a human with override authority?",
      "Is there a documented remedy if the decision is wrong?",
      "Will you receive a written record of any review outcome?",
      "Is retaliation or penalty explicitly prohibited?",
    ],
    outcomes: [
      {
        title: "Mostly yes",
        result: "Enough is in place to challenge it",
        description:
          "You can name an owner, a clock, and a remedy, which is enough to file a challenge and record the answer.",
        nextSteps: [
          {
            label: "Use wording you can send",
            href: "/explainers/language-people-can-use",
          },
          {
            label: "Review STD-02: Contestability and recourse",
            href: "/standards/std-02-contestability-recourse",
          },
          {
            label: "See what a decision record contains",
            href: "/standards/ethotechnics-for-agents",
          },
        ],
      },
      {
        title: "Mostly no",
        result: "Not enough is in place yet",
        description:
          "Without an owner, a clock, or a remedy, the decision cannot be contested as it stands.",
        nextSteps: [
          {
            label: "Ask for a written decision record",
            href: "/standards/std-02-contestability-recourse",
          },
          { label: "Review mechanism options", href: "/mechanisms" },
          {
            label: "Review evidence requirements",
            href: "/evidence-packs",
          },
        ],
      },
    ],
  },
  {
    id: "appeal-real",
    eyebrow: "Tool 2",
    title: "Can this appeal change the outcome?",
    description:
      "Six questions on whether the appeal can change the outcome, or only records the complaint.",
    questions: [
      "Does the appeal route allow new evidence or corrections?",
      "Is the reviewer independent from the original decision maker?",
      "Is there a timeline for when a decision will be issued?",
      "Does the appeal include a remedy if the decision is wrong?",
      "Can you confirm who approves the reversal?",
      "Will you receive written reasons for the appeal outcome?",
    ],
    outcomes: [
      {
        title: "Appeal is real",
        result: "A review that can change the decision",
        description:
          "The appeal path has independent review, a clock, and a clear remedy.",
        nextSteps: [
          {
            label: "Prepare evidence pack inputs",
            href: "/evidence-packs/std-02",
          },
          {
            label: "Use wording to escalate",
            href: "/explainers/language-people-can-use",
          },
          {
            label: "Track response deadlines",
            href: "/standards/std-02-contestability-recourse",
          },
        ],
      },
      {
        title: "Appeal cannot change the outcome",
        result: "A complaint route with no remedy",
        description:
          "If the reviewer is not independent, or there is no remedy, expect the appeal to change nothing.",
        nextSteps: [
          {
            label: "Request a real escalation path",
            href: "/standards/std-02-contestability-recourse",
          },
          { label: "Document the gap", href: "/diagnostics" },
          {
            label: "Review contestability evidence",
            href: "/evidence-packs",
          },
        ],
      },
    ],
  },
  {
    id: "power-map",
    eyebrow: "Tool 3",
    title: "Who holds power here?",
    description:
      "Six questions that name who can pause, reverse, or compel a change to the decision.",
    questions: [
      "Who can reverse or pause the decision today?",
      "Who owns the policy or model behind the decision?",
      "Which team controls the evidence or logs you need?",
      "Who is accountable for harm if this goes wrong?",
      "Which regulator, union, or authority can compel action?",
      "What reputational or contractual leverage exists?",
    ],
    outcomes: [
      {
        title: "Power map is clear",
        result: "Named owners and outside pressure",
        description:
          "You can name at least one accountable owner and one outside body, such as a regulator or union, that can compel action.",
        nextSteps: [
          { label: "Build an escalation path", href: "/mechanisms" },
          {
            label: "Check evidence requirements",
            href: "/evidence-packs",
          },
          { label: "See the validators", href: "/validators" },
        ],
      },
      {
        title: "Power map is opaque",
        result: "Nobody is clearly responsible",
        description:
          "If you cannot see an accountable owner or any outside pressure, treat the system as high risk.",
        nextSteps: [
          {
            label: "Check what the system is allowed to decide",
            href: "/diagnostics/delegation-audit",
          },
          {
            label: "Use wording that asks who is accountable",
            href: "/explainers/language-people-can-use",
          },
          { label: "Document for evidence packs", href: "/evidence-packs" },
        ],
      },
    ],
  },
];

const printSheet = {
  title: "Self-defense diagnostic tools",
  intro: "All three checks on one page, for use during an appeal or review.",
  sections: tools.map((tool) => ({
    title: tool.title,
    items: tool.questions,
  })),
};
---

<BaseLayout
  title={`${pageTitle} — Diagnostics`}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Diagnostics"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="your-rights"
    eyebrow="Before the checks"
    title="What the law already lets you ask for"
    description="The standards on this site are drafts with no force. These rules are in force where they name, and some may cover your case. This is not legal advice."
  >
    <CardGrid className="grid--two self-defense__rights">
      {
        rights.map((entry) => (
          <CardItem
            title={entry.title}
            description={entry.personCanAsk}
            descriptionTone="default"
          >
            <a slot="footer" class="muted" href={`/use-cases#${entry.id}`}>
              How this kind of system is governed
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="how-to-use"
    eyebrow="How to use"
    title="Six or seven questions per check"
    description="The first two checks take yes or no. The third asks who: write down a name or a team for each answer."
  >
    <ol class="muted self-defense__steps">
      <li>Pick the check that matches your situation.</li>
      <li>
        Answer each question: yes or no for the first two checks, a name for the
        third.
      </li>
      <li>
        Count your yes answers, or the questions you could not name anyone for,
        and compare to the outcomes below.
      </li>
      <li>
        Use the next-step links to request evidence, remedies, or escalation.
      </li>
    </ol>
  </SectionBlock>

  {
    tools.map((tool) => (
      <SectionBlock
        id={tool.id}
        eyebrow={tool.eyebrow}
        title={tool.title}
        description={tool.description}
        variant="alt"
      >
        <div class="self-defense__tool">
          <div>
            <p class="eyebrow">Questions</p>
            <ol class="muted self-defense__questions">
              {tool.questions.map((question) => (
                <li>{question}</li>
              ))}
            </ol>
          </div>
          <div>
            <p class="eyebrow">What your answers mean</p>
            <CardGrid className="grid--two">
              {tool.outcomes.map((outcome) => (
                <CardItem
                  title={outcome.title}
                  description={outcome.description}
                  descriptionTone="default"
                >
                  <p class="muted small">{outcome.result}</p>
                  <ul class="self-defense__next-steps">
                    {outcome.nextSteps.map((step) => (
                      <li>
                        <a href={step.href}>{step.label}</a>
                      </li>
                    ))}
                  </ul>
                </CardItem>
              ))}
            </CardGrid>
          </div>
        </div>
      </SectionBlock>
    ))
  }

  <SectionBlock
    id="print"
    eyebrow="Printable"
    title="One-page self-defense sheet"
    description="Print or save the questions so you can use the checks offline."
  >
    <div class="self-defense-print" data-glossary-ignore>
      <div class="self-defense-print__panel">
        <p class="eyebrow">Print or save</p>
        <h3>{printSheet.title}</h3>
        <p class="muted">{printSheet.intro}</p>
        <div class="actions">
          <button class="button ghost" type="button" data-self-defense-print>
            Print sheet
          </button>
        </div>
      </div>
      <div class="self-defense-print__preview" aria-label="Printable sheet">
        <h2
          class="print-only"
          style="margin-top: 0; margin-bottom: var(--space-2);"
        >
          {printSheet.title}
        </h2>
        <p
          class="print-only"
          style="margin-bottom: var(--space-5); color: var(--muted);"
        >
          {printSheet.intro}
        </p>
        {
          printSheet.sections.map((section) => (
            <div class="self-defense-print__section">
              <p class="self-defense-print__title">{section.title}</p>
              <ol>
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ol>
            </div>
          ))
        }
        <p
          class="muted self-defense-print__note print-only"
          style="margin-top: var(--space-6); font-size: var(--text-sm);"
        >
          Source: Ethotechnics self-defense diagnostics · <a href={permalink}
            >ethotechnics.org{permalink}</a
          >
        </p>
      </div>
    </div>
  </SectionBlock>
</BaseLayout>

<script>
  const printButton = document.querySelector<HTMLButtonElement>(
    "[data-self-defense-print]",
  );

  if (printButton) {
    printButton.addEventListener("click", () => {
      window.print();
    });
  }
</script>

<style>
  /* Four rights read as two rows of two, not three and one. */
  :global(.self-defense__rights) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }

  .print-only {
    display: none;
  }

  .self-defense__steps,
  .self-defense__questions,
  .self-defense__next-steps {
    padding-left: var(--space-4);
    margin: var(--space-4) 0 0;
    display: grid;
    gap: var(--space-2);
  }

  .self-defense__tool {
    display: grid;
    gap: var(--space-6);
  }

  .self-defense__next-steps {
    margin-top: var(--space-3);
  }

  .self-defense-print {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--surface);
    display: grid;
    gap: var(--space-5);
  }

  .self-defense-print__panel {
    display: grid;
    gap: var(--space-3);
  }

  .self-defense-print__preview {
    display: grid;
    gap: var(--space-4);
  }

  .self-defense-print__section {
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .self-defense-print__title {
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .self-defense-print__note {
    margin-top: var(--space-5);
  }

  .self-defense-print--print {
    gap: var(--space-4);
  }

  .self-defense-print--print h2 {
    margin-bottom: var(--space-2);
  }

  .self-defense-print--print ol {
    padding-left: var(--space-4);
  }

  @media (min-width: 960px) {
    .self-defense__tool {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    .self-defense-print {
      grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
      align-items: start;
    }
  }

  @media print {
    .print-only {
      display: block !important;
    }

    /* Hide non-printable elements */
    .site-header,
    .institute-banner,
    .nav,
    .page-breadcrumbs,
    .page-intro,
    .footer,
    #how-to-use,
    #governable,
    #appeal-real,
    #power-map,
    .self-defense-print__panel {
      display: none !important;
    }

    /* Reset shell layout constraints for clean print output */
    body,
    html {
      background: #fff !important;
      color: #000 !important;
    }

    .page-shell,
    .page-shell__canvas,
    .page-shell__panel,
    .page-shell__content,
    main {
      padding: 0 !important;
      margin: 0 !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
    }

    .self-defense-print {
      border: none !important;
      padding: 0 !important;
      background: transparent !important;
      display: block !important;
    }

    .self-defense-print__preview {
      display: grid !important;
      gap: var(--space-5) !important;
      width: 100% !important;
    }

    .self-defense-print__section {
      border: 1px solid #000 !important;
      page-break-inside: avoid;
      break-inside: avoid;
    }
  }
</style>
