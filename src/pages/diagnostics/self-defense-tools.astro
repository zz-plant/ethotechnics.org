---
import "../../styles/components/diagnostics.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { useCases } from "../../content/use-cases";

const pageTitle = "Self-defense diagnostic tools";
const pageDescription =
  "Three checks for a person facing an automated decision: whether it can be challenged, whether the appeal can change the outcome, and who can reverse it.";
const permalink = "/diagnostics/self-defense-tools";
const pageUrl = new URL(permalink, Astro.site ?? Astro.url.origin).toString();

// What the law already lets the reader ask for, from the same registry that
// tells operators what to bind. The checks below ask whether a decision can be
// challenged; this says what a person can demand while they find out.
const rights = useCases.filter((entry) => entry.personCanAsk);
const anchorLinks = [
  { href: "#your-rights", label: "What you can ask for now" },
  { href: "#governable", label: "Can this decision be challenged?" },
  { href: "#appeal-real", label: "Can the appeal change anything?" },
  { href: "#power-map", label: "Who holds power?" },
];

const ask = "/explainers/language-people-can-use";

const tools = [
  {
    id: "governable",
    eyebrow: "Tool 1",
    title: "Can this decision be challenged?",
    description:
      "Seven yes-or-no questions: is someone responsible, have you been given reasons and a date, and is there a way to put it right?",
    questions: [
      "Can you name the person or office responsible for this decision?",
      "Have you been given the reasons and the information the decision used?",
      "Have you been told the date by which they must answer a challenge?",
      "Can you reach a person who is allowed to change the decision?",
      "Does a written policy say what they will do if the decision was wrong?",
      "Will they send you the result of any review in writing?",
      "Does a written rule protect you from being penalized for challenging it?",
    ],
    outcomes: [
      {
        title: "Mostly yes",
        result: "Enough is in place to challenge it",
        description:
          "You know who is responsible, when they must answer, and what they would do if they got it wrong. That is enough to file a challenge and keep a record of the reply.",
        nextSteps: [
          {
            label: "Questions to send with your challenge",
            href: `${ask}#phrases`,
          },
          {
            label: "Check whether an appeal can change the outcome",
            href: "#appeal-real",
          },
          { label: "Print the checks to keep with your papers", print: true },
        ],
      },
      {
        title: "Mostly no",
        result: "Not enough is in place yet",
        description:
          "Without someone responsible, a date, or a way to put it right, there is no one yet who has to answer a challenge.",
        nextSteps: [
          {
            label: "Ask who can change it, and by when",
            href: `${ask}#phrases`,
          },
          {
            label: "See what the law already lets you ask for",
            href: "#your-rights",
          },
          { label: "Find out who holds power here", href: "#power-map" },
        ],
      },
    ],
  },
  {
    id: "appeal-real",
    eyebrow: "Tool 2",
    title: "Can this appeal change the outcome?",
    description:
      "Six yes-or-no questions on whether the appeal can change the outcome, or only records the complaint.",
    questions: [
      "Can you add new evidence or correct the record when you appeal?",
      "Will someone other than the original decision-maker review it?",
      "Have you been told when the appeal will be decided?",
      "If you win, will they put right what the decision cost you?",
      "Do you know who signs off on reversing the decision?",
      "Will you get the reasons for the appeal result in writing?",
    ],
    outcomes: [
      {
        title: "Mostly yes",
        result: "A review that can change the decision",
        description:
          "Someone new reviews it, by a known date, and a win puts things right.",
        nextSteps: [
          {
            label: "Questions to send with your appeal",
            href: `${ask}#phrases`,
          },
          {
            label: "Questions for your kind of organization",
            href: `${ask}#contexts`,
          },
          { label: "Find out who can reverse it", href: "#power-map" },
        ],
      },
      {
        title: "Mostly no",
        result: "A complaint route that changes nothing",
        description:
          "If the same people review it, or a win gets you nothing back, expect the appeal to change nothing.",
        nextSteps: [
          { label: "Ask for the refusal in writing", href: `${ask}#phrases` },
          {
            label: "See what the law already lets you ask for",
            href: "#your-rights",
          },
          { label: "Find who outside can make them act", href: "#power-map" },
        ],
      },
    ],
  },
  {
    id: "power-map",
    eyebrow: "Tool 3",
    title: "Who holds power here?",
    description:
      "Six questions. For each, write down a name, an office, or an organization.",
    questions: [
      "Who can reverse or pause the decision today?",
      "Which organization or department made the rule this decision followed?",
      "Who holds the records the decision used?",
      "Who would have to answer if the decision harms you?",
      "Which regulator, ombudsman, union, or court can make them act?",
      "Who else could press them to act, such as an elected representative, a professional body, or the press?",
    ],
    outcomes: [
      {
        title: "You can name them",
        result: "Someone inside answers, and someone outside can make them",
        description:
          "You can name at least one person inside who can reverse the decision, and one body outside, such as a regulator or union, that can make them act.",
        nextSteps: [
          {
            label: "Write to the person who can reverse it",
            href: `${ask}#phrases`,
          },
          {
            label: "Questions for your kind of organization",
            href: `${ask}#contexts`,
          },
          { label: "Print the checks to keep with your papers", print: true },
        ],
      },
      {
        title: "You cannot name them",
        result: "Nobody is clearly responsible",
        description:
          "Ask in writing who is responsible, and keep every reply. A written record is what a regulator, an ombudsman, or an advice service will ask to see.",
        nextSteps: [
          {
            label: "Ask who is responsible, in writing",
            href: `${ask}#phrases`,
          },
          {
            label: "See what the law already lets you ask for",
            href: "#your-rights",
          },
        ],
      },
    ],
  },
];
---

<BaseLayout
  title={`${pageTitle} — Diagnostics`}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Diagnostics"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  >
    <Fragment slot="actions">
      <button class="button ghost" type="button" data-self-defense-print>
        Print or save as PDF
      </button>
    </Fragment>
  </PageIntro>

  <SectionBlock
    id="your-rights"
    eyebrow="Before the checks"
    title="What the law already lets you ask for"
    description="The standards on this site are drafts and bind no one. The laws below are in force in the places they name, and one may cover your case. This is not legal advice."
  >
    <CardGrid className="grid--two self-defense__rights">
      {
        rights.map((entry) => (
          <CardItem
            title={entry.title}
            description={entry.personCanAsk}
            descriptionTone="default"
          >
            <a slot="footer" class="muted" href={`/use-cases#${entry.id}`}>
              How this kind of system is governed
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  {
    tools.map((tool, index) => (
      <SectionBlock
        id={tool.id}
        eyebrow={tool.eyebrow}
        title={tool.title}
        description={tool.description}
        variant="alt"
      >
        <div class="self-defense__tool">
          <div>
            <p class="eyebrow">Questions</p>
            <ol class="muted self-defense__questions">
              {tool.questions.map((question) => (
                <li>{question}</li>
              ))}
            </ol>
          </div>
          <div class="self-defense__outcomes">
            <p class="eyebrow">What your answers mean</p>
            <CardGrid className="grid--two">
              {tool.outcomes.map((outcome) => (
                <CardItem
                  title={outcome.title}
                  description={outcome.description}
                  descriptionTone="default"
                >
                  <p class="muted small">{outcome.result}</p>
                  <ul class="self-defense__next-steps">
                    {outcome.nextSteps.map((step) => (
                      <li>
                        {step.print ? (
                          <button
                            class="self-defense__print-step"
                            type="button"
                            data-self-defense-print
                          >
                            {step.label}
                          </button>
                        ) : (
                          <a href={step.href}>{step.label}</a>
                        )}
                      </li>
                    ))}
                  </ul>
                </CardItem>
              ))}
            </CardGrid>
          </div>
        </div>
        {index === tools.length - 1 && (
          <p class="muted small self-defense-source">
            Source: Ethotechnics self-defense diagnostics ·{" "}
            <a href={permalink}>{pageUrl}</a>
          </p>
        )}
      </SectionBlock>
    ))
  }
</BaseLayout>

<script>
  const printButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-self-defense-print]",
  );

  printButtons.forEach((button) => {
    button.addEventListener("click", () => {
      window.print();
    });
  });
</script>

<style>
  /* Four rights read as two rows of two, not three and one. */
  :global(.self-defense__rights) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }

  .self-defense__questions,
  .self-defense__next-steps {
    padding-left: var(--space-4);
    margin: var(--space-4) 0 0;
    display: grid;
    gap: var(--space-2);
  }

  .self-defense__tool {
    display: grid;
    gap: var(--space-6);
  }

  .self-defense__next-steps {
    margin-top: var(--space-3);
  }

  /* A next step that prints the page instead of going somewhere; it reads
     as one more link in the list. */
  .self-defense__print-step {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    text-align: start;
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--link) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .self-defense__print-step:hover,
  .self-defense__print-step:focus-visible {
    color: var(--link-hover);
    text-decoration-color: currentColor;
  }

  .self-defense-source {
    display: none;
  }

  @media (min-width: 960px) {
    .self-defense__tool {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* The page itself is the printable sheet: the three checks and their
     questions on one page. It used to end in a "One-page self-defense sheet"
     section that repeated all fifteen questions on screen and again in a
     print-only list. The rights, the outcome cards, and their links stay on
     screen; paper keeps the questions. */
  @media print {
    :global(:root) {
      --space-section: var(--space-5);
    }

    :global(.page-breadcrumbs),
    :global(.page-intro__actions),
    :global(#your-rights),
    .self-defense__outcomes {
      display: none !important;
    }

    .self-defense__questions {
      break-inside: avoid;
    }

    .self-defense-source {
      display: block;
      margin-top: var(--space-5);
    }
  }
</style>
