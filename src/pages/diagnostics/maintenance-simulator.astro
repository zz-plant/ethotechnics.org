---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiagnosticToolPage from "../../components/DiagnosticToolPage.astro";
import { diagnosticsStudioOffRampCallout } from "../../content/callouts";
import { diagnosticsContent } from "../../content/diagnostics";
import MaintenanceSimulatorWidget from "../../features/maintenance-simulator";

const tool = diagnosticsContent.tools.find((entry) => entry.slug === "maintenance-simulator");

if (!tool) {
  return Astro.response(
    new Response("Diagnostic not found", {
      status: 404,
    })
  );
}

const { publication } = diagnosticsContent;
const pageTitle = `${tool.title} — Diagnostics`;
const pageDescription = tool.description;
const permalink = `/diagnostics/${tool.slug}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  mainClass="page page--wide"
>
  <DiagnosticToolPage
    tool={tool}
    publication={publication}
    permalink={permalink}
    overviewTitle="When to use the Maintenance Simulator."
    methodologyDescription="Inputs, scoring logic, validation notes, and failure modes used in the tabletop."
    sampleOutputTitle="Preview a simulated run."
    sampleOutputDescription="Use the sample output to see the summary format and comms templates."
    runSectionTitle="Start a maintenance scenario."
    runSectionDescription="Run the tabletop and export the summary for your maintenance packet."
    studioOffRamp={diagnosticsStudioOffRampCallout}
  >
    <MaintenanceSimulatorWidget client:only="react" />
  </DiagnosticToolPage>
</BaseLayout>
