---
import BaseLayout from "../layouts/BaseLayout.astro";
import { methodContent } from "../content/method";

const { chain, invariant } = methodContent;

const stageSummaries: Record<string, string> = {
  evidence:
    "State the propositions that justify letting the system act, and keep them current.",
  authority:
    "Record which actions the system may take, for whom, and until when.",
  decision: "Log what was decided, on what record, and with what dissent.",
  consequence:
    "Account for who carries the burden of the decision and for how long.",
  challenge:
    "Give exposed parties a channel to contest the decision with procedural force.",
  reconsideration:
    "Reopen the delegation when it is challenged or when the facts change.",
  correction:
    "Keep stop, reversal, and repair feasible at a cost the institution can bear.",
};
---

<BaseLayout
  title="How Ethotechnics Works: The Chain, the Lenses, and the Sequence"
  description="How Ethotechnics turns the delegation chain into operational defaults: seven stages every consequential decision passes through, three lenses applied at the Consequence stage, and a four-step application sequence."
  structuredDataType="webpage"
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <section class="stack-lg institute-screen">
    <h1>How Ethotechnics works</h1>
    <p>
      Ethotechnics governs the delegation of consequential agency, not the
      model. Every consequential decision is one link in a governed chain, and
      the method keeps the states of that chain coupled.
    </p>
    <p><strong>{invariant}</strong></p>
    <div class="actions">
      <a class="button primary" href="/method">Read the method</a>
      <a class="button" href="/#failure-intake">Start with a failure</a>
      <a class="button" href="/applications">Explore applications</a>
      <a class="button" href="/artifacts">Browse artifacts</a>
      <a class="button ghost" href="/standards">Review standards</a>
    </div>
  </section>

  <section id="chain" class="stack-lg institute-screen">
    <h2>The chain</h2>
    <p>
      Seven stages, in order. Each has a question the institution must be able
      to answer. The <a href="/method#chain">method page</a> lists the assets that
      answer each one.
    </p>
    <ol class="step-list stack-sm">
      {
        chain.map((stage) => (
          <li>
            <strong>
              <a href={`/method#${stage.id}`}>{stage.title}.</a>
            </strong>{" "}
            {stageSummaries[stage.id]}
          </li>
        ))
      }
    </ol>
  </section>

  <section id="lenses" class="stack-lg institute-screen">
    <h2>The three lenses</h2>
    <p>
      The lenses are instruments applied at the Consequence stage: they make the
      burden a decision places on people visible before the chain moves on to
      Challenge. Apply one lens at a time to a single workflow. Each has a
      question and an example.
    </p>

    <div class="stack-md card">
      <h3>Burden accounting</h3>
      <p>
        Track hidden labor: triage, rework, apology loops, policy exceptions.
      </p>
      <blockquote>
        A health plan's AI triage tool misroutes 12% of prior auths. Nurses
        spend 90 minutes per shift re-routing them. That's 7.5 hours of unpaid
        care-time per week per nurse. Burden accounting surfaces that cost.
      </blockquote>
    </div>

    <div class="stack-md card">
      <h3>Infrastructure dignity</h3>
      <p>
        Does the system preserve operator agency and user recourse under
        pressure?
      </p>
      <blockquote>
        A clinical chatbot gives a wrong dosing recommendation. The nurse cannot
        override it without calling a supervisor who is in a meeting.
        Infrastructure dignity asks: where is the override, and can the operator
        reach it in 30 seconds?
      </blockquote>
    </div>

    <div class="stack-md card">
      <h3>Care-time economics</h3>
      <p>
        What is the tradeoff between shipping velocity and long-term maintenance
        extraction?
      </p>
      <blockquote>
        Engineering ships a model update that cuts false positives by 3% but
        adds 45 minutes of daily review work for the care management team.
        Care-time economics asks whether that tradeoff was visible before the
        deploy.
      </blockquote>
    </div>
  </section>

  <section id="sequence" class="stack-lg institute-screen">
    <h2>Application sequence</h2>
    <ol>
      <li>
        <strong>Select a workflow.</strong> Choose a process where system decisions
        affect people (triage, prior authorization, customer escalation).
      </li>
      <li>
        <strong>Map burden by role.</strong> Follow one decision from initiation to
        resolution. Document each instance where a person compensates for or overrides
        the system.
      </li>
      <li>
        <strong>Apply one lens.</strong> Choose the lens that best fits the pressure
        point in the workflow. Adapt the example pattern to the context.
      </li>
      <li>
        <strong>Share the analysis.</strong> Present the lens analysis to a decision-maker.
        The pattern is designed to communicate in a single conversation.
      </li>
    </ol>
    <p>
      Repeat for a different workflow or lens each week. Three weeks produces a
      cross-section of burden distribution across the system.
    </p>
  </section>
</BaseLayout>
