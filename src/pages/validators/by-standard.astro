---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { standardsContent } from "../../content/standards";
import { validatorsContent } from "../../content/validators";

const pageTitle = "Validators by standard — Ethotechnics";
const pageDescription =
  "Programmatic map of validators grouped by referenced standard for governance and assurance teams.";

const validatorsByStandard = standardsContent.standards
  .filter((standard) => standard.listedOnSite !== false)
  .map((standard) => ({
    standard,
    validators: validatorsContent.validators.filter(
      (validator) => validator.standardRef === standard.id,
    ),
  }));
// One section per standard that has validators; the rest share a line. Every
// listed standard used to get a heading, and six of the seven said only that
// nothing was mapped to it yet.
const mapped = validatorsByStandard.filter(
  ({ validators }) => validators.length,
);
const unmapped = validatorsByStandard.filter(
  ({ validators }) => !validators.length,
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  openGraphType="website"
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Programmatic index"
    title="Validators by standard"
    description={pageDescription}
    anchorLinks={mapped.length > 1
      ? mapped.map(({ standard }) => ({
          href: `#${standard.id.toLowerCase()}`,
          label: standard.id,
        }))
      : []}
  />

  {
    mapped.map(({ standard, validators }) => (
      <SectionBlock
        id={standard.id.toLowerCase()}
        eyebrow={standard.id}
        title={standard.title}
        description={standard.description}
      >
        <ul>
          {validators.map((validator) => (
            <li>
              <a href={`/validators/${validator.slug}`}>{validator.title}</a>
              <span class="muted"> — {validator.description}</span>
            </li>
          ))}
        </ul>
      </SectionBlock>
    ))
  }

  {
    unmapped.length > 0 && (
      <SectionBlock
        id="not-yet-mapped"
        eyebrow="Not yet mapped"
        title="Standards without a published validator"
        description="No published validator references these standards yet. Each links to the standard itself."
        variant="alt"
      >
        <ul class="muted">
          {unmapped.map(({ standard }) => (
            <li>
              <a href={`/standards/${standard.slug}`}>
                {standard.id}: {standard.title}
              </a>
            </li>
          ))}
        </ul>
      </SectionBlock>
    )
  }
</BaseLayout>
