---
import InlineScript from "../../components/InlineScript.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import { validatorsContent } from "../../content/validators";

const {
  pageTitle,
  pageDescription,
  permalink,
  anchorLinks,
  validators,
  method,
} = validatorsContent;
const featuredValidators = validators.slice(0, 2);
const focusGroups = [
  {
    title: "Time burden & friction",
    description: "Constructive denial and friction across a user journey.",
    validators: validators.slice(0, 2),
  },
  {
    title: "Latency & bounded duration",
    description: "Declared timeouts, observed latency, and human escalation.",
    validators: validators.slice(2, 3),
  },
];
const pageUrl = Astro.site
  ? new URL(permalink, Astro.site).toString()
  : permalink;
const validatorUrl = (slug: string) =>
  Astro.site
    ? new URL(`/validators/${slug}`, Astro.site).toString()
    : `/validators/${slug}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": pageUrl,
  name: pageTitle,
  description: pageDescription,
  url: pageUrl,
  hasPart: validators.map((validator) => ({
    "@type": "CreativeWork",
    name: `${validator.id} — ${validator.title}`,
    description: validator.description,
    url: validatorUrl(validator.slug),
    identifier: validator.id,
  })),
};
const structuredDataJson = JSON.stringify(structuredData, null, 2);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonAlternates={[{ href: "/api/validators.json", title: "Validators JSON" }]}
  structuredDataType="collection"
>
  <PageIntro
    eyebrow="Validators"
    title="Validators"
    description="Each validator takes three inputs and returns a report card with a status, the implicated clauses, and a corrective mechanism."
    anchorLinks={anchorLinks}
    illustration="validators"
  >
    <Fragment slot="actions">
      {
        featuredValidators.map((validator, index) => (
          <a
            class={`button ${index === 0 ? "primary" : "ghost"}`}
            href={`/validators/${validator.slug}`}
          >
            Run {validator.title}
          </a>
        ))
      }
      <a class="button ghost" href="#tools"> Browse all validators </a>
    </Fragment>
  </PageIntro>
  <SectionBlock
    id="featured"
    eyebrow="Start here"
    title="Start with the burden validators."
    description="VAL-01 and VAL-02 score the time and friction a journey puts on the person using it."
    variant="alt"
  >
    <CardGrid className="grid--two">
      {
        featuredValidators.map((validator) => (
          <CardItem
            eyebrow={validator.id}
            title={validator.title}
            description={validator.description}
          >
            <a
              slot="footer"
              class="button ghost button--compact"
              href={`/validators/${validator.slug}`}
            >
              Run {validator.title}
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="register"
    eyebrow="Register"
    title="Every validator, in one table"
    description="What it checks against, what you feed it, and which clauses and mechanisms it bears on."
  >
    <div class="mapping-table__wrapper">
      <table class="mapping-table mapping-table--stack catalogue-table">
        <thead>
          <tr>
            <th scope="col">Validator</th>
            <th scope="col">Standard</th>
            <th scope="col">Inputs</th>
            <th scope="col">Clauses</th>
            <th scope="col">Mechanisms</th>
          </tr>
        </thead>
        <tbody>
          {
            validators.map((validator) => (
              <tr>
                <th scope="row">
                  <a href={`/validators/${validator.slug}`}>
                    {validator.id} {validator.title}
                  </a>
                </th>
                <td data-label="Standard">{validator.standardRef}</td>
                <td data-label="Inputs">
                  {validator.inputs.map((i) => i.label).join("; ")}
                </td>
                <td data-label="Clauses">
                  {validator.clauseRefs.length
                    ? validator.clauseRefs.join(", ")
                    : "—"}
                </td>
                <td data-label="Mechanisms">
                  {validator.mechanismRefs.length
                    ? validator.mechanismRefs.join(", ")
                    : "—"}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </SectionBlock>

  <SectionBlock
    id="focus"
    eyebrow="Browse by focus"
    title="Validators grouped by what they check."
    description="Burden and friction on one side, latency and bounded duration on the other."
  >
    <CardGrid className="grid--two">
      {
        focusGroups.map((group) => (
          <CardItem title={group.title} description={group.description}>
            <ul class="muted">
              {group.validators.map((validator) => (
                <li>
                  <a href={`/validators/${validator.slug}`}>
                    {validator.id}: {validator.title}
                  </a>
                </li>
              ))}
            </ul>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <section id="tools" class="section">
    <CardGrid className="grid--two">
      {
        validators.map((validator) => (
          <CardItem
            eyebrow={validator.id}
            title={validator.title}
            description={validator.description}
          >
            <a
              slot="footer"
              class="muted"
              href={`/validators/${validator.slug}`}
            >
              Run {validator.title}
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </section>

  <section id="method" class="section section--alt">
    <div class="section__header">
      <p class="eyebrow">Method</p>
      <h2>{method.title}</h2>
      <p class="muted">{method.description}</p>
    </div>
    <ul class="validator-method">
      {method.steps.map((step) => <li>{step}</li>)}
    </ul>
  </section>
  <section id="from-outputs" class="section">
    <div class="section__header">
      <p class="eyebrow">From outputs</p>
      <h2>Rights and mechanisms behind the outputs</h2>
      <p class="muted">
        The STD-01 rights each validator checks, and the mechanisms that carry
        out remediation.
      </p>
    </div>
    <div class="library__role-buttons">
      <a
        class="button ghost library__role-button"
        href="/standards/std-01-rights-matrix"
      >
        Open the rights matrix
      </a>
      <a class="button ghost library__role-button" href="/mechanisms">
        Browse mechanisms
      </a>
      <a
        class="button ghost library__role-button"
        href="/standards/std-01-temporal-rights"
      >
        Review the rights
      </a>
    </div>
  </section>

  <InlineScript type="application/ld+json" code={structuredDataJson} />
</BaseLayout>
