---
import ValidatorPage from "../../components/ValidatorPage.astro";
---

<ValidatorPage
  id="VAL-01"
  metaTitle="Journey burden check (VAL-01)"
  metaDescription="Scores a user journey on its length, its step count, and whether every screen has an exit, and returns a red, yellow, or green report card."
  variant="burden"
  defaults={{ duration: 12, steps: 4 }}
  fix={{
    href: "/mechanisms/patterns/hard-clock",
    label: "Hard clock (MEC-04)",
  }}
>
  Scores one user journey on its length, its step count, and whether every
  screen has an exit. To rate the workload a system creates for the team that
  runs it, use the
  <a href="/diagnostics/burden-modeler">Workload modeler, a different tool</a>
</ValidatorPage>

<script>
  import { initValidatorForm } from "../../client/validator-form";

  initValidatorForm<{ duration: number; steps: number; exit: string }>(
    ({ duration, steps, exit }) => {
      if (duration > 25 || steps > 7 || exit === "no") return "red";
      if (duration > 15 || steps > 5) return "yellow";
      return "green";
    },
  );
</script>
