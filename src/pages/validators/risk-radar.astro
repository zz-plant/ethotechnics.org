---
import ValidatorPage from "../../components/ValidatorPage.astro";
---

<ValidatorPage
  id="VAL-02"
  metaTitle="Risk radar for journey friction (VAL-02)"
  metaDescription="Scores the friction in a user journey from its high-friction touchpoints, average wait, and appeal paths, and returns a red, yellow, or green report card."
  variant="risk"
  defaults={{ touchpoints: 3, wait: 4 }}
  fix={{
    href: "/mechanisms/patterns/appeal-paths",
    label: "Appeal paths (MEC-06)",
  }}
>
  Counts high-friction touchpoints, average wait, and missing appeal paths in a
  journey, to show where the friction is heavy enough to keep people from the
  service.

  <section
    slot="before-form"
    class="callout callout--emphasis"
    aria-label="Risk radar checklist"
  >
    <p class="eyebrow">Before you run this validator</p>
    <h2>Assess → Select mechanism → Export artifact</h2>
    <div class="callout__metrics" aria-label="Validator run details">
      <span class="pill pill--muted"
        ><strong>Estimated time:</strong> 3–5 minutes</span
      >
      <span class="pill pill--muted"
        ><strong>Required inputs:</strong> touchpoints, wait time, appeal path</span
      >
    </div>
    <p class="muted small">
      After the report card, implement the appeal path, then download the JSON
      for handoff.
    </p>
    <p class="muted small">
      Next steps: <a href="/mechanisms/patterns/appeal-paths"
        >Add appeal paths (MEC-06)</a
      > ·
      <a href="/diagnostics/burden-budget-worksheet"
        >Open burden budget worksheet</a
      > ·
      <a href="/evidence-packs/std-01">Map to STD-01 evidence pack</a>
    </p>
  </section>
</ValidatorPage>

<script>
  import { initValidatorForm } from "../../client/validator-form";

  initValidatorForm<{ touchpoints: number; wait: number; appeal: string }>(
    ({ touchpoints, wait, appeal }) => {
      if (touchpoints >= 5 || wait >= 8 || appeal === "no") return "red";
      if (touchpoints >= 3 || wait >= 5) return "yellow";
      return "green";
    },
  );
</script>
