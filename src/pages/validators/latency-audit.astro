---
import ValidatorPage from "../../components/ValidatorPage.astro";
---

<ValidatorPage
  id="VAL-03"
  metaTitle="Latency audit (VAL-03)"
  metaDescription="Compares a declared timeout with observed maximum latency, checks for a human escalation path, and returns a red, yellow, or green report card."
  variant="latency"
  defaults={{ timeout: 120, latency: 95 }}
  fix={{
    href: "/mechanisms/patterns/hard-clock",
    label: "Hard clock (MEC-04)",
  }}
>
  Compares a declared timeout with the longest latency observed, and checks for
  a human escalation path. It tests the STD-01 rule that every process has a
  declared maximum duration.
</ValidatorPage>

<script>
  import { initValidatorForm } from "../../client/validator-form";

  initValidatorForm<{ timeout: number; latency: number; escalation: string }>(
    ({ timeout, latency, escalation }) => {
      if (latency > timeout || escalation === "no") return "red";
      if (latency > timeout * 0.8) return "yellow";
      return "green";
    },
  );
</script>
