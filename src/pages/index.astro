---
import BaseLayout from "../layouts/BaseLayout.astro";
import CasebookScorecard from "../components/home/CasebookScorecard.astro";
import HeroIllustration from "../components/home/HeroIllustration.astro";
import HomeDifference from "../components/home/HomeDifference.astro";
import RobodebtTimeline from "../components/home/RobodebtTimeline.astro";
import SelfTest from "../components/home/SelfTest.astro";
import RatchetFigure from "../components/RatchetFigure.astro";
import { recentReleases } from "../content/recent-releases";

/**
 * The front door, ordered by what keeps a first-time reader on the page:
 * a failure they can picture, a door that names who they are, a test they
 * can take about their own system, then the evidence. The institute's own
 * description comes last because nobody arrives looking for it.
 */
const doors = [
  {
    href: "/roles/engineering",
    who: "I build these systems",
    what: "The checks a system has to pass before it ships, and the tools that run them.",
  },
  {
    href: "/roles/audit",
    who: "I audit or regulate them",
    what: "Citable clauses, scored public cases, and the evidence each clause needs.",
  },
  {
    href: "/diagnostics/self-defense-tools",
    who: "A system decided something about me",
    what: "Three quick checks: can this be appealed, and who can change it?",
  },
];
---

<BaseLayout
  title="Ethotechnics Institute — can anyone stop your AI system?"
  description="Open standards, scored public failures, and free diagnostics for keeping automated decision systems stoppable, explainable, and appealable."
  structuredDataType="collection"
>
  <section class="institute-hero institute-hero--story">
    <div class="institute-hero__layout">
      <div class="institute-hero__main stack-lg">
        <p class="institute-hero__eyebrow">Ethotechnics Institute</p>
        <h1 class="balanced-headline">
          The appeals kept winning. The system kept running.
        </h1>
        <p class="section-lead">
          Australia's Robodebt raised 470,000 unlawful debts over three years.
          A tribunal ruled individual debts unlawful dozens of times, and each
          ruling fixed one person's debt. Nobody with the power to stop the scheme treated those
          rulings as evidence against it.
        </p>
        <p class="section-lead">
          We publish free, open standards for one question: when an automated
          system is hurting people, can anyone stop it?
        </p>
        <div class="institute-hero__actions actions">
          <a class="button primary" href="#self-test">
            Test your system in 60 seconds
          </a>
        </div>
        <p class="institute-hero__incident small">
          Something going wrong right now?
          <a href="/failure">Go to incident triage →</a>
        </p>
      </div>
      <div class="institute-hero__side">
        <RobodebtTimeline />
      </div>
    </div>
  </section>

  <nav class="home-doors" aria-labelledby="home-doors-heading">
    <h2 id="home-doors-heading" class="eyebrow">Start from where you are</h2>
    <ul class="home-doors__list">
      {
        doors.map((door) => (
          <li>
            <a class="home-doors__door" href={door.href}>
              <span class="home-doors__who">{door.who}</span>
              <span class="home-doors__what small muted">{door.what}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="home-core">
    <div class="home-core__test">
      <SelfTest />
      <HeroIllustration class="home-core__figure" />
    </div>
  </div>

  <CasebookScorecard />

  <section
    id="ratchet"
    class="home-claim stack-lg"
    aria-labelledby="ratchet-heading"
  >
    <p class="eyebrow">The claim, in one figure</p>
    <h2 id="ratchet-heading" class="section__heading">
      A delegation can double without anyone deciding that it should.
    </h2>
    <p class="section-lead">
      Both grants below grow by the same two percent a month. One is reviewed
      only when a single step is large enough to notice, so it is never
      reviewed. The other treats every widening as a fresh authorization, so it
      can be read, questioned, and reversed. That difference is what the
      standards on this site are for.
    </p>
    <RatchetFigure level="h3" />
    <p class="small muted">
      This is Law XI of twelve. <a href="/standards/laws">Read the laws →</a>
      <a href="/standards/std-08-delegation">See what STD-08 requires →</a>
    </p>
  </section>

  <HomeDifference />

  <div class="home-supplement">
    <section class="stack-sm card card--flat">
      <p class="eyebrow">Use and cite this work</p>
      <h2>Free to use, credit, and adapt</h2>
      <p>
        Ethotechnics Institute materials are published under
        <a
          href="https://creativecommons.org/licenses/by-sa/4.0/"
          rel="noopener noreferrer"
          target="_blank"
        >
          CC BY-SA 4.0
        </a>. Credit the Institute, and publish anything you adapt under the
        same license.
      </p>
      <p class="small muted">
        Individual entries and patterns include citation metadata so you can
        reference exactly what you used.
      </p>
    </section>

    <section
      id="recently-published"
      class="stack-sm card card--flat"
      aria-labelledby="recently-published-heading"
    >
      <p class="eyebrow">New and updated</p>
      <h2 id="recently-published-heading">Recent releases</h2>
      <ul class="recent-releases">
        {
          recentReleases.map((release) => (
            <li>
              <a href={release.href}>
                {release.area} {release.version}
              </a>{" "}
              <span class="muted">
                · <time datetime={release.date}>{release.date}</time>
              </span>
              <p class="muted small">{release.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="stack-sm card card--accent">
      <p class="eyebrow">Studio</p>
      <h2>Need hands-on help?</h2>
      <p>
        Ethotechnics Studio provides commissioned support for clinical AI safety
        evaluation, diligence, governance design, and implementation work.
      </p>
      <p>
        <a
          class="button"
          href="https://ethotechnics.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ethotechnics Studio →
        </a>
      </p>
    </section>
  </div>
</BaseLayout>
