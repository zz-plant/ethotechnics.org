---
import BaseLayout from "../layouts/BaseLayout.astro";
import { failureStates } from "../content/institute-site";
---

<BaseLayout
  title="Ethotechnics Institute"
  description="Open standards for high-stakes systems that must remain reversible under failure."
>
  <section class="institute-hero stack-lg">
    <h1>Choose a governance path for your situation.</h1>
    <p>
      Select the path that best matches what you're working on.
    </p>
    <div class="actions">
      <a class="button primary" href="/#failure-intake">Start with a failure</a>
    </div>
    <p class="muted small institute-hero__decision-helper">
      Use <strong>Start with a failure</strong> when something is broken now.
      Use <strong>Quick start</strong> when you are planning ahead.
    </p>
    <details class="institute-hero__other-starts">
      <summary>Other ways to start</summary>
      <ul class="muted">
        <li>
          <a href="/quick-start">Quick start</a> for planning and team onboarding.
        </li>
        <li>
          <a href="/how-it-works">How it works</a> if you need implementation context.
        </li>
        <li>
          <a href="/standards">Browse standards</a> for policy language and references.
        </li>
        <li>
          <a href="/diagnostics">Run diagnostics</a> when you need evidence quickly.
        </li>
      </ul>
    </details>
  </section>

  <section class="stack-lg" aria-labelledby="mobile-shortcuts-title">
    <h2 id="mobile-shortcuts-title">What do you need right now?</h2>
    <p>
      Choose one path to begin. Routes are organized for quick scanning
      on phones.
    </p>
    <ul class="mobile-shortcuts" aria-label="Quick mobile shortcuts">
      <li>
        <a class="mobile-shortcuts__item" href="/quick-start">
          <span class="mobile-shortcuts__label">Need a checklist now?</span>
          <strong>Start with quick-start playbooks</strong>
        </a>
      </li>
      <li>
        <a class="mobile-shortcuts__item" href="/diagnostics">
          <span class="mobile-shortcuts__label">Need evidence now?</span>
          <strong>Start with a diagnostic tool</strong>
        </a>
      </li>
      <li>
        <a class="mobile-shortcuts__item" href="/standards">
          <span class="mobile-shortcuts__label">Need policy language now?</span>
          <strong>Start with standards language</strong>
        </a>
      </li>
    </ul>
  </section>

  <section id="failure-intake" class="stack-lg">
    <h2>What’s not holding?</h2>
    <p>Choose the closest match. This is routing, not blame.</p>
    <div class="failure-grid" aria-label="Failure routing options">
      {
        failureStates.map((state) => (
          <a class="button" href={`/failure/${state.slug}`}>
            {state.shortLabel}
          </a>
        ))
      }
    </div>
    <p class="small muted">
      Each path routes to a ready-to-use governance artifact.
    </p>
  </section>

  <section class="stack-lg">
    <h2>Choose your team lane</h2>
    <div class="adopt-grid">
      <article class="card stack-sm">
        <h3>Legal / Compliance</h3>
        <ul>
          <li>Assign decision owners</li>
          <li>Set reversal time bounds</li>
          <li>Publish appeal rules</li>
        </ul>
        <p class="small muted">Continue with:</p>
        <ul>
          <li>
            <a href="/standards/std-02-contestability-recourse"
              >STD-02 Contestability &amp; Recourse</a
            >
          </li>
          <li><a href="/adopt/policy">More for this lane</a></li>
        </ul>
      </article>

      <article class="card stack-sm">
        <h3>Appeals / Incident</h3>
        <ul>
          <li>Map queues</li>
          <li>Name freeze authority</li>
          <li>Run one tabletop</li>
        </ul>
        <p class="small muted">Continue with:</p>
        <ul>
          <li><a href="/diagnostics">Diagnostics menu</a></li>
          <li><a href="/adopt/ops">More for this lane</a></li>
        </ul>
      </article>

      <article class="card stack-sm">
        <h3>Product / Engineering</h3>
        <ul>
          <li>Instrument reversibility</li>
          <li>Test rollback paths before release</li>
          <li>Log every reversal</li>
        </ul>
        <p class="small muted">Continue with:</p>
        <ul>
          <li>
            <a href="/standards/std-01-temporal-rights"
              >STD-01 Temporal Rights</a
            >
          </li>
          <li><a href="/adopt/build">More for this lane</a></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="stack-lg" aria-labelledby="start-sequence-title">
    <h2 id="start-sequence-title">3 steps</h2>
    <ol class="card__list">
      <li><strong>1.</strong> Pick the closest risk.</li>
      <li><strong>2.</strong> Open the linked standard.</li>
      <li><strong>3.</strong> Use the artifact template.</li>
    </ol>
  </section>
</BaseLayout>
