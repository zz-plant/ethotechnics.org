---
import BaseLayout from "../layouts/BaseLayout.astro";
import CasebookScorecard from "../components/home/CasebookScorecard.astro";
import ExceptionLearningFigure from "../components/ExceptionLearningFigure.astro";
import LineMap from "../components/home/LineMap.astro";
import PublishedMap from "../components/home/PublishedMap.astro";
import RecordSpine from "../components/home/RecordSpine.astro";
import SelfTest from "../components/home/SelfTest.astro";
import { commissionedWork } from "../content/commissioned-work";

/**
 * The front door as a transit line.
 *
 * The seven-stage decision chain is the page's spine. The hero draws it with
 * the Robodebt service pattern; the record shows the warnings the institution
 * never answered; the mechanism shows the count that would have sent the rule
 * back; the casebook shows the same failure five times; the self-test asks the
 * reader to mark their own system on the line; the connections route each
 * reader; the network names what the project publishes; the colophon answers
 * the page's own question about who corrects this site.
 *
 * The world is scoped to `.home-line` on the body, so the rest of the site
 * keeps its own identity. All copy claims, data, and links are the existing
 * ones; the visual system is replaced.
 */
const doors = [
  {
    href: "/roles/engineering",
    who: "I build these systems",
  },
  {
    href: "/roles/audit",
    who: "I audit or regulate them",
  },
  {
    href: "/roles/executive",
    who: "I decide whether to deploy them",
  },
  {
    href: "/diagnostics/burden-modeler",
    who: "My team absorbs its failures",
  },
  {
    href: "/diagnostics/self-defense-tools",
    who: "A system decided something about me",
  },
  {
    href: "/research/scholarly-crossings",
    who: "I study these systems",
  },
];
---

<BaseLayout
  title="Ethotechnics — who has to act when a system is wrong?"
  titleSuffix={false}
  description="Draft standards, scored public failures, and free diagnostics for one question: when an automated decision system is wrong, does anyone have to change it?"
  bodyClass="home-line"
  mainClass="page page--home-line"
  footerOmit={["/about", "/participate#feedback", "/governance"]}
>
  <section class="line-hero line-wrap" aria-labelledby="line-hero-heading">
    <div class="line-hero__top">
      <div class="line-hero__sign">
        <span class="line-hero__plate">
          Ethotechnics <span>Line 7</span>
        </span>
        <h1 id="line-hero-heading">Who has to change it?</h1>
        <p class="line-hero__lede">
          From 2016 to 2019, Robodebt's automated rule raised about 470,000
          Australian welfare debts that were not lawfully made. A tribunal found
          individual debts unlawful dozens of times. The rule kept running.
        </p>
        <div class="line-hero__actions">
          <a class="button primary" href="#self-test">Mark your system</a>
          <a class="line-hero__urgent" href="/triage">
            Failure in progress? Triage it <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <aside class="line-hero__stamp" aria-label="Robodebt service notice">
        <span class="line-hero__stamp-label">Service disruption</span>
        <span class="line-hero__stamp-value">Robodebt</span>
        <span class="line-hero__stamp-note">
          Correction never arrived. The scheme ran until a court stopped it.
        </span>
      </aside>
    </div>
    <LineMap />
  </section>

  <section class="line-section" aria-labelledby="record-heading">
    <div class="line-wrap">
      <RecordSpine />
    </div>
  </section>

  <section
    id="mechanism"
    class="line-section"
    aria-labelledby="mechanism-heading"
  >
    <div class="line-wrap mechanism">
      <div class="mechanism__grid">
        <div class="mechanism__copy">
          <h2 id="mechanism-heading" class="line-heading">
            Each ruling fixed one debt. None of them reached the rule.
          </h2>
          <p class="line-lead">
            The department treated each ruling as one person's outcome. It
            appealed none of them, so none became a precedent, and the averaging
            rule never had to answer for them.
          </p>
          <p class="mechanism__rule">
            The fix is a count: upheld challenges recorded against the rule that
            produced them, and a set number that sends the rule back to its
            owner.
          </p>
          <div class="mechanism__links">
            <a class="line-link" href="/standards/laws#law-viii"
              >Read Law VIII</a
            >
            <a
              class="line-link"
              href="/mechanisms/patterns/policy-review-triggers"
              >Read the review trigger</a
            >
            <a class="line-link" href="/research/theory/exception-learning"
              >Read the essay on exception learning</a
            >
          </div>
        </div>
        <div class="home-draw" data-reveal="draw">
          <ExceptionLearningFigure level="h3" />
        </div>
      </div>
    </div>
  </section>

  <section class="line-section" aria-labelledby="home-casebook-heading">
    <div class="line-wrap">
      <CasebookScorecard />
    </div>
  </section>

  <section class="line-section" aria-labelledby="self-test-heading">
    <div class="line-wrap">
      <SelfTest />
    </div>
  </section>

  <section class="line-section" aria-labelledby="connections-heading">
    <div class="line-wrap connections">
      <h2 id="connections-heading" class="line-heading">Where you get on.</h2>
      <ul class="connections__list">
        {
          doors.map((door, index) => (
            <li class="connections__item">
              <a href={door.href}>
                <span class="connections__code">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="connections__who">{door.who}</span>
                <span class="connections__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="small muted">
        Not sure it applies to your system?
        <a class="line-link" href="/use-cases">Which systems this is for</a>
      </p>
    </div>
  </section>

  <section class="line-section" aria-labelledby="network-heading">
    <div class="line-wrap">
      <PublishedMap />
    </div>
  </section>

  <section
    class="line-section"
    aria-labelledby="home-colophon-heading"
    data-glossary-ignore
  >
    <div class="line-wrap colophon">
      <h2 id="home-colophon-heading" class="line-heading">
        Who has to act when this site is wrong?
      </h2>
      <dl class="colophon__list">
        <div class="colophon__item">
          <dt>Who writes it</dt>
          <dd>
            Kanav Jain writes the framework, with AI coding agents working under
            the repository's rules. Ethotechnics is the name the work publishes
            under. <a class="line-link" href="/about">About the framework</a>
          </dd>
        </div>
        <div class="colophon__item">
          <dt>Corrections</dt>
          <dd>
            If a case score, a clause, or any claim on this site is wrong, send
            the record that shows it.
            <a class="line-link" href="/participate#feedback"
              >Send a correction</a
            >
          </dd>
        </div>
        <div class="colophon__item">
          <dt>Its own failures</dt>
          <dd>
            The framework keeps the record it asks of institutions: where its
            own instruments failed, and what changed because of it.
            <a class="line-link" href="/governance#failure-archive"
              >Read the failure archive</a
            >
          </dd>
        </div>
        <div class="colophon__item">
          <dt>Commissioned work</dt>
          <dd>
            The framework is published here. Its author,
            {commissionedWork.provider}, also applies it to one organization's
            healthcare AI system at a time, under commission.
            <a class="line-link" href="/commissioned-work">How the two fit</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <script>
    import "../client/home-reveal.ts";
  </script>
</BaseLayout>
