---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeDifference from "../components/home/HomeDifference.astro";
import { failureStates } from "../content/institute-site";

const failureChoiceLabels: Record<string, string> = {
  "decision-appealed": "Decision appealed",
  "model-wrong": "Model made a harmful error",
  "queue-stuck": "Appeals or reviews are stuck",
  "user-harmed": "A user was harmed",
  "no-owner": "No owner is assigned",
  "cant-explain": "Decision cannot be clearly explained",
  "cant-stop": "System cannot be quickly stopped or rolled back",
};

const failurePriorityBadges: Record<string, string> = {
  "decision-appealed": "High · Owner in 24h",
  "model-wrong": "Critical · Pause authority needed",
  "queue-stuck": "High · Escalate in 4h",
  "user-harmed": "Critical · Human response now",
  "no-owner": "High · Assign owner",
  "cant-explain": "Medium · Review evidence",
  "cant-stop": "Critical · Activate hard halt",
};

// The badges already lead with a severity word; this is what lets the grid
// show it. Seven triage cards whose whole job is "how bad is this" rendered
// Critical, High and Medium in identical neutral grey, so severity was
// legible only by reading each card.
const failureSeverity = (badge?: string): string | undefined => {
  const level = badge?.split("·")[0]?.trim().toLowerCase();
  return level === "critical" || level === "high" || level === "medium"
    ? level
    : undefined;
};

const recentPublications = [
  "Evidence Pack Readiness diagnostic — v1.2 (March 2026)",
  "Glossary: 8 new entries on decision latency and repair authority (February 2026)",
  "Field note: Mapping invisible maintenance work in clinical AI (January 2026)",
];

const failureChoiceIcons: Record<string, string[]> = {
  "decision-appealed": [
    "M4 5.5h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8l-4 3v-3",
    "M8.5 10h7",
    "M8.5 13h4.5",
  ],
  "model-wrong": ["M10 4.5l6.8 11.8H3.2z", "M10 8.5v3.5", "M10 14.3h.01"],
  "queue-stuck": ["M10 5a5 5 0 1 1-5 5", "M10 7.5v3", "M10 10.5h2.2"],
  "user-harmed": [
    "M10 16.5s-5.5-3.1-5.5-7a3.2 3.2 0 0 1 5.5-2.3 3.2 3.2 0 0 1 5.5 2.3c0 3.9-5.5 7-5.5 7",
    "M7.9 9.4l4.2 4.2",
    "M12.1 9.4 7.9 13.6",
  ],
  "no-owner": [
    "M10 11a2.2 2.2 0 1 0-2.2-2.2A2.2 2.2 0 0 0 10 11z",
    "M5.5 15.5a4.5 4.5 0 0 1 9 0",
    "M14.2 5.8l3.2 3.2",
    "M17.4 5.8l-3.2 3.2",
  ],
  "cant-explain": [
    "M10 16.5a7 7 0 1 0-7-7",
    "M10 12.4v-.4a2 2 0 1 1 2-2",
    "M10 14.7h.01",
  ],
  "cant-stop": ["M4.5 4.5h11v11h-11z", "M8 8h4v4H8z"],
};
---

<BaseLayout
  title="Ethotechnics Institute — Open commons for accountable AI governance"
  description="The open-access home of Ethotechnics standards, ontology, glossary, and diagnostics for teams building or auditing high-stakes AI systems."
  structuredDataType="collection"
>
  <section class="institute-hero stack-lg">
    <div class="institute-hero__layout">
      <div class="institute-hero__main stack-lg">
        <p class="institute-hero__eyebrow">
          Ethotechnics Institute · Open commons
        </p>
        <h1 class="balanced-headline">
          Make high-stakes AI easier to stop, explain, appeal, and repair
        </h1>
        <p class="section-lead">
          When an organization lets software decide who gets a loan, a shift, a
          benefit, or a refund, it hands over part of its own authority. This
          site is about keeping that handover reviewable: who authorized this
          kind of decision, on what evidence, until when, who is allowed to
          object, and what actually changes when they do.
        </p>
        <p class="section-lead">
          Start with a live decision, an incident, or a policy gap. Leave with
          named owners, clocks, evidence, and next actions, using open
          standards, mechanisms, and diagnostics you can cite.
        </p>
        <p class="small muted">
          Other frameworks ask whether you managed risk responsibly. This one
          asks whether the system can still be stopped while it is harming
          someone, and whether the people carrying that harm can make it stop.
          <a href="/standards/#comparison">See how it differs →</a>
          <a href="/method">How the method works →</a>
        </p>
        <p class="small">
          For commercial application of the framework (clinical AI safety
          evaluation, VC diligence, and governance advisory), see
          <a
            href="https://ethotechnics.com"
            rel="noopener noreferrer"
            target="_blank">Ethotechnics Studio</a
          >.
        </p>
      </div>

      <aside
        class="institute-hero__starter panel stack-sm"
        aria-label="Homepage starter"
      >
        <p class="eyebrow">Start here</p>
        <p class="institute-hero__decision-helper muted small">
          Not sure where to begin? Pick the situation that matches your work and
          follow a short path.
        </p>
        <div class="actions" aria-label="Primary standards actions">
          <a class="button primary" href="/start"> Find my starting point </a>
          <a class="button ghost" href="/glossary"> Browse terms → </a>
        </div>
        <ul
          class="institute-hero__status"
          aria-label="Institute publication status"
        >
          <li>
            <svg
              viewBox="0 0 20 20"
              role="presentation"
              focusable="false"
              aria-hidden="true"
            >
              <path d="M3.5 5.5h13v9h-13z" fill="none"></path>
              <path d="M6 8h8"></path>
              <path d="M6 11h6"></path>
            </svg>
            <span>Open-access standards and diagnostics</span>
          </li>
          <li>
            <svg
              viewBox="0 0 20 20"
              role="presentation"
              focusable="false"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="6.5" fill="none"></circle>
              <path d="M10 6.8v3.5"></path>
              <path d="M10 12.8h.01"></path>
            </svg>
            <span>Versioned, citable framework resources</span>
          </li>
          <li>
            <svg
              viewBox="0 0 20 20"
              role="presentation"
              focusable="false"
              aria-hidden="true"
            >
              <path
                d="M10 3.7l5.6 2.1v3.7c0 3.6-2.4 5.9-5.6 6.9-3.2-1-5.6-3.3-5.6-6.9V5.8z"
                fill="none"></path>
              <path d="M8.2 9.9l1.4 1.4 2.5-2.5"></path>
            </svg>
            <span>Built for policy, audit, and research uptake</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <div class="home-core">
    <section id="governance-ontology" class="stack-sm card">
      <p class="eyebrow">Shared language</p>
      <h2>Plain definitions and reference data</h2>
      <p>
        Definitions for concepts like burden, contestability, repair, and
        stoppability, with stable links and JSON for audits, tools, and
        research. Use it when a team needs the same words to mean the same
        things.
      </p>
      <p>
        <a href="/taxonomy">Browse definitions →</a>
        <span aria-hidden="true"> · </span>
        <a href="/api">Use the JSON API →</a>
      </p>
    </section>

    <section id="failure-intake" class="stack-lg">
      <p class="eyebrow">Incident triage</p>
      <h2 id="failure-intake-heading">What is going wrong right now?</h2>
      <p class="section-lead">
        Choose the closest failure mode. Each path starts with what to do now,
        then names who should own follow-up and what evidence to collect.
      </p>
      <ul class="failure-grid" aria-labelledby="failure-intake-heading">
        {
          failureStates.map((state) => {
            const iconPaths = failureChoiceIcons[state.slug] ?? [
              "M5 10h10",
              "M11 6l4 4-4 4",
            ];
            return (
              <li>
                <a
                  class="button failure-grid__button"
                  href={`/failure/${state.slug}`}
                >
                  <span class="failure-grid__label">
                    <span class="failure-grid__title">
                      <span class="failure-grid__state-icon" aria-hidden="true">
                        <svg
                          viewBox="0 0 20 20"
                          role="presentation"
                          focusable="false"
                        >
                          {iconPaths.map((pathValue) => (
                            <path d={pathValue} />
                          ))}
                        </svg>
                      </span>
                      <span>
                        {failureChoiceLabels[state.slug] ?? state.shortLabel}
                      </span>
                    </span>
                    <span
                      class="failure-grid__priority small"
                      data-severity={failureSeverity(
                        failurePriorityBadges[state.slug],
                      )}
                    >
                      {failurePriorityBadges[state.slug] ?? "Review now"}
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
      <p class="small muted">
        Use these when a real person, queue, or decision needs attention—not
        just documentation.
      </p>
    </section>

    <section class="stack-lg">
      <p class="eyebrow">Audit and compliance</p>
      <h2>Map practical controls to standards and audits</h2>
      <p class="section-lead">
        Standards are written so teams can cite requirements, assign owners, and
        show evidence without translating abstract principles from scratch.
      </p>
      <div class="adopt-grid">
        {
          [
            {
              title: "Regulatory mapping",
              items: [
                "EU AI Act references",
                "NIST AI RMF mappings",
                "ISO and sector references",
              ],
            },
            {
              title: "Audit handoff",
              items: [
                "Evidence fields for GRC workflows",
                "Owners, deadlines, and escalation clocks",
                "Artifacts for internal or regulator review",
              ],
            },
            {
              title: "Adoption paths",
              items: [
                "Policy teams can cite clauses",
                "Operations teams can rehearse stoppability",
                "Engineering teams can tie rollback to release gates",
              ],
            },
          ].map((lane) => (
            <article class="card lane-card stack-sm">
              <h3>{lane.title}</h3>
              <ul class="lane-links">
                {lane.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>
  </div>

  <HomeDifference />

  <div class="home-supplement">
    <section class="stack-sm card card--flat">
      <p class="eyebrow">Use and cite this work</p>
      <h2>Free to use with attribution</h2>
      <p>
        Ethotechnics Institute materials are published under
        <a
          href="https://creativecommons.org/licenses/by/4.0/"
          rel="noopener noreferrer"
          target="_blank"
        >
          CC BY 4.0
        </a>.
      </p>
      <p class="small muted">
        Individual entries and patterns include citation metadata so you can
        reference exactly what you used.
      </p>
    </section>

    <section
      id="recently-published"
      class="stack-sm card card--flat"
      aria-labelledby="recently-published-heading"
    >
      <p class="eyebrow">New and updated</p>
      <h2 id="recently-published-heading">Recent releases</h2>
      <ul class="recent-releases">
        {recentPublications.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="stack-sm card card--accent">
      <p class="eyebrow">Studio</p>
      <h2>Need hands-on help?</h2>
      <p>
        Ethotechnics Studio provides commissioned support for clinical AI safety
        evaluation, diligence, governance design, and implementation work.
      </p>
      <p>
        <a
          class="button"
          href="https://ethotechnics.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ethotechnics Studio →
        </a>
      </p>
    </section>
  </div>
</BaseLayout>
