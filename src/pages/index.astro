---
import BaseLayout from "../layouts/BaseLayout.astro";
import CasebookScorecard from "../components/home/CasebookScorecard.astro";
import ExceptionLearningFigure from "../components/ExceptionLearningFigure.astro";
import HomeRail from "../components/home/HomeRail.astro";
import PublishedMap from "../components/home/PublishedMap.astro";
import RecordSpine from "../components/home/RecordSpine.astro";
import SafeguardMap from "../components/home/SafeguardMap.astro";
import SelfTest from "../components/home/SelfTest.astro";
import { commissionedWork } from "../content/commissioned-work";

/**
 * The front door as one story in reading order, told without ever holding
 * the scroll. The hero asks the question the page then puts to the reader's
 * system (the self-test) and to this site (the colophon), and answers it
 * once with Robodebt. Then: watch one scheme run (the record), see why
 * rulings did not stop it (the mechanism), see that it was not special (the
 * casebook), then turn to the reader's own system (the self-test, scored on
 * the six-node figure). Listing what the Institute publishes is not the
 * lede's job; the map after the self-test does it, read from the header's
 * menu, so the front door names the discipline and every body of work
 * behind the one example. It closes on the site's own answer to its
 * question: who writes it, where a correction goes, and where the
 * framework's instruments failed. The claims are the table on /about,
 * and the positioning band leads the completions on
 * /research/scholarly-crossings. The two-ledger rail at the viewport edge is
 * the same grammar, as chrome.
 *
 * Each idea is drawn as well as written, for readers who think in pictures:
 * the record draws the unanswered warnings as a rail, the mechanism leads
 * with the exception-learning drawing that shows both the broken path and
 * the fix, and the self-test draws the reader's system as a six-node ring.
 *
 * The role doors sit in the masthead, beside the question, so a reader who
 * will not scroll the story still has a next page on the first screen: on a
 * phone the header bar shows no sections, and the doors are the first
 * screen's only way past it. They name the reader, not the site's sections;
 * the header carries the sections. They appear only there.
 */
const doors = [
  {
    href: "/roles/engineering",
    who: "I build these systems",
  },
  {
    href: "/roles/audit",
    who: "I audit or regulate them",
  },
  {
    href: "/roles/executive",
    who: "I decide whether to deploy them",
  },
  // 2026-10-24: the protective half of the discipline (arrangements that
  // consume the capacity they run on) had no door; this is its entrance.
  {
    href: "/diagnostics/burden-modeler",
    who: "My team absorbs its failures",
  },
  {
    href: "/diagnostics/self-defense-tools",
    who: "A system decided something about me",
  },
  {
    href: "/research/scholarly-crossings",
    who: "I study these systems",
  },
];
---

<BaseLayout
  title="Ethotechnics Institute — who has to act when a system is wrong?"
  titleSuffix={false}
  description="Open standards, scored public failures, and free diagnostics for one question: when an automated decision system is wrong, does anyone have to change it?"
  structuredDataType="collection"
  footerOmit={["/about", "/participate#feedback", "/institute/governance"]}
>
  <HomeRail />

  <section class="institute-hero institute-hero--story">
    <div class="institute-hero__main">
      <p class="institute-hero__eyebrow">Ethotechnics Institute</p>
      <h1 class="balanced-headline">
        When an automated system is wrong, does anyone have to change it?
      </h1>
      <p class="institute-hero__lede">
        From 2016 to 2019, Robodebt's automated rule raised about 470,000
        Australian welfare debts that were not lawfully made. A tribunal found
        individual debts unlawful dozens of times. The rule kept running.
      </p>
      <div class="institute-hero__actions actions">
        <a class="button primary" href="#self-test">
          Test your system in 60 seconds
        </a>
        <a class="button ghost institute-hero__triage-link" href="/triage">
          Triage a failure in progress
        </a>
      </div>
    </div>
    <nav class="home-doors" aria-labelledby="home-doors-heading">
      <h2 id="home-doors-heading" class="home-doors__heading">
        Start from where you are
      </h2>
      <ul class="home-doors__list">
        {
          doors.map((door) => (
            <li>
              <a class="home-doors__door" href={door.href}>
                <span class="home-doors__who">{door.who}</span>
                <span class="home-doors__action" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="home-doors__fit small muted">
        Not sure it applies to your system?
        <a href="/use-cases">Which systems this is for</a>
      </p>
    </nav>
  </section>

  <RecordSpine />

  <section
    id="mechanism"
    class="home-claim stack-md"
    aria-labelledby="mechanism-heading"
  >
    <div class="home-split-header">
      <div class="stack-sm">
        <p class="eyebrow">Why the rulings did not stop it</p>
        <h2 id="mechanism-heading" class="section__heading">
          Each ruling fixed one debt. None of them reached the rule.
        </h2>
      </div>
      <p class="section-lead">
        The department treated each ruling as one person's outcome. It appealed
        none of them, so none became a precedent, and the averaging rule never
        had to answer for them. The fix is a count: upheld challenges recorded
        against the rule that produced them, and a set number that sends the
        rule back to its owner.
      </p>
    </div>
    <div class="home-draw" data-reveal="draw">
      <ExceptionLearningFigure level="h3" />
    </div>
    <p class="small muted">
      This is Law VIII of the laws the standards are built on: observability
      without state transition is theater.
      <a href="/standards/laws#law-viii">Read Law VIII</a> ·
      <a href="/mechanisms/patterns/policy-review-triggers"
        >Read the review trigger</a
      > ·
      <a href="/research/theory/exception-learning"
        >Read the essay on exception learning</a
      >
    </p>
  </section>

  <CasebookScorecard />

  <div class="home-core">
    <div class="home-core__test">
      <SelfTest />
      <SafeguardMap class="home-core__figure" />
    </div>
  </div>

  <PublishedMap />

  {
    /*
      The site's own answer to the question it asks of institutions. It
      names the author and the routes a correction can take, so the footer
      below leaves out the About, feedback, and governance links it would
      otherwise repeat (footerOmit above).
    */
  }
  <section
    class="home-colophon"
    aria-labelledby="home-colophon-heading"
    data-glossary-ignore
  >
    <h2 id="home-colophon-heading" class="home-colophon__heading">
      Who has to act when this site is wrong?
    </h2>
    <div class="home-colophon__cols">
      <div>
        <p class="home-colophon__label">Who writes it</p>
        <p class="home-colophon__text">
          Kanav Jain writes the framework as part of an institutional
          error-accounting research program.
          <a href="/about">About the framework</a>
        </p>
      </div>
      <div>
        <p class="home-colophon__label">Corrections</p>
        <p class="home-colophon__text">
          If a case score, a clause, or any claim on this site is wrong, send
          the record that shows it.
          <a href="/participate#feedback">Send a correction</a>
        </p>
      </div>
      <div>
        <p class="home-colophon__label">Its own failures</p>
        <p class="home-colophon__text">
          The framework keeps the record it asks of institutions: where its own
          instruments failed, and what changed because of it.
          <a href="/institute/governance#failure-archive">
            Read the failure archive
          </a>
        </p>
      </div>
      <div>
        <p class="home-colophon__label">Commissioned work</p>
        <p class="home-colophon__text">
          The Institute publishes the framework. Its author,
          {commissionedWork.provider}, also applies it to one organization's
          healthcare AI system at a time, under commission.
          <a href="/institute/commissioned-work">How the two fit</a>
        </p>
      </div>
    </div>
  </section>

  <script>
    import "../client/home-reveal.ts";
  </script>
</BaseLayout>
