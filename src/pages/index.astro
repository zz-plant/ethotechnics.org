---
import BaseLayout from "../layouts/BaseLayout.astro";
import CasebookScorecard from "../components/home/CasebookScorecard.astro";
import HomeDifference from "../components/home/HomeDifference.astro";
import HomeRail from "../components/home/HomeRail.astro";
import RecordSpine from "../components/home/RecordSpine.astro";
import RobodebtLoop from "../components/home/RobodebtLoop.astro";
import SafeguardMap from "../components/home/SafeguardMap.astro";
import SelfTest from "../components/home/SelfTest.astro";
import RatchetFigure from "../components/RatchetFigure.astro";
import { recentReleases } from "../content/recent-releases";

/**
 * The front door as one story in reading order, told without ever holding
 * the scroll: watch one scheme run (the record), see why rulings did not
 * stop it (the mechanism), see that it was not special (the casebook), then
 * turn to the reader's own system (the self-test) and the doors out. The
 * two-ledger rail at the viewport edge is the same grammar, as chrome.
 *
 * Each idea is drawn as well as written, for readers who think in pictures:
 * the hero draws the headline as a loop that never closed, the casebook
 * names its glyph columns before its rows, and the self-test draws the
 * reader's system as the same loop, filled in by their answers.
 */
const doors = [
  {
    href: "/roles/engineering",
    who: "I build these systems",
    what: "The checks a system has to pass before it ships, and the tools that run them.",
  },
  {
    href: "/roles/audit",
    who: "I audit or regulate them",
    what: "Citable clauses, scored public cases, and the evidence each clause needs.",
  },
  {
    href: "/diagnostics/self-defense-tools",
    who: "A system decided something about me",
    what: "Three checks: can this decision be challenged, can the appeal change the outcome, and who holds power here?",
  },
];
---

<BaseLayout
  title="Ethotechnics Institute — who has to act when a system is wrong?"
  description="Open standards, scored public failures, and free diagnostics for one question: when an automated decision system is wrong, does anyone have to change it?"
  structuredDataType="collection"
>
  <HomeRail />

  <section class="institute-hero institute-hero--story">
    <div class="institute-hero__main stack-lg">
      <p class="institute-hero__eyebrow">Ethotechnics Institute</p>
      <h1 class="balanced-headline">
        The appeals kept winning. The system kept running.
      </h1>
      <p class="section-lead">
        That was Robodebt, Australia's automated welfare-debt scheme. We publish
        open standards, public case scores, and diagnostics for one question:
        when an automated decision system is hurting people, does evidence of
        the harm reach someone who has to change the system?
      </p>
      <div class="institute-hero__actions actions">
        <a class="button primary" href="#self-test">
          Test your system in 60 seconds
        </a>
        <a class="button ghost institute-hero__triage-link" href="/triage">
          <span class="incident-dot" aria-hidden="true"></span>
          Incident triage →
        </a>
      </div>
      <nav
        class="home-doors home-doors--strip"
        aria-labelledby="home-doors-strip-label"
      >
        <span class="home-doors__strip-label" id="home-doors-strip-label"
          >Start by role:</span
        >
        <ul>
          {
            doors.map((door) => (
              <li>
                <a class="home-doors__strip-link" href={door.href}>
                  {door.who}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <RobodebtLoop class="institute-hero__figure" />
  </section>

  <RecordSpine />

  <section
    id="mechanism"
    class="home-claim stack-md"
    aria-labelledby="mechanism-heading"
  >
    <div class="home-split-header">
      <div class="stack-sm">
        <p class="eyebrow">Why nobody stopped it</p>
        <h2 id="mechanism-heading" class="section__heading">
          A system's reach can double without anyone deciding that it should.
        </h2>
      </div>
      <p class="section-lead">
        At launch the scheme's reach grew about fifty-fold, and nobody
        re-examined its authority to raise debts. Reach can also grow in steps
        too small to trigger a review. STD-08 requires every step to be recorded
        as its own approval.
      </p>
    </div>
    <div class="home-draw" data-reveal="draw">
      <RatchetFigure level="h3" />
    </div>
    <p class="small muted">
      This is Law XI of the twelve the standards are built on: successful
      automation increases its own governance burden.
      <a href="/standards/laws#law-xi">Read Law XI →</a>
      <a href="/standards/std-08-delegation">See what STD-08 requires →</a>
    </p>
  </section>

  <CasebookScorecard />

  <HomeDifference />

  <div class="home-core">
    <div class="home-core__test">
      <SelfTest />
      <SafeguardMap class="home-core__figure" />
    </div>
  </div>

  <nav class="home-doors" aria-labelledby="home-doors-heading">
    <div class="home-doors__header">
      <p class="eyebrow">Start from where you are</p>
      <h2 id="home-doors-heading" class="section__heading">Three ways in.</h2>
      <p class="section-lead">
        Pick the one that fits. Each leads to the standards, tools, and cases
        that apply to you.
      </p>
    </div>
    <ul class="home-doors__list">
      {
        doors.map((door) => (
          <li>
            <a class="home-doors__door" href={door.href}>
              <span class="home-doors__who">{door.who}</span>
              <span class="home-doors__what small muted">{door.what}</span>
              <span class="home-doors__action">View path →</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="home-doors__fit small muted">
      Not sure the framework applies to your system?
      <a href="/use-cases">See which systems it is for →</a>
    </p>
  </nav>

  <div class="home-supplement">
    <section
      id="recently-published"
      class="stack-sm card card--flat home-supplement__releases"
      aria-labelledby="recently-published-heading"
    >
      <p class="eyebrow">New and updated</p>
      <h2 id="recently-published-heading">Recent releases</h2>
      <ul class="recent-releases">
        {
          recentReleases.map((release) => (
            <li>
              <div class="recent-releases__header">
                <a href={release.href} class="recent-releases__title">
                  {release.area} {release.version}
                </a>
                <time
                  class="recent-releases__date muted small"
                  datetime={release.date}
                >
                  {release.date}
                </time>
              </div>
              <p class="muted small">{release.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="home-supplement__aside">
      <section class="stack-sm card card--flat">
        <p class="eyebrow">Use and cite this work</p>
        <h2>Free to use, credit, and adapt</h2>
        <p>
          Ethotechnics Institute materials are published under
          <a
            href="https://creativecommons.org/licenses/by-sa/4.0/"
            rel="noopener noreferrer"
            target="_blank"
          >
            CC BY-SA 4.0
          </a>. Credit the Institute, and publish anything you adapt under the
          same license.
        </p>
        <p class="small muted">
          Individual entries and patterns include citation metadata so you can
          reference exactly what you used.
        </p>
      </section>

      <section class="stack-sm card card--accent">
        <p class="eyebrow">Studio</p>
        <h2>Need hands-on help?</h2>
        <p>
          Ethotechnics Studio provides commissioned support for clinical AI
          safety evaluation, diligence, governance design, and implementation
          work.
        </p>
        <p>
          <a
            class="button"
            href="https://ethotechnics.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ethotechnics Studio →
          </a>
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import "../scripts/home-reveal.ts";
</script>
