---
import BaseLayout from "../layouts/BaseLayout.astro";
import { failureStates } from "../content/institute-site";
import { renderCompactScene, type SceneType } from "../data/scenes";

const failureSceneMap: Record<string, { scene: SceneType; accent: string }> = {
  "decision-appealed": { scene: "review", accent: "#f97316" },
  "model-wrong": { scene: "signals", accent: "#f43f5e" },
  "queue-stuck": { scene: "pipeline", accent: "#3b82f6" },
  "user-harmed": { scene: "signals", accent: "#f43f5e" },
  "no-owner": { scene: "cards", accent: "#64748b" },
  "cant-explain": { scene: "notebook", accent: "#64748b" },
  "cant-stop": { scene: "hex", accent: "#f43f5e" },
};

const failureChoiceLabels: Record<string, string> = {
  "decision-appealed": "Decision appealed",
  "model-wrong": "Model made a harmful error",
  "queue-stuck": "Appeals or reviews are stuck",
  "user-harmed": "A user was harmed",
  "no-owner": "No owner is assigned",
  "cant-explain": "Decision cannot be clearly explained",
  "cant-stop": "System cannot be quickly stopped or rolled back",
};

const failurePriorityBadges: Record<string, string> = {
  "decision-appealed": "High · Owner in 24h",
  "model-wrong": "Critical · Pause authority needed",
  "queue-stuck": "High · Escalate in 4h",
  "user-harmed": "Critical · Human response now",
  "no-owner": "High · Assign owner",
  "cant-explain": "Medium · Review evidence",
  "cant-stop": "Critical · Activate hard halt",
};

const heroSecondaryChips = [
  {
    label: "Start with the glossary",
    href: "/glossary",
  },
  {
    label: "Browse ontology and API",
    href: "/api",
  },
  {
    label: "Read field diagnostics",
    href: "/diagnostics",
  },
];

const mobileQuickActions = [
  {
    title: "Start with glossary",
    description: "Learn the framework through core terms",
    href: "/glossary",
    iconPaths: ["M4.5 5.5h11v9h-11z", "M7 9h6"],
  },
  {
    title: "Browse ontology API",
    description: "Use canonical definitions in your tools",
    href: "/api",
    iconPaths: ["M5 10.4l3 3 7-7"],
  },
  {
    title: "Open diagnostics",
    description: "Run governance and evidence checks",
    href: "/diagnostics",
    iconPaths: ["M5 7h10", "M5 10h10"],
  },
];

const jumpAnchors = [
  {
    label: "Glossary",
    href: "#start-with-glossary",
  },
  {
    label: "Ontology & API",
    href: "#governance-ontology",
  },
  {
    label: "Incident triage",
    href: "#failure-intake",
  },
  {
    label: "Recently published",
    href: "#recently-published",
  },
];

const recentPublications = [
  "Evidence Pack Readiness diagnostic — v1.2 (March 2026)",
  "Glossary: 8 new entries on decision latency and repair authority (February 2026)",
  "Field note: Mapping invisible maintenance work in clinical AI (January 2026)",
];

const failureChoiceIcons: Record<string, string[]> = {
  "decision-appealed": [
    "M4 5.5h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8l-4 3v-3",
    "M8.5 10h7",
    "M8.5 13h4.5",
  ],
  "model-wrong": ["M10 4.5l6.8 11.8H3.2z", "M10 8.5v3.5", "M10 14.3h.01"],
  "queue-stuck": ["M10 5a5 5 0 1 1-5 5", "M10 7.5v3", "M10 10.5h2.2"],
  "user-harmed": [
    "M10 16.5s-5.5-3.1-5.5-7a3.2 3.2 0 0 1 5.5-2.3 3.2 3.2 0 0 1 5.5 2.3c0 3.9-5.5 7-5.5 7",
    "M7.9 9.4l4.2 4.2",
    "M12.1 9.4 7.9 13.6",
  ],
  "no-owner": [
    "M10 11a2.2 2.2 0 1 0-2.2-2.2A2.2 2.2 0 0 0 10 11z",
    "M5.5 15.5a4.5 4.5 0 0 1 9 0",
    "M14.2 5.8l3.2 3.2",
    "M17.4 5.8l-3.2 3.2",
  ],
  "cant-explain": [
    "M10 16.5a7 7 0 1 0-7-7",
    "M10 12.4v-.4a2 2 0 1 1 2-2",
    "M10 14.7h.01",
  ],
  "cant-stop": ["M4.5 4.5h11v11h-11z", "M8 8h4v4H8z"],
};
---

<BaseLayout
  title="Ethotechnics Institute — Open commons for accountable AI governance"
  description="The open-access home of Ethotechnics standards, ontology, glossary, and diagnostics for teams building or auditing high-stakes AI systems."
  structuredDataType="collection"
>
  <section class="institute-hero stack-lg">
    <div class="institute-hero__layout">
      <div class="institute-hero__main stack-lg">
        <p class="institute-hero__eyebrow">Ethotechnics Institute · Open commons</p>
        <h1 class="balanced-headline">
          Public standards, ontology, and diagnostics for accountable high-stakes AI
        </h1>
        <p class="section-lead">
          The Ethotechnics Institute is the public, open-access arm of the Ethotechnics
          framework. We publish formal standards, a governance ontology, a practitioner
          glossary, and field diagnostics for teams building or auditing high-stakes AI
          systems. Everything here is free to use, cite, and build on.
        </p>
        <p class="small">
          For commercial application of the framework (clinical AI safety evaluation, VC
          diligence, and governance advisory), see
          <a href="https://ethotechnics.com" rel="noopener noreferrer" target="_blank">
            Ethotechnics Studio
          </a>.
        </p>
        <ul class="institute-hero__status" aria-label="Institute publication status">
          <li>
            <svg viewBox="0 0 20 20" role="presentation" focusable="false" aria-hidden="true">
              <path d="M3.5 5.5h13v9h-13z" fill="none"></path>
              <path d="M6 8h8"></path>
              <path d="M6 11h6"></path>
            </svg>
            <span>Open-access standards and diagnostics</span>
          </li>
          <li>
            <svg viewBox="0 0 20 20" role="presentation" focusable="false" aria-hidden="true">
              <circle cx="10" cy="10" r="6.5" fill="none"></circle>
              <path d="M10 6.8v3.5"></path>
              <path d="M10 12.8h.01"></path>
            </svg>
            <span>Versioned, citable framework resources</span>
          </li>
          <li>
            <svg viewBox="0 0 20 20" role="presentation" focusable="false" aria-hidden="true">
              <path
                d="M10 3.7l5.6 2.1v3.7c0 3.6-2.4 5.9-5.6 6.9-3.2-1-5.6-3.3-5.6-6.9V5.8z"
                fill="none"></path>
              <path d="M8.2 9.9l1.4 1.4 2.5-2.5"></path>
            </svg>
            <span>Built for policy, audit, and research uptake</span>
          </li>
        </ul>
      </div>

      <aside class="institute-hero__starter panel stack-sm" aria-label="Homepage starter">
        <p class="eyebrow">Start here</p>
        <p class="institute-hero__decision-helper muted small">
          Begin with the glossary for core terms, then explore ontology, diagnostics, and standards.
        </p>
        <div class="actions" aria-label="Primary standards actions">
          <a class="button" href="/glossary">
            Start with the glossary
          </a>
          <a class="button ghost" href="/start-here">
            More entry points →
          </a>
        </div>
      </aside>
    </div>
  </section>

  <div class="home-core">
  <section id="governance-ontology" class="stack-sm card">
    <p class="eyebrow">Reference contribution</p>
    <h2>Governance Ontology &amp; Reference API</h2>
    <p>
      A formal vocabulary of 40+ concepts used in accountability, burden, and
      care-infrastructure governance — with scope notes, citations from moral
      philosophy, STS, and organizational theory, and a read-only API for consuming
      canonical definitions in audits, tools, and research. The ontology is
      versioned and citable.
    </p>
    <p>
      <a href="/taxonomy">Browse the ontology →</a>
      <span aria-hidden="true"> · </span>
      <a href="/api">View API reference →</a>
    </p>
  </section>

  <section id="failure-intake" class="stack-lg">
    <p class="eyebrow">Incident triage</p>
    <h2 id="failure-intake-heading">What needs attention right now?</h2>
    <p class="section-lead">
      Follow one sequence: triage the failure, stabilize the workflow, then collect evidence for review.
    </p>
    <ul class="failure-grid" aria-labelledby="failure-intake-heading">
      {
        failureStates.map((state) => {
          const iconPaths = failureChoiceIcons[state.slug] ?? ["M5 10h10", "M11 6l4 4-4 4"];
          const sceneCfg = failureSceneMap[state.slug];
          const sceneSvg = sceneCfg ? renderCompactScene(sceneCfg) : "";

          return (
            <li>
              {sceneSvg && <div style="border-radius: 4px; overflow: hidden; margin-bottom: 0.4rem;" set:html={sceneSvg} />}
              <a class="button failure-grid__button" href={`/failure/${state.slug}`}>
                <span class="failure-grid__label">
                  <span class="failure-grid__title">
                    <span class="failure-grid__state-icon" aria-hidden="true">
                      <svg viewBox="0 0 20 20" role="presentation" focusable="false">
                        {iconPaths.map((pathValue) => (
                          <path d={pathValue} />
                        ))}
                      </svg>
                    </span>
                    <span>{failureChoiceLabels[state.slug] ?? state.shortLabel}</span>
                  </span>
                  <span class="failure-grid__priority small muted">
                    {failurePriorityBadges[state.slug] ?? "Review now"}
                  </span>
                </span>
                <svg
                  class="failure-grid__icon"
                  viewBox="0 0 20 20"
                  role="presentation"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M5 10h10" />
                  <path d="M11 6l4 4-4 4" />
                </svg>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="small muted">
      Each option routes to triage actions first, then stabilization owners, then evidence artifacts.
    </p>
  </section>

  <section class="stack-lg">
    <p class="eyebrow">Compliance support</p>
    <h2>Connect your work to regulatory and audit expectations</h2>
    <p class="section-lead">
      Each standard is organized so teams can cite policy clearly, prepare for
      internal review, and share complete evidence with regulators.
    </p>
    <div class="adopt-grid">
      {[
        { title: "Regulatory alignment", items: ["EU AI Act obligations", "NIST AI RMF control mapping", "ISO and sector supervision references"], scene: { scene: "cards" as const, accent: "#3b82f6" } },
        { title: "Audit interoperability", items: ["Evidence fields designed for GRC workflows", "Structured ownership and escalation clocks", "Exportable artifacts for regulator review"], scene: { scene: "review" as const, accent: "#14b8a6" } },
        { title: "Adoption pathways", items: ["Policy teams adopt document IDs and clauses", "Operations teams install stoppability drills", "Engineering teams bind rollback to release gates"], scene: { scene: "pipeline" as const, accent: "#f97316" } },
      ].map((lane) => (
        <article class="card lane-card stack-sm">
          {lane.scene && <div style="border-radius: 4px; overflow: hidden; margin-bottom: 0.5rem;" set:html={renderCompactScene(lane.scene)} />}
          <h3>{lane.title}</h3>
          <ul class="lane-links">
            {lane.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
  </div>

  <div class="home-supplement">

  <section class="stack-sm card card--flat">
    <p class="eyebrow">Citing this work</p>
    <h2>How to cite Ethotechnics</h2>
    <p>
      Ethotechnics Institute materials are published under
      <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener noreferrer" target="_blank">
        CC BY 4.0
      </a>.
      To cite the framework:
    </p>
    <blockquote>
      Jain, K. (2025). <em>Ethotechnics: A governance and care-infrastructure framework for high-stakes systems.</em>
      Ethotechnics Institute. https://ethotechnics.org
    </blockquote>
    <p class="small muted">
      Individual glossary entries and patterns include their own citation metadata.
    </p>
  </section>

  <div class="home-supplement">  <section id="recently-published" class="stack-sm card card--flat" aria-labelledby="recently-published-heading">
    <p class="eyebrow">What&apos;s new</p>
    <h2 id="recently-published-heading">Recently published</h2>
    <ul style="list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem;">
      {recentPublications.map((item) => <li><span class="pill">{item}</span></li>)}
    </ul>
  </section>

  <section class="stack-sm card card--accent">
    <p class="eyebrow">Studio</p>
    <h2>Commercial application</h2>
    <p>
      For clinical AI safety evaluation, VC diligence, and governance advisory,
      Ethotechnics Studio offers commissioned engagements applying the framework
      to high-stakes systems.
    </p>
    <p>
      <a class="button" href="https://ethotechnics.com/">
        Ethotechnics Studio →
      </a>
    </p>
  </section>
  </div>
</BaseLayout>
