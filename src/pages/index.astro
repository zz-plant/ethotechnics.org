---
import BaseLayout from "../layouts/BaseLayout.astro";
import CasebookScorecard from "../components/home/CasebookScorecard.astro";
import HomeClaims from "../components/home/HomeClaims.astro";
import HomeRail from "../components/home/HomeRail.astro";
import RecordSpine from "../components/home/RecordSpine.astro";
import RobodebtLoop from "../components/home/RobodebtLoop.astro";
import SafeguardMap from "../components/home/SafeguardMap.astro";
import SelfTest from "../components/home/SelfTest.astro";
import ExceptionLearningFigure from "../components/ExceptionLearningFigure.astro";
import SectionBlock from "../components/SectionBlock.astro";
import { studioSummary } from "../content/studio";

/**
 * The front door as one story in reading order, told without ever holding
 * the scroll: watch one scheme run (the record), see why rulings did not
 * stop it (the mechanism), see that it was not special (the casebook), state
 * what the framework adds to the field (the positioning band), test what an
 * institution says about itself (the claims), then turn to the reader's own
 * system (the self-test) and the doors out — four of them, the last for the
 * readers who study or govern these systems. The two-ledger rail at the
 * viewport edge is the same grammar, as chrome.
 *
 * Each idea is drawn as well as written, for readers who think in pictures:
 * the hero draws the headline as a loop that never closed, the casebook
 * names its glyph columns before its rows, and the self-test draws the
 * reader's system as the same loop, filled in by their answers.
 */
const doors = [
  {
    href: "/roles/engineering",
    who: "I build these systems",
    what: "The checks a system has to pass before it ships, and the tools that run them.",
  },
  {
    href: "/roles/audit",
    who: "I audit or regulate them",
    what: "Citable clauses, scored public cases, and the evidence each clause needs.",
  },
  {
    href: "/diagnostics/self-defense-tools",
    who: "A system decided something about me",
    what: "Three checks: can this decision be challenged, can the appeal change the outcome, and who holds power here?",
  },
  {
    href: "/research/scholarly-crossings",
    who: "I study or govern these systems",
    what: "What the framework adds to adjacent theory, what it asks of rival mechanisms, and where the argument is contestable.",
  },
];
---

<BaseLayout
  title="Ethotechnics Institute — who has to act when a system is wrong?"
  description="Open standards, scored public failures, and free diagnostics for one question: when an automated decision system is wrong, does anyone have to change it?"
  structuredDataType="collection"
>
  <HomeRail />

  <section class="institute-hero institute-hero--story">
    <div class="institute-hero__main stack-lg">
      <p class="institute-hero__eyebrow">Ethotechnics Institute</p>
      <h1 class="balanced-headline">
        The appeals kept winning. The system kept running.
      </h1>
      <p class="section-lead">
        That was Robodebt, Australia's automated welfare-debt scheme. We publish
        open standards, public case scores, and diagnostics for one question:
        when an automated decision system is hurting people, does evidence of
        the harm reach someone who has to change the system?
      </p>
      <div class="institute-hero__actions actions">
        <a class="button primary" href="#self-test">
          Test your system in 60 seconds
        </a>
        <a class="button ghost institute-hero__triage-link" href="/triage">
          <span class="incident-dot" aria-hidden="true"></span>
          Incident triage →
        </a>
      </div>
      <nav
        class="home-doors home-doors--strip"
        aria-labelledby="home-doors-strip-label"
      >
        <span class="home-doors__strip-label" id="home-doors-strip-label"
          >Start by role:</span
        >
        <ul>
          {
            doors.map((door) => (
              <li>
                <a class="home-doors__strip-link" href={door.href}>
                  {door.who}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="home-pillars">
        <a class="home-pillar" href="/standards">
          <span class="eyebrow">Standards</span>
          <strong>8 Enforceable Standards</strong>
          <span class="small muted"
            >Authority leases, contestability clocks, and JSON schemas.</span
          >
        </a>
        <a class="home-pillar" href="/evals">
          <span class="eyebrow">Evaluations</span>
          <strong>16 Suites & Finite Drills</strong>
          <span class="small muted"
            >Dual-ledger surge tests and failure containment benchmarks.</span
          >
        </a>
        <a class="home-pillar" href="/diagnostics">
          <span class="eyebrow">Diagnostics</span>
          <strong>Free Browser Tools</strong>
          <span class="small muted"
            >Audit delegation, calculate debt, and test standing in minutes.</span
          >
        </a>
      </div>
    </div>
    <RobodebtLoop class="institute-hero__figure" />
  </section>

  <SectionBlock
    id="orientation"
    eyebrow="Orientation"
    title="Three things this site answers before you begin"
    description="The discipline that keeps automated decision systems answerable: when one is wrong, evidence of the harm reaches someone who has to change it."
    variant="alt"
  >
    <div class="grid grid--three">
      <article class="card stack-sm">
        <p class="eyebrow">Scope & applicability</p>
        <h3>What counts as a system under test?</h3>
        <p>
          If software takes an action, grants a benefit, denies an application,
          or allocates work—and a human being has to live with the consequences
          of an error—this framework applies.
        </p>
        <p class="small muted">
          The object being engineered is the delegation and its authority lease,
          not model capabilities.
        </p>
        <p class="small">
          <a href="/use-cases">Explore covered use cases &rarr;</a>
        </p>
      </article>

      <article class="card stack-sm">
        <p class="eyebrow">The mechanism</p>
        <h3>How this differs from "AI Ethics"</h3>
        <p>
          We reject "human-in-the-loop" when it means human liability sponging.
          When upheld challenges cross a precommitted threshold, the automated
          rule's authority expires until reauthorized.
        </p>
        <p class="small muted">
          Closed feedback loops, not vague principles like "fairness" or
          "transparency".
        </p>
        <p class="small">
          <a href="/method">See the 7-stage governed chain &rarr;</a>
        </p>
      </article>

      <article class="card stack-sm">
        <p class="eyebrow">Adoption ladder</p>
        <h3>Start by time available</h3>
        <p>
          Spend 5 minutes running a self-test diagnostic, 1 hour evaluating an
          agent against a Finite dual-ledger surge drill, or 1 sprint adopting
          machine-readable delegation records.
        </p>
        <p class="small muted">
          Open standards, open data, and open benchmark fixtures licensed under
          CC BY-SA 4.0.
        </p>
        <p class="small">
          <a href="/start">Pick your entry path &rarr;</a>
        </p>
      </article>
    </div>
  </SectionBlock>

  <RecordSpine />

  <section
    id="mechanism"
    class="home-claim stack-md"
    aria-labelledby="mechanism-heading"
  >
    <div class="home-split-header">
      <div class="stack-sm">
        <p class="eyebrow">Why the rulings did not stop it</p>
        <h2 id="mechanism-heading" class="section__heading">
          Each ruling fixed one debt. None of them reached the rule.
        </h2>
      </div>
      <p class="section-lead">
        The department treated each ruling as one person's outcome, not as
        evidence against the scheme, so the rule that raised the debts never had
        to answer them. The fix is a count: upheld challenges recorded against
        the rule that produced them, and a set number that sends the rule back
        to its owner.
      </p>
    </div>
    <div class="home-draw" data-reveal="draw">
      <ExceptionLearningFigure level="h3" />
    </div>
    <p class="small muted">
      This is Law VIII of the twelve the standards are built on: observability
      without state transition is theater. A ruling that changes one case and
      not the rule is an observation the system never acts on.
      <a href="/standards/laws#law-viii">Read Law VIII →</a>
      <a href="/research/theory/exception-learning"
        >Read the essay on exception learning →</a
      >
    </p>
  </section>

  <CasebookScorecard />

  <section class="home-positioning" aria-labelledby="home-positioning-heading">
    <div class="card card--flat stack-sm">
      <p class="eyebrow">For scholars and governance thinkers</p>
      <h2 id="home-positioning-heading" class="section__heading">
        A theory of counterpower depreciation
      </h2>
      <p class="section-lead">
        Ethotechnics is not another governance ideology. Your preferred
        corrective mechanism — markets, law, management, technology — itself
        changes under prolonged delegation. The question the framework asks of
        each, including its own instruments: does this mechanism continue to
        possess effective corrective power after the system has been successful
        for ten years?
      </p>
      <p class="small muted">
        <a href="/about#scholars">Shared values, new instruments →</a> ·
        <a href="/about#disagreement">The real disagreement →</a> ·
        <a href="/research/scholarly-crossings">Scholarly crossings →</a>
      </p>
    </div>
  </section>

  <HomeClaims />

  <div class="home-core">
    <div class="home-core__test">
      <SelfTest />
      <SafeguardMap class="home-core__figure" />
    </div>
  </div>

  <nav class="home-doors" aria-labelledby="home-doors-heading">
    <div class="home-doors__header">
      <p class="eyebrow">Start from where you are</p>
      <h2 id="home-doors-heading" class="section__heading">Four ways in.</h2>
      <p class="section-lead">
        Pick the one that fits. Each leads to the standards, tools, cases, and
        theory that apply to you.
      </p>
    </div>
    <ul class="home-doors__list">
      {
        doors.map((door) => (
          <li>
            <a class="home-doors__door" href={door.href}>
              <span class="home-doors__who">{door.who}</span>
              <span class="home-doors__what small muted">{door.what}</span>
              <span class="home-doors__action">View path →</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="home-doors__fit small muted">
      Not sure the framework applies to your system?
      <a href="/use-cases">See which systems it is for →</a>
    </p>
  </nav>

  <div class="home-supplement">
    <section class="stack-sm card card--flat">
      <p class="eyebrow">Use and cite this work</p>
      <h2>Free to use, credit, and adapt</h2>
      <p>
        Ethotechnics Institute materials are published under
        <a
          href="https://creativecommons.org/licenses/by-sa/4.0/"
          rel="noopener noreferrer"
          target="_blank"
        >
          CC BY-SA 4.0
        </a>. Credit the Institute, and publish anything you adapt under the
        same license.
      </p>
      <p class="small muted">
        Individual entries and patterns include citation metadata so you can
        reference exactly what you used.
      </p>
    </section>

    <section class="stack-sm card card--accent">
      <p class="eyebrow">Studio</p>
      <h2>Evaluating a healthcare AI system?</h2>
      <p>
        {studioSummary}
      </p>
      <p>
        <a
          class="button"
          href="https://ethotechnics.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ethotechnics Studio →
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import "../scripts/home-reveal.ts";
</script>
