---
import BaseLayout from "../layouts/BaseLayout.astro";
import { failureStates } from "../content/institute-site";

const failureChoiceLabels: Record<string, string> = {
  "decision-appealed": "A decision was appealed",
  "model-wrong": "The model made a harmful error",
  "queue-stuck": "Appeals or reviews are stuck",
  "user-harmed": "A user was harmed",
  "no-owner": "No accountable owner is assigned",
  "cant-explain": "We cannot clearly explain the decision",
  "cant-stop": "We cannot quickly stop or roll back",
};

const failurePriorityBadges: Record<string, string> = {
  "decision-appealed": "High · Owner in 24h",
  "model-wrong": "Critical · Stop authority",
  "queue-stuck": "High · Escalate in 4h",
  "user-harmed": "Critical · Human response",
  "no-owner": "High · Assign owner",
  "cant-explain": "Medium · Evidence review",
  "cant-stop": "Critical · Activate hard halt",
};

const heroSecondaryChips = [
  {
    label: "Writing policy",
    href: "/standards#active",
  },
  {
    label: "Preparing for audit",
    href: "/diagnostics#diagnostic-tools",
  },
];

const otherStartsLabel = `Other ways to start · ${heroSecondaryChips.length} path${heroSecondaryChips.length === 1 ? "" : "s"}`;

const homepageSignals = [
  {
    value: "STD-01 → STD-07",
    label: "Core standards published",
  },
  {
    value: "3 launch lanes",
    label: "Policy, operations, and engineering pathways",
  },
  {
    value: "1 intake flow",
    label: "Failure-first routing for urgent incidents",
  },
];

const mobileQuickActions = [
  {
    title: "Find a standard",
    description: "Open the standards index",
    href: "/standards",
    iconPaths: [
      "M4 5.5h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4z",
      "M7 9h6",
      "M7 12h4",
    ],
  },
  {
    title: "Run a diagnostic",
    description: "Jump to diagnostic tools",
    href: "/diagnostics#diagnostic-tools",
    iconPaths: ["M4.5 14.5l3.2-3.2 2.1 2.1 4.7-4.7", "M4.5 4.5h11v11h-11z"],
  },
  {
    title: "See examples",
    description: "Review implementation examples",
    href: "/examples",
    iconPaths: ["M5 6h10", "M5 10h10", "M5 14h6"],
  },
];

const failureChoiceIcons: Record<string, string[]> = {
  "decision-appealed": [
    "M4 5.5h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8l-4 3v-3",
    "M8.5 10h7",
    "M8.5 13h4.5",
  ],
  "model-wrong": ["M10 4.5l6.8 11.8H3.2z", "M10 8.5v3.5", "M10 14.3h.01"],
  "queue-stuck": ["M10 5a5 5 0 1 1-5 5", "M10 7.5v3", "M10 10.5h2.2"],
  "user-harmed": [
    "M10 16.5s-5.5-3.1-5.5-7a3.2 3.2 0 0 1 5.5-2.3 3.2 3.2 0 0 1 5.5 2.3c0 3.9-5.5 7-5.5 7",
    "M7.9 9.4l4.2 4.2",
    "M12.1 9.4 7.9 13.6",
  ],
  "no-owner": [
    "M10 11a2.2 2.2 0 1 0-2.2-2.2A2.2 2.2 0 0 0 10 11z",
    "M5.5 15.5a4.5 4.5 0 0 1 9 0",
    "M14.2 5.8l3.2 3.2",
    "M17.4 5.8l-3.2 3.2",
  ],
  "cant-explain": [
    "M10 16.5a7 7 0 1 0-7-7",
    "M10 12.4v-.4a2 2 0 1 1 2-2",
    "M10 14.7h.01",
  ],
  "cant-stop": ["M4.5 4.5h11v11h-11z", "M8 8h4v4H8z"],
};
---

<BaseLayout
  title="Ethotechnics Institute — Standards for Accountable AI Systems"
  description="Open standards, governance artifacts, and diagnostic validators for high-stakes systems that must remain stoppable, reversible, and accountable under failure."
  structuredDataType="collection"
>
  <section class="institute-hero stack-lg">
    <div class="institute-hero__layout">
      <div class="institute-hero__main stack-lg">
        <p class="institute-hero__eyebrow">
          Ethotechnics Institute · Governance Standards Body
        </p>
        <h1>Operational Standards for Stoppable, Reversible AI Systems</h1>
        <p class="section-lead">
          Formal governance standards, artifacts, and diagnostics for high-risk
          automated decision systems.
        </p>
        <ul
          class="institute-hero__status"
          aria-label="Standards publication status"
        >
          <li>
            <svg
              viewBox="0 0 20 20"
              role="presentation"
              focusable="false"
              aria-hidden="true"
            >
              <path d="M3.5 5.5h13v9h-13z" fill="none"></path>
              <path d="M6 8h8"></path>
              <path d="M6 11h6"></path>
            </svg>
            <span>Document IDs: STD-01 to STD-07</span>
          </li>
          <li>
            <svg
              viewBox="0 0 20 20"
              role="presentation"
              focusable="false"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="6.5" fill="none"></circle>
              <path d="M10 6.8v3.5"></path>
              <path d="M10 12.8h.01"></path>
            </svg>
            <span>Publication status: active</span>
          </li>
          <li>
            <svg
              viewBox="0 0 20 20"
              role="presentation"
              focusable="false"
              aria-hidden="true"
            >
              <path
                d="M10 3.7l5.6 2.1v3.7c0 3.6-2.4 5.9-5.6 6.9-3.2-1-5.6-3.3-5.6-6.9V5.8z"
                fill="none"></path>
              <path d="M8.2 9.9l1.4 1.4 2.5-2.5"></path>
            </svg>
            <span>Ratification: institute-maintained stable references</span>
          </li>
        </ul>
      </div>

      <aside
        class="institute-hero__starter panel stack-sm"
        aria-label="Homepage starter"
      >
        <p class="eyebrow">Step 1 · Pick your immediate intent</p>
        <p class="institute-hero__decision-helper muted small">
          Start with one action. You can open additional paths if needed.
        </p>
        <div class="actions" aria-label="Primary standards actions">
          <a
            class="button primary institute-hero__primary-cta"
            href="#failure-intake"
          >
            Start incident intake
          </a>
        </div>
        <details class="institute-hero__other-starts">
          <summary>{otherStartsLabel}</summary>
          <ul aria-label="Secondary starting paths">
            {
              heroSecondaryChips.map((chip) => (
                <li>
                  <a href={chip.href}>{chip.label}</a>
                </li>
              ))
            }
          </ul>
        </details>
      </aside>
    </div>
  </section>

  <section
    class="institute-signals-band stack-sm"
    aria-labelledby="home-signals-heading"
  >
    <p id="home-signals-heading" class="eyebrow">Institute at a glance</p>
    <ul class="institute-hero__signal-strip" aria-label="Institute at a glance">
      {
        homepageSignals.map((signal) => (
          <li>
            <strong>{signal.value}</strong>
            <span>{signal.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="stack-sm mobile-quick-actions"
    aria-labelledby="mobile-quick-actions-heading"
  >
    <p id="mobile-quick-actions-heading" class="eyebrow">
      Step 2 · Quick actions
    </p>
    <ul class="mobile-shortcuts" aria-label="Quick actions">
      {
        mobileQuickActions.map((action) => (
          <li>
            <a class="mobile-shortcuts__item" href={action.href}>
              <span class="mobile-shortcuts__icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" role="presentation" focusable="false">
                  {action.iconPaths.map((pathValue) => (
                    <path d={pathValue} fill="none" />
                  ))}
                </svg>
              </span>
              <span class="mobile-shortcuts__title">{action.title}</span>
              <span class="mobile-shortcuts__description">
                {action.description}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="institute-flow institute-flow--soft stack-sm"
    aria-labelledby="home-flow-heading"
  >
    <p class="eyebrow">Step 3 · Team flow</p>
    <h2 id="home-flow-heading">
      Move from incident triage to evidence in three steps
    </h2>
    <ol class="institute-flow__steps">
      <li>
        <strong>Route urgency first</strong>
        <span>Assign owners, escalation clocks, and immediate actions.</span>
      </li>
      <li>
        <strong>Attach standards to response</strong>
        <span>Map obligations to the right clauses and examples.</span>
      </li>
      <li>
        <strong>Export citation-ready evidence</strong>
        <span
          >Package diagnostics and artifacts for audits and regulator review.</span
        >
      </li>
    </ol>
  </section>

  <section id="failure-intake" class="stack-lg">
    <p class="eyebrow">Step 4 · Incident triage</p>
    <h2>What is failing right now?</h2>
    <p class="section-lead">
      Pick the closest symptom. This is for routing to help, not for blame.
    </p>
    <ul class="failure-grid" aria-label="Failure routing options">
      {
        failureStates.map((state) => {
          const iconPaths = failureChoiceIcons[state.slug] ?? [
            "M5 10h10",
            "M11 6l4 4-4 4",
          ];

          return (
            <li>
              <a
                class="button failure-grid__button"
                href={`/failure/${state.slug}`}
              >
                <span class="failure-grid__label">
                  <span class="failure-grid__title">
                    <span class="failure-grid__state-icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 20 20"
                        role="presentation"
                        focusable="false"
                      >
                        {iconPaths.map((pathValue) => (
                          <path d={pathValue} />
                        ))}
                      </svg>
                    </span>
                    <span>
                      {failureChoiceLabels[state.slug] ?? state.shortLabel}
                    </span>
                  </span>
                  <span class="failure-grid__priority small muted">
                    {failurePriorityBadges[state.slug] ?? "Review now"}
                  </span>
                </span>
                <svg
                  class="failure-grid__icon"
                  viewBox="0 0 20 20"
                  role="presentation"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M5 10h10" />
                  <path d="M11 6l4 4-4 4" />
                </svg>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="small muted">
      Each option opens clear next steps, owners, and ready-to-use governance
      artifacts.
    </p>
  </section>

  <section class="stack-lg">
    <p class="eyebrow">Step 5 · Compliance and evidence</p>
    <h2>Regulatory crosswalks and citation readiness</h2>
    <p class="section-lead">
      Every standard is structured for policy citation, internal audit review,
      and regulator-facing evidence packs.
    </p>
    <div class="adopt-grid">
      <article class="card lane-card stack-sm">
        <h3 class="lane-card__heading">
          <svg
            viewBox="0 0 24 24"
            role="presentation"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M4 6h16v12H4z" fill="none"></path>
            <path d="M8 10h8"></path>
            <path d="M8 14h6"></path>
          </svg>
          <span>Regulatory alignment</span>
        </h3>
        <ul class="lane-links">
          <li>EU AI Act obligations</li>
          <li>NIST AI RMF control mapping</li>
          <li>ISO and sector supervision references</li>
        </ul>
        <p class="small muted">Start with:</p>
        <ul>
          <li><a href="/standards">Standards index</a></li>
          <li><a href="/glossary">Terminology and definitions</a></li>
        </ul>
      </article>

      <article class="card lane-card stack-sm">
        <h3 class="lane-card__heading">
          <svg
            viewBox="0 0 24 24"
            role="presentation"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M12 3.5l8 3v5c0 5.2-3.5 8.4-8 9.9-4.5-1.5-8-4.7-8-9.9v-5z"
              fill="none"></path>
            <path d="M9.25 12.25l2 2 3.75-3.75"></path>
          </svg>
          <span>Audit interoperability</span>
        </h3>
        <ul class="lane-links">
          <li>Evidence fields designed for GRC workflows</li>
          <li>Structured ownership and escalation clocks</li>
          <li>Exportable artifacts for regulator review</li>
        </ul>
        <p class="small muted">Start with:</p>
        <ul>
          <li><a href="/artifacts">Artifact templates</a></li>
          <li><a href="/diagnostics">Diagnostics and scorecards</a></li>
        </ul>
      </article>

      <article class="card lane-card stack-sm">
        <h3 class="lane-card__heading">
          <svg
            viewBox="0 0 24 24"
            role="presentation"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="4" y="6" width="16" height="12" rx="2" fill="none"></rect>
            <path d="M8 12h3"></path>
            <path d="M13 12h3"></path>
            <path d="M10.5 9v6"></path>
          </svg>
          <span>Adoption pathways</span>
        </h3>
        <ul class="lane-links">
          <li>Policy teams adopt document IDs and clauses</li>
          <li>Operations teams install stoppability drills</li>
          <li>Engineering teams bind rollback to release gates</li>
        </ul>
        <p class="small muted">Start with:</p>
        <ul>
          <li><a href="/quick-start">Quick-start playbooks</a></li>
          <li>
            <a href="/failure/decision-appealed">Failure intake pathways</a>
          </li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
