---
import BaseLayout from "../layouts/BaseLayout.astro";
import { failureStates } from "../content/institute-site";
---

<BaseLayout
  title="Ethotechnics Institute"
  description="Open standards for high-stakes systems that must remain reversible under failure."
>
  <section class="institute-hero stack-lg">
    <h1>Choose a governance path for your situation.</h1>
    <p>Select one starting point. You can branch into diagnostics and standards from there.</p>
    <ul class="mobile-shortcuts" aria-label="Primary start options">
      <li>
        <a class="mobile-shortcuts__item" href="/#failure-intake">
          <span class="mobile-shortcuts__label">Something is broken now</span>
          <strong class="mobile-shortcuts__title">Start with failure intake</strong>
        </a>
      </li>
      <li>
        <a class="mobile-shortcuts__item" href="/quick-start">
          <span class="mobile-shortcuts__label">You are planning a release</span>
          <strong class="mobile-shortcuts__title">Use quick-start playbooks</strong>
        </a>
      </li>
      <li>
        <a class="mobile-shortcuts__item" href="/standards">
          <span class="mobile-shortcuts__label">You need policy language</span>
          <strong class="mobile-shortcuts__title">Browse standards</strong>
        </a>
      </li>
    </ul>
  </section>

  <section id="failure-intake" class="stack-lg">
    <h2>What’s not holding?</h2>
    <p>Choose the closest match. This is routing, not blame.</p>
    <div class="failure-grid" aria-label="Failure routing options">
      {
        failureStates.map((state) => (
          <a class="button" href={`/failure/${state.slug}`}>
            {state.shortLabel}
          </a>
        ))
      }
    </div>
    <p class="small muted">
      Each path routes to a ready-to-use governance artifact.
    </p>
  </section>

  <section class="stack-lg">
    <h2>Choose your team lane</h2>
    <div class="adopt-grid">
      <article class="card stack-sm">
        <h3>Legal / Compliance</h3>
        <ul>
          <li>Assign decision owners</li>
          <li>Set reversal time bounds</li>
          <li>Publish appeal rules</li>
        </ul>
        <p class="small muted">Continue with:</p>
        <ul>
          <li>
            <a href="/standards/std-02-contestability-recourse"
              >STD-02 Contestability &amp; Recourse</a
            >
          </li>
          <li><a href="/adopt/policy">More for this lane</a></li>
        </ul>
      </article>

      <article class="card stack-sm">
        <h3>Appeals / Incident</h3>
        <ul>
          <li>Map queues</li>
          <li>Name freeze authority</li>
          <li>Run one tabletop</li>
        </ul>
        <p class="small muted">Continue with:</p>
        <ul>
          <li><a href="/diagnostics">Diagnostics menu</a></li>
          <li><a href="/adopt/ops">More for this lane</a></li>
        </ul>
      </article>

      <article class="card stack-sm">
        <h3>Product / Engineering</h3>
        <ul>
          <li>Instrument reversibility</li>
          <li>Test rollback paths before release</li>
          <li>Log every reversal</li>
        </ul>
        <p class="small muted">Continue with:</p>
        <ul>
          <li>
            <a href="/standards/std-01-temporal-rights"
              >STD-01 Temporal Rights</a
            >
          </li>
          <li><a href="/adopt/build">More for this lane</a></li>
        </ul>
      </article>
    </div>
  </section>

</BaseLayout>
