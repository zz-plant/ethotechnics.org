---
import "../../styles/components/intake-form.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextStep from "../../components/NextStep.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionActions from "../../components/SectionActions.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import PullQuote from "../../components/PullQuote.astro";
import WithSidebar from "../../components/WithSidebar.astro";

const pageTitle = "Governance as operational capability";
const pageDescription =
  "Governance measured by what a running system can be made to do: answer a challenge, change the rule the challenge exposes, and halt or reverse when it must.";
const permalink = "/explainers/governance-capability";

const heroCopy =
  "Most AI governance frameworks improve documentation, oversight, and accountability. Ethotechnics asks a narrower question: when a running system is wrong, does evidence of the harm reach someone who has to change it? Halting, reversing, and restoring are part of the answer. They are not all of it. A system that can be stopped can still fix one case at a time and never change the rule.";

const executiveSummary = [
  {
    href: "#standing",
    text: "People affected gain standing. A challenge must be answered, and an upheld one changes the decision.",
  },
  {
    href: "#rule",
    text: "Upheld challenges reach the rule. A pattern of exceptions is evidence against the rule, and its owner must answer it.",
  },
  {
    href: "#performance-spec",
    text: "Governance becomes a performance specification. Halt, reverse, and restore must work under load.",
  },
  {
    href: "#time",
    text: "Time spent waiting is part of the harm. Slow reversals and cases left pending are governance failures.",
  },
  {
    href: "#recovery",
    text: "Maturity is measured by recovery, not coverage. A document does not restore anyone.",
  },
  {
    href: "#stop-rights",
    text: "Authority to halt does not wait for consensus. A halt contains the harm while the rule is fixed.",
  },
  {
    href: "#monitoring-liability",
    text: "Monitoring without intervention becomes liability. Knowing about harm and continuing is a choice.",
  },
];

const coreImplications = [
  {
    id: "standing",
    title: "People affected gain standing, not only visibility",
    commonModel:
      "Transparency, an explanation, and appeals that may not change the outcome.",
    ethotechnicsModel:
      "An upheld challenge changes the decision. The challenge is answered by a date, and the person is protected while it is pending.",
    implication: "If a challenge cannot force a change, it is not governance.",
    requirements: [
      "A challenge route whose reviewer can change the decision.",
      "A stated list of the evidence a person must provide, and a limit on what they can be asked for.",
      "Protection for the person while the challenge is pending.",
      "Escalation to a named person who can halt the system when challenges pass a set number.",
      "A route that works the first time, without repeated calls or unusual persistence.",
    ],
  },
  {
    id: "rule",
    title: "Upheld challenges reach the rule",
    commonModel:
      "Each upheld appeal is resolved as one case. The rule that produced it stays.",
    ethotechnicsModel:
      "An upheld challenge is evidence about the rule. Repeated ones oblige the rule's owner to revise it or publish why not.",
    implication:
      "An appeals process that only fixes cases absorbs the evidence that the system is wrong.",
    requirements: [
      "A count of upheld challenges by rule, sent to whoever owns the rule.",
      "A threshold at which the owner must revise the rule or publish a reasoned refusal.",
      "A record linking each rule change to the challenges that prompted it.",
      "Exception codes reviewed as evidence about the rule, not only as workload.",
    ],
    signals: [
      "Upheld appeals are reported as proof the system works.",
      "Nobody can name the last rule an appeal changed.",
    ],
  },
  {
    id: "performance-spec",
    title: "Governance becomes a performance specification",
    commonModel:
      "Governance is demonstrated through policies, principles, reviews, and artifacts.",
    ethotechnicsModel:
      "Governance is shown by what the running system can do: halt harmful behavior, reverse decisions, and restore the people affected.",
    implication:
      "Responsibility is measured by what the system can do, not by what its builders intend.",
    requirements: [
      "Stop conditions in production (“if X, halt Y”), and a stated route by which each one fires.",
      "A rollback or safe mode that returns the system to its last safe state.",
      "A restoration route that changes the person's record, not only a ticket's status.",
      "Regular drills that run stop, rollback, and restore from start to finish.",
      "Measured time-to-halt, time-to-restore, and time-in-harm.",
    ],
    signals: [
      "Only an executive can stop the system.",
      '"Fix forward" is treated as the only option.',
    ],
  },
  {
    id: "time",
    title: "Time spent waiting is part of the harm",
    commonModel:
      'Time is treated as incidental ("we’re investigating," "pending").',
    ethotechnicsModel:
      "The time a person spends harmed is what gets measured. A review with no end date is itself a harm.",
    implication: "Waiting with no end date is a governance failure.",
    requirements: [
      "A binding maximum time for each contested state.",
      "Protection while the dispute runs, such as continued service or a safe default.",
      "When a clock runs out, the case returns to the safer state.",
      "A named owner for each pending state and for the growth of its queue.",
      "Reports of time-in-harm that show the slowest cases, not only the average.",
    ],
    signals: [
      "Appeals timelines are undefined.",
      '"Pending" states can persist indefinitely.',
    ],
  },
  {
    id: "recovery",
    title: "Maturity is measured by recovery, not coverage",
    commonModel:
      "Maturity means policy coverage, named owners, monitoring, and readiness for audit.",
    ethotechnicsModel:
      "Maturity means the team can halt, reverse, and restore every time, without heroics.",
    implication:
      "A team that documents harm but cannot restore people is not mature.",
    requirements: [
      "Service targets for reversal and restoration, not only for uptime.",
      "A restore route for each workflow, not one general support channel.",
      "A written restoration procedure that works the same way each time.",
      "Actions after an incident that change the controls, not only the incident report.",
      "Recovery tools and staffing tested at full load.",
    ],
  },
  {
    id: "stop-rights",
    title: "Authority to halt does not wait for consensus",
    commonModel:
      "Committees and escalation chains decide whether to stop the system.",
    ethotechnicsModel:
      "A named person can halt the system without waiting for a committee. The halt contains the harm while the rule is fixed.",
    implication:
      "The organization names who can halt, and protects them from retaliation.",
    requirements: [
      "Named stop roles, each stating what it can stop, when, and how.",
      "Protection from retaliation for anyone who uses a stop.",
      "A design in which stopping the system leaves it in a safe state.",
      "Stop authority that does not need a committee's approval.",
      "After a stop, a procedure aimed at restoring people and fixing the rule, not at blame.",
    ],
  },
  {
    id: "monitoring-liability",
    title: "Monitoring without intervention becomes liability",
    commonModel: "Monitoring is treated as governance progress.",
    ethotechnicsModel:
      "An operator who can see harm and cannot stop it is more responsible, not less. Knowing and continuing is a choice.",
    implication: "Once a team can see harm, it has a duty to act on it.",
    requirements: [
      "Monitoring that can trigger a stop condition or a safe state.",
      "Runbooks that include halt and restore steps, not only investigation.",
      "Enough staff to act before the harm budget is spent.",
      "Few enough alerts that people still act on them.",
      "Escalation that happens by rule, not at someone's discretion.",
    ],
  },
];

const additionalImplications = [
  {
    id: "budgets",
    title: "Budgets move from paperwork to infrastructure",
    implication:
      "Governance money is spent on reliability, product, and operations engineering.",
    requirements: [
      "Funded work on restoration tools, on the roadmap.",
      "Engineers assigned to rollback, not ad hoc fixes.",
      "Scheduled drills on the operations calendar.",
    ],
  },
  {
    id: "slow-harm",
    title: "Slow, diffuse harm becomes structurally unacceptable",
    implication:
      "People who give up count as harmed, measured by time-in-harm and by the burden moved onto them.",
    requirements: [
      "Measures of who carries the harm, not only totals.",
      "Thresholds that force safe mode or reversal when the slowest cases get slower.",
    ],
  },
  {
    id: "vendors",
    title: "Vendor governance becomes reversibility, not attestation",
    implication:
      "Trust in a vendor rests on the right to leave, not on its reputation.",
    requirements: [
      "A switch that disconnects the vendor, and a fallback mode.",
      "Rollback terms in vendor contracts.",
      "Commitments to restore people by a stated date.",
    ],
  },
  {
    id: "enforcement",
    title: "Enforcement shifts from punishment to constraint design",
    implication:
      "Enforcement works best as limits built into the system, not as penalties after the fact.",
    requirements: [
      "Binding clocks, with a return to the safe state when one runs out.",
      "A stop right held by someone independent of the operator.",
      "Drills that show the limits hold under load.",
    ],
  },
  {
    id: "culture",
    title: "Culture stops being the primary safeguard",
    implication: "If ethics requires heroism, the system is unethical.",
    requirements: [
      "Protection, in policy and contract, for people who stop the system or report harm.",
      "Enough tools and staff to stop the system when it has to be stopped.",
      "Incentives that do not reward quiet overrides.",
    ],
  },
];

const relatedLinks = [
  {
    href: "/mechanisms#correction",
    label: "Mechanisms for correction (appeal paths, review triggers, halts)",
  },
  {
    href: "/standards",
    label: "Standards comparison (NIST / ISO / EU vs Ethotechnics)",
  },
  {
    href: "/field-notes",
    label: "Field notes (examples of compounding harm)",
  },
];

const anchorLinks = executiveSummary.map(({ href, text }) => ({
  href,
  label: text.split(". ")[0],
}));

const siteBase = Astro.site ? Astro.site.toString() : Astro.url.origin;
const buildAnchor = (id: string) =>
  new URL(`${permalink}#${id}`, siteBase).toString();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Explainer"
    title={pageTitle}
    description={heroCopy}
    anchorLinks={anchorLinks}
  />

  <WithSidebar>
    <Fragment slot="sidebar">
      <p class="toc-heading">On this page</p>
      <nav>
        <ul>
          {
            executiveSummary.map((item) => (
              <li>
                <a href={item.href}>{item.text.split(". ")[0]}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </Fragment>

    <SectionBlock
      id="executive-summary"
      eyebrow="Executive summary"
      title="Seven implications that change governance"
    >
      <ul class="summary-list">
        {
          executiveSummary.map((item) => (
            <li>
              <a href={item.href}>{item.text}</a>
            </li>
          ))
        }
      </ul>
    </SectionBlock>

    <SectionBlock
      id="core-implications"
      eyebrow="Core implications"
      title="What operational governance reveals"
      description="Each implication sets the common model against the Ethotechnics model and lists what it requires."
      variant="alt"
    >
      <SectionActions
        className="implication-controls"
        ariaLabel="Implication controls"
      >
        <button class="button ghost" type="button" data-expand-all>
          Expand all
        </button>
        <button class="button ghost" type="button" data-collapse-all>
          Collapse all
        </button>
      </SectionActions>
      <div class="implications" data-implications>
        {
          coreImplications.map((item) => (
            <details
              class="implication"
              open
              data-default-open="true"
              data-implication
              data-implication-id={item.id}
            >
              <summary class="implication__summary">
                <div class="implication__summary-main">
                  <h3 id={item.id} class="implication__title">
                    {item.title}
                  </h3>
                </div>
                <span class="implication__toggle" aria-hidden="true">
                  <span class="implication__toggle-text--expand">Expand</span>
                  <span class="implication__toggle-text--collapse">
                    Collapse
                  </span>
                </span>
              </summary>
              <div class="implication__body">
                <div class="implication__actions">
                  <a
                    class="implication__permalink"
                    href={`#${item.id}`}
                    aria-label={`Permalink to ${item.title}`}
                    data-implication-anchor
                  >
                    #
                  </a>
                  <button
                    class="copy-button"
                    type="button"
                    data-copy-link
                    data-copy-value={buildAnchor(item.id)}
                    aria-label={`Copy link to ${item.title}`}
                  >
                    Copy link
                  </button>
                  <span
                    class="implication__status"
                    data-copy-status
                    role="status"
                    aria-live="polite"
                  />
                </div>
                <p class="implication__label">Common model</p>
                <p>{item.commonModel}</p>
                <p class="implication__label">Ethotechnics model</p>
                <p>{item.ethotechnicsModel}</p>
                <p class="implication__statement">
                  <strong>Implication:</strong> {item.implication}
                </p>
                <div class="implication__requirements">
                  <p class="implication__label">What this requires</p>
                  <ul>
                    {item.requirements.map((requirement) => (
                      <li>{requirement}</li>
                    ))}
                  </ul>
                </div>
                {item.signals && (
                  <details
                    class="implication__signals"
                    data-default-open="false"
                  >
                    <summary>Signals you’re failing this</summary>
                    <ul>
                      {item.signals.map((signal) => (
                        <li>{signal}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </SectionBlock>

    <SectionBlock
      id="additional-implications"
      eyebrow="Additional implications"
      title="Secondary shifts once capability is required"
      description="Five further shifts that follow once a system must answer challenges and act on what they show."
    >
      <div class="implications" data-implications>
        {
          additionalImplications.map((item) => (
            <details
              class="implication"
              data-default-open="false"
              data-implication
              data-implication-id={item.id}
            >
              <summary class="implication__summary">
                <div class="implication__summary-main">
                  <h3 id={item.id} class="implication__title">
                    {item.title}
                  </h3>
                </div>
                <span class="implication__toggle" aria-hidden="true">
                  <span class="implication__toggle-text--expand">Expand</span>
                  <span class="implication__toggle-text--collapse">
                    Collapse
                  </span>
                </span>
              </summary>
              <div class="implication__body">
                <div class="implication__actions">
                  <a
                    class="implication__permalink"
                    href={`#${item.id}`}
                    aria-label={`Permalink to ${item.title}`}
                    data-implication-anchor
                  >
                    #
                  </a>
                  <button
                    class="copy-button"
                    type="button"
                    data-copy-link
                    data-copy-value={buildAnchor(item.id)}
                    aria-label={`Copy link to ${item.title}`}
                  >
                    Copy link
                  </button>
                  <span
                    class="implication__status"
                    data-copy-status
                    role="status"
                    aria-live="polite"
                  />
                </div>
                <p class="implication__statement">
                  <strong>Implication:</strong> {item.implication}
                </p>
                <div class="implication__requirements">
                  <p class="implication__label">What this requires</p>
                  <ul>
                    {item.requirements.map((requirement) => (
                      <li>{requirement}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </SectionBlock>

    <SectionBlock
      id="legitimacy-standard"
      eyebrow="Legitimacy standard"
      title="The legitimacy standard"
      description="One test for whether a system is responsible in operation."
      variant="alt"
    >
      <div class="legitimacy-standard">
        <p>
          A system is not responsible because it intends to be fair, documents
          its risks, or convenes oversight committees. It is responsible only
          when the people it decides about can make it answer, and when what
          they show it reaches the rule.
        </p>
        <p class="muted">
          Many systems now called “compliant” would fail this standard. They are
          not malicious. Their appeals fix one case at a time.
        </p>
      </div>
    </SectionBlock>

    <SectionBlock id="related" eyebrow="Related" title="Related">
      <ul class="related-links">
        {
          relatedLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="muted small footnote">
        Use stable anchors when citing this spec in memos, briefs, or governance
        playbooks.
      </p>
      <p class="muted small footnote">
        See also: <a href="/taxonomy">Taxonomy</a> &middot; <a href="/standards"
          >Standards</a
        >
      </p>
    </SectionBlock>
  </WithSidebar>
  <NextStep variable="correction" />
  <PullQuote
    quote="A system is responsible only when the people it decides about can make it answer, and when what they show it reaches the rule."
    variant="accent"
  />
</BaseLayout>

<script>
  import "../../scripts/governance-capability.ts";
</script>

<style>
  .summary-list {
    margin: 0;
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .summary-list a {
    color: inherit;
    text-decoration: none;
  }

  .summary-list a:hover,
  .summary-list a:focus {
    text-decoration: underline;
  }

  .implication-controls {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .implications {
    display: grid;
    gap: var(--space-5);
  }

  .implication {
    border: 1px solid var(--panel-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    background: var(--panel);
  }

  .implication__summary {
    list-style: none;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
  }

  .implication__summary::-webkit-details-marker {
    display: none;
  }

  .implication__summary-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .implication__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .implication__actions .copy-button {
    min-height: 44px;
  }

  .implication__title {
    margin: 0;
    font-size: var(--text-lg);
  }

  .implication__permalink {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--panel-border);
    font-weight: 600;
    text-decoration: none;
    color: inherit;
  }

  .implication__permalink:hover,
  .implication__permalink:focus {
    background: var(--panel-strong);
  }

  .implication__status {
    font-size: var(--text-sm);
    color: var(--muted);
    min-width: 4rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .implication__status.is-visible {
    opacity: 1;
  }

  .implication__toggle {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-top: var(--space-1);
    white-space: nowrap;
  }

  .implication__toggle-text--collapse {
    display: none;
  }

  details[open] .implication__toggle-text--collapse {
    display: inline;
  }

  details[open] .implication__toggle-text--expand {
    display: none;
  }

  .implication__body {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .implication__label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label-wide);
    font-size: var(--text-xs);
    color: var(--muted);
    margin: 0;
  }

  .implication__statement {
    margin: 0;
  }

  .implication__requirements ul,
  .implication__signals ul {
    margin: 0;
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }

  .implication__signals {
    margin-top: var(--space-2);
    border-top: 1px solid var(--panel-border);
    padding-top: var(--space-3);
  }

  .implication__signals summary {
    cursor: pointer;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .legitimacy-standard {
    display: grid;
    gap: var(--space-3);
    max-width: 70ch;
  }

  .related-links {
    margin: 0;
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .footnote {
    margin-top: var(--space-5);
    max-width: 70ch;
  }

  @media (max-width: 720px) {
    .implication {
      padding: var(--space-3) var(--space-4);
    }

    .implication__summary {
      flex-direction: column;
      align-items: flex-start;
    }

    .implication__toggle {
      margin-top: 0;
    }
  }
</style>
