---
import { getCollection, render } from "astro:content";
import ExplainerLayout from "../../components/ExplainerLayout.astro";
import { getGlossaryLabel } from "../../utils/glossary";

const entry = (await getCollection("explainers")).find(
  (candidate) => candidate.id === Astro.params.slug,
);
if (!entry) return new Response("Not found", { status: 404 });
const {
  title,
  description,
  permalink,
  glossaryRef,
  definition,
  example,
  distinctSignals,
  ctas,
  faqs,
} = entry.data;

// The glossary link names the entry it opens. The explainer's own title
// ("What is contestability?") read as "Canonical entry: What is
// contestability? in the glossary", and named the wrong term where the
// explainer points at a related entry.
const glossaryLabel = glossaryRef ? getGlossaryLabel(glossaryRef) : title;

const hasBody = Boolean(entry.body && entry.body.trim().length > 0);
const { Content } = hasBody ? await render(entry) : { Content: null };
---

<ExplainerLayout
  title={title}
  description={description}
  permalink={permalink}
  glossary={{ href: `/glossary/${glossaryRef}`, label: glossaryLabel }}
  definition={definition}
  example={example}
  distinctSignals={distinctSignals}
  ctas={ctas}
  faqs={faqs}
  hasDiagram={hasBody}
>
  {Content && <Content />}
</ExplainerLayout>
