---
import { getCollection } from "astro:content";
import ExplainerLayout from "../../components/ExplainerLayout.astro";

const entry = (await getCollection("explainers")).find(
  (candidate) => candidate.id === Astro.params.slug,
);
if (!entry) return new Response("Not found", { status: 404 });
const {
  title,
  description,
  permalink,
  glossaryRef,
  definition,
  example,
  distinctSignals,
  ctas,
  faqs,
} = entry.data;
---

<ExplainerLayout
  title={title}
  description={description}
  permalink={permalink}
  glossary={{ href: `/glossary/${glossaryRef}`, label: title }}
  definition={definition}
  example={example}
  distinctSignals={distinctSignals}
  ctas={ctas}
  faqs={faqs}
/>
