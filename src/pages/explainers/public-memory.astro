---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextStep from "../../components/NextStep.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import SummaryCallout from "../../components/SummaryCallout.astro";

const pageTitle = "Public memory for contestability terms";
const pageDescription =
  "A dated log of how terms like trustworthy AI and responsible AI drifted from commitments into labels, with stable definitions to cite instead.";

const anchorLinks = [
  { href: "#purpose", label: "Language drift" },
  { href: "#timeline", label: "Language drift timeline" },
  { href: "#definitions", label: "Stable definitions" },
  { href: "#usage", label: "Enforceable requirements" },
];

const timelineEntries = [
  {
    period: "2019",
    title: "Trustworthy AI becomes the umbrella phrase.",
    summary:
      "The OECD principles frame trustworthy AI around transparency, robustness, and accountability. The phrase later came to be used as a compliance label, with no route to a remedy attached.",
    sourceLabel: "OECD AI Principles",
    sourceHref: "https://oecd.ai/en/ai-principles",
  },
  {
    period: "2020",
    title: "Responsible AI consolidates around vendor playbooks.",
    summary:
      "Industry guidance offers responsible AI toolkits, but often names no owner and guarantees no appeal. The language moves from shared obligations to internal checklists.",
    sourceLabel: "Google responsible AI practices",
    sourceHref: "https://ai.google/responsibility/responsible-ai-practices/",
  },
  {
    period: "2022",
    title: "Rights framing enters public policy.",
    summary:
      "The White House Blueprint for an AI Bill of Rights centers notice, explanation, and human alternatives. Enforcement stays discretionary. The word “rights” is used, but no review clock is set and no one is named to answer an escalation.",
    sourceLabel: "Blueprint for an AI Bill of Rights (White House archive)",
    sourceHref: "https://bidenwhitehouse.archives.gov/ostp/ai-bill-of-rights/",
  },
  {
    period: "2023",
    title: "Risk management vocabulary takes hold.",
    summary:
      "The NIST AI RMF sets out governance and accountability functions. Organizations often stop at scoring risk, and publish no evidence that a person can get a decision reversed. The language moves toward accepting risk without the means to remedy it.",
    sourceLabel: "NIST AI RMF 1.0",
    sourceHref: "https://www.nist.gov/itl/ai-risk-management-framework",
  },
  {
    period: "2024",
    title: "Regulatory language converges on transparency and oversight.",
    summary:
      "The EU AI Act emphasizes transparency, human oversight, and documentation. Without a shared baseline for challenges, an implementation can still leave out appeal outcomes and reversals that someone has to carry out.",
    sourceLabel: "EU AI Act overview",
    sourceHref: "https://artificialintelligenceact.eu/",
  },
];

const definitionCards = [
  {
    title: "Contestability",
    description:
      "A person affected by a decision can challenge it, and the challenge can change or overturn it. The route is visible to them.",
    href: "/glossary/contestability",
  },
  {
    title: "Explainability for accountability",
    description:
      "An explanation names who owns the decision, the evidence it used, and how to get it corrected.",
    href: "/glossary/explainability-for-accountability",
  },
  {
    title: "Appeal passage rate",
    description:
      "The share of appeals decided in the person's favor. A rate near zero suggests appeals change nothing. A high rate is evidence the rule is wrong, and should send the rule back to its owner.",
    href: "/glossary/appeal-passage-rate",
  },
  {
    title: "Time transparency",
    description:
      "The person can see where their case is, what it is waiting on, how long is left, and what would escalate it.",
    href: "/glossary/time-transparency",
  },
  {
    title: "Design authority",
    description: "A named owner can set safeguards and approve reversals.",
    href: "/glossary/design-authority",
  },
];

const usageSteps = [
  "Cite the glossary entry, not the bare term, in briefs, audits, and press summaries.",
  "Put a number next to each term: the appeal passage rate, the review clock, or the remedy log.",
  "Record each time a term is used as a label with nothing to enforce it.",
];
---

<BaseLayout
  title="Public memory: how AI governance terms drifted, 2019–2024"
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Explainer"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SummaryCallout
    title="Keep contestability language anchored"
    description="A log of when each governance term lost its enforcement mechanism, with a definition to cite in its place."
    takeaways={[
      "Record when a popular term turns into a checklist with no remedy.",
      "Cite the glossary entries for contestability, accountability, and time transparency.",
      "Attach the source, so each term can be traced to where it was first written.",
    ]}
    relatedLinks={[
      {
        href: "/standards/std-02-contestability-recourse",
        label: "STD-02 contestability",
      },
      { href: "/evidence-packs", label: "Evidence packs" },
    ]}
  />

  <SectionBlock
    id="purpose"
    eyebrow="Why this matters"
    title="Language drift hides accountability gaps"
    description="A term that loses its evidence requirement stops binding anyone."
  >
    <p>
      Contestability terms travel through policy, procurement, and public
      narratives. When a term like “responsible AI” becomes a label rather than
      a measurable commitment, people lose the ability to demand remedies. The
      definitions in this appendix record what each term committed to when it
      was written, so a citation carries the commitment, not the label.
    </p>
    <ul class="muted">
      <li>
        Each term maps to an action someone can be held to, not to an internal
        checklist.
      </li>
      <li>
        A stable definition gives an auditor, a buyer, and a journalist the same
        thing to check.
      </li>
      <li>
        A drift log records the gap between what a term promised and what was
        delivered.
      </li>
    </ul>
  </SectionBlock>

  <SectionBlock
    id="timeline"
    eyebrow="Timeline"
    title="Language drift and memory log"
    description="How five accountability terms shifted in policy and practice, 2019 to 2024."
    variant="alt"
  >
    <ol
      class="standards-timeline"
      aria-label="Contestability language drift timeline"
    >
      {
        timelineEntries.map((entry) => (
          <li class="standards-timeline__item">
            <div class="standards-timeline__badge">{entry.period}</div>
            <div class="standards-timeline__body">
              <h3>{entry.title}</h3>
              <p class="muted">{entry.summary}</p>
              <a class="standards-timeline__link" href={entry.sourceHref}>
                Source: {entry.sourceLabel}
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </SectionBlock>

  <SectionBlock
    id="definitions"
    eyebrow="Stable definitions"
    title="Terms to cite verbatim"
    description="Each links to a glossary anchor with a stable definition."
  >
    <CardGrid className="grid--two">
      {
        definitionCards.map((card) => (
          <CardItem title={card.title} description={card.description}>
            <a slot="footer" class="muted" href={card.href}>
              View glossary entry
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="usage"
    eyebrow="How to use"
    title="Turn memory into enforceable requirements"
    description="Cite this page as an appendix in briefs, audits, and public statements."
    variant="alt"
  >
    <ul class="muted">
      {usageSteps.map((step) => <li>{step}</li>)}
    </ul>
    <div class="actions">
      <a class="button primary" href="/glossary"> Open glossary anchors </a>
      <a class="button ghost" href="/standards/std-02-contestability-recourse">
        Read STD-02
      </a>
    </div>
  </SectionBlock>

  <NextStep variable="evidence" />

  <p class="muted" style="margin-top:var(--space-6)">
    See also: <a href="/taxonomy">Taxonomy</a> &middot; <a href="/standards"
      >Standards</a
    > &middot; <a href="/examples">Examples</a>
  </p>
</BaseLayout>
