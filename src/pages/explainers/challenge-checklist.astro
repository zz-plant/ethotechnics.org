---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ActionIcon from "../../components/ActionIcon.astro";
import ClauseCitations from "../../components/ClauseCitations.astro";
import NextStep from "../../components/NextStep.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import type { ClauseCitation } from "../../utils/clause-registry";

const pageTitle = "Can this decision be challenged?";
const pageDescription =
  "Seven pass/fail questions that test whether a person can challenge an automated decision and change it, each with what a failing answer means.";

const anchorLinks = [{ href: "#checklist", label: "Checklist" }];

// Each note on a failing answer sits under the question it explains, and
// each question cites the STD-02 clauses it checks.
const checklistItems: Array<{
  question: string;
  ifNot: string;
  cites: ClauseCitation[];
}> = [
  {
    question:
      "Does the person receive a receipt with the reasons, the date, and what the decision covers?",
    ifNot:
      "The person has nothing in writing to check or to show someone else. Without a receipt, “contact support” is only a request for help.",
    cites: [{ standard: "STD-02", clauses: ["§1.1", "§1.3", "§5.1"] }],
  },
  {
    question: "Can a named person change or reverse the decision?",
    ifNot:
      "The route is for show: it hides who decides. A challenge changes the outcome only when it reaches someone who can reverse the decision, and the evidence the person sends is weighed.",
    cites: [{ standard: "STD-02", clauses: ["§2.2"] }],
  },
  {
    question: "Is there a deadline by which the person must get an answer?",
    ifNot:
      "Requests sit in the queue and are never reversed. Due process needs a deadline and escalation that has to happen.",
    cites: [{ standard: "STD-02", clauses: ["§2.3", "§3.1"] }],
  },
  {
    question:
      "Can the person challenge the decision without asking permission or meeting hidden conditions first?",
    ifNot:
      "The case never reaches a state the system has to answer. The person has no standing, even if there is a form or a hotline.",
    cites: [{ standard: "STD-02", clauses: ["§6.1", "§8.4"] }],
  },
  {
    question:
      "If the challenge is upheld, is there a set way to reverse the decision or repair the harm?",
    ifNot: "Winning changes nothing. Due process needs a decision that binds.",
    cites: [{ standard: "STD-02", clauses: ["§4.1", "§4.2"] }],
  },
  {
    question:
      "Is there a record that challenges have been upheld, not only that they were processed?",
    ifNot:
      "The route may end in a queue no one can trace. A working route publishes how often challenges are upheld.",
    cites: [{ standard: "STD-02", clauses: ["§5.2"] }],
  },
  {
    question:
      "Are upheld challenges counted against the rule that produced them, and is the count sent to the rule's owner?",
    ifNot:
      "Upheld challenges pile up as individual wins, and no one counts them against the rule. A count sent to the rule's owner is what turns repeated upholds into a rule change.",
    cites: [{ standard: "STD-02", clauses: ["§4.4", "§5.2"] }],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2026-01-21T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Explainer"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="checklist"
    eyebrow="Can a person challenge this?"
    title="Challenge checklist"
    description="Seven pass/fail questions to run over a decision flow before it ships or when it is audited."
  >
    <div class="contestability-layout">
      <div
        class="contestability-checklist"
        role="group"
        aria-label="Challenge checklist"
      >
        <p>
          Standing turns “that’s wrong” into something the system has to answer:
          a decision with reasons, a deadline, a named person who can change it,
          and a route to reversal.
        </p>
        <ul>
          {
            checklistItems.map((item) => (
              <li>
                <p
                  class="contestability-checklist__question"
                  data-checklist-question
                >
                  {item.question}
                </p>
                <p class="muted">
                  <strong>If not.</strong> {item.ifNot}
                </p>
                <ClauseCitations cites={item.cites} />
              </li>
            ))
          }
        </ul>
        <p class="muted small">
          The questions come from the <a href="/glossary/contestability"
            >glossary definition</a
          >. Each cites the clauses of the contestability standard, <a
            href="/standards/std-02-contestability-recourse">STD-02</a
          >, that it checks.
        </p>
      </div>
      <aside class="contestability-summary" aria-label="Checklist summary">
        <p class="eyebrow contestability-summary__eyebrow">
          2-minute checklist
        </p>
        <p class="muted contestability-summary__copy">
          Each question asks for a record: a reversal that happened, a review
          that met its deadline.
        </p>
        <div class="contestability-summary__actions">
          <button class="button ghost" type="button" data-checklist-print>
            <ActionIcon action="print" />
            Print checklist
          </button>
          <button class="button ghost" type="button" data-checklist-copy>
            <ActionIcon action="copy" />
            <span data-button-label>Copy checklist</span>
          </button>
        </div>
      </aside>
    </div>
  </SectionBlock>

  <NextStep variable="standing" />

  <p class="muted" style="margin-top:var(--space-6)">
    See also: <a href="/standards">Standards</a> &middot; <a href="/mechanisms"
      >Mechanisms</a
    >
  </p>
</BaseLayout>

<script>
  import { setButtonLabel } from "../../client/button-label";

  const copyButton = document.querySelector<HTMLButtonElement>(
    "[data-checklist-copy]",
  );
  const printButton = document.querySelector<HTMLButtonElement>(
    "[data-checklist-print]",
  );
  const questions = document.querySelectorAll<HTMLElement>(
    "[data-checklist-question]",
  );

  if (printButton) {
    printButton.addEventListener("click", () => {
      window.print();
    });
  }

  if (copyButton && questions.length > 0) {
    copyButton.addEventListener("click", async () => {
      const items = Array.from(questions).map(
        (question) => question.textContent?.trim() ?? "",
      );
      const checklistText = [
        "Challenge checklist",
        "",
        ...items.map((item) => `- ${item}`),
      ]
        .filter(Boolean)
        .join("\n");
      try {
        await navigator.clipboard.writeText(checklistText);
        setButtonLabel(copyButton, "Checklist copied");
        window.setTimeout(() => {
          setButtonLabel(copyButton, "Copy checklist");
        }, 2000);
      } catch (error) {
        setButtonLabel(copyButton, "Copy failed");
        window.setTimeout(() => {
          setButtonLabel(copyButton, "Copy checklist");
        }, 2000);
      }
    });
  }
</script>

<style>
  .contestability-layout {
    display: grid;
    gap: var(--space-5);
  }

  .contestability-checklist {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--surface);
  }

  .contestability-checklist ul {
    margin: var(--space-4) 0;
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-4);
  }

  .contestability-checklist li > p {
    margin: 0;
  }

  .contestability-checklist li > p + p {
    margin-top: var(--space-1);
  }

  .contestability-checklist__question {
    font-weight: 600;
  }

  .contestability-summary {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background: var(--surface);
    display: grid;
    gap: var(--space-3);
  }

  .contestability-summary__eyebrow {
    margin: 0;
  }

  .contestability-summary__copy {
    margin: 0;
  }

  .contestability-summary__actions {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 900px) {
    .contestability-layout {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }

    .contestability-summary {
      position: sticky;
      top: var(--space-5);
    }
  }

  @media print {
    .contestability-layout {
      display: block;
    }

    .contestability-summary {
      display: none;
    }

    .contestability-checklist {
      background: #fff;
      border: 2px solid #111;
      box-shadow: none;
    }

    .contestability-checklist li {
      break-inside: avoid;
      page-break-inside: avoid;
    }
  }
</style>
