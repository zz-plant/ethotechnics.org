---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextStep from "../../components/NextStep.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import SummaryCallout from "../../components/SummaryCallout.astro";

const pageTitle = "Remedy essentials for accountable systems";
const pageDescription =
  "The eight mechanisms a remedy process needs, from bounded pending states and published clocks to named escalation owners and a record that remedy was delivered.";

const anchorLinks = [
  { href: "#map", label: "Remedy backbone map" },
  { href: "#essentials", label: "Eight essential mechanisms" },
  { href: "#deployment", label: "Deployment checklist" },
];

const essentials = [
  {
    title: "Bounded pending",
    description:
      "Every contested state has a published maximum duration. No account, benefit, or payment is left pending without an end date.",
    why: "Without a limit, a pending case becomes a denial nobody decided. A limit forces a decision and shows the backlog.",
    signals:
      "Each pending state has a time limit. When it runs out, the case escalates or a fallback applies.",
    ask: "What is the longest my case can stay pending?",
  },
  {
    title: "Remedy clocks",
    description:
      "Publish when the person will get an acknowledgment, a review, and a remedy.",
    why: "A published deadline makes each delay countable, so an owner can be held to it.",
    signals: "Each receipt states the owner and the deadline for each stage.",
    ask: "By what date will my case be reviewed, and by what date put right?",
  },
  {
    title: "Default provisional reinstatement",
    description:
      "When the evidence is incomplete, restore access for now while review continues.",
    why: "If the decision turns out to be wrong, the person has lost less. This matters most for essential services.",
    signals:
      "The system can give limited access during review, and withdraw it if the decision stands.",
    ask: "Can I have access back while you review my case?",
  },
  {
    title: "Clear escalation paths",
    description:
      "Name who can override the decision, and how a case reaches them.",
    why: "If no one is named, an automated error stays in place because no one is assigned to remove it.",
    signals:
      "On-call rosters and each person's authority appear on receipts and in internal playbooks.",
    ask: "Who can override this decision, and how do I reach them?",
  },
  {
    title: "Compensation or fee shifting",
    description:
      "A wrongful harm triggers credits, fee waivers, or repayment by a set date.",
    why: "When errors cost the operator money, the operator has a reason to reduce them.",
    signals:
      "Each remedy record logs the amount repaid and the date it was paid.",
    ask: "If this decision was wrong, what will you repay, and by when?",
  },
  {
    title: "Time-to-remedy distribution",
    description: "Track how long every remedy takes, not only the average.",
    why: "An average hides the people who wait longest. The slowest cases show who they are.",
    signals:
      "Reports show median, p90, and p99 remedy times for each group of cases.",
    ask: "How long do the slowest cases like mine take to put right?",
  },
  {
    title: "Constraints on discretionary holds",
    description:
      "Each hold has stated criteria, an owner, and a maximum duration, even during fraud or legal review.",
    why: "A hold with no criteria and no limit cannot be told apart from a denial nobody has to explain.",
    signals:
      "Hold policies state the reasons, the clocks, and the appeal route. Exceptions are audited.",
    ask: "What are the criteria for this hold, and when does it end?",
  },
  {
    title: "Reversal drills and error budgets",
    description:
      "Practice reversing decisions. Set how many wrong decisions a rule may produce before it is halted and sent back to its owner.",
    why: "A drill shows that a reversal works before anyone needs one. An error budget stops wrong decisions from being fixed one at a time while the rule that made them keeps running.",
    signals:
      "Quarterly drill results, reviews after incidents, and alerts when the error budget runs low are on record.",
    ask: "Have other decisions made under the same rule been overturned?",
  },
];

const mapLanes = [
  {
    title: "Guardrails before harm",
    items: [
      "Constraints on discretionary holds",
      "Default provisional reinstatement",
    ],
  },
  {
    title: "Clocks and escalation during review",
    items: ["Bounded pending", "Remedy clocks", "Clear escalation paths"],
  },
  {
    title: "Proof of remedy delivery",
    items: ["Time-to-remedy distribution", "Compensation or fee shifting"],
  },
  {
    title: "Readiness",
    items: ["Reversal drills and error budgets"],
  },
];

const checklist = [
  "Show the acknowledgment, review, and remedy deadlines on screen.",
  "Escalate the case, or apply a fallback, when the pending limit runs out.",
  "Restore essential access during review unless a stated safety criterion blocks it.",
  "Name the on-call owners who can override, and how to reach them.",
  "Log each remedy, the amount repaid, and the date it was delivered.",
  "Track how long remedies take, by group of cases and by exception type.",
  "Audit holds each month for criteria, owners, and time limits.",
  "Run reversal drills, and count upheld challenges by rule against the error budget.",
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Explainer"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="map"
    eyebrow="Visualization"
    title="The remedy backbone"
    description="Each mechanism belongs to one phase of the remedy lifecycle, from guardrails before harm to reversal drills."
  >
    <div class="remedy-map" role="list">
      {
        mapLanes.map((lane) => (
          <div class="remedy-map__lane" role="listitem">
            <p class="eyebrow">{lane.title}</p>
            <ul>
              {lane.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </SectionBlock>

  <SectionBlock
    id="essentials"
    eyebrow="Essentials"
    title="Why each mechanism is required"
    description="The mechanisms depend on each other. Clocks without escalation stall. Escalation without compensation leaves the harm in place."
    variant="alt"
  >
    <CardGrid>
      {
        essentials.map((item) => (
          <CardItem
            title={item.title}
            description={item.description}
            descriptionTone="default"
          >
            <div class="remedy-card__icon" aria-hidden="true">
              <svg class="remedy-icon" viewBox="0 0 48 48" role="presentation">
                <circle class="remedy-icon__pulse" cx="24" cy="24" r="10">
                  <animate
                    attributeName="r"
                    values="8;16;8"
                    dur="3.2s"
                    repeatCount="indefinite"
                  />
                  <animate
                    attributeName="opacity"
                    values="0.45;0.05;0.45"
                    dur="3.2s"
                    repeatCount="indefinite"
                  />
                </circle>
                <circle class="remedy-icon__core" cx="24" cy="24" r="6" />
                <path
                  class="remedy-icon__arc"
                  d="M14 24a10 10 0 0 1 20 0"
                  pathLength="40"
                >
                  <animate
                    attributeName="stroke-dashoffset"
                    values="0;40"
                    dur="2.6s"
                    repeatCount="indefinite"
                  />
                </path>
              </svg>
            </div>
            <p class="muted">Why it matters: {item.why}</p>
            <p class="muted">Signal: {item.signals}</p>
            <p class="muted">A person can ask: "{item.ask}"</p>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="deployment"
    eyebrow="Implementation"
    title="Deployment checklist"
    description="Eight steps that put the mechanisms into policy, the UI, and operations."
  >
    <SummaryCallout
      title="Order of work"
      description="Start with visible clocks and escalation owners. Add restitution and distribution tracking after."
      takeaways={checklist}
      relatedLinks={[
        {
          label: "Remedy clocks",
          href: "/standards/std-02-contestability-recourse",
        },
        { label: "Bounded exceptions", href: "/exceptions" },
        { label: "Evidence packs", href: "/evidence-packs" },
      ]}
    />
  </SectionBlock>

  <NextStep variable="correction" />

  <p class="muted" style="margin-top:var(--space-6)">
    See also: <a href="/taxonomy">Taxonomy</a> &middot; <a href="/standards"
      >Standards</a
    >
  </p>
</BaseLayout>

<style>
  .remedy-map {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    margin-top: var(--space-6);
  }

  .remedy-map__lane {
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--card) 90%, white 10%),
      color-mix(in srgb, var(--surface) 92%, white 8%)
    );
    border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    padding: var(--space-4) var(--space-4) var(--space-5);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .remedy-map__lane::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 20% 10%,
      color-mix(in srgb, var(--accent) 18%, transparent) 0,
      transparent 45%
    );
    opacity: 0.45;
    pointer-events: none;
  }

  .remedy-map__lane ul {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: grid;
    gap: var(--space-2);
  }

  .remedy-map__lane li {
    background: color-mix(in srgb, var(--surface) 92%, white 8%);
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    font-weight: 600;
  }

  .remedy-card__icon {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    background: color-mix(in srgb, var(--surface) 88%, white 12%);
  }

  .remedy-icon {
    width: 1.75rem;
    height: 1.75rem;
    overflow: visible;
  }

  .remedy-icon__pulse {
    fill: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .remedy-icon__core {
    fill: color-mix(in srgb, var(--accent) 60%, white 40%);
  }

  .remedy-icon__arc {
    fill: none;
    stroke: color-mix(in srgb, var(--teal) 55%, white 45%);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 40;
  }
</style>
