---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import SectionBlock from "../../components/SectionBlock.astro";

const explainers = await getCollection("explainers");

const pageTitle = "Explainers";
const pageDescription =
  "The ideas the standards rest on, one page each: what the term means, a made-up case where it matters, what to look for in a real system, and which standards use it.";

const anchorLinks = [{ href: "#all-explainers", label: "All explainers" }];

// In the order the argument runs: where the evidence of an error collects,
// who can challenge it, what authority has to be renewed, and how the repair
// is recorded.
const featuredExplainers = [
  "institutional-debris",
  "error-bearing-parties",
  "contestability",
  "authority-as-lease",
  "justified-delegation",
  "repair-log",
];
const featured = featuredExplainers.flatMap((id) => {
  const entry = explainers.find((explainer) => explainer.id === id);
  return entry ? [entry] : [];
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro
    eyebrow="Explainers"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="featured"
    eyebrow="Start here"
    title="Featured explainers"
    description="These six follow the argument: where the evidence of an error collects, who can challenge it, what authority has to be renewed, and how the repair is recorded."
    variant="alt"
  >
    <CardGrid className="grid--three">
      {
        featured.map((entry) => (
          <CardItem
            title={entry.data.title}
            description={entry.data.description}
          >
            <a
              slot="footer"
              class="button ghost button--compact"
              href={entry.data.permalink}
            >
              Read explainer
            </a>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="all-explainers"
    eyebrow="All explainers"
    title="Full explainer index"
    description={`All ${explainers.length} explainers, in alphabetical order. Each has a stable permalink.`}
  >
    <CardGrid className="grid--two">
      {
        explainers
          .sort((a, b) => a.data.title.localeCompare(b.data.title))
          .map((entry) => (
            <CardItem
              title={entry.data.title}
              description={entry.data.description}
            >
              <a slot="footer" class="muted" href={entry.data.permalink}>
                Read explainer
              </a>
            </CardItem>
          ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="pages"
    eyebrow="Also under explainers"
    title="Written as pages rather than collection entries"
    description="Five pages outside the index above: longer arguments, a checklist, and phrasing to reuse."
  >
    <CardGrid className="grid--two">
      <CardItem
        title="Governance as operational capability"
        description="Governance measured by what a running system can be made to do: answer a challenge, change the rule, halt, and reverse."
      >
        <a slot="footer" class="muted" href="/explainers/governance-capability">
          Read explainer
        </a>
      </CardItem>
      <CardItem
        title="Public memory for contestability terms"
        description="A dated log of how governance terms drifted into labels, with definitions to cite instead."
      >
        <a slot="footer" class="muted" href="/explainers/public-memory">
          Read explainer
        </a>
      </CardItem>
      <CardItem
        title="Remedy essentials for accountable systems"
        description="The eight mechanisms a remedy process needs, grouped by when each one acts."
      >
        <a slot="footer" class="muted" href="/explainers/remedy-essentials">
          Read explainer
        </a>
      </CardItem>
      <CardItem
        title="Contestability checklist"
        description="Seven pass/fail questions to run over a decision flow before it ships or when it is audited."
      >
        <a
          slot="footer"
          class="muted"
          href="/explainers/contestability-checklist"
        >
          Read explainer
        </a>
      </CardItem>
      <CardItem
        title="Language people can use"
        description="Questions a person can send when an automated decision affects them, one ask each."
      >
        <a
          slot="footer"
          class="muted"
          href="/explainers/language-people-can-use"
        >
          Read explainer
        </a>
      </CardItem>
    </CardGrid>
  </SectionBlock>

  <p class="muted" style="margin-top:var(--space-6)">
    See also: <a href="/taxonomy">Taxonomy</a> &middot; <a href="/standards"
      >Standards</a
    > &middot; <a href="/mechanisms">Mechanisms</a>
  </p>
</BaseLayout>
