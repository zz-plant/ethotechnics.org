---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import SectionBlock from "../../components/SectionBlock.astro";

const explainers = await getCollection("explainers");

const pageTitle = "Explainers";
const pageDescription =
  "Short, reusable definitions with examples and next-step artifacts.";

const anchorLinks = [{ href: "#all-explainers", label: "All explainers" }];

const featuredExplainers = [
  "stoppability",
  "contestability",
  "safety-valve",
  "time-to-halt",
  "ethical-interrupts",
  "repair-log",
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro
    eyebrow="Explainers"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="featured"
    eyebrow="Start here"
    title="Featured explainers"
    description="These six cover the core governance capabilities most teams need first."
    variant="alt"
  >
    <CardGrid className="grid--three">
      {
        explainers
          .filter((e) => featuredExplainers.includes(e.id))
          .map((entry) => (
            <CardItem
              title={entry.data.title}
              description={entry.data.description}
            >
              <a
                slot="footer"
                class="button ghost button--compact"
                href={entry.data.permalink}
              >
                Read explainer
              </a>
            </CardItem>
          ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="all-explainers"
    eyebrow="All explainers"
    title="Full explainer index"
    description={`Alphabetical list with ${explainers.length} explainers ready to link directly.`}
  >
    <CardGrid className="grid--two">
      {
        explainers
          .sort((a, b) => a.data.title.localeCompare(b.data.title))
          .map((entry) => (
            <CardItem
              title={entry.data.title}
              description={entry.data.description}
            >
              <a slot="footer" class="muted" href={entry.data.permalink}>
                Read explainer
              </a>
            </CardItem>
          ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="essays"
    eyebrow="Longer pieces"
    title="Explainers that are arguments rather than definitions"
    description="These are written as pages rather than collection entries, so the generated index above does not carry them."
  >
    <CardGrid className="grid--two">
      <CardItem
        title="Governance as operational capability"
        description="Why governance is something an organisation can be more or less able to do, rather than a document it has."
      >
        <a slot="footer" class="muted" href="/explainers/governance-capability">
          Read explainer
        </a>
      </CardItem>
      <CardItem
        title="Public memory for contestability terms"
        description="What has to be remembered, and by whom, for a challenge to still mean something later."
      >
        <a slot="footer" class="muted" href="/explainers/public-memory">
          Read explainer
        </a>
      </CardItem>
    </CardGrid>
  </SectionBlock>

  <p class="muted" style="margin-top:2rem">
    See also: <a href="/taxonomy">Taxonomy</a> &middot; <a href="/standards"
      >Standards</a
    > &middot; <a href="/mechanisms">Mechanisms</a>
  </p>
</BaseLayout>
