---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import SectionBlock from "../../components/SectionBlock.astro";

const explainers = await getCollection("explainers");

const pageTitle = "Explainers";
const pageDescription =
  "The ideas the standards rest on, one page each: what the term means, a made-up case, what to look for in a real system, and which standards use it.";

// In the order the argument runs: where the evidence of an error collects,
// who can challenge it, what authority has to be renewed, and how the repair
// is recorded.
const featuredExplainers = [
  "institutional-debris",
  "error-bearing-parties",
  "contestability",
  "authority-as-lease",
  "justified-delegation",
  "repair-log",
];
const featured = featuredExplainers.flatMap((id) => {
  const entry = explainers.find((explainer) => explainer.id === id);
  return entry ? [entry] : [];
});
// "A to Z" by the term, not the title: sorted on the title, every "What is
// …?" fell to the end, ordered by its article.
const sortKey = (title: string) =>
  title
    .replace(/^what (is|are) (an? |the )?/i, "")
    .replace(/\?$/, "")
    .toLowerCase();
const rest = explainers
  .filter((entry) => !featuredExplainers.includes(entry.id))
  .sort((a, b) => sortKey(a.data.title).localeCompare(sortKey(b.data.title)));
---

<BaseLayout
  title="Explainers of the ideas the standards rest on"
  description={pageDescription}
>
  <PageIntro
    eyebrow="Explainers"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={[]}
  />

  <SectionBlock
    id="featured"
    title="Read these first"
    description="In the order the argument runs: where the evidence of an error collects, who can challenge it, what authority has to be renewed, and how the repair is recorded."
    variant="alt"
  >
    <CardGrid className="grid--three">
      {
        featured.map((entry) => (
          <CardItem
            title={entry.data.title}
            href={entry.data.permalink}
            description={entry.data.description}
          />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock id="all-explainers" title="The rest, A to Z">
    <CardGrid className="grid--two">
      {
        rest.map((entry) => (
          <CardItem
            title={entry.data.title}
            href={entry.data.permalink}
            description={entry.data.description}
          />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="pages"
    title="Longer explainers"
    description="Arguments that need more than a definition, a checklist, and phrasing to reuse."
  >
    <CardGrid className="grid--two">
      <CardItem
        title="Governance as operational capability"
        href="/explainers/governance-capability"
        description="Governance measured by what a running system can be made to do: answer a challenge, change the rule, halt, and reverse."
      />
      <CardItem
        title="Remedy essentials for accountable systems"
        href="/explainers/remedy-essentials"
        description="The eight mechanisms a remedy process needs, grouped by when each one acts."
      />
      <CardItem
        title="Can this decision be challenged?"
        href="/explainers/challenge-checklist"
        description="Seven pass/fail questions to run over a decision flow before it ships or when it is audited."
      />
      <CardItem
        title="Language people can use"
        href="/explainers/language-people-can-use"
        description="Questions a person can send when an automated decision is made about them, one ask each."
      />
    </CardGrid>
  </SectionBlock>
</BaseLayout>
