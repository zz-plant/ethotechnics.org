---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import SectionBlock from "../../components/SectionBlock.astro";

const explainers = await getCollection("explainers");

const pageTitle = "Explainers";
const pageDescription =
  "Short explainers for the terms of delegated authority. Each gives a definition, a worked example, the signals that set it apart, and the artifact to build next.";

const anchorLinks = [{ href: "#all-explainers", label: "All explainers" }];

const featuredExplainers = [
  "stoppability",
  "contestability",
  "safety-valve",
  "time-to-halt",
  "ethical-interrupts",
  "repair-log",
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro
    eyebrow="Explainers"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="featured"
    eyebrow="Start here"
    title="Featured explainers"
    description="These six cover stopping a system, contesting a decision, and recording the repair."
    variant="alt"
  >
    <CardGrid className="grid--three">
      {
        explainers
          .filter((e) => featuredExplainers.includes(e.id))
          .map((entry) => (
            <CardItem
              title={entry.data.title}
              description={entry.data.description}
            >
              <a
                slot="footer"
                class="button ghost button--compact"
                href={entry.data.permalink}
              >
                Read explainer
              </a>
            </CardItem>
          ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="all-explainers"
    eyebrow="All explainers"
    title="Full explainer index"
    description={`All ${explainers.length} explainers, in alphabetical order. Each has a stable permalink.`}
  >
    <CardGrid className="grid--two">
      {
        explainers
          .sort((a, b) => a.data.title.localeCompare(b.data.title))
          .map((entry) => (
            <CardItem
              title={entry.data.title}
              description={entry.data.description}
            >
              <a slot="footer" class="muted" href={entry.data.permalink}>
                Read explainer
              </a>
            </CardItem>
          ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="pages"
    eyebrow="Also under explainers"
    title="Written as pages rather than collection entries"
    description="Five pages outside the index above: longer arguments, a checklist, and phrasing to reuse."
  >
    <CardGrid className="grid--two">
      <CardItem
        title="Governance as operational capability"
        description="Why governance is something an organization can be more or less able to do, rather than a document it has."
      >
        <a slot="footer" class="muted" href="/explainers/governance-capability">
          Read explainer
        </a>
      </CardItem>
      <CardItem
        title="Public memory for contestability terms"
        description="What has to be remembered, and by whom, for a challenge to still mean something later."
      >
        <a slot="footer" class="muted" href="/explainers/public-memory">
          Read explainer
        </a>
      </CardItem>
      <CardItem
        title="Remedy essentials for accountable systems"
        description="The eight mechanisms that keep contestability real, each anchored to a phase of the remedy lifecycle."
      >
        <a slot="footer" class="muted" href="/explainers/remedy-essentials">
          Read explainer
        </a>
      </CardItem>
      <CardItem
        title="Contestability checklist"
        description="A pass/fail screen to run over a decision flow before shipping it or auditing it."
      >
        <a
          slot="footer"
          class="muted"
          href="/explainers/contestability-checklist"
        >
          Read explainer
        </a>
      </CardItem>
      <CardItem
        title="Language people can use"
        description="Copy-ready phrasing for email, chat, or an intake form when you need a contestable record."
      >
        <a
          slot="footer"
          class="muted"
          href="/explainers/language-people-can-use"
        >
          Read explainer
        </a>
      </CardItem>
    </CardGrid>
  </SectionBlock>

  <p class="muted" style="margin-top:2rem">
    See also: <a href="/taxonomy">Taxonomy</a> &middot; <a href="/standards"
      >Standards</a
    > &middot; <a href="/mechanisms">Mechanisms</a>
  </p>
</BaseLayout>
