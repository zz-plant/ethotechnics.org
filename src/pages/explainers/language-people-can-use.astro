---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextStep from "../../components/NextStep.astro";
import CardGrid from "../../components/CardGrid.astro";
import CardItem from "../../components/CardItem.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";

const pageTitle = "Language people can use";
const pageDescription =
  "Questions to send when an automated decision affects you. Each asks for one thing: the reasons, the record, who can change it, or when you will hear back.";
const permalink = "/explainers/language-people-can-use";

const anchorLinks = [
  { href: "#phrases", label: "Questions to send" },
  { href: "#contexts", label: "By setting" },
  { href: "#print", label: "Printable sheet" },
];

const phrases = [
  {
    title:
      "Who can change this decision, and by what date will they answer me?",
    description: "Use when no one is named and no date is given.",
  },
  {
    title: "What were the reasons for this decision?",
    description: "Use when you were told the outcome but not why.",
  },
  {
    title:
      "Please send me the record of this decision and the information it used.",
    description:
      "Use when you want something in writing you can check and show to someone else.",
  },
  {
    title: "If this decision was wrong, what will you do to put it right?",
    description: "Use before you appeal, to learn what winning would get you.",
  },
  {
    title: "Have other decisions made under the same rule been overturned?",
    description:
      "Use when you think your case is not the only one. It asks whether wins on appeal have changed the rule.",
  },
  {
    title:
      "If this decision cannot be changed, please tell me that in writing.",
    description:
      "Use to get the answer on the record, from someone who has to stand behind it.",
  },
];

const contextBlocks = [
  {
    title: "Workplace systems",
    description:
      "For HR, scheduling, access control, or performance decisions inside companies.",
    phrases: [
      "Who can change this decision?",
      "By what date will I get a final answer?",
      "If this decision stands, what options do I still have?",
    ],
  },
  {
    title: "Public services",
    description:
      "For benefits, housing, healthcare, or licensing decisions run by public agencies.",
    phrases: [
      "What is the deadline for appealing this decision?",
      "Please tell me in writing what evidence this decision relied on.",
      "If this decision is overturned, will I get back what I missed?",
    ],
  },
  {
    title: "Platforms and marketplaces",
    description:
      "For content moderation, account restrictions, payouts, or ranking changes.",
    phrases: [
      "What content or activity led to this action?",
      "How do I ask a person to review this?",
      "If my appeal succeeds, when will my account be restored?",
    ],
  },
];

const printSheet = {
  title: "Language people can use",
  intro:
    "Each question asks for one thing: the reasons, the record, who can change the decision, when you will hear back, or what happens if it was wrong.",
  sections: [
    {
      title: "Six questions",
      items: phrases.map((item) => item.title),
    },
    {
      title: "Workplace systems",
      items: contextBlocks[0].phrases,
    },
    {
      title: "Public services",
      items: contextBlocks[1].phrases,
    },
    {
      title: "Platforms and marketplaces",
      items: contextBlocks[2].phrases,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Explainer"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="phrases"
    eyebrow="Questions to send"
    title="Six questions to send"
    description="Send them by email, by chat, or in the form you were given."
  >
    <CardGrid className="grid--two">
      {
        phrases.map((phrase) => (
          <CardItem
            title={phrase.title}
            description={phrase.description}
            descriptionTone="default"
          />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="contexts"
    eyebrow="By setting"
    title="Questions for your setting"
    description="Three more for each kind of organization, to send as written."
    variant="alt"
  >
    <CardGrid className="grid--two">
      {
        contextBlocks.map((block) => (
          <CardItem
            title={block.title}
            description={block.description}
            descriptionTone="default"
          >
            <ul class="language-list">
              {block.phrases.map((phrase) => (
                <li>{phrase}</li>
              ))}
            </ul>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="print"
    eyebrow="Printable"
    title="One-page language sheet"
    description="Print this sheet or save it as a PDF to keep with your papers."
  >
    <div class="language-print screen-only">
      <div class="language-print__panel">
        <p class="eyebrow">Print or save</p>
        <h3>{printSheet.title}</h3>
        <p class="muted">{printSheet.intro}</p>
        <div class="actions">
          <button class="button ghost" type="button" data-language-print>
            Print sheet
          </button>
        </div>
      </div>
      <div class="language-print__preview" aria-label="Printable preview">
        {
          printSheet.sections.map((section) => (
            <div class="language-print__section">
              <p class="language-print__title">{section.title}</p>
              <ul>
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div
      class="language-print language-print--print print-only"
      aria-label="Printable sheet"
    >
      <h2>{printSheet.title}</h2>
      <p>{printSheet.intro}</p>
      {
        printSheet.sections.map((section) => (
          <div class="language-print__section">
            <p class="language-print__title">{section.title}</p>
            <ul>
              {section.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="muted language-print__note">
        Source: Ethotechnics contestability guidance · <a href={permalink}
          >{permalink}</a
        >
      </p>
    </div>
  </SectionBlock>

  <NextStep
    variable="standing"
    action={{
      label: "Check a decision about you",
      href: "/diagnostics/self-defense-tools",
    }}
  />

  <p class="muted" style="margin-top:var(--space-6)">
    See also: <a href="/taxonomy">Taxonomy</a> &middot; <a href="/standards"
      >Standards</a
    >
  </p>
</BaseLayout>

<script>
  const printButton = document.querySelector<HTMLButtonElement>(
    "[data-language-print]",
  );

  if (printButton) {
    printButton.addEventListener("click", () => {
      window.print();
    });
  }
</script>

<style>
  .screen-only {
    display: block;
  }

  .print-only {
    display: none;
  }

  .language-list {
    list-style: disc;
    padding-left: var(--space-4);
    margin: var(--space-4) 0 0;
    display: grid;
    gap: var(--space-2);
  }

  .language-print {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--surface);
    display: grid;
    gap: var(--space-5);
  }

  .language-print__panel {
    display: grid;
    gap: var(--space-3);
  }

  .language-print__preview {
    display: grid;
    gap: var(--space-4);
  }

  .language-print__section {
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .language-print__title {
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .language-print__note {
    margin-top: var(--space-5);
  }

  .language-print--print {
    gap: var(--space-4);
  }

  .language-print--print h2 {
    margin-bottom: var(--space-2);
  }

  .language-print--print ul {
    padding-left: var(--space-4);
  }

  @media (min-width: 960px) {
    .language-print {
      grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
      align-items: start;
    }
  }

  @media print {
    .screen-only {
      display: none;
    }

    .print-only {
      display: block;
    }

    .language-print--print {
      border: none;
      padding: 0;
    }

    .language-print__section {
      border: 1px solid var(--border);
      break-inside: avoid;
    }
  }
</style>
