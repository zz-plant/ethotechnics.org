---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextStep from "../../components/NextStep.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionBlock from "../../components/SectionBlock.astro";

const pageTitle = "Contestability checklist";
const pageDescription =
  "Seven pass/fail questions that test whether a person can contest an automated decision, each with what a failing answer means.";

const anchorLinks = [{ href: "#checklist", label: "Checklist" }];

// What a failing answer means used to sit below the checklist as three
// expandable notes, and a reader had to match each note back to its
// questions. Each note's sentences now sit under the question they explain.
const checklistItems = [
  {
    question:
      "Does the person receive a decision record with the reasons, the date, and what the decision covers?",
    ifNot:
      "“Contact support” is a queue. Without a receipt, a deadline, and a named person who can decide, it is only a request for help.",
  },
  {
    question: "Can a named person change or reverse the decision?",
    ifNot:
      "The appeal is for show: it hides who decides. An appeal changes the outcome only when it reaches someone who can reverse the decision, and the evidence the person sends is weighed.",
  },
  {
    question: "Is there a deadline by which the person must get an answer?",
    ifNot:
      "Requests sit in the queue and are never reversed. Due process needs a deadline and escalation that has to happen.",
  },
  {
    question:
      "Can the person appeal without asking permission or meeting hidden conditions first?",
    ifNot:
      "The case never reaches a state the system has to answer. There is no contestability, even if there is a form or a hotline.",
  },
  {
    question:
      "If the appeal succeeds, is there a set way to reverse the decision or remedy the harm?",
    ifNot: "Winning changes nothing. Due process needs a decision that binds.",
  },
  {
    question:
      "Is there a record that appeals have succeeded, not only that they were processed?",
    ifNot:
      "The route may be for show, ending in a queue no one can trace. A real appeal route publishes how often appeals succeed, names who can reverse outcomes, and shows where the evidence is weighed.",
  },
  {
    question:
      "Are upheld appeals counted against the rule that produced them, and is the count sent to the rule's owner?",
    ifNot:
      "The rule keeps running. When appeals against one rule keep winning, the rule is wrong. The count goes to the rule's owner, who changes the rule.",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  publishedTime="2025-06-01T00:00:00.000Z"
>
  <PageIntro
    eyebrow="Explainer"
    title={pageTitle}
    description={pageDescription}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="checklist"
    eyebrow="Can a person contest this?"
    title="Contestability checklist"
    description="Seven pass/fail questions to run over a decision flow before it ships or when it is audited."
  >
    <div class="contestability-layout">
      <div
        class="contestability-checklist"
        role="group"
        aria-label="Contestability checklist"
      >
        <p>
          Contestability turns “that’s wrong” into something the system has to
          answer: a decision with reasons, a deadline, a named person who can
          change it, and a route to reversal.
        </p>
        <ul>
          {
            checklistItems.map((item) => (
              <li>
                <p
                  class="contestability-checklist__question"
                  data-checklist-question
                >
                  {item.question}
                </p>
                <p class="muted">
                  <strong>If not.</strong> {item.ifNot}
                </p>
              </li>
            ))
          }
        </ul>
        <p class="muted small">
          The questions come from the <a href="/glossary/contestability"
            >glossary definition</a
          >. The contestability standard, <a
            href="/standards/std-02-contestability-recourse">STD-02</a
          >, sets the obligations behind them, including clear appeal paths.
        </p>
      </div>
      <aside class="contestability-summary" aria-label="Checklist summary">
        <p class="eyebrow contestability-summary__eyebrow">
          2-minute checklist
        </p>
        <p class="muted contestability-summary__copy">
          Each question asks for a record: a reversal that happened, a review
          that met its clock.
        </p>
        <div class="contestability-summary__actions">
          <button class="button ghost" type="button" data-checklist-print>
            Print checklist
          </button>
          <button class="button ghost" type="button" data-checklist-copy>
            Copy checklist
          </button>
        </div>
      </aside>
    </div>
  </SectionBlock>

  <NextStep variable="standing" />

  <p class="muted" style="margin-top:var(--space-6)">
    See also: <a href="/standards">Standards</a> &middot; <a href="/mechanisms"
      >Mechanisms</a
    >
  </p>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>(
    "[data-checklist-copy]",
  );
  const printButton = document.querySelector<HTMLButtonElement>(
    "[data-checklist-print]",
  );
  const questions = document.querySelectorAll<HTMLElement>(
    "[data-checklist-question]",
  );

  if (printButton) {
    printButton.addEventListener("click", () => {
      window.print();
    });
  }

  if (copyButton && questions.length > 0) {
    copyButton.addEventListener("click", async () => {
      const items = Array.from(questions).map(
        (question) => question.textContent?.trim() ?? "",
      );
      const checklistText = [
        "Contestability checklist",
        "",
        ...items.map((item) => `- ${item}`),
      ]
        .filter(Boolean)
        .join("\n");
      try {
        await navigator.clipboard.writeText(checklistText);
        copyButton.textContent = "Checklist copied";
        window.setTimeout(() => {
          copyButton.textContent = "Copy checklist";
        }, 2000);
      } catch (error) {
        copyButton.textContent = "Copy failed";
        window.setTimeout(() => {
          copyButton.textContent = "Copy checklist";
        }, 2000);
      }
    });
  }
</script>

<style>
  .contestability-layout {
    display: grid;
    gap: var(--space-5);
  }

  .contestability-checklist {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--surface);
  }

  .contestability-checklist ul {
    margin: var(--space-4) 0;
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-4);
  }

  .contestability-checklist li > p {
    margin: 0;
  }

  .contestability-checklist li > p + p {
    margin-top: var(--space-1);
  }

  .contestability-checklist__question {
    font-weight: 600;
  }

  .contestability-summary {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background: var(--surface);
    display: grid;
    gap: var(--space-3);
  }

  .contestability-summary__eyebrow {
    margin: 0;
  }

  .contestability-summary__copy {
    margin: 0;
  }

  .contestability-summary__actions {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 900px) {
    .contestability-layout {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }

    .contestability-summary {
      position: sticky;
      top: var(--space-5);
    }
  }

  /* The checklist itself prints; a second, print-only copy of it used to. */
  @media print {
    .contestability-layout {
      display: block;
    }

    .contestability-summary {
      display: none;
    }

    .contestability-checklist {
      background: #fff;
      border: 2px solid #111;
      box-shadow: none;
    }

    .contestability-checklist li {
      break-inside: avoid;
      page-break-inside: avoid;
    }
  }
</style>
