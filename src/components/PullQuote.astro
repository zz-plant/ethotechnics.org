---
export interface Props {
  quote: string;
  attribution?: string;
  variant?: "default" | "accent";
}
const { quote, attribution, variant = "default" } = Astro.props;
---

<aside class:list={["pull-quote", `pull-quote--${variant}`]}>
  <blockquote>
    <p>{quote}</p>{attribution && <cite>{attribution}</cite>}
  </blockquote>
</aside>
<style>
  .pull-quote {
    margin: var(--space-6) 0;
    padding: var(--space-5) 0;
    border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    break-inside: avoid;
  }
  @media (min-width: 900px) {
    .pull-quote {
      float: right;
      width: 300px;
      margin: var(--space-2) calc(-1 * var(--space-5)) var(--space-5)
        var(--space-6);
      border: none;
      border-left: 3px solid
        var(
          --surface-accent-edge,
          color-mix(in srgb, var(--accent) 50%, transparent)
        );
      padding: 0 0 0 var(--space-5);
    }
  }
  .pull-quote--accent {
    border-left-color: var(--accent);
  }
  .pull-quote blockquote {
    margin: 0;
  }
  .pull-quote p {
    font-family: var(--serif);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
  }
  .pull-quote cite {
    display: block;
    margin-top: var(--space-3);
    font-style: normal;
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .pull-quote cite::before {
    content: "\2014 ";
  }
</style>
