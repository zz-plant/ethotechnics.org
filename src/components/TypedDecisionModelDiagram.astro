---
/**
 * Typed Decision Model Diagram (STD-08, STD-09, STD-02).
 *
 * Draws one call to a typed decision model (state and fixed-answer questions
 * in, a choice and a confidence out, a threshold between acting and asking)
 * and the six places the explainer says its authority sits, each tied to the
 * clause that governs it.
 */
interface Props {
  level?: "h2" | "h3";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;
---

<figure class="state-diagram" aria-labelledby="tdm-diagram-title">
  <figcaption>
    <p class="eyebrow">Mechanism, drawn</p>
    <Heading id="tdm-diagram-title">
      Six places a decision model holds authority
    </Heading>
    <p class="muted">
      The model returns a choice and a confidence, not text. Its authority sits around the call, in
      six places the standards name.
    </p>
  </figcaption>

  <div class="diagram-scroll">
    <svg
      viewBox="0 0 920 470"
      role="img"
      class="state-diagram__svg"
      aria-label="Anatomy of a typed decision model call. An upstream hop feeds an input of state and fixed-answer questions to the model, which returns a choice and a confidence. A threshold sends the case to a reviewer or runs it unattended. Six callouts mark where authority sits: shaping hops (STD-09 section 1.5 and 1.6), content in the state (STD-08 section 1.5), reasons nobody produced (STD-02 section 1.4), the reviewer's queue (STD-08 section 3.6), the threshold (STD-08 section 2.6), and the rate at which decisions outrun recourse (STD-02 section 8.6)."
    >
      <defs>
        <marker
          id="tdm-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--muted)" />
        </marker>
      </defs>

      {/* Leaders: each place of authority to the part of the call it sits on */}
      <g stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 4" fill="none">
        <line x1="125" y1="108" x2="80" y2="190" />
        <line x1="350" y1="108" x2="240" y2="190" />
        <line x1="575" y1="108" x2="565" y2="190" />
        <line x1="800" y1="108" x2="840" y2="176" />
        <line x1="695" y1="281" x2="600" y2="356" />
        <line x1="840" y1="296" x2="800" y2="356" />
      </g>

      {/* The model call, left to right */}
      <g stroke="var(--muted)" stroke-width="2" fill="none">
        <line x1="140" y1="236" x2="163" y2="236" marker-end="url(#tdm-arrow)" />
        <line x1="315" y1="236" x2="338" y2="236" marker-end="url(#tdm-arrow)" />
        <line x1="490" y1="236" x2="513" y2="236" marker-end="url(#tdm-arrow)" />
        <line x1="615" y1="236" x2="638" y2="236" marker-end="url(#tdm-arrow)" />
        <path d="M 750 236 L 760 236 L 760 201 L 773 201" marker-end="url(#tdm-arrow)" />
        <path d="M 760 236 L 760 271 L 773 271" marker-end="url(#tdm-arrow)" />
      </g>

      <g class="state-diagram__node" transform="translate(20, 190)">
        <rect width="120" height="92" rx="8" />
        <text x="60" y="26" text-anchor="middle" class="state-diagram__state">Upstream hop</text>
        <text x="60" y="48" text-anchor="middle" class="state-diagram__label">Ranks, filters,</text>
        <text x="60" y="66" text-anchor="middle" class="state-diagram__label">or routes</text>
      </g>

      <g class="state-diagram__node" transform="translate(165, 190)">
        <rect width="150" height="92" rx="8" />
        <text x="75" y="26" text-anchor="middle" class="state-diagram__state">Input</text>
        <text x="75" y="48" text-anchor="middle" class="state-diagram__label">Block of state</text>
        <text x="75" y="66" text-anchor="middle" class="state-diagram__label">Questions with</text>
        <text x="75" y="84" text-anchor="middle" class="state-diagram__label">fixed answers</text>
      </g>

      <g class="state-diagram__node state-diagram__node--active" transform="translate(340, 190)">
        <rect width="150" height="92" rx="8" />
        <text x="75" y="26" text-anchor="middle" class="state-diagram__state">Decision model</text>
        <text x="75" y="48" text-anchor="middle" class="state-diagram__label">Writes no text,</text>
        <text x="75" y="66" text-anchor="middle" class="state-diagram__label">gives no reasons</text>
      </g>

      <g class="state-diagram__node" transform="translate(515, 190)">
        <rect width="100" height="92" rx="8" />
        <text x="50" y="26" text-anchor="middle" class="state-diagram__state">Output</text>
        <text x="50" y="48" text-anchor="middle" class="state-diagram__clause">Choice</text>
        <text x="50" y="66" text-anchor="middle" class="state-diagram__clause">Confidence</text>
      </g>

      <g class="state-diagram__node" transform="translate(640, 191)">
        <polygon points="55,0 110,45 55,90 0,45" fill="var(--panel)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="55" y="50" text-anchor="middle" class="state-diagram__state">Threshold</text>
      </g>

      <g class="state-diagram__node" transform="translate(775, 176)">
        <rect width="130" height="50" rx="8" />
        <text x="65" y="21" text-anchor="middle" class="state-diagram__state">Ask</text>
        <text x="65" y="40" text-anchor="middle" class="state-diagram__label">To a reviewer</text>
      </g>

      <g class="state-diagram__node" transform="translate(775, 246)">
        <rect width="130" height="50" rx="8" />
        <text x="65" y="21" text-anchor="middle" class="state-diagram__state">Act</text>
        <text x="65" y="40" text-anchor="middle" class="state-diagram__label">Runs unattended</text>
      </g>

      {/* The six places, top row */}
      <g class="state-diagram__node" transform="translate(20, 16)">
        <rect width="210" height="92" rx="8" fill="var(--surface)" stroke="var(--accent)" />
        <text x="105" y="24" text-anchor="middle" class="state-diagram__state">Shaping hops</text>
        <text x="105" y="45" text-anchor="middle" class="state-diagram__clause">STD-09 §1.5, §1.6</text>
        <text x="105" y="65" text-anchor="middle" class="state-diagram__label">Shape the decision</text>
        <text x="105" y="83" text-anchor="middle" class="state-diagram__label">without making it</text>
      </g>

      <g class="state-diagram__node" transform="translate(245, 16)">
        <rect width="210" height="92" rx="8" fill="var(--surface)" stroke="var(--accent)" />
        <text x="105" y="24" text-anchor="middle" class="state-diagram__state">Content in the state</text>
        <text x="105" y="45" text-anchor="middle" class="state-diagram__clause">STD-08 §1.5</text>
        <text x="105" y="65" text-anchor="middle" class="state-diagram__label">Content does not</text>
        <text x="105" y="83" text-anchor="middle" class="state-diagram__label">authorize</text>
      </g>

      <g class="state-diagram__node" transform="translate(470, 16)">
        <rect width="210" height="92" rx="8" fill="var(--surface)" stroke="var(--accent)" />
        <text x="105" y="24" text-anchor="middle" class="state-diagram__state">Reasons nobody produced</text>
        <text x="105" y="45" text-anchor="middle" class="state-diagram__clause">STD-02 §1.4</text>
        <text x="105" y="65" text-anchor="middle" class="state-diagram__label">A reason must be</text>
        <text x="105" y="83" text-anchor="middle" class="state-diagram__label">the decision's own</text>
      </g>

      <g class="state-diagram__node" transform="translate(695, 16)">
        <rect width="210" height="92" rx="8" fill="var(--surface)" stroke="var(--accent)" />
        <text x="105" y="24" text-anchor="middle" class="state-diagram__state">The reviewer's queue</text>
        <text x="105" y="45" text-anchor="middle" class="state-diagram__clause">STD-08 §3.6</text>
        <text x="105" y="65" text-anchor="middle" class="state-diagram__label">Review sees what</text>
        <text x="105" y="83" text-anchor="middle" class="state-diagram__label">ran unattended</text>
      </g>

      {/* The six places, bottom row */}
      <g class="state-diagram__node" transform="translate(470, 356)">
        <rect width="210" height="92" rx="8" fill="var(--surface)" stroke="var(--accent)" />
        <text x="105" y="24" text-anchor="middle" class="state-diagram__state">The threshold</text>
        <text x="105" y="45" text-anchor="middle" class="state-diagram__clause">STD-08 §2.6</text>
        <text x="105" y="65" text-anchor="middle" class="state-diagram__label">Decides between</text>
        <text x="105" y="83" text-anchor="middle" class="state-diagram__label">acting and asking</text>
      </g>

      <g class="state-diagram__node" transform="translate(695, 356)">
        <rect width="210" height="92" rx="8" fill="var(--surface)" stroke="var(--accent)" />
        <text x="105" y="24" text-anchor="middle" class="state-diagram__state">Issue rate</text>
        <text x="105" y="45" text-anchor="middle" class="state-diagram__clause">STD-02 §8.6</text>
        <text x="105" y="65" text-anchor="middle" class="state-diagram__label">Decisions cannot</text>
        <text x="105" y="83" text-anchor="middle" class="state-diagram__label">outrun recourse</text>
      </g>

      {/* Key */}
      <g class="state-diagram__node" transform="translate(20, 370)">
        <line x1="0" y1="18" x2="44" y2="18" stroke="var(--muted)" stroke-width="2" marker-end="url(#tdm-arrow)" />
        <text x="58" y="23" class="state-diagram__label">The model call</text>
        <line x1="0" y1="52" x2="44" y2="52" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 4" />
        <text x="58" y="57" class="state-diagram__label">Where its authority sits</text>
      </g>
    </svg>
  </div>
</figure>
