---
/**
 * Dependence Asymmetry Coordinate Space Diagram.
 *
 * Visualizes the relationship between Institution Substitution Cost (Capture)
 * and Population Exit Cost (Domination), illustrating why Ethotechnics inverts
 * the traditional inference of command into an escalated obligation of care.
 */
interface Props {
  level?: "h2" | "h3";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;
---

<figure class="state-diagram" aria-labelledby="dependence-asymmetry-title">
  <figcaption>
    <p class="eyebrow">Theory, drawn</p>
    <Heading id="dependence-asymmetry-title">
      Two-Way Dependence: Substitution Cost vs. Exit Cost
    </Heading>
    <p class="muted">
      Dependence does not license command. The less a population can leave, the more correction capacity the institution owes.
    </p>
  </figcaption>

  <div class="diagram-scroll">
    <svg
      viewBox="0 0 920 430"
      role="img"
      class="state-diagram__svg"
      aria-label="Quadrant diagram plotting Institution Substitution Cost against Population Exit Cost, showing that high exit cost escalates institutional obligations rather than command authority."
    >
      <defs>
        <marker
          id="axis-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--border)" />
        </marker>
        <marker
          id="duty-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
      </defs>

      {/* Axis Lines */}
      <line x1="158" y1="388" x2="905" y2="388" stroke="var(--border)" stroke-width="2" marker-end="url(#axis-arrow)" />
      <line x1="158" y1="388" x2="158" y2="30" stroke="var(--border)" stroke-width="2" marker-end="url(#axis-arrow)" />

      {/* Axis Labels */}
      <text x="902" y="414" text-anchor="end" class="state-diagram__clause">Institution Substitution Cost → (Measures Capture)</text>
      <text x="164" y="22" text-anchor="start" class="state-diagram__clause">Population Exit Cost ↑ (Measures Exposure / Domination)</text>

      {/* Quadrant Dividers */}
      <line x1="536" y1="40" x2="536" y2="388" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 4" />
      <line x1="158" y1="218" x2="902" y2="218" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 4" />

      {/* Quadrant II: High Exit Cost, Low Substitution Cost (The Asymmetry Trap) */}
      <g transform="translate(170, 40)">
        <rect width="360" height="168" rx="8" fill="var(--panel)" stroke="var(--accent)" stroke-width="2" />
        <text x="16" y="27" class="state-diagram__state" fill="var(--accent-strong)">The Captive Population Trap</text>
        <text x="16" y="50" class="state-diagram__label">Low substitution cost for operator ·</text>
        <text x="16" y="68" class="state-diagram__label">High exit cost for user</text>
        <text x="16" y="93" class="state-diagram__clause">Default Illusion: "We may direct them,</text>
        <text x="16" y="111" class="state-diagram__clause">they cannot leave"</text>
        <text x="16" y="136" class="state-diagram__state">Ethotechnic Inversion: Maximum</text>
        <text x="16" y="156" class="state-diagram__state">Standing & Reversal Owed</text>
      </g>

      {/* Quadrant I: High Exit Cost, High Substitution Cost (Deep Entrenchment) */}
      <g transform="translate(542, 40)">
        <rect width="360" height="168" rx="8" fill="var(--surface)" stroke="var(--border)" />
        <text x="16" y="27" class="state-diagram__state">Mutual Structural Capture</text>
        <text x="16" y="50" class="state-diagram__label">High substitution cost · High exit cost</text>
        <text x="16" y="75" class="state-diagram__label">Infrastructure lock-in: both parties</text>
        <text x="16" y="93" class="state-diagram__label">bound to legacy flow</text>
        <text x="16" y="118" class="state-diagram__clause">Requires: Reversibility Rehearsal</text>
        <text x="16" y="136" class="state-diagram__clause">& Contingency Rails</text>
      </g>

      {/* Quadrant III: Low Exit Cost, Low Substitution Cost (Dispensable / Market) */}
      <g transform="translate(170, 228)">
        <rect width="360" height="148" rx="8" fill="var(--surface)" stroke="var(--border)" />
        <text x="16" y="27" class="state-diagram__state">Symmetric Fluidity</text>
        <text x="16" y="50" class="state-diagram__label">Low substitution cost · Low exit cost</text>
        <text x="16" y="75" class="state-diagram__label">Commodity tools: exit is realistic</text>
        <text x="16" y="93" class="state-diagram__label">and caps error exposure</text>
        <text x="16" y="118" class="state-diagram__clause">Minimal structural exposure;</text>
        <text x="16" y="136" class="state-diagram__clause">light governance overhead</text>
      </g>

      {/* Quadrant IV: Low Exit Cost, High Substitution Cost (Vendor Lock-in) */}
      <g transform="translate(542, 228)">
        <rect width="360" height="148" rx="8" fill="var(--surface)" stroke="var(--border)" />
        <text x="16" y="27" class="state-diagram__state">Operator Capture</text>
        <text x="16" y="50" class="state-diagram__label">High substitution cost · Low user exit cost</text>
        <text x="16" y="75" class="state-diagram__label">Institution trapped by proprietary stack</text>
        <text x="16" y="93" class="state-diagram__label">while users can migrate</text>
        <text x="16" y="118" class="state-diagram__clause">Requires: Retained Technical</text>
        <text x="16" y="136" class="state-diagram__clause">Competence (Law V)</text>
      </g>

      {/* Core Dynamic Vector: runs up the exit-cost axis */}
      <line
        x1="144"
        y1="372"
        x2="144"
        y2="52"
        stroke="var(--accent)"
        stroke-width="2"
        stroke-dasharray="4 4"
        marker-end="url(#duty-arrow)"
      />
      <text x="134" y="206" text-anchor="end" class="state-diagram__clause">As Exit</text>
      <text x="134" y="224" text-anchor="end" class="state-diagram__clause">Cost Rises</text>
      <text x="134" y="244" text-anchor="end" class="state-diagram__label">Obligation</text>
      <text x="134" y="262" text-anchor="end" class="state-diagram__label">escalates</text>
    </svg>
  </div>
</figure>
