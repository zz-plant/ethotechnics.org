---
/**
 * The casebook as five lines that failed the same way.
 *
 * One row per case, sorted by how long harm ran. Six stops on the line are
 * the six safeguards, drawn held, drifted, or failed; the halt time sits at
 * the right edge. The row is the link; the stops are labelled for assistive
 * technology.
 */
import {
  cases,
  stateVariables,
  type StateVariableId,
} from "../../content/casebook";

const days = [...cases].sort((a, b) => b.timeToHaltDays - a.timeToHaltDays);
const yearDays = 365.25;

const safeguardGloss: Record<StateVariableId, string> = {
  capability: "what the system could do",
  authority: "what it was allowed to do, for whom, and until when",
  evidence: "what justified that permission",
  dependency: "how hard it had become to switch off or replace",
  standing:
    "whether a person it decided about could challenge the decision and get an answer",
  correction: "whether anyone could still step in, and how fast",
};

const haltLabel = (value: number) => {
  if (value < yearDays) return `${Math.max(1, Math.round(value))} days`;
  const years = Math.floor(value / yearDays);
  const months = Math.round((value % yearDays) / 30.4);
  return months > 0 ? `${years} yr ${months} mo` : `${years} yr`;
};
---

<section
  id="casebook"
  class="case-lines"
  aria-labelledby="home-casebook-heading"
>
  <header class="case-lines__header">
    <h2 id="home-casebook-heading" class="line-heading">
      Robodebt was not the exception.
    </h2>
    <p class="line-lead">
      A court, an inquiry, or a regulator established the facts of each case
      below. None was stopped by the organization running it. Apple Card's
      issuer is the one operator that changed its own process, after a
      regulator's investigation.
    </p>
  </header>

  <div class="case-lines__key">
    <span><i class="line-map__key line-map__key--held"></i>held</span>
    <span><i class="line-map__key line-map__key--drift"></i>drifted</span>
    <span><i class="line-map__key line-map__key--failed"></i>failed</span>
    <span>Longest harm first.</span>
  </div>

  <div class="case-lines__columns" aria-hidden="true">
    <span></span>
    <span class="case-lines__col-group">
      {
        stateVariables.map((variable) => (
          <span>{variable.label.slice(0, 3).toUpperCase()}</span>
        ))
      }
    </span>
    <span>Halt</span>
  </div>

  <ol class="case-lines__list">
    {
      days.map((entry) => (
        <li class="case-lines__row" data-reveal>
          <a href={`/casebook/${entry.slug}`}>
            <span class="case-lines__name">
              <span>{entry.title}</span>
              <span class="case-lines__meta">
                {entry.jurisdiction.split(" · ")[0]} ·{" "}
                {entry.learningOutcome.verdict === "learned"
                  ? "changed its own process"
                  : "change imposed from outside"}
              </span>
            </span>
            <span
              class="case-lines__track"
              aria-label={stateVariables
                .map((variable) => {
                  const finding = entry.findings.find(
                    (item) => item.variable === variable.id,
                  );
                  return `${variable.label}: ${finding?.verdict ?? "not scored"}`;
                })
                .join(", ")}
            >
              {stateVariables.map((variable) => {
                const finding = entry.findings.find(
                  (item) => item.variable === variable.id,
                );
                return finding ? (
                  <span
                    class:list={[
                      "case-lines__stop",
                      `case-lines__stop--${finding.verdict}`,
                    ]}
                    aria-hidden="true"
                  />
                ) : null;
              })}
            </span>
            <span class="case-lines__halt">
              {haltLabel(entry.timeToHaltDays)}
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <details class="case-lines__key">
    <summary>How to read the stops</summary>
    <ul class="small">
      {
        stateVariables.map((variable) => (
          <li>
            <strong>{variable.label}</strong>
            {`: ${safeguardGloss[variable.id]}`}
          </li>
        ))
      }
    </ul>
    <p class="small muted">
      Each row marks the six safeguards left to right. The halt time is how long
      the harm ran before it stopped.
    </p>
  </details>

  <p class="small muted">
    <a class="line-link" href="/casebook">Open the casebook →</a>
  </p>
</section>
