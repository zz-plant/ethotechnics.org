---
/**
 * The casebook as barcode rows: one packed row per case, sorted by how long
 * harm ran. The six verdicts read as a barcode, the halt bar sits at the
 * right edge on a square-root scale — so a four-day bar stays visible beside
 * a twenty-year one — and the row's text carries what the record
 * established. The row link is the content; the marks are labelled for
 * assistive technology and drawn as marks for everyone else.
 */
import { cases, stateVariables } from "../../content/casebook";
import StateVariableGlyph from "../StateVariableGlyph.astro";
import VerdictMark from "../VerdictMark.astro";

const days = [...cases].sort((a, b) => b.timeToHaltDays - a.timeToHaltDays);
const longest = days[0]?.timeToHaltDays ?? 1;
const yearDays = 365.25;
const shortest = days[days.length - 1];

const haltShare = (value: number) => Math.sqrt(value / longest);
const haltLabel = (value: number) => {
  if (value < yearDays) return `${Math.max(1, Math.round(value))} days`;
  const years = Math.floor(value / yearDays);
  const months = Math.round((value % yearDays) / 30.4);
  return months > 0 ? `${years}y ${months}m` : `${years}y`;
};
---

<section
  id="casebook"
  class="home-casebook stack-lg"
  aria-labelledby="home-casebook-heading"
>
  <div class="section__header">
    <p class="eyebrow">Casebook</p>
    <h2 id="home-casebook-heading" class="section__heading">
      Five public failures, scored
    </h2>
    <p class="section-lead">
      A court, an inquiry, or a regulator established the facts of each. None
      was stopped by the organization running it. Apple Card's issuer is the
      one operator that changed its own process, after a regulator's
      investigation. Each row: the six safeguards as a verdict barcode, and
      the time to halt as the bar at the right edge — longest harm first.
    </p>
  </div>

  <div class="home-casebook__key" aria-hidden="true">
    <ul class="home-casebook__legend">
      {
        stateVariables.map((variable) => (
          <li>
            <StateVariableGlyph variable={variable.id} label={variable.label} />
          </li>
        ))
      }
    </ul>
    <p class="home-casebook__verdict-key">
      <VerdictMark verdict="held" labelled />
      <VerdictMark verdict="drifted" labelled />
      <VerdictMark verdict="failed" labelled />
    </p>
  </div>

  <ol class="home-casebook__list">
    {
      days.map((entry) => (
        <li data-reveal>
          <a class="home-casebook__row" href={`/casebook/${entry.slug}`}>
            <span class="home-casebook__name">
              <span class="home-casebook__title">{entry.title}</span>
              <span class="home-casebook__meta small muted">
                {entry.jurisdiction.split(" · ")[0]} ·{" "}
                {entry.learningOutcome.verdict === "learned"
                  ? "changed its own process"
                  : "change imposed from outside"}
              </span>
            </span>
            <span
              class="home-casebook__marks"
              aria-label={stateVariables
                .map((variable) => {
                  const finding = entry.findings.find(
                    (item) => item.variable === variable.id,
                  );
                  return `${variable.label}: ${finding?.verdict ?? "not scored"}`;
                })
                .join(", ")}
            >
              {stateVariables.map((variable) => {
                const finding = entry.findings.find(
                  (item) => item.variable === variable.id,
                );
                return finding ? (
                  <VerdictMark verdict={finding.verdict} />
                ) : null;
              })}
            </span>
            <span class="home-casebook__halt">
              <span class="home-casebook__track" aria-hidden="true">
                <span
                  class="home-casebook__bar"
                  style={`--halt-share: ${haltShare(entry.timeToHaltDays).toFixed(4)}`}
                />
              </span>
              <span class="home-casebook__days">{haltLabel(entry.timeToHaltDays)}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  <p class="small muted">
    Sorted by time to halt, longest first. {shortest.title}:{" "}
    {haltLabel(shortest.timeToHaltDays)} — at a square-root scale that is a
    sliver, but the label carries the figure.
  </p>
  <p class="small muted">
    <a href="/casebook">Open the full matrix →</a>
  </p>
</section>
