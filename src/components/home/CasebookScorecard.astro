---
/**
 * The casebook, compressed to one row per case: which of the six variables
 * held, and whether the institution changed the process afterward. How long
 * harm ran is drawn once, in the bars below, rather than written in each row
 * as well.
 *
 * The cells are glyphs, so the key comes before the rows: on a wide screen
 * each column is named above it, and below that width a legend names each
 * glyph. Both are visual aids only; every row's label already spells out
 * each variable and its verdict.
 */
import {
  cases,
  learningVerdictLabels,
  stateVariables,
} from "../../content/casebook";
import StateVariableGlyph from "../StateVariableGlyph.astro";
import TimeToHaltBars from "../TimeToHaltBars.astro";
import VerdictMark from "../VerdictMark.astro";
---

<section
  id="casebook"
  class="home-casebook stack-lg"
  aria-labelledby="home-casebook-heading"
>
  <div class="section__header">
    <p class="eyebrow">Casebook</p>
    <h2 id="home-casebook-heading" class="section__heading">
      Five public failures, scored
    </h2>
    <p class="section-lead">
      A court, an inquiry, or a regulator established the facts of each. None
      was stopped by the organization running it. Apple Card's issuer is the one
      operator that changed its own process, after a regulator's investigation.
      In the other four, any change was imposed from outside, by a court, an
      inquiry, a minister, or Parliament. Each row marks six safeguards as held,
      drifted, or failed, then what changed afterward.
    </p>
  </div>

  <div class="home-casebook__key" aria-hidden="true">
    <ul class="home-casebook__legend">
      {
        stateVariables.map((variable) => (
          <li>
            <StateVariableGlyph variable={variable.id} label={variable.label} />
          </li>
        ))
      }
    </ul>
    <p class="home-casebook__verdict-key">
      <VerdictMark verdict="held" labelled />
      <VerdictMark verdict="drifted" labelled />
      <VerdictMark verdict="failed" labelled />
    </p>
  </div>

  <div>
    <div class="home-casebook__columns" aria-hidden="true">
      {
        stateVariables.map((variable) => (
          <span class="home-casebook__column">{variable.label}</span>
        ))
      }
    </div>

    <ol class="home-casebook__list">
      {
        cases.map((entry) => (
          <li data-reveal>
            <a class="home-casebook__row" href={`/casebook/${entry.slug}`}>
              <span class="home-casebook__title">{entry.title}</span>
              <span class="home-casebook__meta small muted">
                {entry.jurisdiction.split(" · ")[0]} · after the failure:{" "}
                {learningVerdictLabels[
                  entry.learningOutcome.verdict
                ].toLowerCase()}
              </span>
              <span
                class="home-casebook__verdicts"
                aria-label={stateVariables
                  .map((variable) => {
                    const finding = entry.findings.find(
                      (item) => item.variable === variable.id,
                    );
                    return `${variable.label}: ${finding?.verdict ?? "not scored"}`;
                  })
                  .join(", ")}
              >
                {stateVariables.map((variable) => {
                  const finding = entry.findings.find(
                    (item) => item.variable === variable.id,
                  );
                  return (
                    <span class="home-casebook__cell" aria-hidden="true">
                      <StateVariableGlyph
                        variable={variable.id}
                        size="0.85rem"
                      />
                      {finding && <VerdictMark verdict={finding.verdict} />}
                    </span>
                  );
                })}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <TimeToHaltBars id="home-time-to-halt" />
  <p class="small muted">
    <a href="/casebook">Open the full matrix →</a>
  </p>
</section>
