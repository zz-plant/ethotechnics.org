---
/**
 * The casebook as barcode rows: one packed row per case, sorted by how long
 * harm ran. The six verdicts read as a barcode, the halt bar sits at the
 * right edge on a square-root scale — so a four-day bar stays visible beside
 * a twenty-year one — and the row's text carries what the record
 * established. The row link is the content; the marks are labelled for
 * assistive technology and drawn as marks for everyone else.
 */
import {
  cases,
  stateVariables,
  type StateVariableId,
} from "../../content/casebook";
import VerdictMark from "../VerdictMark.astro";

const days = [...cases].sort((a, b) => b.timeToHaltDays - a.timeToHaltDays);
const longest = days[0]?.timeToHaltDays ?? 1;
const yearDays = 365.25;

// The scorecard can sit above the self-test that names the six safeguards,
// so it glosses them itself. Plain restatements of the casebook's questions;
// the legend also keys the three-letter column heads.
const safeguardGloss: Record<StateVariableId, string> = {
  capability: "what the system could do",
  authority: "what it was allowed to do, for whom, and until when",
  evidence: "what justified that permission",
  dependency: "how hard it had become to switch off or replace",
  standing:
    "whether a person it decided about could challenge the decision and get an answer",
  correction: "whether anyone could still step in, and how fast",
};
const abbreviation = (label: string) => label.slice(0, 3).toUpperCase();

const haltShare = (value: number) => Math.sqrt(value / longest);
const haltLabel = (value: number) => {
  if (value < yearDays) return `${Math.max(1, Math.round(value))} days`;
  const years = Math.floor(value / yearDays);
  const months = Math.round((value % yearDays) / 30.4);
  return months > 0 ? `${years} yr ${months} mo` : `${years} yr`;
};
---

<section
  id="casebook"
  class="home-casebook stack-lg"
  aria-labelledby="home-casebook-heading"
>
  <div class="section__header">
    <p class="eyebrow">Casebook</p>
    <h2 id="home-casebook-heading" class="section__heading">
      Five public failures, scored
    </h2>
    <p class="section-lead">
      A court, an inquiry, or a regulator established the facts of each. None
      was stopped by the organization running it. Apple Card's issuer is the one
      operator that changed its own process, after a regulator's investigation.
    </p>
    <p>
      Each row marks six safeguards, left to right, as held, drifted (in place
      but no longer doing its job), or failed. The bar at the right edge is the
      time to halt: how long the harm ran before it stopped. Longest harm first.
    </p>
    <ul class="card__list small">
      {
        stateVariables.map((variable) => (
          <li>
            <strong>{variable.label}</strong>
            {` (${abbreviation(variable.label)}): ${safeguardGloss[variable.id]}`}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="home-casebook__columns" aria-hidden="true">
    <span class="home-casebook__col home-casebook__col--spacer"></span>
    <span class="home-casebook__col-group">
      {
        stateVariables.map((variable) => (
          <span class="home-casebook__col" title={variable.label}>
            {abbreviation(variable.label)}
          </span>
        ))
      }
    </span>
    <span class="home-casebook__col home-casebook__col--halt">
      Time to halt
    </span>
  </div>
  <p class="home-casebook__verdict-key" aria-hidden="true">
    <VerdictMark verdict="held" labelled />
    <VerdictMark verdict="drifted" labelled />
    <VerdictMark verdict="failed" labelled />
  </p>

  <ol class="home-casebook__list">
    {
      days.map((entry) => (
        <li data-reveal>
          <a class="home-casebook__row" href={`/casebook/${entry.slug}`}>
            <span class="home-casebook__name">
              <span class="home-casebook__title">{entry.title}</span>
              <span class="home-casebook__meta small muted">
                {entry.jurisdiction.split(" · ")[0]} ·{" "}
                {entry.learningOutcome.verdict === "learned"
                  ? "changed its own process"
                  : "change imposed from outside"}
              </span>
            </span>
            <span
              class="home-casebook__marks"
              aria-label={stateVariables
                .map((variable) => {
                  const finding = entry.findings.find(
                    (item) => item.variable === variable.id,
                  );
                  return `${variable.label}: ${finding?.verdict ?? "not scored"}`;
                })
                .join(", ")}
            >
              {stateVariables.map((variable) => {
                const finding = entry.findings.find(
                  (item) => item.variable === variable.id,
                );
                return finding ? (
                  <VerdictMark verdict={finding.verdict} />
                ) : null;
              })}
            </span>
            <span class="home-casebook__halt">
              <span class="home-casebook__track" aria-hidden="true">
                <span
                  class="home-casebook__bar"
                  style={`--halt-share: ${haltShare(entry.timeToHaltDays).toFixed(4)}`}
                />
              </span>
              <span class="home-casebook__days">
                {haltLabel(entry.timeToHaltDays)}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  <p class="small muted">Time to halt is drawn on a square-root scale.</p>
  <p class="small muted">
    <a href="/casebook">Open the full matrix →</a>
  </p>
</section>
