---
/**
 * Act 1 of the home page: the Robodebt record as a spine rail.
 *
 * One row per dated event the casebook holds: the quote on the left, a dot
 * on the rail, and the institution's response on the right. Rust dots are
 * warnings the institution never answered by changing the scheme; the count
 * chip in the header reads the rail, and the halt row's dot is drawn in the
 * institution's ink because the halt is the one thing the record made
 * happen.
 *
 * Everything is server-rendered from the casebook entry, so the page is
 * true without JavaScript. The rows keep the reveal animation; nothing here
 * counts on scroll anymore — the rail is the count.
 */
import { casesBySlug } from "../../content/casebook";

const robodebt = casesBySlug.get("robodebt");
const timeline = robodebt?.timeline ?? [];
const haltIndex = timeline.findIndex((event) => event.halt);

type Row = {
  when: string;
  said: string;
  speaker: string;
  note?: string;
  state: "unanswered" | "halt" | "after";
  response: string;
};

const rows: Row[] = [];
timeline.forEach((event, index) => {
  if (!event.evidence || !event.voice) return;
  if (event.halt) {
    rows.push({
      when: event.when,
      said: event.voice.said,
      speaker: event.voice.speaker,
      state: "halt",
      response: "halt",
    });
    return;
  }
  const after = haltIndex >= 0 && index > haltIndex;
  rows.push({
    when: event.when,
    said: event.voice.said,
    speaker: event.voice.speaker,
    note: event.voice.after || undefined,
    state: after ? "after" : "unanswered",
    response: after ? "came after the halt" : "no response",
  });
});

const warnings = rows.filter((row) => row.state === "unanswered").length;

// The launch is the run's opening beat: it is not a warning, so it sets the
// scene in a lead rather than taking a rail row.
const launch = timeline.find(
  (event) => !event.evidence && !event.halt && !event.voice,
);
---

{
  robodebt && rows.length > 0 && (
    <section id="record" class="record-spine" aria-labelledby="record-heading">
      <header class="record-spine__header">
        <div class="stack-sm">
          <p class="eyebrow">The record</p>
          <h2 id="record-heading" class="section__heading">
            Watch one scheme run.
          </h2>
        </div>
        <p class="record-spine__chip">{warnings} unanswered · 1 halt</p>
      </header>

      {launch && (
        <p class="record-spine__lead">
          {launch.what} Every dated warning the record issued follows, with the
          response each got.
        </p>
      )}

      <ol class="record-spine__rail">
        {rows.map((row) => (
          <li
            class:list={[
              "record-spine__row",
              `record-spine__row--${row.state}`,
            ]}
            data-reveal
          >
            <div class="record-spine__quote">
              <p class="record-spine__said">
                &ldquo;{row.said}&rdquo;
                {row.note && (
                  <span class="record-spine__note"> — {row.note}</span>
                )}
              </p>
              <p class="record-spine__source">
                {row.when} · {row.speaker}
              </p>
            </div>
            <span class="record-spine__dot" aria-hidden="true" />
            <p class="record-spine__response">{row.response}</p>
          </li>
        ))}
      </ol>

      <p class="record-spine__foot small muted">
        The rail is the count: rust dots are warnings the institution never
        answered by changing the scheme.
        <a href={`/casebook/${robodebt.slug}`}>Read the scored case →</a>
      </p>
    </section>
  )
}
