---
/**
 * Act 1 of the home page: the Robodebt record as a spine rail.
 *
 * One row per dated event the casebook holds: the quote on the left, a dot
 * on the rail, and the institution's response on the right. Rust dots are
 * warnings the institution never answered by changing the scheme; the count
 * chip in the header reads the rail, and the halt row's dot is drawn in the
 * institution's ink because the halt is the one thing the record made
 * happen.
 *
 * Everything is server-rendered from the casebook entry, so the page is
 * true without JavaScript. The rows keep the reveal animation; nothing here
 * counts on scroll anymore — the rail is the count.
 */
import { casesBySlug } from "../../content/casebook";

const robodebt = casesBySlug.get("robodebt");
const timeline = robodebt?.timeline ?? [];
const haltIndex = timeline.findIndex((event) => event.halt);

type Row = {
  when: string;
  said: string;
  /** Only the speaker's own words take quotation marks. */
  verbatim: boolean;
  speaker: string;
  note?: string;
  state: "unanswered" | "halt" | "after";
  response: string;
};

const rows: Row[] = [];
timeline.forEach((event, index) => {
  if (!event.evidence || !event.voice) return;
  if (event.halt) {
    rows.push({
      when: event.when,
      said: event.voice.said,
      verbatim: event.voice.verbatim ?? false,
      speaker: event.voice.speaker,
      state: "halt",
      response: "halt",
    });
    return;
  }
  const after = haltIndex >= 0 && index > haltIndex;
  rows.push({
    when: event.when,
    said: event.voice.said,
    verbatim: event.voice.verbatim ?? false,
    speaker: event.voice.speaker,
    note: event.voice.after || undefined,
    state: after ? "after" : "unanswered",
    response: after ? "came after the halt" : "no response",
  });
});

const warnings = rows.filter((row) => row.state === "unanswered").length;

// The launch is the run's opening beat: it is not a warning, so it sets the
// scene in a lead rather than taking a rail row.
const launch = timeline.find(
  (event) => !event.evidence && !event.halt && !event.voice,
);
const launchFact = launch
  ? launch.what.split(". ")[1]?.charAt(0).toLowerCase() +
    launch.what.split(". ")[1]?.slice(1)
  : undefined;

// An illustrative year for the averaging figure: a person works casual
// shifts for ten fortnights, then claims benefits for sixteen and correctly
// reports no income. Averaging spreads the year's pay across all 26, so the
// rule sees income in every benefit fortnight that the person never earned.
const fortnights = 26;
const worked = 10;
const pay = 1300;
const average = (worked * pay) / fortnights;
const phantom = (fortnights - worked) * average;
const slot = 20;
const barWidth = 14;
const chartHeight = 120;
const baseline = chartHeight + 4;
const yFor = (amount: number) => baseline - (amount / pay) * chartHeight;
const money = (amount: number) => `A$${amount.toLocaleString("en-AU")}`;
---

{
  robodebt && rows.length > 0 && (
    <section id="record" class="record-spine" aria-labelledby="record-heading">
      <header class="record-spine__header">
        <div class="stack-sm">
          <p class="eyebrow">The record</p>
          <h2 id="record-heading" class="section__heading">
            Watch one scheme run.
          </h2>
        </div>
        <p
          class="record-spine__chip"
          data-spine-chip
          data-warnings-total={warnings}
        >
          {warnings} unanswered · 1 halt
        </p>
      </header>

      {launch && (
        <p class="record-spine__lead">
          The rule takes a person's yearly income from tax records, spreads it
          evenly across the year's fortnights, and treats any gap with what they
          reported as a debt they have to disprove. At launch, {launchFact} Each
          dated warning on the record follows, with the response it got.
        </p>
      )}

      {launch && (
        <figure class="averaging" aria-labelledby="averaging-caption">
          <svg
            class="averaging__chart"
            viewBox={`0 0 ${fortnights * slot} ${baseline + 2}`}
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            {Array.from({ length: fortnights }, (_, index) => {
              const x = index * slot + (slot - barWidth) / 2;
              const amount = index < worked ? pay : average;
              return (
                <rect
                  class={
                    index < worked ? "averaging__pay" : "averaging__phantom"
                  }
                  x={x}
                  y={yFor(amount)}
                  width={barWidth}
                  height={baseline - yFor(amount)}
                />
              );
            })}
            <line
              class="averaging__average"
              x1="0"
              x2={fortnights * slot}
              y1={yFor(average)}
              y2={yFor(average)}
            />
            <line
              class="averaging__baseline"
              x1="0"
              x2={fortnights * slot}
              y1={baseline}
              y2={baseline}
            />
          </svg>
          <div
            class="averaging__spans small"
            style={`grid-template-columns: ${worked}fr ${fortnights - worked}fr`}
            aria-hidden="true"
          >
            <span>Worked: {money(pay)} a fortnight</span>
            <span>On benefits, reported no income</span>
          </div>
          <figcaption id="averaging-caption" class="small muted">
            One illustrative year of 26 fortnights. The person earns{" "}
            {money(worked * pay)}, all of it in the first {worked}. The dashed
            line is the average the rule uses: {money(average)} a fortnight. In
            the {fortnights - worked} fortnights on benefits, the rule finds{" "}
            {money(phantom)} of income they never earned, shaded, and bills it
            as a debt.
          </figcaption>
        </figure>
      )}

      <ol class="record-spine__rail">
        {rows.map((row) => (
          <li
            class:list={[
              "record-spine__row",
              `record-spine__row--${row.state}`,
            ]}
            data-spine-row
            data-state={row.state}
            data-reveal
          >
            <div class="record-spine__quote">
              <p class="record-spine__said">
                {row.verbatim ? <q>{row.said}</q> : row.said}
                {row.note && (
                  <span class="record-spine__note"> — {row.note}</span>
                )}
              </p>
              <p class="record-spine__source">
                {row.when} · {row.speaker}
              </p>
            </div>
            <span class="record-spine__dot" aria-hidden="true" />
            <p class="record-spine__response">{row.response}</p>
          </li>
        ))}
      </ol>

      <p class="record-spine__cost">{robodebt.scale}</p>

      <p class="record-spine__foot small muted">
        <a href={`/casebook/${robodebt.slug}`}>Read the scored case →</a>
      </p>
    </section>
  )
}
