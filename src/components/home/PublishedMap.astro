---
/**
 * What this project publishes, as a network of four lines.
 *
 * It reads the header's own menu (navSections), so the map and the menu
 * cannot drift apart. Each section is a line with its pages as stops; labels
 * only, because the menu carries the descriptions.
 */
import { methodContent } from "../../content/method";
import { navSections } from "../../content/navigation";

const definition = methodContent.definition.slice(
  0,
  methodContent.definition.indexOf(".") + 1,
);

const lineColors = [
  "var(--line-cobalt)",
  "var(--line-vermilion)",
  "var(--line-teal)",
  "var(--line-violet)",
];
---

<nav class="network" aria-labelledby="network-heading">
  <header class="network__header">
    <h2 id="network-heading" class="line-heading">The network.</h2>
    <p class="line-lead">
      {definition} Everything below is licensed CC BY-SA 4.0.
      <a class="line-link" href="/start">Start here</a>
    </p>
  </header>
  <div class="network__lines" data-glossary-ignore>
    {
      navSections.map((section, index) => (
        <section class="network__line" style={`--line: ${lineColors[index]}`}>
          <h3 class="network__name">
            {section.href ? (
              <a href={section.href}>{section.heading}</a>
            ) : (
              section.heading
            )}
          </h3>
          <p class="network__description small">{section.description}</p>
          <ul class="network__stops">
            {section.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</nav>
