---
import CardGrid from "../CardGrid.astro";
import CardItem from "../CardItem.astro";
import SectionBlock from "../SectionBlock.astro";
---

<SectionBlock
  id="quickstart"
  eyebrow="Quickstart"
  title="Produce a governance artifact in under an hour."
  description="Choose a track and share the output with the people who need it."
>
  <CardGrid className="grid--two">
    <CardItem
      title="Run a diagnostic"
      description="Export a structured report to attach to a review or audit ticket."
      icon="lucide:scan"
      tags={["Diagnostic", "Evidence-ready"]}
      className="quickstart-card card--quiet"
    >
      <div class="quickstart-card__actions">
        <a class="button primary button--compact" href="/diagnostics">
          Launch diagnostics
        </a>
        <p class="quickstart-card__note muted">
          Start with
          {" "}
          <a href="/diagnostics/evidence-pack-readiness">evidence pack readiness</a>
          .
        </p>
      </div>
    </CardItem>
    <CardItem
      title="Score governance gaps"
      description="Quantify the highest-risk gaps and share a scorecard internally."
      icon="lucide:gauge"
      tags={["Scorecard", "Risk-ranked"]}
      className="quickstart-card card--quiet"
    >
      <div class="quickstart-card__actions">
        <a
          class="button primary button--compact"
          href="/tools/governance-gap-score"
        >
          Run the gap score
        </a>
        <p class="quickstart-card__note muted">
          Review the
          {" "}
          <a href="/tools/governance-gap-score#methodology">methodology</a>
          .
        </p>
      </div>
    </CardItem>
    <CardItem
      title="Attach enforceable clauses"
      description="Hand legal or procurement teams ready-to-use binding language."
      icon="lucide:file-text"
      tags={["Clause pack", "Procurement"]}
      className="quickstart-card card--quiet"
    >
      <div class="quickstart-card__actions">
        <a class="button primary button--compact" href="/bindings">
          Browse bindings
        </a>
        <p class="quickstart-card__note muted">
          Use the
          {" "}
          <a href="/bundles/procurement-clause-pack">procurement clause pack</a>
          .
        </p>
      </div>
    </CardItem>
  </CardGrid>
</SectionBlock>
