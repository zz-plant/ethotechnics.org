---
/**
 * The home page self-test, drawn as six stops on the line.
 *
 * Six questions, answered in place, scored as the reader goes. Each drifting
 * answer points at the public case where that safeguard failed, so a "no"
 * lands on evidence rather than on a definition. The line beside the form
 * fills as the answers arrive; the result announces the score in words.
 */
import { cases } from "../../content/casebook";
import { caseForEachQuestion, selfTestQuestions } from "../../utils/self-test";
import StateVariableGlyph from "../StateVariableGlyph.astro";
import ActionIcon from "../ActionIcon.astro";
import SafeguardMap from "./SafeguardMap.astro";

const caseFor = caseForEachQuestion(cases);

const codes: Record<string, string> = {
  correction: "COR",
  standing: "CHA",
  authority: "AUT",
  evidence: "EVD",
  capability: "DEC",
  dependency: "CON",
};

const choices = [
  { value: "y", label: "Yes" },
  { value: "n", label: "No" },
  { value: "u", label: "Not sure" },
];
---

<section id="self-test" class="self-test" aria-labelledby="self-test-heading">
  <header class="self-test__header">
    <h2 id="self-test-heading" class="line-heading">
      Check your system on the line.
    </h2>
    <p class="line-lead">
      Pick one automated system where you work: one that decides benefits,
      loans, schedules, or fraud alerts. Answer six questions, one for each
      safeguard that should keep it answerable. "Not sure" counts as no. The
      score reflects your answers; it does not check the system.
    </p>
  </header>

  <div class="self-test__board">
    <SafeguardMap />

    <form class="self-test__form" data-self-test>
      <ol class="self-test__questions">
        {
          selfTestQuestions.map((item, index) => {
            const failedCase = caseFor.get(item.variable);
            return (
              <li
                class="self-test__item"
                data-variable={item.variable}
                data-if-no={item.ifNo}
                data-case-title={failedCase?.title}
                data-case-href={
                  failedCase ? `/casebook/${failedCase.slug}` : undefined
                }
              >
                <fieldset class="self-test__fieldset">
                  <legend class="self-test__legend">
                    <span class="self-test__variable">
                      <span class="line-mono">
                        {codes[item.variable] ?? item.variable.slice(0, 3)}
                      </span>
                      <StateVariableGlyph
                        variable={item.variable}
                        size="1rem"
                      />
                      {item.label}
                    </span>
                    <span class="self-test__question">{item.question}</span>
                  </legend>
                  <div class="self-test__choices">
                    {choices.map((choice) => (
                      <label class="self-test__choice">
                        <input
                          type="radio"
                          name={`q${index}`}
                          value={choice.value}
                        />
                        <span>{choice.label}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              </li>
            );
          })
        }
      </ol>
    </form>
  </div>

  <div
    class="self-test__result"
    data-self-test-result
    aria-live="polite"
    hidden
  >
    <p class="self-test__score">
      <span data-self-test-holding>0</span> of {selfTestQuestions.length} pass
    </p>
    <p class="self-test__verdict" data-self-test-verdict></p>
    <ul class="self-test__drift" data-self-test-drift></ul>
    <div class="actions">
      <a class="button primary" href="/diagnostics/delegation-audit">
        Run the delegation audit
      </a>
      <button type="button" class="button ghost" data-self-test-share>
        <ActionIcon action="copy" />
        <span data-button-label>Copy link to this result</span>
      </button>
    </div>
  </div>

  <noscript>
    <p class="small muted">
      The self-test scores in your browser. Without JavaScript, <a
        class="line-link"
        href="/diagnostics/delegation-audit">run the delegation audit</a
      > instead.
    </p>
  </noscript>
</section>

<script>
  import "../../client/self-test.ts";
</script>
