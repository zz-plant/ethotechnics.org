---
/**
 * The reader's system, drawn as the self-test's line.
 *
 * Six stations on one rail, in chain order. Each answer lights its station:
 * held fills it, drift and "not sure" flood it vermilion. The rail completes
 * when all six hold. The states are a picture of answers already in the form,
 * whose result is announced on its own, so the figure is hidden from assistive
 * technology and the form carries the information.
 */
import { selfTestQuestions } from "../../utils/self-test";

interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;

const order = [
  { variable: "evidence", code: "EVD", color: "var(--line-teal)" },
  { variable: "authority", code: "AUT", color: "var(--line-cobalt)" },
  { variable: "capability", code: "DEC", color: "var(--line-violet)" },
  { variable: "dependency", code: "CON", color: "var(--line-vermilion)" },
  { variable: "standing", code: "CHA", color: "var(--line-amber)" },
  { variable: "correction", code: "COR", color: "var(--line-ink)" },
] as const;

const labelFor = (variable: string) =>
  selfTestQuestions.find((question) => question.variable === variable)?.label ??
  variable;

const y = 58;
const startX = 60;
const step = 120;

const stations = order.map((station, index) => ({
  ...station,
  label: labelFor(station.variable),
  x: startX + index * step,
}));
---

<figure
  class:list={["safeguard-map", className]}
  aria-labelledby="safeguard-map-title"
  data-safeguard-map
  data-glossary-ignore
>
  <figcaption class="safeguard-map__caption">
    <p id="safeguard-map-title" class="safeguard-map__title">Your line</p>
    <p class="small muted">
      Each answer lights a station: filled for yes, red for no or not sure.
    </p>
  </figcaption>
  <svg class="safeguard-map__svg" viewBox="0 0 720 130" aria-hidden="true">
    <path
      class="safeguard-map__rail"
      data-map-ring
      pathLength="600"
      d={`M ${startX} ${y} H ${startX + step * (stations.length - 1)}`}></path>
    {
      stations.map((station) => (
        <g
          data-map-variable={station.variable}
          data-answer=""
          style={`--station: ${station.color}`}
        >
          <circle
            class="safeguard-map__node-pulse"
            cx={station.x}
            cy={y}
            r="15"
          />
          <circle class="safeguard-map__node" cx={station.x} cy={y} r="9" />
          <line
            class="safeguard-map__spoke"
            data-map-spoke={station.variable}
            x1={station.x}
            y1={y + 12}
            x2={station.x}
            y2={y + 28}
          />
          <text
            class="safeguard-map__svg-label"
            data-map-label={station.variable}
            x={station.x}
            y={y + 48}
            text-anchor="middle"
          >
            {station.code}
          </text>
          <title>{station.label}</title>
        </g>
      ))
    }
  </svg>
  <p class="safeguard-map__score">
    <span data-map-score>–/6</span> pass
  </p>
</figure>
