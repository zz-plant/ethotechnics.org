---
/**
 * The reader's system, drawn as the six safeguards on one ring.
 *
 * Each node is one state variable; the self-test beside it fills the node in
 * as its question is answered — held is drawn in the accent, drift in the
 * record's unanswered rust, unanswered stays hollow. The center reads the
 * count of holding answers. The states are a picture of answers already in
 * the form, whose result is announced on its own, so the figure is hidden
 * from assistive technology and the form carries the information.
 */
import type { StateVariableId } from "../../content/casebook";
import { selfTestQuestions } from "../../utils/self-test";

interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;

// Ring order: the questions' own order, correction at the top and the rest
// clockwise — so the ring fills in exactly the order the form is answered.
const order: StateVariableId[] = [
  "correction",
  "standing",
  "authority",
  "evidence",
  "dependency",
  "capability",
];

const labelFor = (variable: StateVariableId) =>
  selfTestQuestions.find((question) => question.variable === variable)?.label ??
  variable;

const cx = 180;
const cy = 155;
const radius = 96;

// Vertices: correction at the top, the rest every 60 degrees clockwise.
const nodes = order.map((variable, index) => {
  const angle = -Math.PI / 2 + (index * Math.PI) / 3;
  const x = Math.round((cx + radius * Math.cos(angle)) * 10) / 10;
  const y = Math.round((cy + radius * Math.sin(angle)) * 10) / 10;
  const lx = Math.round((cx + (radius + 28) * Math.cos(angle)) * 10) / 10;
  const ly = Math.round((cy + (radius + 28) * Math.sin(angle)) * 10) / 10;
  return { variable, label: labelFor(variable), x, y, lx, ly };
});

const ring = nodes.map((node) => `${node.x},${node.y}`).join(" ");
---

<figure
  class:list={["safeguard-map", className]}
  aria-labelledby="safeguard-map-title"
  data-safeguard-map
  data-glossary-ignore
>
  <figcaption class="safeguard-map__caption">
    <p id="safeguard-map-title" class="safeguard-map__title">
      Your system, as six safeguards
    </p>
    <p class="small muted">
      Each answer fills in its node. A rust node is drift; the center reads what
      is holding.
    </p>
  </figcaption>
  <svg class="safeguard-map__svg" viewBox="0 0 360 310" aria-hidden="true">
    <polygon class="safeguard-map__ring" points={ring}></polygon>
    {
      nodes.map((node) => (
        <line
          class="safeguard-map__spoke"
          x1={cx}
          y1={cy}
          x2={node.x}
          y2={node.y}
        />
      ))
    }
    {
      nodes.map((node) => (
        <g
          class="safeguard-map__node"
          data-map-variable={node.variable}
          transform={`translate(${node.x} ${node.y})`}
        >
          <circle class="safeguard-map__node-shape" r="13" />
        </g>
      ))
    }
    {
      nodes.map((node) => (
        <text
          class="safeguard-map__label"
          x={node.lx}
          y={node.ly}
          text-anchor={
            node.lx < cx - 20 ? "end" : node.lx > cx + 20 ? "start" : "middle"
          }
        >
          {node.label.toUpperCase()}
        </text>
      ))
    }
    <text class="safeguard-map__score" x={cx} y={cy + 5} text-anchor="middle">
      <tspan data-map-score>–/6</tspan>
    </text>
    <text
      class="safeguard-map__score-sub"
      x={cx}
      y={cy + 22}
      text-anchor="middle"
    >
      holding
    </text>
  </svg>
</figure>
