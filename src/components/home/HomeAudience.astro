---
import CardGrid from "../CardGrid.astro";
import CardItem from "../CardItem.astro";
import SectionBlock from "../SectionBlock.astro";
---

<SectionBlock
  id="audience"
  eyebrow="Audience selector"
  title="Route to the right artifacts in one click."
  description="Each path reorders the stack to match the work you do."
  variant="alt"
>
  <CardGrid className="grid--two audience-grid">
    <CardItem
      title="I am building an automated system or agent"
      description="Fast path, mechanisms, and concrete implementation examples."
      className="audience-card card--quiet"
    >
      <div class="audience-card__actions">
        <a
          class="button primary button--compact"
          href="/start-here?persona=builder"
        >
          Start: Build & ship
        </a>
        <p class="audience-card__note muted">
          Start with
          {" "}
          <a href="/fast-path">fast path</a>
          .
        </p>
      </div>
    </CardItem>
    <CardItem
      title="I am auditing or governing a system"
      description="Evidence, bindings, and minimum enforceable requirements."
      className="audience-card card--quiet"
    >
      <div class="audience-card__actions">
        <a
          class="button primary button--compact"
          href="/start-here?persona=auditor"
        >
          Start: Audit & govern
        </a>
        <p class="audience-card__note muted">
          Review
          {" "}
          <a href="/evidence-packs">evidence packs</a>
          .
        </p>
      </div>
    </CardItem>
    <CardItem
      title="I am writing policy or procurement language"
      description="Standards, where they bind, and enforceable clauses."
      className="audience-card card--quiet"
    >
      <div class="audience-card__actions">
        <a
          class="button primary button--compact"
          href="/start-here?persona=policy"
        >
          Start: Draft policy
        </a>
        <p class="audience-card__note muted">
          Pull
          {" "}
          <a href="/standards">standards + clauses</a>
          .
        </p>
      </div>
    </CardItem>
  </CardGrid>
  <p class="audience__aside muted">
    Looking for research or teaching materials? Explore
    {" "}
    <a href="/research">research</a>
    {" "}
    and
    {" "}
    <a href="/field-notes">field notes</a>
    .
  </p>
</SectionBlock>
