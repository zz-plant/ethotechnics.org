---
/**
 * The mechanism, drawn compactly: the scheme and the person it decides
 * about, the debts out, the appeal back, the ruling returning to one
 * person — and the rust line that never arrives, because the rule is
 * drawn where the ruling cannot reach it.
 *
 * The loop left the hero when the ledger took its place; here it does
 * argumentative work instead of decorative work. The facts in the drawing
 * come from the casebook entry, so the figure and the record spine cannot
 * disagree.
 */
import { casesBySlug } from "../../content/casebook";

interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;

const robodebt = casesBySlug.get("robodebt");
const tribunal = robodebt?.timeline?.find(
  (event) => event.voice?.speaker === "The Administrative Appeals Tribunal",
);
const ruling = tribunal?.voice?.said;
const rulingWhen = tribunal?.when;

const description =
  ruling &&
  rulingWhen &&
  `The delegation drawn as four lines. The scheme sends debts to the person. The person appeals. The tribunal rules "${ruling}" (${rulingWhen}), and the ruling goes back to that one person: one debt fixed. The fourth line, the one from the ruling to the rule that produced the debts, is drawn in the record's unanswered colour and stops at a cross: the ruling never reaches the rule.`;
---

{
  description && (
    <figure class:list={["mech-loop", className]} data-glossary-ignore>
      <svg
        class="mech-loop__svg"
        viewBox="0 0 440 260"
        role="img"
        aria-label={description}
      >
        <rect
          class="mech-loop__box mech-loop__box--scheme"
          x="20"
          y="36"
          width="116"
          height="48"
          rx="6"
        />
        <text class="mech-loop__title" x="78" y="64" text-anchor="middle">
          The scheme
        </text>
        <rect
          class="mech-loop__box mech-loop__box--person"
          x="304"
          y="36"
          width="116"
          height="48"
          rx="6"
        />
        <text class="mech-loop__title" x="362" y="64" text-anchor="middle">
          The person
        </text>

        <line
          class="mech-loop__flow mech-loop__flow--debts"
          x1="136"
          y1="60"
          x2="298"
          y2="60"
        />
        <text class="mech-loop__caps" x="217" y="50" text-anchor="middle">
          debts
        </text>

        <line
          class="mech-loop__flow mech-loop__flow--appeal"
          x1="304"
          y1="116"
          x2="142"
          y2="116"
        />
        <text class="mech-loop__caps" x="217" y="106" text-anchor="middle">
          appeal
        </text>

        <line
          class="mech-loop__flow mech-loop__flow--ruling"
          x1="136"
          y1="172"
          x2="298"
          y2="172"
        />
        <text class="mech-loop__caps" x="217" y="162" text-anchor="middle">
          ruling — back to one person
        </text>

        <rect
          class="mech-loop__box mech-loop__box--rule"
          x="20"
          y="200"
          width="116"
          height="44"
          rx="6"
        />
        <text class="mech-loop__title" x="78" y="226" text-anchor="middle">
          The rule
        </text>

        <line
          class="mech-loop__flow mech-loop__flow--cut"
          x1="304"
          y1="228"
          x2="164"
          y2="228"
        />
        <text class="mech-loop__cut" x="152" y="233" text-anchor="middle">
          ✕
        </text>
        <text
          class="mech-loop__caps mech-loop__caps--cut"
          x="228"
          y="248"
          text-anchor="middle"
        >
          the ruling never reaches the rule
        </text>
      </svg>
      <figcaption class="mech-loop__caption small muted">
        The first three lines ran at Robodebt. The fourth is the line the
        standards require.
      </figcaption>
    </figure>
  )
}
