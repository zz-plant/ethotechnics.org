---
/**
 * HeroIllustration.astro
 *
 * An editorial, responsive SVG architectural illustration representing
 * the core thesis of Ethotechnics:
 * The Governed Delegation Arc / Bounded Machine Agency Loop.
 *
 * Shows:
 * 1. Human Authority & Invariant Boundary (top / anchor)
 * 2. Active Machine Agency / Execution Stream (center)
 * 3. Continuous Evidence Verification & Circuit Breakers (instant halt trip)
 * 4. Standing for Recourse / Reversible Return Loop (feedback)
 *
 * Matches the site's monoline design language (warm inks, currentColor, rounded caps).
 */
interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;
---

<figure class:list={["hero-illustration", className]} aria-labelledby="hero-illustration-caption">
  <div class="hero-illustration__card">
    <svg
      viewBox="0 0 460 300"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="hero-illustration__svg"
      role="img"
      aria-label="Schematic diagram: Governed Agency Arc showing Human Authority, Delegated Machine Action, Circuit-Breaker Halt Gate, and Standing Recourse loop."
    >
      <defs>
        <!-- Gradients for subtle depth while staying true to paper aesthetic -->
        <linearGradient id="hero-grid-fade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="currentColor" stop-opacity="0.04" />
          <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
        </linearGradient>

        <linearGradient id="hero-pulse" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.1" />
          <stop offset="50%" stop-color="var(--mark)" stop-opacity="0.25" />
          <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.1" />
        </linearGradient>

        <marker
          id="hero-arrow-accent"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--accent)" />
        </marker>

        <marker
          id="hero-arrow-mark"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--mark)" />
        </marker>
      </defs>

      <!-- Background schematic grid / baseline reference -->
      <g class="hero-illustration__grid" opacity="0.6">
        <line x1="40" y1="50" x2="420" y2="50" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" />
        <line x1="40" y1="130" x2="420" y2="130" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" />
        <line x1="40" y1="210" x2="420" y2="210" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" />
        
        <line x1="110" y1="30" x2="110" y2="250" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" />
        <line x1="230" y1="30" x2="230" y2="250" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" />
        <line x1="350" y1="30" x2="350" y2="250" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" />
      </g>

      <!-- 1. AUTHORITY BOUNDARY ENVELOPE (Top Envelope) -->
      <g class="hero-illustration__boundary">
        <path
          d="M 50 82 C 120 45, 340 45, 410 82"
          stroke="var(--accent)"
          stroke-width="1.5"
          stroke-dasharray="4 4"
          fill="none"
        />
        <rect x="175" y="36" width="110" height="22" rx="11" fill="var(--surface)" stroke="var(--border)" stroke-width="1" />
        <text x="230" y="51" text-anchor="middle" font-family="var(--sans)" font-size="9.5" font-weight="650" letter-spacing="0.08em" fill="var(--accent)">
          AUTHORITY LEASE
        </text>
      </g>

      <!-- 2. MAIN CONTEXTUAL STAGES / NODES -->
      
      <!-- Stage 1: Origin / Human Intent & Evidence -->
      <g class="hero-node" transform="translate(60, 100)">
        <circle cx="24" cy="30" r="24" fill="var(--surface)" stroke="currentColor" stroke-width="1.6" />
        <!-- Micro icon: Evidence / Document -->
        <rect x="17" y="21" width="14" height="18" rx="2" stroke="currentColor" stroke-width="1.4" fill="none" />
        <line x1="20" y1="26" x2="28" y2="26" stroke="currentColor" stroke-width="1.3" />
        <line x1="20" y1="30" x2="28" y2="30" stroke="currentColor" stroke-width="1.3" />
        <line x1="20" y1="34" x2="25" y2="34" stroke="currentColor" stroke-width="1.3" />
        
        <text x="24" y="66" text-anchor="middle" font-family="var(--sans)" font-size="10.5" font-weight="600" fill="var(--text)">
          Evidence
        </text>
        <text x="24" y="78" text-anchor="middle" font-family="var(--mono)" font-size="8" fill="var(--muted)">
          Ground Truth
        </text>
      </g>

      <!-- Connecting Forward Vector 1 -->
      <path
        d="M 112 130 L 174 130"
        stroke="var(--accent)"
        stroke-width="2"
        marker-end="url(#hero-arrow-accent)"
      />

      <!-- Stage 2: Delegated Machine Execution Core -->
      <g class="hero-node" transform="translate(182, 94)">
        <rect x="0" y="0" width="96" height="72" rx="10" fill="var(--surface)" stroke="var(--accent)" stroke-width="1.8" />
        
        <!-- Status indicator dot -->
        <circle cx="16" cy="18" r="4" fill="var(--status-success)" />
        <text x="26" y="21" font-family="var(--mono)" font-size="8" font-weight="600" fill="var(--muted)">
          AGENCY
        </text>

        <!-- Execution waveform -->
        <path
          d="M 16 46 L 30 46 L 38 32 L 48 54 L 58 38 L 66 46 L 80 46"
          stroke="var(--accent)"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
        />

        <text x="48" y="86" text-anchor="middle" font-family="var(--sans)" font-size="10.5" font-weight="600" fill="var(--text)">
          Delegated Action
        </text>
        <text x="48" y="98" text-anchor="middle" font-family="var(--mono)" font-size="8" fill="var(--muted)">
          Observable Impact
        </text>
      </g>

      <!-- Connecting Forward Vector 2 with Circuit-Breaker Intercept Gate -->
      <g class="hero-gate" transform="translate(286, 108)">
        <line x1="0" y1="22" x2="38" y2="22" stroke="var(--accent)" stroke-width="2" />
        
        <!-- Interactive Halt Gate / Trip Switch -->
        <rect x="10" y="4" width="22" height="36" rx="4" fill="var(--surface)" stroke="var(--mark)" stroke-width="1.8" />
        <path d="M 16 14 L 26 30 M 26 14 L 16 30" stroke="var(--mark)" stroke-width="1.8" stroke-linecap="round" />
        
        <text x="21" y="-4" text-anchor="middle" font-family="var(--sans)" font-size="8.5" font-weight="700" letter-spacing="0.05em" fill="var(--mark)">
          HALT TRIP
        </text>
        
        <line x1="38" y1="22" x2="56" y2="22" stroke="var(--accent)" stroke-width="2" marker-end="url(#hero-arrow-accent)" />
      </g>

      <!-- Stage 3: Affected Parties / Recourse Standing -->
      <g class="hero-node" transform="translate(352, 100)">
        <circle cx="24" cy="30" r="24" fill="var(--surface)" stroke="currentColor" stroke-width="1.6" />
        <!-- Micro icon: Person & Standing portal -->
        <circle cx="24" cy="24" r="5" stroke="currentColor" stroke-width="1.4" fill="none" />
        <path d="M 14 38 C 14 32, 34 32, 34 38" stroke="currentColor" stroke-width="1.4" fill="none" />

        <text x="24" y="66" text-anchor="middle" font-family="var(--sans)" font-size="10.5" font-weight="600" fill="var(--text)">
          Standing
        </text>
        <text x="24" y="78" text-anchor="middle" font-family="var(--mono)" font-size="8" fill="var(--muted)">
          Right of Contest
        </text>
      </g>

      <!-- 3. BINDING RETURN PATH (REVERSAL & CORRECTION LOOP) -->
      <g class="hero-illustration__loop">
        <path
          d="M 376 160 C 376 245, 84 245, 84 160"
          stroke="var(--mark)"
          stroke-width="1.8"
          stroke-dasharray="6 4"
          fill="none"
          marker-end="url(#hero-arrow-mark)"
        />
        
        <!-- Loop Badge / Invariant Label -->
        <rect x="155" y="222" width="150" height="24" rx="12" fill="var(--surface)" stroke="var(--mark)" stroke-width="1.2" />
        <circle cx="170" cy="234" r="3.5" fill="var(--mark)" />
        <text x="236" y="238" text-anchor="middle" font-family="var(--sans)" font-size="9" font-weight="700" letter-spacing="0.05em" fill="var(--mark)">
          MANDATORY REVERSAL PATH
        </text>
      </g>

      <!-- Live metrics telemetry tag in corner -->
      <g class="hero-illustration__telemetry" transform="translate(340, 276)">
        <text x="75" y="10" text-anchor="end" font-family="var(--mono)" font-size="8.5" fill="var(--muted)">
          Coupling invariant · The method
        </text>
      </g>
    </svg>
  </div>
  <figcaption id="hero-illustration-caption" class="sr-only">
    Diagram: delegated machine action runs under an authority lease, can be tripped by a halt gate, and connects back to the affected person through a right to contest and a mandatory reversal path.
  </figcaption>
</figure>

<style>
  .hero-illustration {
    margin: 0;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-illustration__card {
    width: 100%;
    max-width: 480px;
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: var(--radius-lg);
    padding: clamp(0.75rem, 2vw, 1.25rem);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .hero-illustration__card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 0%,
      color-mix(in srgb, var(--accent) 5%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-illustration__svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--text);
  }

  /* Micro subtle hover feedback */
  .hero-illustration__card:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
    box-shadow: var(--shadow);
    transition: border-color var(--motion-base) ease, box-shadow var(--motion-base) ease;
  }

  @media (max-width: 899px) {
    .hero-illustration__card {
      max-width: 360px;
      padding: 0.65rem;
      margin-inline: auto;
    }
  }
</style>
