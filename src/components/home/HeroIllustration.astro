---
/**
 * HeroIllustration.astro
 *
 * An editorial, responsive SVG architectural illustration representing
 * the core thesis of Ethotechnics:
 * The Governed Delegation Arc / Bounded Machine Agency Loop.
 *
 * Shows:
 * 1. Human Authority & Invariant Boundary (top / anchor)
 * 2. Active Machine Agency / Execution Stream (center)
 * 3. Continuous Evidence Verification & Circuit Breakers (instant halt trip)
 * 4. Standing for Recourse / Reversible Return Loop (feedback)
 *
 * Matches the site's monoline design language (warm inks, currentColor, rounded caps).
 */
interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;
---

<figure class:list={["hero-illustration", className]} aria-labelledby="hero-illustration-caption">
  <div class="hero-illustration__card">
    <svg
      viewBox="0 0 320 276"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="hero-illustration__svg"
      role="img"
      aria-label="Schematic diagram: Governed Agency Arc showing Human Authority, Delegated Machine Action, Circuit-Breaker Halt Gate, and Standing Recourse loop."
    >
      <defs>
        <marker
          id="hero-arrow-accent"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--accent)" />
        </marker>

        <marker
          id="hero-arrow-mark"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--mark)" />
        </marker>
      </defs>

      <!-- Background schematic grid / baseline reference -->
      <g opacity="0.6">
        <line x1="16" y1="196" x2="304" y2="196" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" />
        <line x1="80" y1="60" x2="80" y2="200" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" />
        <line x1="240" y1="60" x2="240" y2="200" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" />
      </g>

      <!-- 1. AUTHORITY BOUNDARY ENVELOPE (Top Envelope) -->
      <g>
        <path
          d="M 22 100 C 70 30, 250 30, 298 100"
          stroke="var(--accent)"
          stroke-width="1.5"
          stroke-dasharray="4 4"
          fill="none"
        />
        <rect x="56" y="18" width="208" height="32" rx="16" fill="var(--surface)" stroke="var(--border)" stroke-width="1" />
        <text x="160" y="40" text-anchor="middle" font-family="var(--sans)" font-size="16" font-weight="650" letter-spacing="0.06em" fill="var(--accent)">
          AUTHORITY LEASE
        </text>
      </g>

      <!-- 2. MAIN CONTEXTUAL STAGES / NODES -->

      <!-- Stage 1: Evidence -->
      <g transform="translate(12, 104)">
        <circle cx="24" cy="24" r="24" fill="var(--surface)" stroke="currentColor" stroke-width="1.6" />
        <!-- Micro icon: Evidence / Document -->
        <rect x="17" y="15" width="14" height="18" rx="2" stroke="currentColor" stroke-width="1.4" fill="none" />
        <line x1="20" y1="20" x2="28" y2="20" stroke="currentColor" stroke-width="1.3" />
        <line x1="20" y1="24" x2="28" y2="24" stroke="currentColor" stroke-width="1.3" />
        <line x1="20" y1="28" x2="25" y2="28" stroke="currentColor" stroke-width="1.3" />

        <text x="24" y="72" text-anchor="middle" font-family="var(--sans)" font-size="16" font-weight="600" fill="var(--text)">
          Evidence
        </text>
      </g>

      <!-- Connecting Forward Vector 1 -->
      <path
        d="M 62 128 L 104 128"
        stroke="var(--accent)"
        stroke-width="2"
        marker-end="url(#hero-arrow-accent)"
      />

      <!-- Stage 2: Delegated Machine Execution Core -->
      <g transform="translate(110, 98)">
        <rect x="0" y="0" width="86" height="60" rx="10" fill="var(--surface)" stroke="var(--accent)" stroke-width="1.8" />

        <!-- Status indicator dot -->
        <circle cx="14" cy="14" r="4" fill="var(--status-success)" />

        <!-- Execution waveform -->
        <path
          d="M 12 36 L 24 36 L 32 22 L 42 44 L 52 28 L 60 36 L 74 36"
          stroke="var(--accent)"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
        />

        <text x="43" y="78" text-anchor="middle" font-family="var(--sans)" font-size="16" font-weight="600" fill="var(--text)">
          Delegated Action
        </text>
      </g>

      <!-- Connecting Forward Vector 2 with Circuit-Breaker Intercept Gate -->
      <g transform="translate(198, 106)">
        <line x1="0" y1="22" x2="14" y2="22" stroke="var(--accent)" stroke-width="2" />

        <!-- Halt Gate / Trip Switch -->
        <rect x="14" y="4" width="22" height="36" rx="4" fill="var(--surface)" stroke="var(--mark)" stroke-width="1.8" />
        <path d="M 20 14 L 30 30 M 30 14 L 20 30" stroke="var(--mark)" stroke-width="1.8" stroke-linecap="round" />

        <text x="25" y="-12" text-anchor="middle" font-family="var(--sans)" font-size="16" font-weight="700" letter-spacing="0.04em" fill="var(--mark)">
          HALT TRIP
        </text>

        <line x1="36" y1="22" x2="54" y2="22" stroke="var(--accent)" stroke-width="2" marker-end="url(#hero-arrow-accent)" />
      </g>

      <!-- Stage 3: Affected Parties / Recourse Standing -->
      <g transform="translate(256, 104)">
        <circle cx="24" cy="24" r="24" fill="var(--surface)" stroke="currentColor" stroke-width="1.6" />
        <!-- Micro icon: Person & Standing portal -->
        <circle cx="24" cy="18" r="5" stroke="currentColor" stroke-width="1.4" fill="none" />
        <path d="M 14 32 C 14 26, 34 26, 34 32" stroke="currentColor" stroke-width="1.4" fill="none" />

        <text x="24" y="72" text-anchor="middle" font-family="var(--sans)" font-size="16" font-weight="600" fill="var(--text)">
          Standing
        </text>
      </g>

      <!-- 3. BINDING RETURN PATH (REVERSAL & CORRECTION LOOP) -->
      <g>
        <path
          d="M 280 184 C 280 262, 36 262, 36 186"
          stroke="var(--mark)"
          stroke-width="1.8"
          stroke-dasharray="6 4"
          fill="none"
          marker-end="url(#hero-arrow-mark)"
        />

        <!-- Loop Badge / Invariant Label -->
        <rect x="10" y="226" width="300" height="32" rx="16" fill="var(--surface)" stroke="var(--mark)" stroke-width="1.2" />
        <circle cx="26" cy="242" r="3.5" fill="var(--mark)" />
        <text x="166" y="248" text-anchor="middle" font-family="var(--sans)" font-size="16" font-weight="700" letter-spacing="0.02em" fill="var(--mark)">
          MANDATORY REVERSAL PATH
        </text>
      </g>
    </svg>
  </div>
  <figcaption id="hero-illustration-caption" class="sr-only">
    Diagram: delegated machine action runs under an authority lease, can be tripped by a halt gate, and connects back to the affected person through a right to contest and a mandatory reversal path.
  </figcaption>
</figure>

<style>
  /* No display here: the page decides whether the figure shows at all
     (home.css hides it under 1000px), and a scoped display rule would
     outrank that and put a 256px drawing on phones. */
  .hero-illustration {
    margin: 0;
    width: 100%;
  }

  .hero-illustration__card {
    width: 100%;
    max-width: 480px;
    margin-inline: auto;
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: var(--radius-lg);
    padding: clamp(0.75rem, 2vw, 1.25rem);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .hero-illustration__card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 0%,
      color-mix(in srgb, var(--accent) 5%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-illustration__svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--text);
  }

  /* Micro subtle hover feedback */
  .hero-illustration__card:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
    box-shadow: var(--shadow);
    transition: border-color var(--motion-base) ease, box-shadow var(--motion-base) ease;
  }

  @media (max-width: 899px) {
    .hero-illustration__card {
      max-width: 360px;
      padding: 0.65rem;
      margin-inline: auto;
    }
  }
</style>
