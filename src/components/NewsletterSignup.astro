<div class="newsletter-signup">
  <form class="newsletter-signup__form" data-newsletter-form novalidate>
    <h3 class="eyebrow">Updates by email</h3>
    <p class="muted">
      Get notified when new standards, terms, or field notes are published.
    </p>
    <div class="newsletter-signup__row">
      <input
        type="email"
        name="email"
        aria-label="Email address"
        placeholder="your@email.com"
        required
        autocomplete="email"
        spellcheck="false"
        autocapitalize="off"
      />
      <button type="submit" class="button primary button--compact">
        Subscribe
      </button>
    </div>
    <p class="newsletter-signup__status" role="status" aria-live="polite"></p>
  </form>
</div>

<script>
  document
    .querySelectorAll<HTMLFormElement>("[data-newsletter-form]")
    .forEach((form) => {
      if (form.dataset.initialized) return;
      form.dataset.initialized = "true";
      const status = form.querySelector(
        "[role='status']",
      ) as HTMLParagraphElement;
      const button = form.querySelector("button") as HTMLButtonElement;
      const input = form.querySelector("input") as HTMLInputElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = input.value.trim();

        if (!email) {
          status.textContent = "Please enter an email address.";
          return;
        }

        button.disabled = true;
        const submittingLabel = "Subscribing…";
        const restoreLabel = button.textContent;
        button.textContent = submittingLabel;
        status.textContent = "";
        status.className = "newsletter-signup__status";

        try {
          const res = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          });

          const data = (await res.json()) as {
            success?: boolean;
            error?: string;
          };

          if (res.ok && data.success) {
            status.textContent = "Subscribed. Thank you.";
            status.classList.add("newsletter-signup__status--success");
            input.value = "";
          } else {
            status.textContent =
              data.error || "Something went wrong. Try again.";
            status.classList.add("newsletter-signup__status--error");
          }
        } catch {
          status.textContent = "Network error. Please try again.";
          status.classList.add("newsletter-signup__status--error");
        } finally {
          button.disabled = false;
          if (button.textContent === submittingLabel) {
            button.textContent = restoreLabel ?? "Subscribe";
          }
        }
      });
    });
</script>

<style>
  .newsletter-signup__form {
    display: grid;
    gap: var(--space-2);
  }

  .newsletter-signup__row {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-1);
    flex-wrap: wrap;
  }

  .newsletter-signup__row input {
    flex: 1 1 180px;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    border: 1px solid var(--interactive-border);
    background: var(--interactive-bg);
    color: var(--text);
    font-size: var(--text-sm);
    font-family: var(--sans);
  }

  .newsletter-signup__row input::placeholder {
    color: var(--muted);
  }

  .newsletter-signup__row input:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
    box-shadow: var(--focus-ring);
  }

  .newsletter-signup__status {
    font-size: var(--text-sm);
    min-height: 1.3em;
    margin: 0;
  }

  .newsletter-signup__status--success {
    color: var(--teal);
  }

  .newsletter-signup__status--error {
    color: var(--accent);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
