<div class="newsletter-signup">
  <form class="newsletter-signup__form" data-newsletter-form novalidate>
    <h3 class="eyebrow">Updates by email</h3>
    <p class="muted">
      Get notified when new standards, terms, or field notes are published.
    </p>
    <div class="newsletter-signup__row">
      <input
        type="email"
        name="email"
        aria-label="Email address"
        placeholder="name@example.com"
        required
        autocomplete="email"
        spellcheck="false"
        autocapitalize="off"
      />
      <button type="submit" class="button primary button--compact">
        Subscribe
      </button>
    </div>
    <p class="newsletter-signup__status" role="status" aria-live="polite"></p>
  </form>
</div>

<script>
  document
    .querySelectorAll<HTMLFormElement>("[data-newsletter-form]")
    .forEach((form) => {
      if (form.dataset.initialized) return;
      form.dataset.initialized = "true";
      const status = form.querySelector(
        "[role='status']",
      ) as HTMLParagraphElement;
      const button = form.querySelector("button") as HTMLButtonElement;
      const input = form.querySelector("input") as HTMLInputElement;

      // `addressRejected` marks the field itself as invalid. A failed request
      // with a good address is an error too, but not the reader's to correct.
      const showStatus = (
        message: string,
        kind?: "success" | "error",
        addressRejected = false,
      ) => {
        status.textContent = message;
        status.className = "newsletter-signup__status";
        if (kind) status.classList.add(`newsletter-signup__status--${kind}`);
        if (addressRejected) input.setAttribute("aria-invalid", "true");
        else input.removeAttribute("aria-invalid");
      };

      // The API's error strings are written for whoever reads the response.
      // The reader of this form gets the status in words they can act on.
      const failureMessage = (statusCode: number) => {
        if (statusCode === 400) {
          return "Enter a full email address, like name@example.com.";
        }
        if (statusCode === 429) {
          return "Too many attempts. Wait a minute, then try again.";
        }
        if (statusCode >= 500) {
          return "Signup is not working right now. Try again later.";
        }
        return "The signup did not go through. Try again.";
      };

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = input.value.trim();

        if (!email) {
          showStatus("Enter an email address.", "error", true);
          input.focus();
          return;
        }

        button.disabled = true;
        const submittingLabel = "Subscribing…";
        const restoreLabel = button.textContent;
        button.textContent = submittingLabel;
        showStatus("");

        try {
          const res = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          });

          const data = (await res.json().catch(() => ({}))) as {
            success?: boolean;
          };

          if (res.ok && data.success) {
            showStatus("Subscribed. Thank you.", "success");
            input.value = "";
          } else {
            showStatus(failureMessage(res.status), "error", res.status === 400);
          }
        } catch {
          showStatus(
            "Could not reach ethotechnics.org. Check your connection, then try again.",
            "error",
          );
        } finally {
          button.disabled = false;
          if (button.textContent === submittingLabel) {
            button.textContent = restoreLabel ?? "Subscribe";
          }
        }
      });
    });
</script>

<style>
  .newsletter-signup__form {
    display: grid;
    gap: var(--space-2);
  }

  .newsletter-signup__row {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-1);
    flex-wrap: wrap;
  }

  .newsletter-signup__row input {
    flex: 1 1 180px;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    border: 1px solid var(--interactive-border);
    background: var(--interactive-bg);
    color: var(--text);
    font-size: var(--text-sm);
    font-family: var(--sans);
  }

  .newsletter-signup__row input::placeholder {
    color: var(--muted);
  }

  .newsletter-signup__row input:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
    box-shadow: var(--focus-ring);
  }

  .newsletter-signup__status {
    font-size: var(--text-sm);
    min-height: 1.3em;
    margin: 0;
  }

  .newsletter-signup__status--success {
    color: var(--teal);
  }

  .newsletter-signup__status--error {
    color: var(--accent);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
