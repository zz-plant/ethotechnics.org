---
import "../styles/components/pattern-browser.css";
import { randomUUID } from "node:crypto";

import type { Pattern, PatternFilter } from "../content/library";
import { buildPatternSearchText } from "../utils/pattern-search";

type Props = {
  filters: PatternFilter[];
  entries: Pattern[];
  searchId?: string;
};

const { filters, entries, searchId }: Props = Astro.props;
const filterLabels = Object.fromEntries(
  filters.map((filter) => [filter.slug, filter.label]),
);
const filtersWithAll: Array<{
  slug: string;
  label: string;
  description?: string;
}> = [{ slug: "all", label: "All safeguards" }, ...filters];
const searchInputId = searchId ?? `pattern-search-${randomUUID()}`;
---

<div
  class="pattern-filter"
  data-pattern-filter
  data-filters={filters.map((filter) => filter.slug).join(",")}
  data-filter-labels={JSON.stringify(filterLabels)}
>
  <div class="pattern-filter__controls">
    <label class="pattern-filter__search" for={searchInputId}>
      <span class="pattern-filter__search-label">Search mechanisms</span>
      <input
        id={searchInputId}
        type="search"
        class="pattern-filter__search-input"
        placeholder="Search by name or keyword"
        data-search-input
        aria-label="Search mechanisms by name or keyword"
      />
    </label>
    <ul class="pill-list pattern-filter__themes">
      {
        filtersWithAll.map((filter) => {
          const isAll = filter.slug === "all";

          return (
            <li
              class={`pill-list__item${isAll ? " pill-list__item--active" : ""}`}
            >
              <button
                type="button"
                class="pill-list__button"
                aria-pressed={isAll}
                data-filter={filter.slug}
                title={filter.description}
                aria-label={
                  filter.slug === "all"
                    ? "Show all mechanisms"
                    : `Filter mechanisms by ${filter.label} and update visible results`
                }
              >
                {filter.label}
              </button>
            </li>
          );
        })
      }
    </ul>
    <div class="pattern-filter__meta">
      <p
        class="muted small"
        role="status"
        aria-live="polite"
        data-filter-status
      >
        Showing all mechanisms.
      </p>
    </div>
    {
      filters.some((filter) => filter.description) && (
        <details class="pattern-filter__legend">
          <summary>What the safeguards mean</summary>
          <dl>
            {filters.map((filter) =>
              filter.description ? (
                <div>
                  <dt>{filter.label}</dt>
                  <dd>{filter.description}</dd>
                </div>
              ) : null,
            )}
          </dl>
        </details>
      )
    }
  </div>
  <div class="pattern-filter__results" data-pattern-results>
    {
      entries.map((pattern) => {
        const appliedFilters = pattern.filters
          .map((filter) => filterLabels[filter] ?? filter)
          .join(", ");
        const detailHref = `/mechanisms/patterns/${pattern.slug}`;
        const searchContent = buildPatternSearchText(pattern);

        return (
          <article
            class="card pattern-card"
            id={pattern.slug}
            data-pattern-card
            data-filters={pattern.filters.join(",")}
            data-search={searchContent}
          >
            <p class="muted small">{appliedFilters}</p>
            <h3 class="pattern-card__heading">
              <a class="pattern-card__title" href={detailHref}>
                {pattern.title}
              </a>
            </h3>
            <p class="pattern-card__summary">{pattern.summary}</p>
          </article>
        );
      })
    }
    <p class="muted" data-empty hidden>No mechanisms match these filters.</p>
  </div>
</div>

<script>
  import "../scripts/pattern-filter.ts";
</script>
