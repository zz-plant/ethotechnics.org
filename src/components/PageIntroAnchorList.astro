---
import type { AnchorLink } from "./PageIntro.astro";

interface Props {
  links: AnchorLink[];
  className?: string;
  startIndex?: number;
}

const { links, className, startIndex = 0 } = Astro.props;
---

<ul class={className}>
  {
    links.map((link, index) => (
      <li>
        <a href={link.href} data-index={startIndex + index + 1}>
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
