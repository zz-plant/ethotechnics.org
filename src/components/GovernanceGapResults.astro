---
import CardGrid from "./CardGrid.astro";
import CardItem from "./CardItem.astro";
import SectionBlock from "./SectionBlock.astro";

interface Props {
  id?: string;
}

const { id = "results" } = Astro.props;
---

<div data-gap-results hidden>
  <SectionBlock
    id={id}
    eyebrow="Results"
    title="Governance Gap Score"
    description="A scorecard you can send, with links to the evidence packs and the other diagnostics."
  >
    <CardGrid className="grid--two">
      <CardItem
        title="Score summary"
        description="How ownership, evidence cadence, and escalation coverage scored."
      >
        <p class="muted">Overall score</p>
        <p class="metric" data-gap-score>--</p>
        <span class="status-pill status-pill--yellow" data-gap-status
          >Steady</span
        >
        <p class="muted" data-gap-summary>
          Capture the missing evidence and rerun the check after remediation.
        </p>
        <label class="intake-form__field intake-form__field--full">
          Shareable link
          <input
            id="gap-share-link"
            name="gap-share-link"
            type="text"
            readonly
            data-gap-share
            aria-label="Shareable results link"
          />
        </label>
        <div class="intake-form__actions">
          <button class="button ghost" type="button" data-gap-copy>
            Copy share link
          </button>
          <button class="button ghost" type="button" data-gap-download>
            Download JSON
          </button>
          <button class="button ghost" type="button" data-gap-download-csv>
            Download CSV
          </button>
          <button class="button ghost" type="button" data-gap-download-pdf>
            Save PDF
          </button>
        </div>
      </CardItem>
      <CardItem
        title="Disclaimer"
        description="The score reflects your own answers to seven questions. It is not an audit or a legal assessment."
      >
        <ul class="muted">
          <li>
            Use it to decide which gaps a formal review should look at first.
          </li>
          <li>
            Confirm outputs with internal policy, legal, and security owners.
          </li>
          <li>Back each answer with the records an evidence pack asks for.</li>
        </ul>
      </CardItem>
      <CardItem
        title="What the new dimensions mean"
        description="Three dimensions cover what happens to a delegation after launch."
      >
        <ul class="muted">
          <li>
            <strong>Authority:</strong> whether every automated action can name who
            authorized it and when that authority ends.
          </li>
          <li>
            <strong>Dependence:</strong> whether the work could still be done without
            the system, and whether anyone has tried lately.
          </li>
          <li>
            <strong>Standing:</strong> whether the people who bear the errors can
            reach a named responder on a deadline.
          </li>
        </ul>
      </CardItem>
      <CardItem
        title="Recommended next steps"
        description="Where to go once you know the gaps."
      >
        <div class="actions">
          <a class="button primary" href="/diagnostics"
            >Run deeper diagnostics</a
          >
          <a class="button ghost" href="/evidence-packs"
            >Review evidence packs</a
          >
        </div>
      </CardItem>
    </CardGrid>
  </SectionBlock>
</div>
