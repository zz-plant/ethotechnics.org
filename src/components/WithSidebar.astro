<div class="with-sidebar">
  <aside class="with-sidebar__aside"><slot name="sidebar" /></aside>
  <div class="with-sidebar__content"><slot /></div>
</div>
<style>
  .with-sidebar {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 1024px) {
    .with-sidebar {
      grid-template-columns: 200px 1fr;
    }
  }
  .with-sidebar__aside {
    position: sticky;
    top: 5rem;
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--text-sm);
  }
  @media (max-width: 1023px) {
    .with-sidebar__aside {
      display: none;
    }
  }
  .with-sidebar__aside :global(.toc-heading) {
    font-weight: 700;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label-wide);
    color: var(--muted);
    margin: 0 0 var(--space-3);
  }
  .with-sidebar__aside :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-1);
  }
  .with-sidebar__aside :global(a) {
    color: var(--muted);
    text-decoration: none;
    display: block;
    line-height: 1.4;
  }
  .with-sidebar__aside :global(a:hover),
  .with-sidebar__aside :global(a:focus-visible) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
