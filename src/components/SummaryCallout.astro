---
/**
 * Shared summary callout with quick takeaways and navigation links.
 *
 * Props:
 * - eyebrow: Optional label above the callout title.
 * - title: Callout heading text.
 * - description: Supporting copy under the title.
 * - takeaways: Bullet list of key takeaways.
 * - relatedLinks: Pill-style links to related sections.
 *
 * No on-page jump list: the intro's "Jump to" and the sticky section bar
 * already carry the same anchors, and on a phone all three were on screen
 * at once.
 */
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  takeaways?: string[];
  relatedLinks?: LinkItem[];
}

const props: Props = Astro.props;
const {
  eyebrow = "Summary",
  title,
  description,
  takeaways = [],
  relatedLinks = [],
} = props;
---

<div class="callout summary-callout">
  <div class="summary-callout__intro">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p class="muted summary-callout__desc">{description}</p>
  </div>
  <div class="summary-callout__body">
    {
      takeaways.length > 0 && (
        <div class="summary-callout__section">
          <p class="eyebrow">Takeaways</p>
          <ul class="summary-callout__takeaways">
            {takeaways.map((takeaway) => (
              <li>{takeaway}</li>
            ))}
          </ul>
        </div>
      )
    }
    {
      relatedLinks.length > 0 && (
        <div class="summary-callout__section">
          <p class="eyebrow">Related sections</p>
          <ul class="pill-list">
            {relatedLinks.map((link) => (
              <li class="pill-list__item">
                <a class="pill-list__button" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</div>
