---
/**
 * The theater test, drawn: a dashboard as usually built, then Law VIII's
 * question put to every tile.
 *
 * The opening frame is the dashboard alone, all green, because that is what
 * the reader has seen in every deployment review. The button asks each tile
 * which governing state it can change; the answer, for a dashboard built the
 * usual way, is none, and the tiles dim to what they are. The form then wires
 * one tile to a grant transition and shows the reconsideration record the
 * wire emits. Tiles, trigger kinds, and target states come from
 * src/utils/theater-test.ts, which a test holds to the published schemas.
 */
import DemoFigure from "./DemoFigure.astro";
import {
  TARGET_LABELS,
  TILES,
  TRIGGER_KINDS,
  TRIGGER_LABELS,
  WIRE_TARGETS,
} from "../utils/theater-test";

interface Props {
  /** The heading level the figure's title takes from where it sits. */
  level?: "h3" | "h4";
}

const { level = "h3" }: Props = Astro.props;
const auditLines = [
  "09:14:02 decision d-88213 issued grant#3",
  "09:14:02 decision d-88214 issued grant#3",
  "09:14:03 review r-2231 approved d-88213",
  "09:14:03 decision d-88215 issued grant#3",
];
---

<DemoFigure
  id="theater-test"
  class="theater"
  level={level}
  title="The theater test"
  lede="A dashboard for a prior-authorization router, as one is usually built. Every tile is green and every tile is true. Press the button to ask each one Law VIII's question: which governing state can it change?"
>
  <div class="demo-figure__frame" data-theater>
    <div class="theater__bar">
      <button
        type="button"
        class="demo-button"
        data-theater-toggle
        aria-pressed="false"
        hidden>Show what each tile can change</button
      >
      <p class="theater__count" data-theater-count aria-live="polite" hidden>
        <strong data-theater-count-value>0</strong> of {TILES.length} tiles can change
        a governing state. The rest record what happened.
      </p>
    </div>
    <ul class="theater__grid">
      {
        TILES.map((tile) => (
          <li
            class="theater__tile"
            data-tile={tile.id}
            data-kind={tile.kind}
            id={`theater-tile-${tile.id}`}
          >
            <p class="theater__tile-title">
              <span class="demo-status" data-tile-status aria-hidden="true" />
              {tile.title}
            </p>
            {tile.kind === "stream" ? (
              <p class="theater__tile-reading theater__tile-reading--stream">
                {tile.reading}
              </p>
            ) : (
              <p class="theater__tile-reading">{tile.reading}</p>
            )}
            {tile.kind === "stream" ? (
              <ul class="theater__stream" aria-label="Recent audit events">
                {auditLines.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            ) : (
              <p class="theater__tile-detail">{tile.detail}</p>
            )}
            <p class="theater__tile-wire" data-tile-wire hidden>
              Changes:
              <span data-tile-wire-target>nothing</span>
            </p>
          </li>
        ))
      }
    </ul>
    <form class="theater__form" data-theater-form hidden>
      <p class="theater__form-lede">
        Wire one tile to a state. The rule names the observation, the trigger
        kind, and the state it moves the grant to.
      </p>
      <div class="theater__form-grid">
        <label class="demo-field">
          <span class="demo-field__label">When</span>
          <select class="demo-select" name="tile">
            {
              TILES.map((tile) => (
                <option value={tile.id}>
                  {tile.title} moves outside its band
                </option>
              ))
            }
          </select>
        </label>
        <label class="demo-field">
          <span class="demo-field__label">and</span>
          <select class="demo-select" name="trigger">
            {
              TRIGGER_KINDS.map((kind) => (
                <option value={kind}>{TRIGGER_LABELS[kind]}</option>
              ))
            }
          </select>
        </label>
        <label class="demo-field">
          <span class="demo-field__label">move the grant to</span>
          <select class="demo-select" name="target">
            {
              WIRE_TARGETS.map((target) => (
                <option value={target}>{TARGET_LABELS[target]}</option>
              ))
            }
          </select>
        </label>
        <div class="demo-field theater__form-action">
          <button type="submit" class="demo-button">Wire it</button>
        </div>
      </div>
    </form>
    <div class="theater__record" data-theater-record hidden>
      <p class="theater__record-title">
        The record the wire emits when it fires. Opened, not decided: the wire
        gets the observation into the governing state, and the decision is the
        issuer's.
      </p>
      <pre class="demo-pre"><code data-theater-json /></pre>
    </div>
  </div>
  <p class="demo-figure__note">
    A demonstration, not a measurement of any deployment. The tiles are read
    from <code>src/utils/theater-test.ts</code>; the trigger kinds and target
    states are the ones <code>reconsideration.schema.json</code> and
    <code>authority-grant.schema.json</code> allow, and a test holds them there.
  </p>
</DemoFigure>

<script>
  import {
    buildReconsideration,
    describeWire,
    findTile,
    TARGET_LABELS,
    type TriggerKind,
    type WireTarget,
  } from "../utils/theater-test";

  const figures = document.querySelectorAll<HTMLElement>("[data-theater]");

  figures.forEach((figure) => {
    const toggle = figure.querySelector<HTMLButtonElement>(
      "[data-theater-toggle]",
    );
    const count = figure.querySelector<HTMLElement>("[data-theater-count]");
    const countValue = figure.querySelector<HTMLElement>(
      "[data-theater-count-value]",
    );
    const form = figure.querySelector<HTMLFormElement>("[data-theater-form]");
    const record = figure.querySelector<HTMLElement>("[data-theater-record]");
    const json = figure.querySelector<HTMLElement>("[data-theater-json]");
    if (!toggle || !count || !countValue || !form || !record || !json) return;

    const wired = new Map<string, WireTarget>();
    let sequence = 0;

    const refreshCount = () => {
      countValue.textContent = String(wired.size);
    };

    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      const tested = figure.classList.toggle("theater--tested");
      toggle.setAttribute("aria-pressed", String(tested));
      toggle.textContent = tested
        ? "Hide what each tile can change"
        : "Show what each tile can change";
      count.hidden = !tested;
      form.hidden = !tested;
      figure
        .querySelectorAll<HTMLElement>("[data-tile-wire]")
        .forEach((line) => {
          line.hidden = !tested;
        });
      if (!tested) record.hidden = true;
      refreshCount();
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const tileId = String(data.get("tile") ?? "");
      const trigger = String(data.get("trigger") ?? "") as TriggerKind;
      const to = String(data.get("target") ?? "") as WireTarget;
      const tile = findTile(tileId);
      const tileElement = figure.querySelector<HTMLElement>(
        `[data-tile="${tileId}"]`,
      );
      if (!tile || !tileElement) return;

      const wire = { tileId, trigger, to };
      wired.set(tileId, to);
      sequence += 1;

      tileElement.classList.add("theater__tile--wired");
      const target = tileElement.querySelector<HTMLElement>(
        "[data-tile-wire-target]",
      );
      if (target) {
        target.textContent = `grant → ${TARGET_LABELS[to]}`;
      }
      tileElement.title = describeWire(tile, wire);

      const emitted = buildReconsideration(
        tile,
        wire,
        new Date().toISOString(),
        sequence,
      );
      json.textContent = JSON.stringify(emitted, null, 2);
      record.hidden = false;
      refreshCount();
    });
  });
</script>
