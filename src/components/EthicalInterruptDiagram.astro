---
/**
 * Ethical Interrupt Circuit Breaker Diagram (STD-01).
 *
 * Visualizes the 3-tier interrupt taxonomy (Soft Prompt, Hard Stop, Mandatory Escalation)
 * and the state machine governing automated halting, reviewer SLA clocks,
 * and immutable interrupt receipts.
 */
interface Props {
  level?: "h2" | "h3";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;
---

<figure class="state-diagram" aria-labelledby="ethical-interrupt-title">
  <figcaption>
    <p class="eyebrow">Mechanism, drawn</p>
    <Heading id="ethical-interrupt-title">
      Ethical Interrupt Circuit Breaker Architecture
    </Heading>
    <p class="muted">
      Deliberate friction at quantified risk boundaries. Interrupts halt execution, issue receipts, and route to named human authorities before harm becomes irreversible.
    </p>
  </figcaption>

  <div class="diagram-scroll">
    <svg
      viewBox="0 0 920 380"
      role="img"
      class="state-diagram__svg"
      aria-label="State diagram of an ethical interrupt circuit breaker showing automated execution, risk trigger, hard stop state, reviewer SLA triage, and auditable resolution."
    >
      <defs>
        <marker
          id="ei-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--border)" />
        </marker>
        <marker
          id="ei-accent-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
        <marker
          id="ei-danger-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--danger, #e06c75)" />
        </marker>
      </defs>

      {/* Main Flow: Left to Right */}
      {/* State 1: Autonomous Execution */}
      <g class="state-diagram__node" transform="translate(30, 70)">
        <rect width="170" height="85" rx="8" />
        <text x="85" y="30" text-anchor="middle" class="state-diagram__state">1. Normal Flow</text>
        <text x="85" y="50" text-anchor="middle" class="state-diagram__label">Autonomous execution</text>
        <text x="85" y="66" text-anchor="middle" class="state-diagram__clause">Within standard bounds</text>
      </g>

      {/* Arrow 1 -> Decision */}
      <line x1="200" y1="112" x2="245" y2="112" stroke="var(--border)" stroke-width="2" marker-end="url(#ei-arrow)" />

      {/* Decision: Risk Threshold Tripped */}
      <g class="state-diagram__node" transform="translate(245, 67)">
        <polygon points="90,0 180,45 90,90 0,45" fill="var(--panel)" stroke="var(--danger, #e06c75)" stroke-width="1.5" />
        <text x="90" y="38" text-anchor="middle" class="state-diagram__state" font-size="11" fill="var(--danger, #e06c75)">Threshold</text>
        <text x="90" y="54" text-anchor="middle" class="state-diagram__clause">Breached?</text>
      </g>

      {/* Tripped Arrow -> State 2 */}
      <line x1="425" y1="112" x2="470" y2="112" stroke="var(--danger, #e06c75)" stroke-width="2" marker-end="url(#ei-danger-arrow)" />

      {/* State 2: Interrupt Engaged */}
      <g class="state-diagram__node state-diagram__node--active" transform="translate(470, 60)">
        <rect width="200" height="105" rx="8" fill="var(--panel)" stroke="var(--danger, #e06c75)" stroke-width="2" />
        <text x="100" y="28" text-anchor="middle" class="state-diagram__state" fill="var(--danger, #e06c75)">2. Interrupt Tripped</text>
        <text x="100" y="48" text-anchor="middle" class="state-diagram__clause">Execution Suspended</text>
        <text x="100" y="68" text-anchor="middle" class="state-diagram__label">Halt receipt published</text>
        <text x="100" y="86" text-anchor="middle" class="state-diagram__label">State checkpointed</text>
      </g>

      {/* Escalation Ladder Arrow -> State 3 */}
      <line x1="670" y1="112" x2="715" y2="112" stroke="var(--accent)" stroke-width="2" marker-end="url(#ei-accent-arrow)" />

      {/* State 3: Human Adjudication */}
      <g class="state-diagram__node" transform="translate(715, 60)">
        <rect width="175" height="105" rx="8" fill="var(--panel)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="87" y="28" text-anchor="middle" class="state-diagram__state" fill="var(--accent-strong)">3. Human Review</text>
        <text x="87" y="48" text-anchor="middle" class="state-diagram__label">Named on-call owner</text>
        <text x="87" y="68" text-anchor="middle" class="state-diagram__label">Enforceable SLA clock</text>
        <text x="87" y="86" text-anchor="middle" class="state-diagram__clause">Reversal ready</text>
      </g>

      {/* Branch Out of Review */}
      {/* Down to Revoke/Remediate */}
      <path d="M 802 165 L 802 215 L 710 215" stroke="var(--danger, #e06c75)" stroke-width="2" fill="none" marker-end="url(#ei-danger-arrow)" />
      <g transform="translate(470, 190)">
        <rect width="230" height="50" rx="6" fill="var(--surface)" stroke="var(--danger, #e06c75)" stroke-width="1" />
        <text x="115" y="22" text-anchor="middle" class="state-diagram__state" font-size="11" fill="var(--danger, #e06c75)">Risk Confirmed: Rollback &amp; Compensate</text>
        <text x="115" y="38" text-anchor="middle" class="state-diagram__label" font-size="9.5">State reverted; harm bounded; incident logged</text>
      </g>

      {/* Loop Back: Safe Override -> Resume */}
      <path d="M 802 60 L 802 20 L 115 20 L 115 70" stroke="var(--accent)" stroke-width="2" stroke-dasharray="4 4" fill="none" marker-end="url(#ei-accent-arrow)" />
      <text x="460" y="14" text-anchor="middle" class="state-diagram__clause" fill="var(--accent-strong)">Verified Safe: Signed Override Resumes Execution</text>

      {/* Bottom Row: 3 Tiers of Interrupts */}
      <g transform="translate(30, 275)">
        <rect width="260" height="75" rx="6" fill="var(--surface)" stroke="var(--border)" />
        <text x="20" y="24" class="state-diagram__state" font-size="11">Tier 1: Soft Prompt</text>
        <text x="20" y="42" class="state-diagram__label" font-size="9.5">Advisory warning; user confirms</text>
        <text x="20" y="58" class="state-diagram__clause" font-size="9">Low consequence · Fast friction</text>
      </g>

      <g transform="translate(315, 275)">
        <rect width="260" height="75" rx="6" fill="var(--panel)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="20" y="24" class="state-diagram__state" font-size="11" fill="var(--accent-strong)">Tier 2: Hard Stop</text>
        <text x="20" y="42" class="state-diagram__label" font-size="9.5">Execution paused pending review</text>
        <text x="20" y="58" class="state-diagram__clause" font-size="9">Confidence dip · Irreversible action</text>
      </g>

      <g transform="translate(600, 275)">
        <rect width="290" height="75" rx="6" fill="var(--surface)" stroke="var(--danger, #e06c75)" stroke-width="1.5" />
        <text x="20" y="24" class="state-diagram__state" font-size="11" fill="var(--danger, #e06c75)">Tier 3: Mandatory Escalation</text>
        <text x="20" y="42" class="state-diagram__label" font-size="9.5">Emergency circuit trip; leadership alerted</text>
        <text x="20" y="58" class="state-diagram__clause" font-size="9">Severe demographic harm · Systematic drift</text>
      </g>
    </svg>
  </div>
</figure>
