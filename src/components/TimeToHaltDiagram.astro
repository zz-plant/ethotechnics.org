---
/**
 * Time-to-Halt (TTH) Latency Architecture Diagram (STD-01).
 *
 * Visualizes the end-to-end latency budget of an authenticated stop signal,
 * contrasting superficial UI acknowledgement with actual downstream cessation,
 * and illustrating the critical boundary against irreversible harm.
 */
interface Props {
  level?: "h2" | "h3";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;
---

<figure class="state-diagram" aria-labelledby="tth-diagram-title">
  <figcaption>
    <p class="eyebrow">Mechanism, drawn</p>
    <Heading id="tth-diagram-title">
      Time-to-Halt (TTH) Latency &amp; Blast Radius
    </Heading>
    <p class="muted">
      TTH measures latency to confirmed downstream cessation, not cosmetic UI acknowledgement. If halting latency exceeds the harm horizon, stoppability is nominal.
    </p>
  </figcaption>

  <div class="diagram-scroll">
    <svg
      viewBox="0 0 920 450"
      role="img"
      class="state-diagram__svg"
      aria-label="Timeline and latency chart showing the phases of Time-to-Halt: signal receipt, queue drain, downstream worker kill, and receipt issuance before the irreversible harm horizon."
    >
      <defs>
        <marker
          id="tth-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--border)" />
        </marker>
        <marker
          id="tth-accent-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
      </defs>

      {/* Top Section: End-to-End Signal Pipeline */}
      <g transform="translate(40, 30)">
        <text x="0" y="20" class="state-diagram__clause" fill="var(--accent-strong)">End-to-End Cessation Pipeline</text>

        {/* Phase 1: Halt Triggered */}
        <g class="state-diagram__node" transform="translate(0, 35)">
          <rect width="170" height="85" rx="6" fill="var(--panel)" stroke="var(--border)" />
          <text x="85" y="28" text-anchor="middle" class="state-diagram__state">t0: Halt Signal</text>
          <text x="85" y="50" text-anchor="middle" class="state-diagram__label">Authenticated request</text>
          <text x="85" y="69" text-anchor="middle" class="state-diagram__clause">UI / Policy trip</text>
        </g>

        <line x1="170" y1="77" x2="200" y2="77" stroke="var(--border)" stroke-width="2" marker-end="url(#tth-arrow)" />

        {/* Phase 2: Ingestion & Ingress Block */}
        <g class="state-diagram__node" transform="translate(200, 35)">
          <rect width="190" height="85" rx="6" fill="var(--panel)" stroke="var(--border)" />
          <text x="95" y="28" text-anchor="middle" class="state-diagram__state">t1: Ingress Severed</text>
          <text x="95" y="50" text-anchor="middle" class="state-diagram__label">Queue rejects new input</text>
          <text x="95" y="69" text-anchor="middle" class="state-diagram__clause">&lt; 150ms</text>
        </g>

        <line x1="390" y1="77" x2="420" y2="77" stroke="var(--border)" stroke-width="2" marker-end="url(#tth-arrow)" />

        {/* Phase 3: Downstream Workers Drained / SIGKILL */}
        <g class="state-diagram__node state-diagram__node--active" transform="translate(420, 35)">
          <rect width="205" height="85" rx="6" fill="var(--panel)" stroke="var(--accent)" stroke-width="2" />
          <text x="102.5" y="28" text-anchor="middle" class="state-diagram__state" fill="var(--accent-strong)">t2: Worker Drain</text>
          <text x="102.5" y="50" text-anchor="middle" class="state-diagram__label">In-flight transactions cut</text>
          <text x="102.5" y="69" text-anchor="middle" class="state-diagram__clause">True Cessation</text>
        </g>

        <line x1="625" y1="77" x2="655" y2="77" stroke="var(--accent)" stroke-width="2" marker-end="url(#tth-accent-arrow)" />

        {/* Phase 4: Immutable Halt Receipt */}
        <g class="state-diagram__node" transform="translate(655, 35)">
          <rect width="185" height="85" rx="6" fill="var(--surface)" stroke="var(--accent)" stroke-width="1.5" />
          <text x="92.5" y="28" text-anchor="middle" class="state-diagram__state">t3: Halt Receipt</text>
          <text x="92.5" y="50" text-anchor="middle" class="state-diagram__label">Signed state snapshot</text>
          <text x="92.5" y="69" text-anchor="middle" class="state-diagram__clause">Auditable proof</text>
        </g>

        {/* Cosmetic Warning Callout: under the UI-facing stages */}
        <g transform="translate(0, 134)">
          <rect width="390" height="34" rx="6" fill="var(--surface)" stroke="var(--status-danger)" stroke-dasharray="3 3" />
          <text x="14" y="22" class="state-diagram__clause" fill="var(--status-danger)">Cosmetic Pitfall</text>
          <text x="148" y="22" class="state-diagram__label">UI spinner stops while jobs run on</text>
        </g>
      </g>

      {/* Divider */}
      <line x1="40" y1="215" x2="880" y2="215" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 4" />

      {/* Bottom Section: Latency Budget vs Harm Horizon */}
      <g transform="translate(40, 230)">
        <text x="0" y="20" class="state-diagram__clause" fill="var(--accent-strong)">Latency Horizon vs. Consequential Blast Radius</text>

        {/* Horizontal Timeline Bar */}
        <rect x="0" y="70" width="840" height="26" rx="4" fill="var(--surface)" stroke="var(--border)" />

        {/* Enforced Target: TTH p99 Budget (e.g. 5.0s) */}
        <rect x="0" y="70" width="300" height="26" rx="4" fill="var(--panel)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="150" y="88" text-anchor="middle" class="state-diagram__state" fill="var(--accent-strong)">Enforced TTH Window (p99 SLA)</text>

        {/* Irreversible Harm Boundary */}
        <line x1="490" y1="30" x2="490" y2="196" stroke="var(--status-danger)" stroke-width="2" stroke-dasharray="4 4" />
        <text x="500" y="42" class="state-diagram__clause" fill="var(--status-danger)">Irreversible Harm Horizon</text>
        <text x="500" y="60" class="state-diagram__label">Wire transfer committed / PII leaked to public wire</text>

        {/* Safe Margin Indicator */}
        <line x1="300" y1="114" x2="486" y2="114" stroke="var(--accent)" stroke-width="2" marker-end="url(#tth-accent-arrow)" />
        <text x="393" y="136" text-anchor="middle" class="state-diagram__clause">Required Safety Margin</text>

        {/* Tail Latency Hazard */}
        <g transform="translate(505, 110)">
          <rect width="335" height="86" rx="6" fill="var(--surface)" stroke="var(--status-danger)" stroke-width="1" />
          <text x="167.5" y="26" text-anchor="middle" class="state-diagram__clause" fill="var(--status-danger)">Tail Latency Violation (TTH &gt; Harm Horizon)</text>
          <text x="167.5" y="50" text-anchor="middle" class="state-diagram__label">Average TTH is 2s, but p99 is 45s</text>
          <text x="167.5" y="68" text-anchor="middle" class="state-diagram__label">→ Fatal Failure</text>
        </g>
      </g>
    </svg>
  </div>
</figure>
