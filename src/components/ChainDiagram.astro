---
/**
 * The seven-stage chain, with the loops drawn.
 *
 * An ordered list of seven cards cannot show that Reconsideration reopens
 * Authority, or that Correction produces the Evidence the next decision rests
 * on — and those two return paths are the whole difference between a chain and
 * a pipeline. The stages come from the method content, so a renamed stage
 * renames here.
 */
import { methodContent } from "../content/method";

const stages = methodContent.chain;
const n = stages.length;
// Wide enough that "Reconsideration" fits its box, and tall enough that the
// deeper of the two return loops keeps its label inside the canvas.
const W = 1060;
const H = 262;
const pad = 32;
const nodeW = 130;
const gap = (W - pad * 2 - nodeW * n) / (n - 1);
const y = 120;
const xs = stages.map((_, i) => pad + i * (nodeW + gap));

const idx = (id: string) => stages.findIndex((s) => s.id === id);
const centre = (i: number) => xs[i]! + nodeW / 2;

const loops = [
  {
    from: "reconsideration",
    to: "authority",
    label: "reopens the grant",
    depth: 62,
  },
  {
    from: "correction",
    to: "evidence",
    label: "becomes the next decision's evidence",
    depth: 92,
  },
].map((loop) => ({ ...loop, fi: idx(loop.from), ti: idx(loop.to) }));
---

<figure class="chain-diagram" aria-labelledby="chain-diagram-title">
  <figcaption>
    <p class="eyebrow">The chain</p>
    <h3 id="chain-diagram-title">Seven stages and two returns</h3>
    <p class="muted">
      Left to right is one decision. The arrows underneath are what make it
      governed rather than merely logged: a challenge reopens the authority it
      ran under, and a correction is evidence the next decision has to rest on.
    </p>
  </figcaption>
  <div class="diagram-scroll">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={`The chain: ${stages.map((s) => s.title).join(", then ")}. Reconsideration returns to Authority; Correction returns to Evidence.`}
      class="chain-diagram__svg"
    >
      <defs>
        <marker
          id="chain-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor"></path>
        </marker>
      </defs>

      {
        stages
          .slice(0, -1)
          .map((_, i) => (
            <line
              x1={xs[i]! + nodeW}
              y1={y}
              x2={xs[i + 1]! - 2}
              y2={y}
              stroke="currentColor"
              stroke-width="1.5"
              marker-end="url(#chain-arrow)"
              class="chain-diagram__forward"
            />
          ))
      }

      {
        loops.map((loop) => {
          const x1 = centre(loop.fi);
          const x2 = centre(loop.ti);
          const top = y + 24;
          const d = `M ${x1} ${top} C ${x1} ${top + loop.depth} ${x2} ${top + loop.depth} ${x2} ${top + 2}`;
          return (
            <g class="chain-diagram__return">
              <path
                d={d}
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-dasharray="5 4"
                marker-end="url(#chain-arrow)"
              />
              <text
                x={(x1 + x2) / 2}
                y={top + loop.depth - 4}
                text-anchor="middle"
                class="chain-diagram__label"
              >
                {loop.label}
              </text>
            </g>
          );
        })
      }

      {
        stages.map((stage, i) => (
          <a href={`#${stage.id}`} class="chain-diagram__node">
            <rect x={xs[i]} y={y - 24} width={nodeW} height="48" rx="10" />
            <text
              x={centre(i)}
              y={y + 5}
              text-anchor="middle"
              class="chain-diagram__title"
            >
              {stage.title}
            </text>
            <text
              x={centre(i)}
              y={y - 34}
              text-anchor="middle"
              class="chain-diagram__index"
            >
              {i + 1}
            </text>
          </a>
        ))
      }
    </svg>
  </div>
</figure>
