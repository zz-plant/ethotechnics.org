---
/**
 * The framework comparison as a two-column table: what each framework asks
 * for, and what the drafts add. Rows come from src/content/framework-comparison.ts.
 */
import { frameworkComparison } from "../content/framework-comparison";
---

<div class="mapping-table__wrapper">
  <table class="mapping-table mapping-table--compare">
    <thead>
      <tr>
        <th scope="col">The framework asks for</th>
        <th scope="col">The drafts add</th>
      </tr>
    </thead>
    <tbody>
      {
        frameworkComparison.map((row) => (
          <tr>
            <td data-label="The framework asks for">
              {row.asks}
              <br />
              <span class="small muted">{row.source}</span>
            </td>
            <td data-label="The drafts add">{row.adds}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
