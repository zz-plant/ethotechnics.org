---
/**
 * STD-02 Contestability & Recourse State Machine.
 *
 * Visualizes the procedural path an error-bearing party can compel:
 * Decision -> Failure Point -> Standing Register (7 fields) -> Standard of Review -> Enforceable Transitions.
 * Also highlights the Section 10.2 Deepened Dependence re-consent loop.
 */
interface Props {
  level?: "h3" | "h4";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;
---

<figure class="state-diagram" aria-labelledby="std02-recourse-title">
  <figcaption>
    <p class="eyebrow">Article VIII, drawn</p>
    <Heading id="std02-recourse-title">
      The Contestability Lifecycle: from model failure to state transition
    </Heading>
    <p class="muted">
      Contestability is not a complaint box. It is a procedural route that binds exposure to enforceable state changes.
    </p>
  </figcaption>

  <div class="diagram-scroll">
    <svg
      viewBox="0 0 780 460"
      role="img"
      class="state-diagram__svg"
      aria-label="STD-02 Contestability lifecycle: consequential decision encounters model failure point, initiates standing check with seven required parameters, evaluates against standard of review, and compels binding state transitions."
    >
      <defs>
        <marker
          id="recourse-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--border)" />
        </marker>
        <marker
          id="recourse-arrow-accent"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
      </defs>

      {/* Connection Edges */}
      {/* 1. Decision to Failure Point */}
      <line x1="180" y1="75" x2="240" y2="75" stroke="var(--border)" stroke-width="2" marker-end="url(#recourse-arrow)" />

      {/* 2. Failure Point to Standing Check */}
      <line x1="410" y1="75" x2="470" y2="75" stroke="var(--border)" stroke-width="2" marker-end="url(#recourse-arrow)" />

      {/* 3. Standing Check down to Review */}
      <line x1="615" y1="130" x2="615" y2="170" stroke="var(--border)" stroke-width="2" marker-end="url(#recourse-arrow)" />

      {/* 4. Review branching down to Outcomes */}
      <path d="M 615 260 L 615 300" stroke="var(--border)" stroke-width="2" fill="none" />
      <path d="M 615 300 L 140 300 L 140 336" stroke="var(--border)" stroke-width="2" marker-end="url(#recourse-arrow)" fill="none" />
      <path d="M 615 300 L 390 300 L 390 336" stroke="var(--border)" stroke-width="2" marker-end="url(#recourse-arrow)" fill="none" />
      <path d="M 615 300 L 640 300 L 640 336" stroke="var(--border)" stroke-width="2" marker-end="url(#recourse-arrow)" fill="none" />

      {/* 5. Return Loop: Article 10 Deepened Dependence */}
      <path
        d="M 80 340 L 80 122"
        stroke="var(--accent)"
        stroke-width="1.5"
        stroke-dasharray="4 4"
        fill="none"
        marker-end="url(#recourse-arrow-accent)"
      />

      {/* Step 1: Decision Node */}
      <g class="state-diagram__node" transform="translate(20, 32)">
        <rect width="160" height="86" rx="8" />
        <text x="80" y="38" text-anchor="middle" class="state-diagram__state">Decision</text>
        <text x="80" y="62" text-anchor="middle" class="state-diagram__label">§1.1 Notice emitted</text>
      </g>

      {/* Step 2: The Failure Point / Collision */}
      <g class="state-diagram__node state-diagram__node--active" transform="translate(240, 32)">
        <rect width="170" height="86" rx="8" />
        <text x="85" y="30" text-anchor="middle" class="state-diagram__state" fill="var(--accent-strong)">Failure Point</text>
        <text x="85" y="52" text-anchor="middle" class="state-diagram__label">not represented</text>
        <text x="85" y="71" text-anchor="middle" class="state-diagram__label">⇒ unresolved</text>
      </g>

      {/* Step 3: Standing Register Verification */}
      <g class="state-diagram__node" transform="translate(470, 20)">
        <rect width="290" height="110" rx="8" />
        <text x="145" y="28" text-anchor="middle" class="state-diagram__state">Standing Register</text>
        <text x="145" y="50" text-anchor="middle" class="state-diagram__clause">§8.1 Seven Parameters</text>
        <text x="145" y="72" text-anchor="middle" class="state-diagram__label">who · what · evidence · responder</text>
        <text x="145" y="91" text-anchor="middle" class="state-diagram__label">deadline · standard · transitions</text>
      </g>

      {/* Step 4: Standard of Review */}
      <g class="state-diagram__node" transform="translate(470, 170)">
        <rect width="290" height="90" rx="8" />
        <text x="145" y="30" text-anchor="middle" class="state-diagram__state">Standard of Review</text>
        <text x="145" y="52" text-anchor="middle" class="state-diagram__clause">§8.2 Merits & Policy</text>
        <text x="145" y="72" text-anchor="middle" class="state-diagram__label">not merely "did code run"</text>
      </g>

      {/* Outcome Tier 1: Remediation / Reversal */}
      <g class="state-diagram__node" transform="translate(20, 336)">
        <rect width="240" height="108" rx="8" />
        <text x="120" y="30" text-anchor="middle" class="state-diagram__state">Reversal & Repair</text>
        <text x="120" y="52" text-anchor="middle" class="state-diagram__clause">§8.3 Transitions</text>
        <text x="120" y="74" text-anchor="middle" class="state-diagram__label">Decision Reversed /</text>
        <text x="120" y="93" text-anchor="middle" class="state-diagram__label">Rectified</text>
      </g>

      {/* Outcome Tier 2: Suspension & Narrowing */}
      <g class="state-diagram__node" transform="translate(270, 336)">
        <rect width="240" height="108" rx="8" />
        <text x="120" y="30" text-anchor="middle" class="state-diagram__state">Authority Narrowed</text>
        <text x="120" y="52" text-anchor="middle" class="state-diagram__clause">§8.3 Scope Reduced</text>
        <text x="120" y="74" text-anchor="middle" class="state-diagram__label">Grant moved to</text>
        <text x="120" y="93" text-anchor="middle" class="state-diagram__label">review_required</text>
      </g>

      {/* Outcome Tier 3: Grant Revocation */}
      <g class="state-diagram__node" transform="translate(520, 336)">
        <rect width="240" height="108" rx="8" />
        <text x="120" y="30" text-anchor="middle" class="state-diagram__state">Grant Revocation</text>
        <text x="120" y="52" text-anchor="middle" class="state-diagram__clause">STD-07 §2.2 Expiry</text>
        <text x="120" y="74" text-anchor="middle" class="state-diagram__label">Unilateral delegation</text>
        <text x="120" y="93" text-anchor="middle" class="state-diagram__label">terminated</text>
      </g>

      {/* Deepened dependence annotation, beside the loop it labels */}
      <text x="94" y="212" class="state-diagram__clause">Article X: Deepened Dependence</text>
      <text x="94" y="232" class="state-diagram__label">Exit cost +25% ⇒ Reopens consent</text>
    </svg>
  </div>
</figure>
