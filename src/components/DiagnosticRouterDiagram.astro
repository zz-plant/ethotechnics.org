---
/**
 * Diagnostic Router Decision Tree Diagram.
 *
 * Visualizes the symptom-to-diagnostic triage flow to guide operators,
 * auditors, and governance teams to the exact tool needed in 30 seconds.
 */
interface Props {
  level?: "h2" | "h3";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;
---

<figure class="state-diagram" aria-labelledby="diagnostic-router-title">
  <figcaption>
    <p class="eyebrow">Diagnostic Router, drawn</p>
    <Heading id="diagnostic-router-title">
      Triage Decision Tree: From Symptom to Tool
    </Heading>
    <p class="muted">
      Select your primary operational symptom to identify the diagnostic and required output artifact.
    </p>
  </figcaption>

  <div class="diagram-scroll">
    <svg
      viewBox="0 0 920 396"
      role="img"
      class="state-diagram__svg"
      aria-label="Decision tree flowchart routing four operational symptoms (human burden, escalation confusion, capacity decay, contestability deficit) to specific diagnostic tools."
    >
      <defs>
        <marker
          id="dt-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--border)" />
        </marker>
        <marker
          id="dt-accent-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
      </defs>

      {/* Root Node: Left Column */}
      <g transform="translate(16, 150)">
        <rect width="184" height="100" rx="8" fill="var(--panel)" stroke="var(--accent)" stroke-width="2" />
        <text x="92" y="32" text-anchor="middle" class="state-diagram__clause">Primary Question</text>
        <text x="92" y="56" text-anchor="middle" class="state-diagram__state">What is failing</text>
        <text x="92" y="76" text-anchor="middle" class="state-diagram__state">or unmeasured?</text>
      </g>

      {/* Branch Connectors: root to each symptom row */}
      <path d="M 200 172 C 236 172, 234 54, 270 54" stroke="var(--border)" stroke-width="2" fill="none" marker-end="url(#dt-arrow)" />
      <path d="M 200 190 C 236 190, 234 150, 270 150" stroke="var(--border)" stroke-width="2" fill="none" marker-end="url(#dt-arrow)" />
      <path d="M 200 210 C 236 210, 234 246, 270 246" stroke="var(--border)" stroke-width="2" fill="none" marker-end="url(#dt-arrow)" />
      <path d="M 200 228 C 236 228, 234 342, 270 342" stroke="var(--border)" stroke-width="2" fill="none" marker-end="url(#dt-arrow)" />

      {/* Branch 1: Burden Modeler */}
      <g transform="translate(270, 12)">
        <rect width="274" height="84" rx="6" fill="var(--surface)" stroke="var(--border)" />
        <text x="14" y="27" class="state-diagram__state">Symptom: Silent Absorption</text>
        <text x="14" y="50" class="state-diagram__label">Staff burnout, manual overrides,</text>
        <text x="14" y="69" class="state-diagram__label">uncounted workaround labor</text>

        <line x1="274" y1="42" x2="300" y2="42" stroke="var(--accent)" stroke-width="2" marker-end="url(#dt-accent-arrow)" />

        <a href="/diagnostics/burden-modeler">
          <g transform="translate(300, 0)">
            <rect width="330" height="84" rx="6" fill="var(--panel)" stroke="var(--accent)" stroke-width="1.5" />
            <text x="14" y="27" class="state-diagram__state" fill="var(--link)">→ Burden Modeler</text>
            <text x="14" y="50" class="state-diagram__label">Output: Burden Evidence Table</text>
            <text x="14" y="69" class="state-diagram__clause">Standard: STD-02 / Law IV</text>
          </g>
        </a>
      </g>

      {/* Branch 2: Maintenance Simulator */}
      <g transform="translate(270, 108)">
        <rect width="274" height="84" rx="6" fill="var(--surface)" stroke="var(--border)" />
        <text x="14" y="27" class="state-diagram__state">Symptom: Escalation Vacuum</text>
        <text x="14" y="50" class="state-diagram__label">Outage ownership unclear,</text>
        <text x="14" y="69" class="state-diagram__label">fallback routes unrehearsed</text>

        <line x1="274" y1="42" x2="300" y2="42" stroke="var(--accent)" stroke-width="2" marker-end="url(#dt-accent-arrow)" />

        <a href="/diagnostics/maintenance-simulator">
          <g transform="translate(300, 0)">
            <rect width="330" height="84" rx="6" fill="var(--panel)" stroke="var(--accent)" stroke-width="1.5" />
            <text x="14" y="27" class="state-diagram__state" fill="var(--link)">→ Maintenance Simulator</text>
            <text x="14" y="50" class="state-diagram__label">Output: Escalation Coverage Report</text>
            <text x="14" y="69" class="state-diagram__clause">Standard: STD-05 / Law VI</text>
          </g>
        </a>
      </g>

      {/* Branch 3: Capacity Forecaster */}
      <g transform="translate(270, 204)">
        <rect width="274" height="84" rx="6" fill="var(--surface)" stroke="var(--border)" />
        <text x="14" y="27" class="state-diagram__state">Symptom: Atrophy &amp; Saturation</text>
        <text x="14" y="50" class="state-diagram__label">Reserve declining over time,</text>
        <text x="14" y="69" class="state-diagram__label">growing lock-in risk</text>

        <line x1="274" y1="42" x2="300" y2="42" stroke="var(--accent)" stroke-width="2" marker-end="url(#dt-accent-arrow)" />

        <a href="/diagnostics/capacity-forecaster">
          <g transform="translate(300, 0)">
            <rect width="330" height="84" rx="6" fill="var(--panel)" stroke="var(--accent)" stroke-width="1.5" />
            <text x="14" y="27" class="state-diagram__state" fill="var(--link)">→ Capacity Forecaster</text>
            <text x="14" y="50" class="state-diagram__label">Output: Stability &amp; Decay Horizon</text>
            <text x="14" y="69" class="state-diagram__clause">Standard: STD-04 / Law XII</text>
          </g>
        </a>
      </g>

      {/* Branch 4: System Auditor */}
      <g transform="translate(270, 300)">
        <rect width="274" height="84" rx="6" fill="var(--surface)" stroke="var(--border)" />
        <text x="14" y="27" class="state-diagram__state">Symptom: Opaque Authority</text>
        <text x="14" y="50" class="state-diagram__label">Is decision reversible? Can user</text>
        <text x="14" y="69" class="state-diagram__label">contest outcome with standing?</text>

        <line x1="274" y1="42" x2="300" y2="42" stroke="var(--accent)" stroke-width="2" marker-end="url(#dt-accent-arrow)" />

        <a href="/diagnostics/system-auditor">
          <g transform="translate(300, 0)">
            <rect width="330" height="84" rx="6" fill="var(--panel)" stroke="var(--accent)" stroke-width="1.5" />
            <text x="14" y="27" class="state-diagram__state" fill="var(--link)">→ System Auditor</text>
            <text x="14" y="50" class="state-diagram__label">Output: Governability &amp; Standing Audit</text>
            <text x="14" y="69" class="state-diagram__clause">Standard: STD-01, STD-02 / Law VII</text>
          </g>
        </a>
      </g>
    </svg>
  </div>
</figure>
