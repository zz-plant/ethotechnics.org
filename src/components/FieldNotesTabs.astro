---
import {
  getGlossaryDefinition,
  getGlossaryLabel,
  glossaryEntryPermalink,
} from "../utils/glossary";
import type { FieldNoteEntry, FieldNotesContent } from "../content/fieldNotes";
import fieldNotesTabsScript from "../scripts/field-notes-tabs.ts?url";

export interface Props {
  sections: FieldNotesContent["sections"];
  entries: FieldNoteEntry[];
}

const { sections, entries } = Astro.props as Props;
const initialFormat = sections[0]?.format ?? "";

const glossaryHref = (slug: string) => glossaryEntryPermalink(slug);
const listSeparator = (index: number, total: number) =>
  index < total - 1 ? ", " : "";
const relatedLinkLabel = (href: string) => {
  const normalized = href.replace(/^https?:\/\//, "").replace(/\/$/, "");

  if (href.startsWith("/")) {
    const segments = href.split("/").filter(Boolean);
    const lastSegment = segments.at(-1) ?? "resource";
    return `Open ${lastSegment.replace(/-/g, " ")}`;
  }

  const [host, ...rest] = normalized.split("/");
  const pathLabel = rest.at(-1)?.replace(/[-_]/g, " ") ?? "resource";
  return `Reference ${pathLabel} (${host})`;
};
const fieldNoteSections = sections.map((section, index) => ({
  section,
  entries: entries.filter((entry) => entry.format === section.format),
  isActive: section.format === initialFormat || (index === 0 && !initialFormat),
}));
---

{
  sections.length ? (
    <section
      class="section section--alt field-notes"
      data-field-notes
      data-default-format={initialFormat}
    >
      <div class="section__header field-notes__header">
        {fieldNoteSections.map(({ section }) => (
          <div
            class="field-notes__heading"
            data-field-notes-heading
            data-format={section.format}
          >
            <p class="eyebrow">{section.title}</p>
            <h2>{section.description}</h2>
          </div>
        ))}
        <ul
          class="pill-list pill-list--wrap field-notes__tabs"
          role="tablist"
          aria-label="Field note formats"
          data-field-notes-tablist
        >
          {fieldNoteSections.map(({ section, isActive }) => (
            <li
              class={`pill-list__item field-notes__tab${
                isActive ? " pill-list__item--active" : ""
              }`}
            >
              <button
                class="pill-list__button"
                id={`${section.format}-tab`}
                type="button"
                role="tab"
                aria-selected={isActive}
                aria-controls={`${section.format}-panel`}
                tabindex={isActive ? 0 : -1}
                data-format={section.format}
                data-field-notes-tab
              >
                {section.title}
              </button>
            </li>
          ))}
        </ul>
      </div>
      {fieldNoteSections.map(({ section, entries: sectionEntries }) => (
        <div
          id={section.format}
          data-field-notes-section
          data-format={section.format}
        >
          <div
            class="grid"
            id={`${section.format}-panel`}
            role="tabpanel"
            aria-labelledby={`${section.format}-tab`}
            data-field-notes-panel
            data-format={section.format}
          >
            {sectionEntries.map((entry) => {
              const links = entry.links ?? [];
              const hasLinks = links.length > 0;
              const primaryTerm = entry.relatedTerms[0];
              const primaryGlossaryHref = primaryTerm
                ? glossaryHref(primaryTerm)
                : "/glossary";

              return (
                <article
                  class="card field-notes__card"
                  id={entry.slug}
                  data-field-notes-entry
                  data-format={entry.format}
                >
                  <div class="card__glow" aria-hidden="true" />
                  <h3>{entry.title}</h3>
                  <p class="muted">{entry.summary}</p>
                  <p class="muted">
                    Glossary{" "}
                    {entry.relatedTerms.map((slug, relatedIndex) => (
                      <span>
                        <a
                          href={glossaryHref(slug)}
                          title={getGlossaryDefinition(slug) || undefined}
                        >
                          {getGlossaryLabel(slug)}
                        </a>
                        {listSeparator(relatedIndex, entry.relatedTerms.length)}
                      </span>
                    ))}
                  </p>
                  {hasLinks ? (
                    <p class="muted">
                      Related links{" "}
                      {links.map((link, linkIndex) => (
                        <span>
                          <a href={link}>{relatedLinkLabel(link)}</a>
                          {listSeparator(linkIndex, links.length)}
                        </span>
                      ))}
                    </p>
                  ) : null}
                  <div
                    class="field-notes__continue muted"
                    aria-label="After this note"
                  >
                    <p class="eyebrow">After this note</p>
                    <ul>
                      <li>
                        <a href={primaryGlossaryHref}>Glossary definition</a>
                      </li>
                      <li>
                        <a href={links[0] ?? "/mechanisms#patterns"}>
                          Mechanism or pattern
                        </a>
                      </li>
                      <li>
                        <a href="/diagnostics#quick-triage">
                          Diagnostic next step
                        </a>
                      </li>
                    </ul>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </section>
  ) : null
}

<script type="module" src={fieldNotesTabsScript} is:inline></script>
