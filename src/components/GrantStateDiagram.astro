---
/**
 * The authority grant's state machine, drawn.
 *
 * The site's central claim is that observability without state transition is
 * theater, and the grant object has states and transitions — described, until
 * now, in clause prose. The state names come from the schema itself, so the
 * diagram cannot show a state the object cannot be in; a test holds the two
 * to each other. The transitions are the ones STD-08 Parts A and C describe.
 */
import schema from "../../public/standards/authority-grant.schema.json";
import { DIAGRAM_STATES, type DiagramState } from "../utils/grant-states";

const stateEnum: string[] = schema.properties.state.enum;

const labels: Record<DiagramState, string> = {
  allowed: "Allowed",
  review_required: "Review required",
  suspended: "Suspended",
  revoked: "Revoked",
};

// Explicit geometry on an 830×400 canvas. Generic midpoint labels collided
// the moment two edges shared a corridor, so each edge carries its own path
// and its own label anchor.
const nodes = {
  none: { x: 60, y: 200 },
  allowed: { x: 250, y: 200, w: 150 },
  review_required: { x: 580, y: 70, w: 200 },
  suspended: { x: 580, y: 200, w: 150 },
  revoked: { x: 580, y: 330, w: 150 },
} as const;

const edges: {
  d: string;
  label: string;
  clause: string;
  lx: number;
  ly: number;
  anchor?: "start" | "middle" | "end";
  /** Put the clause on its own line under the label. */
  stack?: boolean;
}[] = [
  {
    d: "M 74 200 L 173 200",
    label: "issue",
    clause: "STD-07 §2.2",
    lx: 124,
    ly: 190,
  },
  {
    d: "M 300 178 Q 380 70 478 70",
    label: "unrenewed or policy fires",
    clause: "§1.2, §2.4–2.5",
    lx: 350,
    ly: 96,
    anchor: "start",
  },
  {
    d: "M 482 90 Q 420 160 327 180",
    label: "renewed or confirmed",
    clause: "§1.1, §2.4",
    lx: 405,
    ly: 152,
    anchor: "start",
  },
  {
    d: "M 325 195 L 503 195",
    label: "revocation condition",
    clause: "",
    lx: 414,
    ly: 186,
  },
  {
    d: "M 503 210 Q 414 244 325 212",
    label: "reinstated",
    clause: "state_history",
    lx: 414,
    ly: 250,
  },
  {
    d: "M 300 222 Q 380 330 503 330",
    label: "revocation condition",
    clause: "",
    lx: 340,
    ly: 318,
    anchor: "start",
  },
  {
    d: "M 664 92 Q 700 200 660 308",
    label: "revoked by the issuer",
    clause: "issuing_authority",
    lx: 672,
    ly: 200,
    anchor: "start",
    stack: true,
  },
];
---

<figure class="state-diagram" aria-labelledby="grant-state-title">
  <figcaption>
    <p class="eyebrow">State machine</p>
    <h3 id="grant-state-title">
      The four states a grant can be in, and how it moves between them
    </h3>
    <p class="muted">
      Only <strong>allowed</strong> authorizes action. Every other state is a form
      of the burden of proof having moved back to the issuer. State is not mode: a
      grant in <em>allowed</em> with mode <em>confirm</em> is in force and still asks
      a human before each action. Edges cite the STD-08 clause that requires them.
      Three the text leaves to the grant object: its
      <code>revocation_conditions</code> lead to suspended or revoked, the
      <code>issuing_authority</code> can revoke a grant under review that it will
      not confirm, and reinstatement is a recorded transition in
      <code>state_history</code>.
    </p>
  </figcaption>
  <div class="diagram-scroll">
    <svg
      viewBox="0 0 830 400"
      role="img"
      aria-label="Grant state diagram: issue moves a grant to allowed; an unexamined renewal or a policy that fires or expires moves it to review required, and renewal or confirmation returns it; a revocation condition moves it to suspended or revoked; the issuing authority can revoke a grant under review; a suspended grant reinstated is recorded as a transition."
      class="state-diagram__svg"
    >
      <defs>
        <marker
          id="grant-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor"></path>
        </marker>
      </defs>

      {
        edges.map((e) => (
          <g class="state-diagram__edge">
            <path
              d={e.d}
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              marker-end="url(#grant-arrow)"
            />
            <text
              x={e.lx}
              y={e.ly}
              text-anchor={e.anchor ?? "middle"}
              class="state-diagram__label"
            >
              {e.label}
              {e.clause && (
                <tspan
                  class="state-diagram__clause"
                  x={e.stack ? e.lx : undefined}
                  dy={e.stack ? 14 : undefined}
                >
                  {e.stack ? e.clause : ` ${e.clause}`}
                </tspan>
              )}
            </text>
          </g>
        ))
      }

      <g class="state-diagram__node state-diagram__node--origin">
        <circle cx={nodes.none.x} cy={nodes.none.y} r="14"></circle>
        <text
          x={nodes.none.x}
          y={nodes.none.y + 34}
          text-anchor="middle"
          class="state-diagram__label">none</text
        >
      </g>

      {
        DIAGRAM_STATES.map((state) => {
          const n = nodes[state];
          const inForce = state === "allowed";
          return (
            <g
              class:list={[
                "state-diagram__node",
                { "state-diagram__node--active": inForce },
              ]}
            >
              <rect
                x={n.x - n.w / 2}
                y={n.y - 22}
                width={n.w}
                height="44"
                rx="22"
              />
              <text
                x={n.x}
                y={n.y + 5}
                text-anchor="middle"
                class="state-diagram__state"
              >
                {labels[state]}
              </text>
            </g>
          );
        })
      }
    </svg>
  </div>
  <p class="muted small">
    States are read from <code>authority-grant.schema.json</code>
    ({stateEnum.join(", ")}); the diagram cannot show one the object cannot be
    in.
  </p>
</figure>
