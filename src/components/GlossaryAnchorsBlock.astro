---
import SectionBlock from "./SectionBlock.astro";

type AnchorLink = {
  label: string;
  href: string;
};

type AnchorItem = {
  links: AnchorLink[];
};

const {
  id = "glossary-anchors",
  eyebrow = "Glossary anchors",
  title = "Glossary anchors used",
  description = "Glossary terms that bind this example's clocks, artifacts, and ownership.",
  variant,
} = Astro.props;

const anchors: AnchorItem[] = [
  {
    links: [
      { label: "Time transparency", href: "/glossary/time-transparency" },
    ],
  },
  {
    links: [
      { label: "Stable clock", href: "/glossary/stable-clock" },
      { label: "Bounded duration", href: "/glossary/bounded-duration" },
    ],
  },
  {
    links: [
      { label: "Decision artifact", href: "/glossary/decision-artifact" },
    ],
  },
  {
    links: [
      { label: "Traceable ownership", href: "/glossary/traceable-ownership" },
    ],
  },
  {
    links: [{ label: "Safe pause", href: "/glossary/safe-pause" }],
  },
  {
    links: [
      { label: "Time-to-restore (TTR)", href: "/glossary/time-to-restore" },
    ],
  },
  {
    links: [{ label: "Time-to-halt (TTH)", href: "/glossary/time-to-halt" }],
  },
  {
    links: [
      { label: "Appeal passage rate", href: "/glossary/appeal-passage-rate" },
    ],
  },
];
---

<SectionBlock
  id={id}
  eyebrow={eyebrow}
  title={title}
  description={description}
  variant={variant}
>
  <ul class="muted">
    {
      anchors.map((anchor) => (
        <li>
          {anchor.links.map((link, index) => (
            <>
              <a href={link.href}>{link.label}</a>
              {index < anchor.links.length - 1 && " / "}
            </>
          ))}
        </li>
      ))
    }
  </ul>
</SectionBlock>
