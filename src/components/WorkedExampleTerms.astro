---
/**
 * The glossary terms that bind a worked scenario's clocks, records, and
 * ownership, as one line for its "Where this fits" box.
 *
 * This was GlossaryAnchorsBlock, a section of its own with a heading, an
 * eyebrow, and a description over its links. The links were the only
 * content, so they moved into the fit box as a line.
 */
const terms = [
  { label: "Binding clock", href: "/glossary/binding-clock" },
  { label: "Decision object", href: "/glossary/decision-object" },
  { label: "Authority grant", href: "/glossary/authority-grant" },
  { label: "Safe pause", href: "/glossary/safe-pause" },
  { label: "Time to restore (TTR)", href: "/glossary/time-to-restore" },
  { label: "Time to halt (TTH)", href: "/glossary/time-to-halt" },
  { label: "Appeal passage rate", href: "/glossary/appeal-passage-rate" },
];
---

<p class="small">
  Terms used:
  {
    terms.map((term) => (
      <span class="worked-example-terms__term">
        <a href={term.href}>{term.label}</a>
      </span>
    ))
  }
</p>

<style>
  /* Each term is its own inline-flex box, so the markup's whitespace cannot
     land before the comma that follows it. */
  .worked-example-terms__term {
    display: inline-flex;
  }

  .worked-example-terms__term:not(:last-child)::after {
    content: ",";
  }
</style>
