---
/**
 * The governance-mechanism completions, one row per interlocutor: the
 * mechanism they prefer, what Ethotechnics adds to it without replacing it,
 * and what the addition makes testable. Rendered on the About page and in
 * the scholarly crossings research note.
 */
import { completions } from "../../content/positioning";
---

<div class="mapping-table__wrapper">
  <table
    class="mapping-table mapping-table--stack mapping-table--compare lineage__table"
  >
    <thead>
      <tr>
        <th scope="col">Interlocutor</th>
        <th scope="col">What Ethotechnics adds</th>
        <th scope="col">What it makes testable</th>
      </tr>
    </thead>
    <tbody>
      {
        completions.map((row) => (
          <tr>
            <th scope="row" data-label="Interlocutor">
              {row.interlocutor}
              <span class="lineage__works small muted">{row.mechanism}</span>
            </th>
            <td data-label="What Ethotechnics adds">{row.addition}</td>
            <td data-label="What it makes testable">{row.testable}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
