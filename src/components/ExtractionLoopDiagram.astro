---
/**
 * Fail-Silent Absorption Loop Diagram.
 *
 * Visualizes the self-concealing feedback loop of corrective labor (extraction by endurance):
 * Model Failure -> Human Absorption -> Evidence Erasure -> Dashboard Health -> Scope Expansion -> Compounding Fragility.
 */
interface Props {
  level?: "h2" | "h3";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;
---

<figure class="state-diagram" aria-labelledby="extraction-loop-title">
  <figcaption>
    <p class="eyebrow">Theory, drawn</p>
    <Heading id="extraction-loop-title">
      The Fail-Silent Feedback Loop of Uncounted Absorption
    </Heading>
    <p class="muted">
      Competently absorbing a failure erases the evidence that it occurred. Clean dashboards cannot be read as health until absorption is measured separately.
    </p>
  </figcaption>

  <div class="diagram-scroll">
    <svg
      viewBox="0 0 920 420"
      role="img"
      class="state-diagram__svg"
      aria-label="Feedback loop showing model error leading to human absorption, evidence erasure, clean dashboard illusion, scope expansion, and compounding fragility, intercepted by procedural standing."
    >
      <defs>
        <marker
          id="loop-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--border)" />
        </marker>
        <marker
          id="standing-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
      </defs>

      {/* Top Forward Path */}
      <line x1="216" y1="216" x2="243" y2="216" stroke="var(--border)" stroke-width="2" marker-end="url(#loop-arrow)" />
      <line x1="444" y1="216" x2="471" y2="216" stroke="var(--border)" stroke-width="2" marker-end="url(#loop-arrow)" />
      <line x1="672" y1="216" x2="699" y2="216" stroke="var(--border)" stroke-width="2" marker-end="url(#loop-arrow)" />

      {/* Return Loop Down to Bottom and Back */}
      <line x1="802" y1="268" x2="802" y2="309" stroke="var(--border)" stroke-width="2" marker-end="url(#loop-arrow)" />
      <line x1="704" y1="359" x2="255" y2="359" stroke="var(--border)" stroke-width="2" marker-end="url(#loop-arrow)" />
      <line x1="118" y1="314" x2="118" y2="273" stroke="var(--border)" stroke-width="2" marker-end="url(#loop-arrow)" />

      {/* Step 1: Model Error */}
      <g class="state-diagram__node" transform="translate(20, 164)">
        <rect width="196" height="104" rx="8" />
        <text x="98" y="30" text-anchor="middle" class="state-diagram__state">1. Model Error</text>
        <text x="98" y="54" text-anchor="middle" class="state-diagram__label">Unrepresented edge case</text>
        <text x="98" y="72" text-anchor="middle" class="state-diagram__label">or ambiguous output</text>
      </g>

      {/* Step 2: Human Absorption */}
      <g class="state-diagram__node state-diagram__node--active" transform="translate(248, 164)">
        <rect width="196" height="104" rx="8" />
        <text x="98" y="30" text-anchor="middle" class="state-diagram__state" fill="var(--accent-strong)">2. Human Absorption</text>
        <text x="98" y="54" text-anchor="middle" class="state-diagram__label">Workaround, re-entry,</text>
        <text x="98" y="72" text-anchor="middle" class="state-diagram__label">manual override</text>
      </g>

      {/* Step 3: Evidence Erasure */}
      <g class="state-diagram__node" transform="translate(476, 164)">
        <rect width="196" height="104" rx="8" />
        <text x="98" y="30" text-anchor="middle" class="state-diagram__state">3. Evidence Erasure</text>
        <text x="98" y="54" text-anchor="middle" class="state-diagram__label">Failure resolved before</text>
        <text x="98" y="72" text-anchor="middle" class="state-diagram__label">instrument looks</text>
        <text x="98" y="90" text-anchor="middle" class="state-diagram__label">(fail-silent)</text>
      </g>

      {/* Step 4: Metric Improvement */}
      <g class="state-diagram__node" transform="translate(704, 164)">
        <rect width="196" height="104" rx="8" />
        <text x="98" y="30" text-anchor="middle" class="state-diagram__state">4. Metric Health</text>
        <text x="98" y="54" text-anchor="middle" class="state-diagram__label">Dashboard shows 99.9%</text>
        <text x="98" y="72" text-anchor="middle" class="state-diagram__clause">Falsified Denominator</text>
      </g>

      {/* Step 5: Scope Expansion */}
      <g class="state-diagram__node" transform="translate(704, 314)">
        <rect width="196" height="90" rx="8" />
        <text x="98" y="30" text-anchor="middle" class="state-diagram__state">5. Scope Expansion</text>
        <text x="98" y="54" text-anchor="middle" class="state-diagram__label">Authority widened on</text>
        <text x="98" y="72" text-anchor="middle" class="state-diagram__label">uncounted human labor</text>
      </g>

      {/* Step 6: Compounding Fragility */}
      <g class="state-diagram__node" transform="translate(20, 314)">
        <rect width="235" height="90" rx="8" />
        <text x="117" y="30" text-anchor="middle" class="state-diagram__state">6. Deepened Fragility</text>
        <text x="117" y="54" text-anchor="middle" class="state-diagram__label">Absorptive capacity strained;</text>
        <text x="117" y="72" text-anchor="middle" class="state-diagram__label">system harder to exit/replace</text>
      </g>

      {/* The Intercept: Law VII Procedural Standing */}
      <line
        x1="346"
        y1="164"
        x2="346"
        y2="129"
        stroke="var(--accent)"
        stroke-width="2"
        stroke-dasharray="4 4"
        marker-end="url(#standing-arrow)"
      />
      <g transform="translate(216, 10)">
        <rect width="260" height="114" rx="8" fill="var(--panel)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="130" y="30" text-anchor="middle" class="state-diagram__clause">Law VII: Procedural Standing</text>
        <text x="130" y="54" text-anchor="middle" class="state-diagram__state">Breaks the Loop</text>
        <text x="130" y="78" text-anchor="middle" class="state-diagram__label">Converts silent absorption</text>
        <text x="130" y="96" text-anchor="middle" class="state-diagram__label">into state-transitioning event</text>
      </g>
    </svg>
  </div>
</figure>
