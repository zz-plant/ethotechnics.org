---
import Search from "../Search.astro";
import { Icon } from "astro-icon/components";
import { navSections } from "../../content/navigation";
import {
  getAriaCurrent,
  isHashLink,
  isSameDocumentHashLink,
  normalizePath,
} from "../../utils/navigation";

interface Props {
  currentPath: string;
  currentHash?: string;
}

const { currentPath, currentHash = "" }: Props = Astro.props;
const isStart = normalizePath(currentPath) === "/start";
---

<nav class="nav__mobile" aria-label="Main navigation">
  <div class="nav__mobile-bar">
    <div class="nav__search-mobile">
      <Search scope="mobile" label="Search" includeDialog={true} />
    </div>

    {
      /* "Start here" sits in the bar and the theme switch in the drawer. The
         theme toggle used to hold this spot, beside search, and took 9-18% of
         predicted first-screen taps on a phone; the way in for a new reader
         was two taps deep. The drawer below it no longer opens on a second
         copy of the same link. */
    }
    <a
      href="/start"
      class="nav__mobile-start"
      aria-current={isStart ? "page" : undefined}>Start here</a
    >

    <details
      class="nav__mobile-sections"
      name="mobile-sections"
      data-mobile-nav
    >
      <summary class="nav__mobile-sections-summary">
        <span class="nav__mobile-summary-text">Browse</span>
        <Icon name="lucide:chevron-down" class="nav__mobile-summary-icon" />
      </summary>

      <div class="nav__mobile-drawer">
        <div class="nav__mobile-section-groups">
          {
            navSections.map((section) => (
              <div class="nav__mobile-group">
                <p class="eyebrow nav__mobile-group-title">
                  {section.href ? (
                    <a
                      href={section.href}
                      aria-current={getAriaCurrent(
                        section.href,
                        currentPath,
                        currentHash,
                      )}
                    >
                      {section.heading}
                    </a>
                  ) : (
                    section.heading
                  )}
                </p>
                <div class="nav__mobile-group-links">
                  {section.links.map((link) => (
                    <a
                      class="nav__mobile-link-card"
                      href={link.href}
                      aria-label={
                        isHashLink(link.href)
                          ? `${link.label}, jumps to a homepage section`
                          : link.label
                      }
                      data-nav-hash-link={
                        isSameDocumentHashLink(link.href) ? "true" : undefined
                      }
                      aria-current={getAriaCurrent(
                        link.href,
                        currentPath,
                        currentHash,
                      )}
                    >
                      <span class="nav__mobile-link-title">{link.label}</span>
                      {link.description && (
                        <span class="nav__mobile-link-desc">
                          {link.description}
                        </span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <div class="nav__mobile-theme">
          <button
            class="theme-toggle nav__mobile-theme-toggle"
            data-theme-toggle
            aria-label="Toggle theme"
            type="button"
          >
            <Icon
              name="lucide:sun"
              class="theme-toggle__icon theme-toggle__icon--sun"
            />
            <Icon
              name="lucide:moon"
              class="theme-toggle__icon theme-toggle__icon--moon"
            />
          </button>
          <span aria-hidden="true">Light or dark theme</span>
        </div>
      </div>
    </details>
  </div>
</nav>
