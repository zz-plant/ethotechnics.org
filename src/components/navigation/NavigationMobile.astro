---
import NavUtilityLinks from "../NavUtilityLinks.astro";
import Search from "../Search.astro";
import {
  navUtilityMobilePrimaryLinks,
  type NavLink,
} from "../../content/navigation";
import {
  getAriaCurrent,
  isHashLink,
  isSameDocumentHashLink,
  toViewTransitionName,
} from "../../utils/navigation";

interface Props {
  currentPath: string;
  currentHash?: string;
  mobileLinks: NavLink[];
}

const { currentPath, currentHash = "", mobileLinks } = Astro.props as Props;

const featuredMobileLinks = mobileLinks.filter((link) => link.mobileFeatured);
const overflowMobileLinks = mobileLinks.filter((link) => !link.mobileFeatured);

const currentPrimaryLink = mobileLinks.find((link) => {
  const ariaCurrent = getAriaCurrent(link.href, currentPath, currentHash);
  return ariaCurrent === "page" || ariaCurrent === "location";
});

const showCurrentPageChip = Boolean(
  currentPrimaryLink && !featuredMobileLinks.includes(currentPrimaryLink),
);
const hasOverflowMobileLinks = overflowMobileLinks.length > 0;
---

<div class="nav__mobile" aria-label="Main navigation">
  <div class="nav__mobile-row">
    <div class="nav__mobile-top">
      <div class="nav__search-mobile" aria-label="Search">
        <Search scope="mobile" label="Search" includeDialog={false} />
      </div>

      <div class="nav__utility-inline" aria-label="Quick start">
        <NavUtilityLinks
          currentPath={currentPath}
          links={navUtilityMobilePrimaryLinks}
        />
      </div>
    </div>

    {
      showCurrentPageChip && currentPrimaryLink ? (
        <p class="nav__current-page-chip" aria-live="polite">
          <span class="nav__current-page-label">Current page:</span>{" "}
          <a
            class="nav__current-page-link"
            href={currentPrimaryLink.href}
            aria-current={getAriaCurrent(
              currentPrimaryLink.href,
              currentPath,
              currentHash,
            )}
          >
            {currentPrimaryLink.label}
          </a>
        </p>
      ) : null
    }

    <div class="nav__links nav__links--mobile nav__links--mobile-compact">
      {
        featuredMobileLinks.map((link) => (
          <a
            class="nav__link"
            href={link.href}
            aria-label={
              isHashLink(link.href)
                ? `${link.label}, jumps to a homepage section`
                : link.label
            }
            title={
              isHashLink(link.href)
                ? "Jumps to a section on the homepage"
                : undefined
            }
            data-nav-hash-link={
              isSameDocumentHashLink(link.href) ? "true" : undefined
            }
            aria-current={getAriaCurrent(link.href, currentPath, currentHash)}
            style={`view-transition-name: ${toViewTransitionName(
              link.href,
              "mobile",
            )};`}
          >
            <span class="nav__link-label">{link.label}</span>
          </a>
        ))
      }
    </div>

    {
      hasOverflowMobileLinks ? (
        <details class="nav__primary-disclosure" aria-label="More pages">
          <summary>More pages</summary>
          <div class="nav__links nav__links--mobile">
            {overflowMobileLinks.map((link) => (
              <a
                class="nav__link"
                href={link.href}
                aria-label={
                  isHashLink(link.href)
                    ? `${link.label}, jumps to a homepage section`
                    : link.label
                }
                title={
                  isHashLink(link.href)
                    ? "Jumps to a section on the homepage"
                    : undefined
                }
                data-nav-hash-link={
                  isSameDocumentHashLink(link.href) ? "true" : undefined
                }
                aria-current={getAriaCurrent(
                  link.href,
                  currentPath,
                  currentHash,
                )}
                style={`view-transition-name: ${toViewTransitionName(
                  link.href,
                  "mobile",
                )};`}
              >
                <span class="nav__link-label">{link.label}</span>
                {link.description ? (
                  <span class="nav__link-detail">{link.description}</span>
                ) : null}
              </a>
            ))}
          </div>
        </details>
      ) : null
    }
  </div>
</div>
