---
import { Icon } from "astro-icon/components";
import { navSections } from "../../content/navigation";
import { getAriaCurrent, isSectionCurrent } from "../../utils/navigation";

interface Props {
  currentPath: string;
  currentHash?: string;
}

const { currentPath, currentHash = "" }: Props = Astro.props;
const activeSectionIndex = navSections.findIndex((section) =>
  isSectionCurrent(section, currentPath),
);
---

<dialog
  id="nav-drawer"
  class="nav-drawer"
  aria-labelledby="nav-drawer-title"
  data-nav-drawer
>
  <div class="nav-drawer__scroller" data-nav-drawer-scroller>
    <div class="nav-drawer__sheet" data-nav-drawer-sheet>
      <div class="nav-drawer__header">
        <p id="nav-drawer-title" class="nav-drawer__title">Menu</p>
        <button
          type="button"
          class="nav-drawer__close"
          aria-label="Close menu"
          autofocus
          data-nav-drawer-close
        >
          <Icon
            name="lucide:x"
            class="nav-drawer__close-icon"
            aria-hidden="true"
          />
        </button>
      </div>

      <nav class="nav-drawer__body" aria-label="Site sections">
        {
          navSections.map((section, index) => {
            const panelId = `nav-drawer-panel-${section.id}`;
            const isActive = index === activeSectionIndex;
            const defaultOpen =
              isActive || (activeSectionIndex === -1 && index === 0);

            return (
              <div
                class="nav-drawer__section"
                data-drawer-section
                data-default-open={defaultOpen ? "true" : "false"}
              >
                <button
                  type="button"
                  class="nav-drawer__section-trigger"
                  aria-expanded="true"
                  aria-controls={panelId}
                  data-drawer-accordion-trigger
                  data-section-active={isActive ? "true" : undefined}
                >
                  <span class="nav-drawer__section-heading">
                    {section.heading}
                  </span>
                  <Icon
                    name="lucide:chevron-down"
                    class="nav-drawer__section-chevron"
                    aria-hidden="true"
                  />
                </button>

                <div
                  id={panelId}
                  class="nav-drawer__section-panel"
                  data-drawer-accordion-panel
                >
                  <p class="nav-drawer__section-desc">{section.description}</p>
                  <ul class="nav-drawer__links">
                    {section.href && (
                      <li>
                        <a
                          class="nav-drawer__link nav-drawer__link--hub"
                          href={section.href}
                          aria-current={getAriaCurrent(
                            section.href,
                            currentPath,
                            currentHash,
                          )}
                        >
                          <span class="nav-drawer__link-title">
                            <span>{section.heading}</span>
                            <Icon
                              name="lucide:arrow-right"
                              class="nav-drawer__hub-icon"
                              aria-hidden="true"
                            />
                          </span>
                        </a>
                      </li>
                    )}
                    {section.links.map((link) => (
                      <li>
                        <a
                          class="nav-drawer__link"
                          href={link.href}
                          aria-current={getAriaCurrent(
                            link.href,
                            currentPath,
                            currentHash,
                          )}
                        >
                          <span class="nav-drawer__link-title">
                            {link.label}
                          </span>
                          {link.description && (
                            <span class="nav-drawer__link-desc">
                              {link.description}
                            </span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })
        }
      </nav>

      <div class="nav-drawer__footer">
        <button
          class="nav-drawer__theme-btn"
          data-theme-toggle
          aria-label="Toggle theme"
          type="button"
        >
          <span class="nav-drawer__theme-icons" aria-hidden="true">
            <Icon
              name="lucide:sun"
              class="theme-toggle__icon theme-toggle__icon--sun"
            />
            <Icon
              name="lucide:moon"
              class="theme-toggle__icon theme-toggle__icon--moon"
            />
          </span>
          <span class="nav-drawer__theme-text" data-theme-toggle-text>
            Switch theme
          </span>
        </button>
      </div>
    </div>
  </div>
</dialog>
