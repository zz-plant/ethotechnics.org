---
import NavUtilityLinks from "../NavUtilityLinks.astro";
import Search from "../Search.astro";
import { Icon } from "astro-icon/components";
import {
  navUtilityMobilePrimaryLinks,
  type NavLink,
} from "../../content/navigation";
import {
  getAriaCurrent,
  isHashLink,
  isSameDocumentHashLink,
} from "../../utils/navigation";

interface Props {
  currentPath: string;
  currentHash?: string;
  mobileLinks: NavLink[];
}

const { currentPath, currentHash = "", mobileLinks }: Props = Astro.props;

---

<nav class="nav__mobile" aria-label="Main navigation">
  <div class="nav__mobile-row">
    <div class="nav__mobile-top">
      <div class="nav__search-mobile">
        <Search scope="mobile" label="Search" includeDialog={false} />
      </div>

      <div class="nav__utility-inline">
        <NavUtilityLinks
          currentPath={currentPath}
          links={navUtilityMobilePrimaryLinks}
        />
        <button
          class="theme-toggle"
          data-theme-toggle
          aria-label="Toggle theme"
          type="button"
        >
          <Icon name="lucide:sun" class="theme-toggle__icon theme-toggle__icon--sun" />
          <Icon name="lucide:moon" class="theme-toggle__icon theme-toggle__icon--moon" />
        </button>
      </div>
    </div>

    <details class="nav__mobile-sections" name="mobile-sections" data-mobile-nav>
      <summary class="nav__mobile-sections-summary">Browse sections</summary>
      <div class="nav__links nav__links--mobile nav__links--mobile-compact">
        {
          mobileLinks.map((link) => (
            <a
              class="nav__link"
              href={link.href}
              aria-label={
                isHashLink(link.href)
                  ? `${link.label}, jumps to a homepage section`
                  : link.label
              }
              title={
                isHashLink(link.href)
                  ? "Jumps to a section on the homepage"
                  : undefined
              }
              data-nav-hash-link={
                isSameDocumentHashLink(link.href) ? "true" : undefined
              }
              aria-current={getAriaCurrent(link.href, currentPath, currentHash)}
            >
              <span class="nav__link-label">{link.label}</span>
            </a>
          ))
        }
      </div>
    </details>
  </div>
</nav>
