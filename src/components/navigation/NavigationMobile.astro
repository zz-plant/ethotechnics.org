---
import NavUtilityLinks from "../NavUtilityLinks.astro";
import Search from "../Search.astro";
import type { NavLink } from "../../content/navigation";
import {
  getAriaCurrent,
  isHashLink,
  toViewTransitionName,
} from "../../utils/navigation";

interface Props {
  currentPath: string;
  mobileLinks: NavLink[];
}

const { currentPath, mobileLinks } = Astro.props as Props;

const featuredMobileLinks = mobileLinks.slice(0, 3);
const overflowMobileLinks = mobileLinks.slice(featuredMobileLinks.length);
const hasOverflowMobileLinks = overflowMobileLinks.length > 0;

const primaryUtilityLinks = [
  {
    href: "/start-here",
    label: "Start here",
    class: "nav__utility-link nav__utility-link--primary",
    icon: "lucide:arrow-right",
  },
];

const secondaryUtilityLinks = [
  {
    href: "https://github.com/zz-plant/ethotechnics",
    label: "GitHub",
    class: "nav__utility-link nav__utility-link--quiet",
    rel: "noopener noreferrer",
    target: "_blank",
    icon: "lucide:github",
  },
  {
    href: "/participate#feedback",
    label: "Send feedback",
    class: "nav__utility-link nav__utility-link--quiet",
    icon: "lucide:message-circle",
  },
  {
    href: "https://ethotechnics.com/studio",
    label: "Ethotechnics Studio",
    class: "nav__utility-link",
    rel: "noopener noreferrer",
    target: "_blank",
    icon: "lucide:arrow-up-right",
  },
];
---

<div class="nav__mobile" aria-label="Primary">
  <div class="nav__mobile-row">
    <div class="nav__mobile-top">
      <div class="nav__search-mobile" aria-label="Search">
        <Search scope="mobile" label="Search" />
      </div>

      <div class="nav__utility-inline" aria-label="Primary utility link">
        <NavUtilityLinks
          currentPath={currentPath}
          links={primaryUtilityLinks}
        />
      </div>

      <details class="nav__utility-disclosure">
        <summary>More links</summary>
        <div
          class="nav__utility nav__utility--mobile"
          aria-label="Utility links"
        >
          <NavUtilityLinks
            currentPath={currentPath}
            links={secondaryUtilityLinks}
          />
        </div>
      </details>
    </div>

    <p class="nav__mobile-hint muted small" aria-live="polite">
      Common destinations
    </p>
    <div class="nav__links nav__links--mobile nav__links--mobile-compact">
      {
        featuredMobileLinks.map((link) => (
          <a
            class="nav__link"
            href={link.href}
            aria-label={
              isHashLink(link.href)
                ? `${link.label}, jumps to a homepage section`
                : link.label
            }
            title={
              isHashLink(link.href)
                ? "Jumps to a section on the homepage"
                : undefined
            }
            aria-current={getAriaCurrent(link.href, currentPath)}
            style={`view-transition-name: ${toViewTransitionName(
              link.href,
              "mobile",
            )};`}
          >
            <span class="nav__link-label">{link.label}</span>
          </a>
        ))
      }
    </div>

    {
      hasOverflowMobileLinks ? (
        <details
          class="nav__primary-disclosure"
          aria-label="More primary routes"
        >
          <summary>More routes · {overflowMobileLinks.length}</summary>
          <div class="nav__links nav__links--mobile">
            {overflowMobileLinks.map((link) => (
              <a
                class="nav__link"
                href={link.href}
                aria-label={
                  isHashLink(link.href)
                    ? `${link.label}, jumps to a homepage section`
                    : link.label
                }
                title={
                  isHashLink(link.href)
                    ? "Jumps to a section on the homepage"
                    : undefined
                }
                aria-current={getAriaCurrent(link.href, currentPath)}
                style={`view-transition-name: ${toViewTransitionName(
                  link.href,
                  "mobile",
                )};`}
              >
                <span class="nav__link-label">{link.label}</span>
                {link.description ? (
                  <span class="nav__link-detail">{link.description}</span>
                ) : null}
              </a>
            ))}
          </div>
        </details>
      ) : null
    }
  </div>
</div>
