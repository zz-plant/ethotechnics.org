---
import Logo from "../Logo.astro";
import Wordmark from "../Wordmark.astro";
import Search from "../Search.astro";
import { Icon } from "astro-icon/components";
import type { NavLink } from "../../content/navigation";
import { navSections } from "../../content/navigation";
import {
  getAriaCurrent,
  isHashLink,
  isSameDocumentHashLink,
  normalizePath,
} from "../../utils/navigation";

interface Props {
  currentPath: string;
  currentHash?: string;
  desktopLinks: NavLink[];
}

const { currentPath, currentHash = "", desktopLinks }: Props = Astro.props;
const isHome = normalizePath(currentPath) === "/";
const isStart = normalizePath(currentPath) === "/start";
---

<div class="nav__bar">
  <a
    href="/"
    class="nav__brand"
    aria-label="Go to the homepage"
    aria-current={isHome ? "page" : undefined}
  >
    <Logo class="nav__brand-logo" title="Ethotechnics" />
    <Wordmark class="nav__wordmark" ariaHidden={true} />
  </a>

  <nav class="nav__links nav__links--desktop" aria-label="Primary">
    {
      desktopLinks.map((link) => (
        <a
          class="nav__link"
          href={link.href}
          aria-label={
            isHashLink(link.href)
              ? `${link.label}, jumps to a homepage section`
              : link.label
          }
          title={
            isHashLink(link.href)
              ? "Jumps to a section on the homepage"
              : undefined
          }
          data-nav-hash-link={
            isSameDocumentHashLink(link.href) ? "true" : undefined
          }
          aria-current={getAriaCurrent(link.href, currentPath, currentHash)}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  {
    /*
    The four sections and their twenty described links used to render only in
    the mobile drawer, so the widest viewport saw the least: five bare labels
    and no descriptions. This panel puts the same map on desktop without
    hiding the primary links behind a hover menu — the bar stays a fast path,
    this is the full view. A <details> element carries the open state, so it
    works from the keyboard and before any script runs, which is the pattern
    the mobile drawer already uses.
  */
  }
  <details class="nav__browse" data-nav-browse>
    <summary class="nav__browse-summary">
      <span>Browse</span>
      <Icon name="lucide:chevron-down" class="nav__browse-chevron" />
    </summary>

    <div class="nav__browse-panel">
      <div class="nav__browse-grid">
        {
          navSections.map((section) => (
            <div class="nav__browse-group">
              <p class="nav__browse-group-title">{section.heading}</p>
              <p class="nav__browse-group-desc">{section.description}</p>
              <ul class="nav__browse-links">
                {section.links.map((link) => (
                  <li>
                    <a
                      class="nav__browse-link"
                      href={link.href}
                      aria-current={getAriaCurrent(
                        link.href,
                        currentPath,
                        currentHash,
                      )}
                    >
                      <span class="nav__browse-link-title">{link.label}</span>
                      {link.description && (
                        <span class="nav__browse-link-desc">
                          {link.description}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </details>

  <div class="nav__actions-desktop">
    <a
      href="/start"
      class:list={["nav__start-btn", { "nav__start-btn--active": isStart }]}
      aria-current={isStart ? "page" : undefined}
    >
      <span>Start here</span>
    </a>

    <div class="nav__search-desktop">
      <Search scope="desktop" label="Search" shortcut="⌘K" />
    </div>

    <a
      class="nav__icon-btn"
      href="https://github.com/zz-plant/ethotechnics.org"
      rel="noopener noreferrer"
      target="_blank"
      aria-label="GitHub repository"
      title="GitHub repository"
    >
      <Icon name="lucide:github" class="nav__icon" />
    </a>

    <button
      class="theme-toggle"
      data-theme-toggle
      aria-label="Toggle theme"
      type="button"
    >
      <Icon
        name="lucide:sun"
        class="theme-toggle__icon theme-toggle__icon--sun"
      />
      <Icon
        name="lucide:moon"
        class="theme-toggle__icon theme-toggle__icon--moon"
      />
    </button>
  </div>
</div>
