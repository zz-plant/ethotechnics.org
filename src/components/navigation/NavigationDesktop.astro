---
import Logo from "../Logo.astro";
import NavUtilityLinks from "../NavUtilityLinks.astro";
import Wordmark from "../Wordmark.astro";
import Search from "../Search.astro";
import { Icon } from "astro-icon/components";
import type { NavLink } from "../../content/navigation";
import {
  getAriaCurrent,
  isHashLink,
  isSameDocumentHashLink,
  normalizePath,
} from "../../utils/navigation";

interface Props {
  currentPath: string;
  currentHash?: string;
  desktopLinks: NavLink[];
}

const { currentPath, currentHash = "", desktopLinks }: Props = Astro.props;
const isHome = normalizePath(currentPath) === "/";
---

<div class="nav__bar">
  <a
    href="/"
    class="nav__brand"
    aria-label="Go to the homepage"
    aria-current={isHome ? "page" : undefined}
  >
    <Logo class="nav__brand-logo" title="Ethotechnics" />
    <Wordmark class="nav__wordmark" ariaHidden={true} />
  </a>

  <nav class="nav__links nav__links--desktop" aria-label="Primary">
    {
      desktopLinks.map((link) => (
        <a
          class="nav__link"
          href={link.href}
          aria-label={
            isHashLink(link.href)
              ? `${link.label}, jumps to a homepage section`
              : link.label
          }
          title={isHashLink(link.href) ? "Jumps to a section on the homepage" : undefined}
          data-nav-hash-link={isSameDocumentHashLink(link.href) ? "true" : undefined}
          aria-current={getAriaCurrent(link.href, currentPath, currentHash)}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="nav__search-desktop">
    <Search scope="desktop" label="Search standards, diagnostics, and guides" />
  </div>

  <div class="nav__utility nav__utility--desktop">
    <NavUtilityLinks currentPath={currentPath} />
    <button
      class="theme-toggle"
      data-theme-toggle
      aria-label="Toggle theme"
      type="button"
    >
      <Icon name="lucide:sun" class="theme-toggle__icon theme-toggle__icon--sun" />
      <Icon name="lucide:moon" class="theme-toggle__icon theme-toggle__icon--moon" />
    </button>
  </div>
</div>
