---
import { Icon } from "astro-icon/components";
import { navSections } from "../../content/navigation";
import { getAriaCurrent, isSectionCurrent } from "../../utils/navigation";

interface Props {
  currentPath: string;
  currentHash?: string;
}

const { currentPath, currentHash = "" }: Props = Astro.props;
---

<nav class="nav__primary" aria-label="Primary">
  <ul class="nav__sections">
    {
      navSections.map((section) => {
        const panelId = `nav-panel-${section.id}`;
        const isActive = isSectionCurrent(section, currentPath);

        return (
          <li class="nav__section-item" data-nav-section>
            <button
              type="button"
              class="nav__section-trigger"
              popovertarget={panelId}
              popovertargetaction="toggle"
              aria-controls={panelId}
              aria-expanded="false"
              data-nav-trigger
              data-section-active={isActive ? "true" : undefined}
            >
              <span>{section.heading}</span>
              <Icon
                name="lucide:chevron-down"
                class="nav__chevron"
                aria-hidden="true"
              />
            </button>

            <div
              id={panelId}
              class="nav__popover"
              popover="auto"
              data-nav-popover
            >
              <div class="nav__popover-surface">
                <div class="nav__popover-header">
                  {section.href ? (
                    <a
                      class="nav__popover-hub"
                      href={section.href}
                      aria-current={getAriaCurrent(
                        section.href,
                        currentPath,
                        currentHash,
                      )}
                    >
                      <span>{section.heading}</span>
                      <Icon
                        name="lucide:arrow-right"
                        class="nav__popover-hub-icon"
                        aria-hidden="true"
                      />
                    </a>
                  ) : (
                    <p class="nav__popover-heading">{section.heading}</p>
                  )}
                  <p class="nav__popover-desc">{section.description}</p>
                </div>

                <ul class="nav__popover-list">
                  {section.links.map((link) => (
                    <li>
                      <a
                        class="nav__popover-link"
                        href={link.href}
                        aria-current={getAriaCurrent(
                          link.href,
                          currentPath,
                          currentHash,
                        )}
                      >
                        <span class="nav__popover-link-title">
                          {link.label}
                        </span>
                        {link.description && (
                          <span class="nav__popover-link-desc">
                            {link.description}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</nav>
