---
import Logo from "../Logo.astro";
import NavUtilityLinks from "../NavUtilityLinks.astro";
import Wordmark from "../Wordmark.astro";
import type { NavLink } from "../../content/navigation";
import {
  getAriaCurrent,
  isHashLink,
  normalizePath,
  toViewTransitionName,
} from "../../utils/navigation";

interface Props {
  currentPath: string;
  desktopLinks: NavLink[];
}

const { currentPath, desktopLinks } = Astro.props as Props;
const isHome = normalizePath(currentPath) === "/";
---

<div class="nav__bar">
  <a
    href="/"
    class="nav__brand"
    aria-label="Go to the homepage"
    aria-current={isHome ? "page" : undefined}
    style="view-transition-name: nav-brand;"
  >
    <Logo class="nav__brand-logo" title="Ethotechnics" />
    <Wordmark class="nav__wordmark" ariaHidden={true} />
  </a>

  <div class="nav__links nav__links--desktop" aria-label="Primary">
    {
      desktopLinks.map((link) => (
        <a
          class="nav__link"
          href={link.href}
          aria-label={
            isHashLink(link.href)
              ? `${link.label}, jumps to a homepage section`
              : link.label
          }
          title={isHashLink(link.href) ? "Jumps to a section on the homepage" : undefined}
          aria-current={getAriaCurrent(link.href, currentPath)}
          style={`view-transition-name: ${toViewTransitionName(
            link.href,
            "desktop",
          )};`}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="nav__utility nav__utility--desktop" aria-label="Utility links">
    <NavUtilityLinks currentPath={currentPath} />
  </div>
</div>
