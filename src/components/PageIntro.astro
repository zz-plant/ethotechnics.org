---
export interface AnchorLink {
  href: string;
  label: string;
}

export interface PanelCopy {
  eyebrow?: string;
  title: string;
  description: string;
  link?: {
    label: string;
    href: string;
  };
}

export interface Props {
  eyebrow: string;
  title: string;
  titleLevel?: 1 | 2 | 3 | 4 | 5 | 6;
  description: string;
  permalink: string;
  anchorLinks: AnchorLink[];
  panelCopy?: PanelCopy;
  collapseAnchorLinks?: boolean;
  collapseAnchorLinksOnMobile?: boolean;
  anchorLinksSummary?: string;
  version?: string;
  lastUpdated?: string;
}

const {
  eyebrow,
  title,
  titleLevel = 1,
  description,
  permalink,
  anchorLinks,
  panelCopy,
  collapseAnchorLinks = false,
  collapseAnchorLinksOnMobile = false,
  anchorLinksSummary = "Show full outline",
  version,
  lastUpdated,
} = Astro.props;
const hasCustomAside = Astro.slots.has("aside");
const hasActions = Astro.slots.has("actions");

const siteBase = Astro.site ? Astro.site.toString() : Astro.url.origin;
const normalizedPermalink = permalink?.trim();
const permalinkUrl = normalizedPermalink
  ? new URL(normalizedPermalink, siteBase)
  : null;
const abbreviatedPermalink = permalinkUrl
  ? `${permalinkUrl.pathname}${permalinkUrl.hash}`
  : normalizedPermalink;

const HeadingTag = `h${titleLevel}` as const;

// Several pages feed the same object to both the page header and the aside --
// /evals/ passed `panelCopy.title`/`panelCopy.description` as its own title and
// description and then passed `panelCopy` again -- so the panel restated the
// h1 and the lede verbatim, side by side at nearly the same size. An aside
// that repeats the thing it sits next to is worth less than the space it
// costs, so drop it when that is all it says.
const norm = (value?: string) => value?.trim().toLowerCase() ?? "";
const panelEchoesLead =
  !!panelCopy &&
  norm(panelCopy.title) === norm(title) &&
  norm(panelCopy.description) === norm(description);
const resolvedPanelCopy = panelEchoesLead ? undefined : panelCopy;
---

<section class="section page-intro">
  <div class="page-intro__grid">
    <div class="page-intro__lead">
      <div class="page-intro__meta">
        <p class="eyebrow">{eyebrow}</p>
        {
          (version || lastUpdated) && (
            <p class="page-intro__versioning" aria-label="Document metadata">
              {version && <span>Version {version}</span>}
              {version && lastUpdated && <span aria-hidden="true"> · </span>}
              {lastUpdated && <span>Last updated {lastUpdated}</span>}
            </p>
          )
        }
      </div>
      <HeadingTag>{title}</HeadingTag>
      <p class="muted page-intro__lede">{description}</p>
      {
        /* Below the lede, not above the title. As a filled, bordered chip in
          the meta row it was the widest and loudest element on every interior
          page -- a copy-link utility outranking the page's own name. */
      }
      <p class="page-intro__permalink">
        <span class="page-intro__permalink-icon" aria-hidden="true">↺</span>
        <span class="page-intro__permalink-label">Permanent link</span>
        <a class="page-intro__permalink-path" href={permalink}>
          {abbreviatedPermalink}
        </a>
        <button
          class="copy-button page-intro__permalink-copy"
          type="button"
          data-permalink-copy
          data-copy-value={permalinkUrl?.toString() ?? normalizedPermalink}
          aria-label="Copy permanent link to this page"
        >
          Copy link
        </button>
        <span
          class="page-intro__permalink-status"
          data-permalink-status
          role="status"
          aria-live="polite"></span>
      </p>
      {
        hasActions && (
          <div class="page-intro__actions section__actions">
            <slot name="actions" />
          </div>
        )
      }
    </div>

    <div class="page-intro__aside">
      {
        resolvedPanelCopy && (
          <div class="panel panel--glass page-intro__panel">
            {resolvedPanelCopy.eyebrow && (
              <p class="eyebrow">{resolvedPanelCopy.eyebrow}</p>
            )}
            <h2 class="page-intro__panel-title">{resolvedPanelCopy.title}</h2>
            <p>{resolvedPanelCopy.description}</p>
            {resolvedPanelCopy.link && (
              <p>
                <a href={resolvedPanelCopy.link.href}>
                  {resolvedPanelCopy.link.label}
                </a>
              </p>
            )}
          </div>
        )
      }

      {
        hasCustomAside && (
          <div class="page-intro__aside-custom">
            <slot name="aside" />
          </div>
        )
      }

      {
        anchorLinks.length > 0 && (
          <nav aria-label="On-page links" class="page-intro__anchors">
            <p class="eyebrow page-intro__anchors-title">Jump to</p>
            {collapseAnchorLinks ? (
              <details class="page-intro__anchors-disclosure">
                <summary>{anchorLinksSummary}</summary>
                <ul>
                  {anchorLinks.map((link, index) => (
                    <li>
                      <a href={link.href} class="pill pill--ghost">
                        <span class="page-intro__anchor-index">
                          {index + 1}
                        </span>
                        <span>{link.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : collapseAnchorLinksOnMobile ? (
              <>
                <ul class="page-intro__anchors-list page-intro__anchors-list--desktop">
                  {anchorLinks.map((link, index) => (
                    <li>
                      <a href={link.href} class="pill pill--ghost">
                        <span class="page-intro__anchor-index">
                          {index + 1}
                        </span>
                        <span>{link.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <details class="page-intro__anchors-disclosure page-intro__anchors-disclosure--mobile">
                  <summary>{anchorLinksSummary}</summary>
                  <ul>
                    {anchorLinks.map((link, index) => (
                      <li>
                        <a href={link.href} class="pill pill--ghost">
                          <span class="page-intro__anchor-index">
                            {index + 1}
                          </span>
                          <span>{link.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </>
            ) : (
              <ul class="page-intro__anchors-list">
                {anchorLinks.map((link, index) => (
                  <li>
                    <a href={link.href} class="pill pill--ghost">
                      <span class="page-intro__anchor-index">{index + 1}</span>
                      <span>{link.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </nav>
        )
      }
    </div>
  </div>
</section>

<script>
  import "../scripts/permalink-copy.ts";
</script>
