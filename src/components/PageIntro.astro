---
import PageIntroAnchorList from "./PageIntroAnchorList.astro";
import SectionNav from "./SectionNav.astro";

export interface AnchorLink {
  href: string;
  label: string;
}

export interface PanelCopy {
  eyebrow?: string;
  title: string;
  description: string;
  link?: {
    label: string;
    href: string;
  };
}

export interface Props {
  eyebrow: string;
  title: string;
  titleLevel?: 1 | 2 | 3 | 4 | 5 | 6;
  description: string;
  anchorLinks: AnchorLink[];
  panelCopy?: PanelCopy;
  anchorLinksSummary?: string;
  version?: string;
  lastUpdated?: string;
}

const {
  eyebrow,
  title,
  titleLevel = 1,
  description,
  anchorLinks,
  panelCopy,
  anchorLinksSummary = "Show full outline",
  version,
  lastUpdated,
} = Astro.props;
const hasCustomAside = Astro.slots.has("aside");
const hasActions = Astro.slots.has("actions");

const HeadingTag = `h${titleLevel}` as const;

// The eyebrow is meant to say what kind of page this is. On the section hubs
// several pages fed it the section name itself, so the page rendered a label
// on a label: STANDARDS over *Standards*, FINITE [BETA] over *Finite [Beta]*.
// Drop it when it adds nothing, mirroring the panelEchoesLead guard below.
const norm = (value?: string) => value?.trim().toLowerCase() ?? "";
const trimmedEyebrow = eyebrow?.trim();
const resolvedEyebrow =
  !trimmedEyebrow || norm(trimmedEyebrow) === norm(title)
    ? undefined
    : trimmedEyebrow;

// Several pages feed the same object to both the page header and the aside --
// /evals/ passed `panelCopy.title`/`panelCopy.description` as its own title and
// description and then passed `panelCopy` again -- so the panel restated the
// h1 and the lede verbatim, side by side at nearly the same size. An aside
// that repeats the thing it sits next to is worth less than the space it
// costs, so drop it when that is all it says.
const panelEchoesLead =
  !!panelCopy &&
  norm(panelCopy.title) === norm(title) &&
  norm(panelCopy.description) === norm(description);
const resolvedPanelCopy = panelEchoesLead ? undefined : panelCopy;
---

{anchorLinks.length >= 4 && <SectionNav links={anchorLinks} />}
<section class="section page-intro">
  <div class="page-intro__grid">
    <div class="page-intro__lead">
      <div class="page-intro__meta">
        {resolvedEyebrow && <p class="eyebrow">{resolvedEyebrow}</p>}
        {
          (version || lastUpdated) && (
            <p class="page-intro__versioning" aria-label="Document metadata">
              {version && <span>Version {version}</span>}
              {version && lastUpdated && <span aria-hidden="true"> · </span>}
              {lastUpdated && <span>Last updated {lastUpdated}</span>}
            </p>
          )
        }
      </div>
      <HeadingTag>{title}</HeadingTag>
      <p class="muted page-intro__lede">{description}</p>
      {
        hasActions && (
          <div class="page-intro__actions section__actions">
            <slot name="actions" />
          </div>
        )
      }
    </div>

    <div class="page-intro__aside">
      {
        resolvedPanelCopy && (
          <div class="panel panel--glass page-intro__panel">
            {resolvedPanelCopy.eyebrow && (
              <p class="eyebrow">{resolvedPanelCopy.eyebrow}</p>
            )}
            <h2 class="page-intro__panel-title">{resolvedPanelCopy.title}</h2>
            <p>{resolvedPanelCopy.description}</p>
            {resolvedPanelCopy.link && (
              <p>
                <a href={resolvedPanelCopy.link.href}>
                  {resolvedPanelCopy.link.label}
                </a>
              </p>
            )}
          </div>
        )
      }

      {
        hasCustomAside && (
          <div class="page-intro__aside-custom">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </div>

  {
    /* The outline used to sit under the panel in the right rail, which made
       the rail the tallest thing in the hero and left the lede column empty
       beneath it -- 200px on most pages and 450px on a theory essay, where
       no body text reached the first screen at all. As a strip it spans the
       width the lede already leaves, and the whole outline is visible at a
       glance instead of four entries and a disclosure. */
  }
  {
    anchorLinks.length > 1 && (
      <nav aria-label="On-page links" class="page-intro__anchors">
        <p class="eyebrow page-intro__anchors-title">Jump to</p>
        <div class="page-intro__anchors-list page-intro__anchors-list--desktop">
          <PageIntroAnchorList links={anchorLinks} />
        </div>
        <details class="page-intro__anchors-disclosure page-intro__anchors-disclosure--mobile">
          <summary>{anchorLinksSummary}</summary>
          <PageIntroAnchorList links={anchorLinks} />
        </details>
      </nav>
    )
  }
</section>
