---
/**
 * What an existing framework says beside what these standards require, one
 * row per framework. The rows live in content/standards-comparison.ts so the
 * home page and the About page cannot drift apart.
 */
import { standardsComparisonRows } from "../content/standards-comparison";
---

<div class="mapping-table__wrapper">
  <table class="mapping-table mapping-table--compare">
    <thead>
      <tr>
        <th scope="col">Existing standard says</th>
        <th scope="col">Ethotechnics requires</th>
      </tr>
    </thead>
    <tbody>
      {
        standardsComparisonRows.map((row) => (
          <tr>
            <td data-label="Existing standard says">
              "{row.says}"<br />
              <span class="small muted">{row.source}</span>
            </td>
            <td data-label="Ethotechnics requires">{row.requires}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
