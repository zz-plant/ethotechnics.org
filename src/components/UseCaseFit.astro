---
/**
 * Where a worked example sits on /use-cases: the context it belongs to, with
 * the standards to bind and the check to run first, or the boundary it shows.
 *
 * The sector comparisons under /use-cases/examples used to end at glossary links, so a
 * reader who found their sector there met no standard and no tool. Every
 * example page renders this, and use-cases.test.ts fails if an example
 * belongs to no context.
 *
 * Props:
 * - slug: The example's path segment under /use-cases/examples.
 *
 * Slot: copy that belongs with the fit, set above the link to /use-cases.
 * The scenarios put their bindings and the terms they use here, which used
 * to be two thin sections of their own; retail personalization puts its
 * opening here, which said what the boundary already says.
 */
import FitFacts from "./FitFacts.astro";
import SectionBlock from "./SectionBlock.astro";
import { fitForExample } from "../content/use-cases";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const fit = fitForExample(slug);
if (!fit) {
  throw new Error(
    `UseCaseFit: /use-cases/examples/${slug} belongs to no entry in src/content/use-cases.ts`,
  );
}
const href = `/use-cases#${fit.entry.id}`;
---

{
  fit.kind === "context" ? (
    <SectionBlock
      id="fit"
      eyebrow="Where this fits"
      title={fit.entry.title}
      description={fit.entry.decides}
    >
      <div class="stack-sm">
        <FitFacts context={fit.entry} compact />
        <slot />
        <p class="small">
          <a href={href}>
            The full entry, and where the framework does less &rarr;
          </a>
        </p>
      </div>
    </SectionBlock>
  ) : (
    <SectionBlock
      id="fit"
      eyebrow="Where this fits"
      title={`A boundary case: ${fit.entry.title.toLowerCase()}`}
      description={fit.entry.why}
    >
      <div class="stack-sm">
        <slot />
        <p class="small">
          <a href={href}>Where the framework does less &rarr;</a>
        </p>
      </div>
    </SectionBlock>
  )
}
