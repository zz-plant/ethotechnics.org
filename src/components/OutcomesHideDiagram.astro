---
/**
 * Outcomes Hide Diagram (Laws IV, VII, VIII, X).
 *
 * A paired comparison: two institutions with the same outcome, one run on robust
 * systems and correctable by the people it serves, the other run on its people
 * and merely making good decisions. The outcome row matches; the adaptation
 * burden and corrective power rows do not. Bars are qualitative.
 */
interface Props {
  level?: "h2" | "h3";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;
---

<figure class="state-diagram" aria-labelledby="outcomes-hide-title">
  <figcaption>
    <p class="eyebrow">Theory, drawn</p>
    <Heading id="outcomes-hide-title">Same outcome, different institutions</Heading>
    <p class="muted">
      Two institutions can produce identical outcomes and differ in everything else. The essay gives no figures, so the bars show only equal, low, and high.
    </p>
  </figcaption>

  <div class="diagram-scroll">
    <svg
      viewBox="0 0 920 470"
      role="img"
      class="state-diagram__svg"
      aria-label="Paired bar comparison of two institutions. Outcome: equal for both. Adaptation burden: low for institution A, which runs on robust systems; high for institution B, which runs on exhausted workers and unofficial workarounds. Corrective power: high for institution A, where people can challenge and obtain remedies; low for institution B, which merely happens to make good decisions. The outcome measure sees only the first row. Bars are qualitative, with no numeric scale."
    >
      <g class="state-diagram__node">
        {/* Key */}
        <rect x="20" y="18" width="16" height="16" rx="3" fill="var(--accent)" stroke="none" />
        <text x="46" y="31" class="state-diagram__state">Institution A</text>
        <text x="46" y="52" class="state-diagram__label">Robust systems</text>
        <text x="46" y="70" class="state-diagram__label">People can challenge and obtain remedies</text>

        <rect x="480" y="18" width="16" height="16" rx="3" fill="var(--status-warning)" stroke="none" />
        <text x="506" y="31" class="state-diagram__state">Institution B</text>
        <text x="506" y="52" class="state-diagram__label">Exhausted workers, unofficial workarounds</text>
        <text x="506" y="70" class="state-diagram__label">Merely happens to make good decisions</text>

        {/* What the outcome measure sees */}
        <rect x="10" y="96" width="900" height="100" rx="8" fill="var(--panel)" stroke="var(--border)" />

        {/* Row 1: outcome */}
        <text x="24" y="124" class="state-diagram__state">Outcome</text>
        <text x="24" y="145" class="state-diagram__label">What did it accomplish?</text>
        <text x="24" y="166" class="state-diagram__clause">The measure sees this</text>
        <rect x="380" y="112" width="320" height="26" rx="3" fill="var(--accent)" stroke="none" />
        <rect x="380" y="148" width="320" height="26" rx="3" fill="var(--status-warning)" stroke="none" />
        <text x="710" y="130" class="state-diagram__clause">Equal</text>
        <text x="710" y="166" class="state-diagram__clause">Equal</text>

        {/* Row 2: adaptation burden */}
        <text x="24" y="232" class="state-diagram__state">Adaptation burden</text>
        <text x="24" y="253" class="state-diagram__label">What did it require from people?</text>
        <text x="24" y="274" class="state-diagram__clause" fill="var(--status-danger)">The measure misses this</text>
        <rect x="380" y="220" width="100" height="26" rx="3" fill="var(--accent)" stroke="none" />
        <rect x="380" y="256" width="400" height="26" rx="3" fill="var(--status-warning)" stroke="none" />
        <text x="490" y="238" class="state-diagram__clause">Low</text>
        <text x="790" y="274" class="state-diagram__clause">High</text>

        <line x1="20" y1="306" x2="900" y2="306" stroke="var(--border)" stroke-width="1" />

        {/* Row 3: corrective power */}
        <text x="24" y="338" class="state-diagram__state">Corrective power</text>
        <text x="24" y="359" class="state-diagram__label">What power did people have</text>
        <text x="24" y="377" class="state-diagram__label">over those requirements?</text>
        <text x="24" y="398" class="state-diagram__clause" fill="var(--status-danger)">The measure misses this</text>
        <rect x="380" y="330" width="400" height="26" rx="3" fill="var(--accent)" stroke="none" />
        <rect x="380" y="366" width="100" height="26" rx="3" fill="var(--status-warning)" stroke="none" />
        <text x="790" y="348" class="state-diagram__clause">High</text>
        <text x="490" y="384" class="state-diagram__clause">Low</text>

        {/* Qualitative scale */}
        <line x1="380" y1="428" x2="780" y2="428" stroke="var(--border)" stroke-width="1.5" />
        <text x="380" y="450" class="state-diagram__label">Low</text>
        <text x="780" y="450" text-anchor="end" class="state-diagram__label">High</text>
      </g>
    </svg>
  </div>
</figure>
