---
/**
 * The end of a deep page: one public case where the page's idea broke, and
 * one action. Readers who arrive from search on a glossary entry, an
 * explainer, or a failure page otherwise reach the footer with nowhere to go.
 *
 * The case and the law come from src/utils/next-step.ts, which maps the
 * topic text to a state variable. Pass `variable` to skip the keyword match.
 *
 * The action states the safeguard as the self-test's plain question rather
 * than as a law number: glossary and explainer readers arrive from search,
 * and many of them run no system. Pass `action` to replace the law link on a
 * page written for the person a system decided about.
 */
import "../styles/components/next-step.css";

import { getEntry } from "astro:content";
import VerdictMark from "./VerdictMark.astro";
import { stateVariables, type StateVariableId } from "../content/casebook";
import { extractLaws } from "../utils/laws";
import { pickMatchedCase, variableForTopic } from "../utils/next-step";
import { selfTestQuestions } from "../utils/self-test";

interface Props {
  /** Page title, slug, tags: any text that names the page's subject. */
  topic?: (string | undefined | null)[];
  /** Set when the page's variable is known; overrides `topic`. */
  variable?: StateVariableId;
  /** Replaces the law link, e.g. with a check for a person decided about. */
  action?: { label: string; href: string };
  class?: string;
}

const { topic = [], variable, action, class: className }: Props = Astro.props;

// No match, no block: a page whose topic names no safeguard shows no case
// rather than a fallback that has nothing to do with it.
const pick = pickMatchedCase(variable ?? variableForTopic(...topic));
const variableLabel = pick
  ? (stateVariables.find((item) => item.id === pick.finding.variable)?.label ??
    pick.finding.variable)
  : "";

const lawsEntry = pick ? await getEntry("standards", "laws") : undefined;
const lawRow =
  pick && lawsEntry?.body
    ? extractLaws(lawsEntry.body).find((row) => row.numeral === pick.law)
    : undefined;
const lawHref = pick
  ? `/standards/laws#${lawRow?.id ?? `law-${pick.law.toLowerCase()}`}`
  : "";
const question = pick
  ? selfTestQuestions.find((item) => item.variable === pick.finding.variable)
      ?.question
  : undefined;
const entry = pick?.entry;
const finding = pick?.finding;
---

{
  entry && finding && (
    <aside
      class:list={["next-step", className]}
      aria-labelledby="next-step-case-title"
    >
      <div class="next-step__case">
        <p class="eyebrow">Where this broke in public</p>
        <h2 id="next-step-case-title" class="next-step__title">
          {entry.title}
        </h2>
        <p class="next-step__verdict">
          <span>{variableLabel}</span>
          <VerdictMark verdict={finding.verdict} labelled />
        </p>
        <p class="small muted next-step__hook">
          {entry.period}. Time to halt: {entry.timeToHalt}
        </p>
        <a class="next-step__case-link" href={`/casebook/${entry.slug}`}>
          Read the full case <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="next-step__action">
        <p class="eyebrow">The question it failed</p>
        {question && <p class="next-step__law">{question}</p>}
        <a
          class="button primary next-step__button"
          href={action?.href ?? lawHref}
        >
          {action?.label ?? "Read the law behind it"}
        </a>
      </div>
    </aside>
  )
}
