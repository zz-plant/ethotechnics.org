---
/**
 * RosettaStone.astro
 *
 * Common AI terms paired with checks and standard requirements.
 */

interface TranslationRow {
  industryTerm: string;
  industryUsage: string;
  ethotechnicReality: string;
  constitutionalMechanism: string;
  governingStandard: { id: string; name: string; href: string };
  governingLaw: { numeral: string; statement: string; href: string };
}

const translations: TranslationRow[] = [
  {
    industryTerm: "Human-in-the-loop (HITL)",
    industryUsage: "A human reviews or approves an automated output.",
    ethotechnicReality:
      "Check whether the reviewer can change or stop the action.",
    constitutionalMechanism:
      "The delegation standard asks who holds authority, which actions are permitted, and when that permission expires.",
    governingStandard: {
      id: "STD-08",
      name: "Delegation",
      href: "/standards/std-08-delegation",
    },
    governingLaw: {
      numeral: "Law I",
      statement: "What a system can do is not permission to do it.",
      href: "/standards/laws#law-i",
    },
  },
  {
    industryTerm: "Kill switch",
    industryUsage: "A control stops an automated process.",
    ethotechnicReality:
      "Check whether operations can continue after it is used.",
    constitutionalMechanism:
      "The standard on people's time includes a right to stop. The operator needs a tested fallback so stopping the process does not leave people without a service.",
    governingStandard: {
      id: "STD-01",
      name: "The Temporal Bill of Rights",
      href: "/standards/std-01-temporal-rights",
    },
    governingLaw: {
      numeral: "Law V",
      statement:
        "Once people rely on a system, switching it off costs more, so fewer fixes stay affordable.",
      href: "/standards/laws#law-v",
    },
  },
  {
    industryTerm: "AI ethics & alignment",
    industryUsage:
      "A project states principles or checks model behavior against them.",
    ethotechnicReality:
      "Check whether a person can challenge a consequential decision.",
    constitutionalMechanism:
      "The recourse standard specifies a challenge path, a response deadline, and a route to remedy.",
    governingStandard: {
      id: "STD-02",
      name: "Contestability & Recourse",
      href: "/standards/std-02-contestability-recourse",
    },
    governingLaw: {
      numeral: "Law VII",
      statement:
        "People who bear a system's errors must be able to challenge it, and the more they bear, the stronger that right.",
      href: "/standards/laws#law-vii",
    },
  },
  {
    industryTerm: "Bias audit & fairness metric",
    industryUsage: "An audit compares outcomes across groups.",
    ethotechnicReality:
      "Group-level results do not explain an individual decision.",
    constitutionalMechanism:
      "The decision-record standard specifies a record for each decision. Its higher levels add the reasons, who may object, and where an objection goes.",
    governingStandard: {
      id: "STD-07",
      name: "Revisable Delegation Record",
      href: "/standards/std-07-revisable-delegation-record",
    },
    governingLaw: {
      numeral: "Law VII",
      statement:
        "People who bear a system's errors must be able to challenge it, and the more they bear, the stronger that right.",
      href: "/standards/laws#law-vii",
    },
  },
  {
    industryTerm: "Hallucination & model drift",
    industryUsage:
      "A model produces an unsupported answer or its performance changes.",
    ethotechnicReality:
      "Check whether the evidence still supports the permitted actions.",
    constitutionalMechanism:
      "The delegation standard ties permission to act to stated evidence and to events that force a review. A model’s output does not itself grant permission to act.",
    governingStandard: {
      id: "STD-08",
      name: "Delegation",
      href: "/standards/std-08-delegation",
    },
    governingLaw: {
      numeral: "Law II",
      statement:
        "Permission to act runs out unless someone renews it on current evidence.",
      href: "/standards/laws#law-ii",
    },
  },
  {
    industryTerm: "Worker burnout & change fatigue",
    industryUsage:
      "Staff report exhaustion or difficulty keeping up with changes.",
    ethotechnicReality:
      "Count repair work when assessing the system’s workload.",
    constitutionalMechanism:
      "The human impact standard asks how a system affects people. Record the time staff spend fixing outputs rather than treating those repairs as free capacity.",
    governingStandard: {
      id: "STD-06",
      name: "Human Impact Safety Case",
      href: "/standards/std-06-human-impact-safety-case",
    },
    governingLaw: {
      numeral: "Law IV",
      statement:
        "Handing a decision to a system creates a duty to catch and fix its mistakes.",
      href: "/standards/laws#law-iv",
    },
  },
  {
    industryTerm: "Compliance checklist & self-attestation",
    industryUsage: "A team reports that it has completed required checks.",
    ethotechnicReality: "Ask for records another reviewer can inspect.",
    constitutionalMechanism:
      "The decision-record standard sets the record format. The record checker grades an exported log against it; that does not establish that the decisions were justified.",
    governingStandard: {
      id: "STD-07",
      name: "Revisable Delegation Record",
      href: "/standards/std-07-revisable-delegation-record",
    },
    governingLaw: {
      numeral: "Law III",
      statement:
        "When the evidence behind a permission changes, the permission must be open to review.",
      href: "/standards/laws#law-iii",
    },
  },
];
---

<div class="rosetta-stone" data-rosetta-stone>
  <div class="rosetta-grid">
    {
      translations.map((row) => (
        <article class="rosetta-card">
          <header class="rosetta-card__header">
            <span class="pill pill--ghost small">Industry term</span>
            <h3 class="rosetta-card__title">"{row.industryTerm}"</h3>
            <p class="rosetta-card__euphemism small muted">
              <strong>Common use:</strong> {row.industryUsage}
            </p>
          </header>

          <div class="rosetta-card__body">
            <div class="rosetta-reality">
              <span class="eyebrow warning">What to check</span>
              <p class="small">
                <strong>{row.ethotechnicReality}</strong>
              </p>
            </div>

            <div class="rosetta-mechanism">
              <span class="eyebrow">Relevant requirement</span>
              <p class="small">{row.constitutionalMechanism}</p>
            </div>
          </div>

          <footer class="rosetta-card__footer">
            <div class="rosetta-binding">
              <span class="rosetta-label">Standard:</span>
              <a href={row.governingStandard.href} class="rosetta-link">
                <strong>{row.governingStandard.id}:</strong>{" "}
                {row.governingStandard.name}
              </a>
            </div>
            <div class="rosetta-binding">
              <span class="rosetta-label">Governing law:</span>
              <a href={row.governingLaw.href} class="rosetta-link">
                <strong>{row.governingLaw.numeral}:</strong>{" "}
                {row.governingLaw.statement}
              </a>
            </div>
          </footer>
        </article>
      ))
    }
  </div>
</div>

<style>
  .rosetta-stone {
    display: grid;
    gap: var(--space-6);
  }

  .rosetta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
  }

  .rosetta-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
    align-content: space-between;
  }

  .rosetta-card__header {
    display: grid;
    gap: var(--space-2);
  }

  .rosetta-card__title {
    margin: 0;
    font-size: var(--text-base);
    color: var(--text);
  }

  .rosetta-card__euphemism {
    margin: 0;
    line-height: 1.45;
  }

  .rosetta-card__body {
    display: grid;
    gap: var(--space-3);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-3);
  }

  .rosetta-reality p,
  .rosetta-mechanism p {
    margin: var(--space-1) 0 0;
  }

  .rosetta-card__footer {
    display: grid;
    gap: var(--space-2);
  }

  .rosetta-binding {
    display: grid;
    gap: 2px;
    font-size: var(--text-sm);
  }

  .rosetta-label {
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .rosetta-link {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .rosetta-link:hover {
    color: var(--accent);
  }
</style>
