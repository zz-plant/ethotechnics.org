---
import SectionBlock from "./SectionBlock.astro";
import { finiteContent } from "../content/finite";

const { hero, measures, institutionalGames, benchmarkHarness, keyTakeaways } =
  finiteContent;
---

<SectionBlock
  id="finite"
  eyebrow={hero.eyebrow}
  title={`${hero.heading}: Rehearsing halts, rollbacks, and recovery`}
  description={hero.lede}
  variant="alt"
>
  <div class="finite-hero-actions">
    {
      hero.actions.map((action) => (
        <a class={`button ${action.variant}`} href={action.href}>
          {action.label}
        </a>
      ))
    }
  </div>

  <div class="grid grid--two finite-overview-grid">
    <article class="card card--emphasis">
      <p class="eyebrow">Evaluation scope</p>
      <p class="finite-summary">{hero.summary}</p>
      <ul class="card__list">
        {
          measures.dimensions.map((dim) => (
            <li>
              <strong>{dim.title}:</strong> {dim.detail}
            </li>
          ))
        }
      </ul>
    </article>

    <article class="card">
      <p class="eyebrow">Verification deliverables</p>
      <ul class="card__list">
        {measures.deliverables.map((item) => <li>{item}</li>)}
      </ul>
      <div class="panel panel--glass deliverables-panel">
        <p class="eyebrow deliverables-eyebrow">{keyTakeaways.label}</p>
        <p class="small muted">{keyTakeaways.note}</p>
        <ul class="card__list small muted">
          {keyTakeaways.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      </div>
    </article>
  </div>

  <div class="finite-subsection">
    <div class="finite-subsection__header">
      <p class="eyebrow">{institutionalGames.eyebrow}</p>
      <h3>{institutionalGames.title}</h3>
      <p class="muted">{institutionalGames.description}</p>
    </div>

    <div class="grid grid--four conditions-grid">
      {
        institutionalGames.conditions.map((cond) => (
          <article class="card condition-card">
            <span class="pill pill--ghost condition-pill">
              {cond.condition}
            </span>
            <h4 class="condition-card__title">{cond.title}</h4>
            <p class="muted small">{cond.description}</p>
          </article>
        ))
      }
    </div>

    <div class="grid grid--two games-grid">
      {
        institutionalGames.games.map((game) => (
          <article class="card card--emphasis game-card">
            <div class="game-card__header">
              <div class="game-card__title-row">
                <div>
                  <p class="eyebrow">{game.subtitle}</p>
                  <h4>{game.title}</h4>
                </div>
                <span
                  class={`drill-status drill-status--${game.status === "executable_benchmark" ? "runnable" : "tabletop"}`}
                >
                  {game.status === "executable_benchmark"
                    ? "Executable benchmark"
                    : "Tabletop drill"}
                </span>
              </div>
            </div>

            <p class="game-card__setting">
              <strong>Setting:</strong> {game.setting}
            </p>

            <div class="panel panel--glass ledger-panel">
              <div class="ledger-row ledger-row--visible">
                <span class="ledger-badge ledger-badge--visible">
                  Visible ledger
                </span>
                <p class="small">{game.visibleLedger}</p>
              </div>
              <div class="ledger-row ledger-row--audit">
                <span class="ledger-badge ledger-badge--audit">
                  Audit ledger
                </span>
                <p class="small">{game.auditLedger}</p>
              </div>
            </div>

            <p class="muted small">
              <strong>Trigger:</strong> {game.trigger}
            </p>
            <p class="muted small">
              <strong>Mechanic:</strong> {game.mechanic}
            </p>
            <p class="game-card__insight">
              <strong>Dual-ledger insight:</strong> {game.dualLedgerInsight}
            </p>

            <div class="game-card__footer">
              <div class="game-card__tags">
                {game.standardRefs.map((ref) => (
                  <span class="pill pill--ghost">{ref}</span>
                ))}
              </div>
              <div class="game-card__links">
                {game.benchmarkRef && (
                  <a
                    class="button ghost button--compact"
                    href={game.benchmarkRef}
                  >
                    Inspect schema &rarr;
                  </a>
                )}
                <a class="button ghost button--compact" href={game.suiteRef}>
                  Open eval suite &rarr;
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="finite-subsection">
    <div class="finite-subsection__header">
      <p class="eyebrow">Runnable harness</p>
      <h3>{benchmarkHarness.title}</h3>
      <p class="muted">{benchmarkHarness.description}</p>
      <div class="harness-meta">
        <span class="small muted">Framework compatibility:</span>
        <div class="harness-frameworks">
          {
            benchmarkHarness.frameworks.map((fw) => (
              <span class="pill pill--ghost">{fw}</span>
            ))
          }
        </div>
        <a
          class="button ghost button--compact harness-schema-link"
          href={benchmarkHarness.schemaHref}
        >
          View JSON schema &rarr;
        </a>
      </div>
    </div>

    <div class="grid grid--three tools-grid">
      {
        benchmarkHarness.tools.map((tool) => (
          <article class="card tool-card">
            <div class="tool-card__header">
              <code class="tool-name">{tool.name}</code>
              <span class={`tool-badge tool-badge--${tool.actionClass.toLowerCase()}`}>
                {tool.actionClass}
              </span>
            </div>
            <p class="small muted">{tool.description}</p>
            <p class="tool-card__approval">
              <span class="small muted">
                {tool.requiresApproval
                  ? "Requires approval"
                  : "Direct execution"}
              </span>
            </p>
          </article>
        ))
      }
    </div>
  </div>
</SectionBlock>

<style>
  .finite-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .finite-overview-grid {
    margin-bottom: var(--space-8);
  }

  .finite-summary {
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: var(--leading-snug, 1.35);
    margin-bottom: var(--space-3);
  }

  .deliverables-panel {
    margin-top: var(--space-4);
  }

  .deliverables-eyebrow {
    margin-bottom: var(--space-2);
  }

  .finite-subsection {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .finite-subsection__header {
    margin-bottom: var(--space-5);
  }

  .conditions-grid {
    margin-bottom: var(--space-6);
  }

  .condition-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .condition-pill {
    align-self: flex-start;
  }

  .condition-card__title {
    font-size: var(--text-base);
    margin: 0;
  }

  .games-grid {
    gap: var(--space-5);
  }

  .game-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .game-card__header {
    margin-bottom: var(--space-1);
  }

  .game-card__title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .game-card__header h4 {
    font-size: var(--text-xl);
    margin: 0;
  }

  .drill-status {
    border-radius: var(--radius-pill);
    padding: var(--space-hair) var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label, 0.05em);
    white-space: nowrap;
  }

  .drill-status--runnable {
    background: color-mix(in srgb, var(--status-success) 16%, transparent);
    color: var(--status-success);
  }

  .drill-status--tabletop {
    background: color-mix(in srgb, var(--text-muted) 16%, transparent);
    color: var(--text-muted);
  }

  .game-card__setting {
    font-size: var(--text-sm);
    margin: 0;
  }

  .ledger-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .ledger-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .ledger-badge {
    align-self: flex-start;
    border-radius: var(--radius-pill);
    padding: var(--space-hair) var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label, 0.05em);
  }

  .ledger-badge--visible {
    background: color-mix(in srgb, var(--status-success) 16%, transparent);
    color: var(--status-success);
  }

  .ledger-badge--audit {
    background: color-mix(in srgb, var(--status-danger) 16%, transparent);
    color: var(--status-danger);
  }

  .game-card__insight {
    font-size: var(--text-sm);
    color: var(--accent);
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px dashed var(--border);
  }

  .game-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }

  .game-card__tags {
    display: flex;
    gap: var(--space-1);
  }

  .game-card__links {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .harness-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .harness-frameworks {
    display: flex;
    gap: var(--space-1);
  }

  .harness-schema-link {
    margin-left: auto;
  }

  .tools-grid {
    gap: var(--space-4);
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tool-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
  }

  .tool-name {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .tool-badge {
    border-radius: var(--radius-pill);
    padding: var(--space-hair) var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label, 0.05em);
  }

  .tool-badge--write {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
  }

  .tool-badge--transfer {
    background: color-mix(in srgb, var(--status-warning) 16%, transparent);
    color: var(--status-warning);
  }

  .tool-badge--read {
    background: color-mix(in srgb, var(--text-muted) 16%, transparent);
    color: var(--text-muted);
  }

  .tool-card__approval {
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }
</style>
