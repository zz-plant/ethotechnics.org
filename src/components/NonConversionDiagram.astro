---
/**
 * Non-Conversion Structural Boundary Diagram.
 *
 * Visualizes the 7 refusals where facts about systems are blocked from silently
 * becoming facts about authority, requiring explicit object transitions instead.
 */
interface Props {
  level?: "h2" | "h3";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;

const rows = [
  {
    y: 65,
    fact: "1. Reachable capability",
    refused: "≠ Authorized agency",
    boundary: "Catalog vs. authority grant",
  },
  {
    y: 115,
    fact: "2. Elapsed quiet time",
    refused: "≠ Automatic renewal",
    boundary: "Recorded basis at lease expiry",
  },
  {
    y: 165,
    fact: "3. Pilot or scope success",
    refused: "≠ License to expand",
    boundary: "New delegation decision",
  },
  {
    y: 215,
    fact: "4. Corrective labor absorbed",
    refused: "≠ Free operational buffer",
    boundary: "Procedural standing register",
  },
  {
    y: 265,
    fact: "7. Model boundary (omission)",
    refused: "≠ Resolved reality",
    boundary: "not represented ⇒ unresolved",
    emphasis: true,
  },
];
---

<figure class="state-diagram" aria-labelledby="non-conversion-title">
  <figcaption>
    <p class="eyebrow">Theory, drawn</p>
    <Heading id="non-conversion-title">
      The non-conversion principle: what a capability may not become
    </Heading>
    <p class="muted">
      A fact about a system does not become a fact about its authority on its
      own. Nothing passes without an explicit, recorded decision. The drawing
      shows five of the seven conversions, numbered as the essay numbers them.
    </p>
  </figcaption>

  <div
    class="diagram-scroll"
    tabindex="0"
    role="region"
    aria-labelledby="non-conversion-title"
  >
    <svg
      viewBox="0 0 920 340"
      role="img"
      class="state-diagram__svg"
      aria-label="The non-conversion principle: comparing default technocratic inferences against the structural object boundary and governing transitions."
    >
      <defs>
        <marker
          id="nc-gate-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)"></path>
        </marker>
        <marker
          id="nc-blocked"
          viewBox="0 0 10 10"
          refX="5"
          refY="5"
          markerWidth="8"
          markerHeight="8"
        >
          <circle cx="5" cy="5" r="4" fill="var(--status-danger)"></circle>
        </marker>
      </defs>

      {/* Header Columns */}
      <rect x="20" y="20" width="280" height="32" rx="4" fill="var(--panel)"
      ></rect>
      <text x="160" y="41" text-anchor="middle" class="state-diagram__clause"
        >Observed fact (system state)</text
      >

      <rect x="320" y="20" width="280" height="32" rx="4" fill="var(--panel)"
      ></rect>
      <text
        x="460"
        y="41"
        text-anchor="middle"
        class="state-diagram__state"
        fill="var(--status-danger)">Refused default inference</text
      >

      <rect x="620" y="20" width="280" height="32" rx="4" fill="var(--panel)"
      ></rect>
      <text x="760" y="41" text-anchor="middle" class="state-diagram__clause"
        >Governing object boundary</text
      >

      {
        rows.map(({ y, fact, refused, boundary, emphasis }) => (
          <g transform={`translate(0, ${y})`}>
            <rect
              x="20"
              y="0"
              width="280"
              height="42"
              rx="6"
              fill="var(--surface)"
              stroke={emphasis ? "var(--accent)" : "var(--border)"}
            />
            <text
              x="35"
              y="26"
              class={
                emphasis ? "state-diagram__clause" : "state-diagram__label"
              }
              set:text={fact}
            />
            <line
              x1="300"
              y1="21"
              x2="350"
              y2="21"
              stroke="var(--status-danger)"
              stroke-width="2"
              stroke-dasharray="3 3"
              marker-end="url(#nc-blocked)"
            />
            <text
              x="460"
              y="26"
              text-anchor="middle"
              class={
                emphasis ? "state-diagram__clause" : "state-diagram__label"
              }
              fill={emphasis ? "var(--accent-strong)" : "var(--muted)"}
              set:text={refused}
            />
            <line
              x1="570"
              y1="21"
              x2="620"
              y2="21"
              stroke="var(--accent)"
              stroke-width="2"
              marker-end="url(#nc-gate-arrow)"
            />
            <rect
              x="620"
              y="0"
              width="280"
              height="42"
              rx="6"
              fill={emphasis ? "var(--panel)" : "var(--surface)"}
              stroke="var(--accent)"
            />
            <text
              x="635"
              y="26"
              class="state-diagram__state"
              set:text={boundary}
            />
          </g>
        ))
      }
    </svg>
  </div>
</figure>
