---
/**
 * Non-Conversion Structural Boundary Diagram.
 *
 * Visualizes the 7 refusals where facts about systems are blocked from silently
 * becoming facts about authority, requiring explicit object transitions instead.
 */
interface Props {
  level?: "h2" | "h3";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;
---

<figure class="state-diagram" aria-labelledby="non-conversion-title">
  <figcaption>
    <p class="eyebrow">Theory, drawn</p>
    <Heading id="non-conversion-title">
      The Non-Conversion Principle: Object Boundaries vs. Default Inferences
    </Heading>
    <p class="muted">
      A fact about a system does not become a fact about its authority on its own. Nothing passes without an explicit, recorded decision.
    </p>
  </figcaption>

  <div class="diagram-scroll">
    <svg
      viewBox="0 0 920 340"
      role="img"
      class="state-diagram__svg"
      aria-label="The Non-Conversion Principle: comparing default technocratic inferences against the structural object boundary and governing transitions."
    >
      <defs>
        <marker
          id="nc-gate-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
        <marker
          id="nc-blocked"
          viewBox="0 0 10 10"
          refX="5"
          refY="5"
          markerWidth="8"
          markerHeight="8"
        >
          <circle cx="5" cy="5" r="4" fill="var(--danger, #ef4444)" />
        </marker>
      </defs>

      {/* Header Columns */}
      <rect x="20" y="20" width="280" height="32" rx="4" fill="var(--panel)" />
      <text x="160" y="41" text-anchor="middle" class="state-diagram__clause">Observed Fact (System State)</text>

      <rect x="320" y="20" width="280" height="32" rx="4" fill="var(--panel)" />
      <text x="460" y="41" text-anchor="middle" class="state-diagram__state" fill="var(--danger, #ef4444)">Refused Default Inference</text>

      <rect x="620" y="20" width="280" height="32" rx="4" fill="var(--panel)" />
      <text x="760" y="41" text-anchor="middle" class="state-diagram__clause">Governing Object Boundary</text>

      {/* Row 1: Law I */}
      <g transform="translate(0, 65)">
        <rect x="20" y="0" width="280" height="42" rx="6" fill="var(--surface)" stroke="var(--border)" />
        <text x="35" y="26" class="state-diagram__label">1. Reachable Capability</text>

        <line x1="300" y1="21" x2="350" y2="21" stroke="var(--danger, #ef4444)" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#nc-blocked)" />
        <text x="460" y="26" text-anchor="middle" class="state-diagram__label" fill="var(--muted)">≠ Authorized agency</text>

        <line x1="570" y1="21" x2="620" y2="21" stroke="var(--accent)" stroke-width="2" marker-end="url(#nc-gate-arrow)" />
        <rect x="620" y="0" width="280" height="42" rx="6" fill="var(--surface)" stroke="var(--accent)" />
        <text x="635" y="26" class="state-diagram__state" font-size="12">Catalog vs. Authority Grant</text>
      </g>

      {/* Row 2: Law II */}
      <g transform="translate(0, 115)">
        <rect x="20" y="0" width="280" height="42" rx="6" fill="var(--surface)" stroke="var(--border)" />
        <text x="35" y="26" class="state-diagram__label">2. Elapsed Quiet Time</text>

        <line x1="300" y1="21" x2="350" y2="21" stroke="var(--danger, #ef4444)" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#nc-blocked)" />
        <text x="460" y="26" text-anchor="middle" class="state-diagram__label" fill="var(--muted)">≠ Automatic renewal</text>

        <line x1="570" y1="21" x2="620" y2="21" stroke="var(--accent)" stroke-width="2" marker-end="url(#nc-gate-arrow)" />
        <rect x="620" y="0" width="280" height="42" rx="6" fill="var(--surface)" stroke="var(--accent)" />
        <text x="635" y="26" class="state-diagram__state" font-size="12">Recorded Basis at Lease Expiry</text>
      </g>

      {/* Row 3: Law XI */}
      <g transform="translate(0, 165)">
        <rect x="20" y="0" width="280" height="42" rx="6" fill="var(--surface)" stroke="var(--border)" />
        <text x="35" y="26" class="state-diagram__label">3. Pilot or Scope Success</text>

        <line x1="300" y1="21" x2="350" y2="21" stroke="var(--danger, #ef4444)" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#nc-blocked)" />
        <text x="460" y="26" text-anchor="middle" class="state-diagram__label" fill="var(--muted)">≠ License to expand</text>

        <line x1="570" y1="21" x2="620" y2="21" stroke="var(--accent)" stroke-width="2" marker-end="url(#nc-gate-arrow)" />
        <rect x="620" y="0" width="280" height="42" rx="6" fill="var(--surface)" stroke="var(--accent)" />
        <text x="635" y="26" class="state-diagram__state" font-size="12">New Delegation Decision</text>
      </g>

      {/* Row 4: Corrective Labor */}
      <g transform="translate(0, 215)">
        <rect x="20" y="0" width="280" height="42" rx="6" fill="var(--surface)" stroke="var(--border)" />
        <text x="35" y="26" class="state-diagram__label">4. Corrective Labor Absorbed</text>

        <line x1="300" y1="21" x2="350" y2="21" stroke="var(--danger, #ef4444)" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#nc-blocked)" />
        <text x="460" y="26" text-anchor="middle" class="state-diagram__label" fill="var(--muted)">≠ Free operational buffer</text>

        <line x1="570" y1="21" x2="620" y2="21" stroke="var(--accent)" stroke-width="2" marker-end="url(#nc-gate-arrow)" />
        <rect x="620" y="0" width="280" height="42" rx="6" fill="var(--surface)" stroke="var(--accent)" />
        <text x="635" y="26" class="state-diagram__state" font-size="12">Procedural Standing Register</text>
      </g>

      {/* Row 5: Model Incompleteness */}
      <g transform="translate(0, 265)">
        <rect x="20" y="0" width="280" height="42" rx="6" fill="var(--surface)" stroke="var(--accent)" />
        <text x="35" y="26" class="state-diagram__clause">7. Model Boundary (Omission)</text>

        <line x1="300" y1="21" x2="350" y2="21" stroke="var(--danger, #ef4444)" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#nc-blocked)" />
        <text x="460" y="26" text-anchor="middle" class="state-diagram__clause" fill="var(--accent-strong)">≠ Resolved reality</text>

        <line x1="570" y1="21" x2="620" y2="21" stroke="var(--accent)" stroke-width="2" marker-end="url(#nc-gate-arrow)" />
        <rect x="620" y="0" width="280" height="42" rx="6" fill="var(--panel)" stroke="var(--accent)" />
        <text x="635" y="26" class="state-diagram__state" font-size="12">not represented ⇒ unresolved</text>
      </g>
    </svg>
  </div>
</figure>
