---
// The record-diagram classes (.chip, .label, .small …) live in figures.css.
import "../styles/components/figures.css";

export interface ValidatorMicroDiagramProps {
  variant: "burden" | "latency" | "risk";
}

const { variant } = Astro.props;

const variants = {
  burden: {
    title: "Burden modeler micro-diagram",
    desc: "Steps and declared duration feed a burden badge to show cumulative time tax.",
    label: "Burden index",
  },
  latency: {
    title: "Latency audit micro-diagram",
    desc: "Observed latency crosses a declared timeout threshold with a human escalation path.",
    label: "Timeout ≤ 120s",
  },
  risk: {
    title: "Risk radar micro-diagram",
    desc: "Multiple touchpoints feed a risk badge inside a system boundary.",
    label: "Risk cluster",
  },
} as const;

const diagram = variants[variant as keyof typeof variants];
// The risk drawing stacks its touchpoints, so it is taller than the others.
const viewBox = variant === "risk" ? "0 0 360 158" : "0 0 360 120";
const titleId = `validator-${variant}-title`;
const descId = `validator-${variant}-desc`;
---

<figure class="validator-diagram">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox={viewBox}
    role="img"
    aria-labelledby={`${titleId} ${descId}`}
  >
    <title id={titleId}>{diagram.title}</title>
    <desc id={descId}>{diagram.desc}</desc>

    {
      variant === "burden" ? (
        <>
          <rect x="16" y="18" width="328" height="84" class="band" rx="12" />
          <line x1="88" y1="60" x2="182" y2="60" class="line" />
          <path d="M194 60 L182 52 L182 68 Z" class="fill-border" />

          <rect x="28" y="42" width="60" height="36" class="chip chip-state" />
          <text x="58" y="65" text-anchor="middle" class="label ink">
            Steps
          </text>

          <rect x="100" y="42" width="80" height="36" class="chip chip-state" />
          <text x="140" y="65" text-anchor="middle" class="label ink">
            Duration
          </text>

          <line x1="198" y1="60" x2="222" y2="60" class="line dot" />

          <rect
            x="222"
            y="42"
            width="114"
            height="36"
            class="chip chip-badge"
          />
          <text x="279" y="65" text-anchor="middle" class="label ink">
            {diagram.label}
          </text>
        </>
      ) : null
    }

    {
      variant === "latency" ? (
        <>
          <rect x="16" y="18" width="328" height="84" class="band" rx="12" />
          <line x1="32" y1="60" x2="144" y2="60" class="line" />
          <path d="M156 60 L144 52 L144 68 Z" class="fill-border" />

          <line x1="100" y1="40" x2="100" y2="88" class="line dash" />
          <text x="100" y="34" text-anchor="middle" class="small muted">
            {diagram.label}
          </text>

          <rect x="156" y="44" width="86" height="32" class="chip chip-state" />
          <text x="199" y="65" text-anchor="middle" class="label ink">
            Latency
          </text>

          <path d="M242 60 L256 60" class="line-strong" />

          <rect x="256" y="44" width="80" height="32" class="chip chip-agent" />
          <text x="296" y="65" text-anchor="middle" class="label ink">
            Escalate
          </text>
        </>
      ) : null
    }

    {
      variant === "risk" ? (
        <>
          <rect x="16" y="14" width="328" height="130" class="band" rx="12" />
          <rect
            x="28"
            y="22"
            width="150"
            height="114"
            class="line dash"
            rx="12"
          />
          <text x="40" y="40" class="small muted">
            System boundary
          </text>

          <rect x="46" y="50" width="114" height="24" class="chip chip-state" />
          <text x="103" y="67" text-anchor="middle" class="small ink">
            Touchpoint
          </text>

          <rect x="46" y="78" width="114" height="24" class="chip chip-state" />
          <text x="103" y="95" text-anchor="middle" class="small ink">
            Touchpoint
          </text>

          <rect
            x="46"
            y="106"
            width="114"
            height="24"
            class="chip chip-state"
          />
          <text x="103" y="123" text-anchor="middle" class="small ink">
            Touchpoint
          </text>

          <path
            d="M160 62 L214 90 M160 90 L214 90 M160 118 L214 90"
            class="line"
          />
          <path d="M226 90 L214 84 L214 96 Z" class="fill-border" />

          <rect
            x="226"
            y="72"
            width="106"
            height="36"
            class="chip chip-badge"
          />
          <text x="279" y="95" text-anchor="middle" class="label ink">
            {diagram.label}
          </text>
        </>
      ) : null
    }
  </svg>
</figure>
