---
/**
 * Capture Ratchet Diagram (Law XII).
 *
 * Visualizes the dual-curve dynamic of institutional capture over time:
 * Throughput & reliance rise while retained competence and withdrawal feasibility
 * erode through successive "rational economies", eventually crossing below the
 * critical reserve boundary where reversibility becomes merely nominal.
 */
interface Props {
  level?: "h2" | "h3";
}

const { level = "h3" }: Props = Astro.props;
const Heading = level;
---

<figure class="state-diagram" aria-labelledby="capture-ratchet-title">
  <figcaption>
    <p class="eyebrow">Theory, drawn</p>
    <Heading id="capture-ratchet-title">
      The Capture Ratchet: Erosion of Institutional Reserve
    </Heading>
    <p class="muted">
      Capture is the gradual disappearance of everything an institution needs in order to stop. Law XII mandates an inviolable reserve boundary above nominal kill-switches.
    </p>
  </figcaption>

  <div class="diagram-scroll">
    <svg
      viewBox="0 0 920 540"
      role="img"
      class="state-diagram__svg"
      aria-label="Graph showing system throughput and reliance rising over time while retained competence and withdrawal feasibility decline below the Law XII reserve boundary into institutional capture."
    >
      <defs>
        <marker
          id="ratchet-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--border)" />
        </marker>
        <marker
          id="accent-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
        <marker
          id="danger-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--status-danger)" />
        </marker>
        <linearGradient id="capture-zone-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--status-danger)" stop-opacity="0.08" />
          <stop offset="100%" stop-color="var(--status-danger)" stop-opacity="0.22" />
        </linearGradient>
      </defs>

      {/* Background Capture Zone (Below Reserve Floor) */}
      <rect x="80" y="300" width="800" height="200" fill="url(#capture-zone-gradient)" rx="4" />
      <text x="92" y="324" class="state-diagram__clause" fill="var(--status-danger)">
        Zone of Irreversible Capture
      </text>
      <text x="92" y="342" class="state-diagram__clause" fill="var(--status-danger)">
        (Nominal Reversibility Only)
      </text>

      {/* Axis Lines */}
      <line x1="80" y1="500" x2="880" y2="500" stroke="var(--border)" stroke-width="2" marker-end="url(#ratchet-arrow)" />
      <line x1="80" y1="500" x2="80" y2="30" stroke="var(--border)" stroke-width="2" marker-end="url(#ratchet-arrow)" />

      {/* Axis Labels */}
      <text x="880" y="528" text-anchor="end" class="state-diagram__clause">Time / Successive "Rational Economies" →</text>
      <text x="90" y="22" text-anchor="start" class="state-diagram__clause">Level / Capacity ↑</text>

      {/* Law XII Boundary: Critical Reserve Floor */}
      <line x1="80" y1="300" x2="880" y2="300" stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 4" />
      <text x="92" y="230" class="state-diagram__state" fill="var(--accent-strong)">
        Law XII Floor: Minimum Retained
      </text>
      <text x="92" y="251" class="state-diagram__state" fill="var(--accent-strong)">
        Contestability Reserve
      </text>
      <text x="92" y="272" class="state-diagram__label">
        (Expertise, Parallel Process, Unbundled Records)
      </text>

      {/* Curve 1: Throughput & Reliance (Rising) */}
      <path
        d="M 100 460 Q 300 440 500 250 T 850 70"
        stroke="var(--accent)"
        stroke-width="3"
        fill="none"
      />
      <text x="850" y="52" text-anchor="end" class="state-diagram__state" fill="var(--accent-strong)">
        Operational Reliance & Throughput ↑
      </text>

      {/* Curve 2: Retained Internal Competence & Withdrawal Feasibility (Declining) */}
      <path
        d="M 100 70 Q 300 90 500 270 T 850 440"
        stroke="var(--status-danger)"
        stroke-width="3"
        fill="none"
      />
      <text x="875" y="470" text-anchor="end" class="state-diagram__state" fill="var(--status-danger)">
        Retained Withdrawal Capacity ↓
      </text>

      {/* Phase markers sit on the withdrawal-capacity curve */}
      {/* Phase 1: Adoption */}
      <line x1="140" y1="76" x2="140" y2="130" stroke="var(--border)" stroke-width="1.5" />
      <circle cx="140" cy="76" r="4" fill="var(--text)" />
      <rect x="105" y="130" width="175" height="68" rx="6" fill="var(--panel)" stroke="var(--border)" />
      <text x="192" y="153" text-anchor="middle" class="state-diagram__state">1. Adoption</text>
      <text x="192" y="172" text-anchor="middle" class="state-diagram__label">High internal reserve;</text>
      <text x="192" y="189" text-anchor="middle" class="state-diagram__label">manual fallback active</text>

      {/* Phase 2: Rational Economies */}
      <line x1="360" y1="164" x2="360" y2="108" stroke="var(--border)" stroke-width="1.5" />
      <circle cx="360" cy="164" r="4" fill="var(--text)" />
      <rect x="290" y="40" width="200" height="68" rx="6" fill="var(--panel)" stroke="var(--border)" />
      <text x="390" y="63" text-anchor="middle" class="state-diagram__state">2. "Economies"</text>
      <text x="390" y="82" text-anchor="middle" class="state-diagram__label">Staff reallocated,</text>
      <text x="390" y="99" text-anchor="middle" class="state-diagram__label">manual routes deprecated</text>

      {/* Phase 3: The Ratchet Crosses Line */}
      <line x1="535" y1="300" x2="665" y2="200" stroke="var(--status-danger)" stroke-width="1.5" />
      <circle cx="535" cy="300" r="5" fill="var(--status-danger)" />
      <rect x="650" y="150" width="225" height="50" rx="6" fill="var(--panel)" stroke="var(--status-danger)" />
      <text x="762" y="170" text-anchor="middle" class="state-diagram__clause" fill="var(--status-danger)">Critical Crossing</text>
      <text x="762" y="189" text-anchor="middle" class="state-diagram__label">Reversibility becomes nominal</text>

      {/* Phase 4: Institutional Capture */}
      <rect x="425" y="390" width="185" height="70" rx="6" fill="var(--surface)" stroke="var(--status-danger)" />
      <text x="517" y="413" text-anchor="middle" class="state-diagram__state" fill="var(--status-danger)">4. Full Capture</text>
      <text x="517" y="432" text-anchor="middle" class="state-diagram__label">Switching cost ruinous;</text>
      <text x="517" y="450" text-anchor="middle" class="state-diagram__label">governance surrendered</text>
    </svg>
  </div>
</figure>
