---

<div class="safeguard-matrix" data-safeguard-matrix>
  <div
    class="safeguard-matrix__filter"
    role="tablist"
    aria-label="Filter safeguards"
  >
    <button
      type="button"
      class="matrix-tab matrix-tab--active"
      data-matrix-filter="all"
      role="tab"
      aria-selected="true"
    >
      All safeguards
    </button>
    {
      matrix.map((row) => (
        <button
          type="button"
          class="matrix-tab"
          data-matrix-filter={row.id}
          role="tab"
          aria-selected="false"
        >
          <StateVariableGlyph
            variable={row.id}
            label={row.name}
            size="0.95em"
          />
        </button>
      ))
    }
  </div>

  <div class="safeguard-matrix__grid">
    {
      matrix.map((row) => (
        <article class="matrix-card" data-matrix-card={row.id}>
          <header class="matrix-card__header">
            <div class="matrix-card__title-row">
              <h3>
                <StateVariableGlyph variable={row.id} label={row.name} />
              </h3>
              <span class="pill pill--ghost small">{row.question}</span>
            </div>
            <p class="matrix-card__drift small muted">
              <strong>Failure drift:</strong> {row.driftWarning}
            </p>
          </header>

          <div class="matrix-card__columns">
            <div class="matrix-col">
              <span class="matrix-col__label">Governing laws</span>
              <ul class="matrix-list">
                {row.laws.map((law) => (
                  <li>
                    <a href={law.href} class="matrix-link">
                      <strong>{law.numeral}:</strong> {law.statement}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div class="matrix-col">
              <span class="matrix-col__label">Core standards</span>
              <ul class="matrix-list">
                {row.standards.map((std) => (
                  <li>
                    <a href={std.href} class="matrix-link">
                      <strong>{std.id}:</strong> {std.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div class="matrix-col">
              <span class="matrix-col__label">Casebook precedent</span>
              <ul class="matrix-list">
                {row.precedents.map((precedent) => (
                  <li>
                    <a href={precedent.href} class="matrix-link">
                      <strong>{precedent.title}</strong>
                    </a>
                    <span class="matrix-col__sub">{precedent.outcome}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="matrix-col">
              <span class="matrix-col__label">Foundational theory</span>
              <ul class="matrix-list">
                {row.theory.map((item) => (
                  <li>
                    <a href={item.href} class="matrix-link">
                      <strong>{item.title}</strong>
                    </a>
                    <span class="matrix-col__sub">{item.question}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="matrix-col">
              <span class="matrix-col__label">Diagnostics & evals</span>
              <ul class="matrix-list">
                {row.diagnostics.map((diag) => (
                  <li>
                    <a href={diag.href} class="matrix-link">
                      <strong>{diag.name}</strong>
                    </a>
                    <span class="matrix-col__sub">{diag.purpose}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</div>

<script>
  function initSafeguardMatrix() {
    const containers = document.querySelectorAll<HTMLElement>(
      "[data-safeguard-matrix]",
    );
    containers.forEach((container) => {
      const tabs = container.querySelectorAll<HTMLButtonElement>(
        "[data-matrix-filter]",
      );
      const cards =
        container.querySelectorAll<HTMLElement>("[data-matrix-card]");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const filter = tab.getAttribute("data-matrix-filter");
          tabs.forEach((t) => {
            const isActive = t === tab;
            t.classList.toggle("matrix-tab--active", isActive);
            t.setAttribute("aria-selected", isActive ? "true" : "false");
          });

          cards.forEach((card) => {
            const cardId = card.getAttribute("data-matrix-card");
            const isVisible = filter === "all" || cardId === filter;
            card.style.display = isVisible ? "grid" : "none";
          });
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSafeguardMatrix, {
      once: true,
    });
  } else {
    initSafeguardMatrix();
  }
</script>

<style>
  .safeguard-matrix {
    display: grid;
    gap: var(--space-6);
  }

  .safeguard-matrix__filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-3);
  }

  .matrix-tab {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    transition: all var(--motion-fast) ease;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .matrix-tab:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .matrix-tab--active {
    background: var(--accent);
    color: var(--surface);
    border-color: var(--accent);
  }

  .matrix-tab--active:hover {
    color: var(--surface);
  }

  .safeguard-matrix__grid {
    display: grid;
    gap: var(--space-6);
  }

  .matrix-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  .matrix-card__header {
    display: grid;
    gap: var(--space-2);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-3);
  }

  .matrix-card__title-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .matrix-card__title-row h3 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .matrix-card__drift {
    margin: 0;
    color: var(--muted);
  }

  .matrix-card__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .matrix-col {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .matrix-col__label {
    font-size: var(--text-xs);
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    padding-bottom: var(--space-1);
  }

  .matrix-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .matrix-list li {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .matrix-link {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .matrix-link:hover {
    color: var(--accent);
  }

  .matrix-col__sub {
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.4;
  }
</style>
