---
/**
 * Exception learning, drawn: the same upheld challenges twice. (The theory
 * essay on absorption as concealment has its own figure, about errors staff
 * absorb before they are ever recorded; this one starts after a challenge is
 * upheld.)
 *
 * On the left, each upheld challenge goes back to the one person who brought
 * it, and the rule that produced the decision is never asked to answer. The
 * same error keeps arriving, quarter after quarter. On the right, upheld
 * challenges are counted against the rule (MEC-14). When the count reaches a
 * set number the rule goes back to its owner, is revised, and stops producing
 * the error. Same system, same errors at the start. The difference is whether
 * anyone had to count.
 *
 * One drawing per panel, so the two stack on a phone instead of the second,
 * which carries the point, sitting off-screen in a scroller.
 */
import DemoFigure from "./DemoFigure.astro";

interface Props {
  level?: "h3" | "h4";
}

const { level = "h3" }: Props = Astro.props;

const MONTHS = 36;
const EVERY = 3; // one upheld challenge a quarter
const THRESHOLD = 4; // upheld challenges that send the rule back for review

const challengeMonths = Array.from(
  { length: MONTHS / EVERY },
  (_, i) => (i + 1) * EVERY,
);
const reviewMonth = challengeMonths[THRESHOLD - 1];
const countedMonths = challengeMonths.filter((month) => month <= reviewMonth);

// Each panel is drawn on a 480 × 400 canvas.
const x0 = 40;
const panelWidth = 400;
const ruleY = 112;
const markY = 196;
const caseY = 252;
const axisY = 284;

const xAt = (month: number) => x0 + (panelWidth * month) / MONTHS;
const reviewX = xAt(reviewMonth);

const panels = [
  {
    counted: false,
    title: "Settled one case at a time",
    kicker: "each upheld challenge goes back to one person",
    marks: challengeMonths,
    label: `${challengeMonths.length} upheld challenges over ${MONTHS} months, each fixing one case. The rule never changes, and the next person meets the same error.`,
    totals: [`upheld challenges: ${challengeMonths.length}`, "rule reviews: 0"],
    note: "the next person meets the same error",
  },
  {
    counted: true,
    title: "Counted against the rule",
    kicker: `${THRESHOLD} upheld challenges send the rule to its owner`,
    marks: countedMonths,
    label: `The same challenges, counted against the rule. At the ${THRESHOLD}th, in month ${reviewMonth}, the rule goes back to its owner and is revised, and no challenge is upheld after it.`,
    totals: [
      `upheld challenges: ${countedMonths.length}`,
      "rule reviews: 1, none upheld after it",
    ],
    note: "its owner had to revise it or publish why not",
  },
];
---

<DemoFigure
  id="exception-learning-figure"
  class="rule-count"
  level={level}
  title="The same upheld challenges, settled and counted"
  lede={`One upheld challenge a quarter for ${MONTHS / 12} years. In the first drawing, each is settled as one person's case. In the second, each is also counted against the rule that produced it, and ${THRESHOLD} send the rule back to its owner.`}
>
  <div class="demo-figure__frame rule-count__panels">
    {
      panels.map((panel) => (
        <svg
          viewBox="0 0 480 400"
          role="img"
          aria-label={`${panel.title}. ${panel.label}`}
          class="rule-count__svg"
        >
          {panel.counted && (
            <defs>
              <marker
                id="rule-count-arrow"
                viewBox="0 0 10 10"
                refX="8"
                refY="5"
                markerWidth="7"
                markerHeight="7"
                orient="auto-start-reverse"
              >
                <path d="M 0 0 L 10 5 L 0 10 z" class="rule-count__arrowhead" />
              </marker>
            </defs>
          )}
          <text x={x0} y={34} class="demo-figure__svg-title">
            {panel.title}
          </text>
          <text x={x0} y={58} class="demo-figure__svg-label">
            {panel.kicker}
          </text>

          <text x={x0} y={ruleY - 16} class="demo-figure__svg-label">
            the rule
          </text>
          {panel.counted ? (
            <g>
              <line
                x1={x0}
                x2={reviewX}
                y1={ruleY}
                y2={ruleY}
                class="rule-count__rule"
              />
              <path
                d={`M ${reviewX} ${ruleY} L ${x0 + panelWidth} ${ruleY}`}
                class="rule-count__rule rule-count__rule--revised rule-count__draw"
                pathLength={100}
              />
              <text
                x={reviewX + 8}
                y={ruleY - 16}
                class="demo-figure__svg-mono rule-count__late"
              >
                revised, month {reviewMonth}
              </text>
            </g>
          ) : (
            <g>
              <line
                x1={x0}
                x2={x0 + panelWidth}
                y1={ruleY}
                y2={ruleY}
                class="rule-count__rule"
              />
              <text
                x={x0 + panelWidth}
                y={ruleY - 16}
                text-anchor="end"
                class="demo-figure__svg-mono"
              >
                unchanged
              </text>
            </g>
          )}

          <g class="rule-count__marks">
            {panel.marks.map((month, i) => (
              <g>
                <line
                  x1={xAt(month)}
                  x2={xAt(month)}
                  y1={markY + 9}
                  y2={caseY - 4}
                  class="rule-count__to-case"
                />
                <circle
                  cx={xAt(month)}
                  cy={caseY}
                  r="3.5"
                  class="rule-count__case"
                />
                <circle
                  cx={xAt(month)}
                  cy={markY}
                  r="9"
                  class="rule-count__challenge"
                />
                {panel.counted && (
                  <text
                    x={xAt(month)}
                    y={markY + 4.5}
                    text-anchor="middle"
                    class="rule-count__count"
                  >
                    {i + 1}
                  </text>
                )}
              </g>
            ))}
          </g>
          <text x={x0} y={caseY + 24} class="demo-figure__svg-label">
            one case fixed per challenge
          </text>

          {panel.counted && (
            <path
              d={`M ${reviewX} ${markY - 11} L ${reviewX} ${ruleY + 8}`}
              class="rule-count__to-rule rule-count__draw"
              marker-end="url(#rule-count-arrow)"
              pathLength={100}
            />
          )}

          <line
            x1={x0}
            x2={x0 + panelWidth}
            y1={axisY}
            y2={axisY}
            class="rule-count__axis"
          />
          {[0, 12, 24, 36].map((month) => (
            <text
              x={xAt(month)}
              y={axisY + 22}
              text-anchor={
                month === 0 ? "start" : month === 36 ? "end" : "middle"
              }
              class="demo-figure__svg-label"
            >
              {month === 0 ? "month 0" : month}
            </text>
          ))}

          {panel.totals.map((line, i) => (
            <text x={x0} y={axisY + 56 + i * 24} class="demo-figure__svg-mono">
              {line}
            </text>
          ))}
          <text x={x0} y={axisY + 104} class="demo-figure__svg-label">
            {panel.note}
          </text>
        </svg>
      ))
    }
  </div>
  <p class="demo-figure__note">
    A demonstration, not a measurement of any real system. The trigger is
    <a href="/mechanisms/patterns/policy-review-triggers"
      >MEC-14, policy review triggers</a
    >; the obligation to revise within a clock is
    <a href="/standards/std-07-revisable-delegation-record">STD-07</a>'s. The
    first system fixes every case it is shown and never learns.
  </p>
</DemoFigure>
