---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "./PageIntro.astro";

interface AnchorLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  permalink: string;
  eyebrow?: string;
  anchorLinks: AnchorLink[];
  version?: string;
  lastUpdated?: string;
  seoTitle?: string;
  publishedTime?: string;
  modifiedTime?: string;
  mainClass?: string;
  jsonAlternates?: Array<{ href: string; title: string }>;
  /** "route" when the document emits its own page-level JSON-LD. */
  pageSchema?: "layout" | "route";
}

const {
  title,
  description,
  eyebrow = "Standard",
  anchorLinks,
  version,
  lastUpdated,
  seoTitle,
  publishedTime,
  modifiedTime,
  mainClass,
  jsonAlternates,
  pageSchema,
} = Astro.props as Props;
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  pageSchema={pageSchema}
  mainClass={mainClass}
  jsonAlternates={jsonAlternates}
>
  <slot name="pre-intro" />
  <PageIntro
    eyebrow={eyebrow}
    title={title}
    description={description}
    anchorLinks={anchorLinks}
    version={version}
    lastUpdated={lastUpdated}
    illustration="standards"
  />
  <slot />
</BaseLayout>
