---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "./PageIntro.astro";

interface AnchorLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  permalink: string;
  eyebrow?: string;
  anchorLinks: AnchorLink[];
  version?: string;
  lastUpdated?: string;
  seoTitle?: string;
  publishedTime?: string;
  modifiedTime?: string;
  mainClass?: string;
  jsonAlternates?: Array<{ href: string; title: string }>;
  /** "route" when the document emits its own page-level JSON-LD. */
  pageSchema?: "layout" | "route";
}

const {
  title,
  description,
  permalink,
  eyebrow = "Standard",
  anchorLinks,
  version,
  lastUpdated,
  seoTitle,
  publishedTime,
  modifiedTime,
  mainClass,
  jsonAlternates,
  pageSchema,
} = Astro.props as Props;

// The critiques have no index of their own; the framework map lists them,
// and a crumb derived from the path would point at a page that does not exist.
const breadcrumbItems = permalink.startsWith("/standards/critiques/")
  ? [
      { name: "Home", url: "/" },
      { name: "Standards", url: "/standards" },
      {
        name: "Framework map for buyers and auditors",
        url: "/standards/enforceable-governance-crosswalks",
      },
      { name: title, url: permalink },
    ]
  : undefined;
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  pageSchema={pageSchema}
  mainClass={mainClass}
  jsonAlternates={jsonAlternates}
  breadcrumbItems={breadcrumbItems}
>
  <slot name="pre-intro" />
  <PageIntro
    eyebrow={eyebrow}
    title={title}
    description={description}
    anchorLinks={anchorLinks}
    version={version}
    lastUpdated={lastUpdated}
  />
  <slot />
</BaseLayout>
