---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "./PageIntro.astro";

interface AnchorLink {
  href: string;
  label: string;
}

interface PanelCopy {
  eyebrow: string;
  title: string;
  description: string;
  link?: {
    label: string;
    href: string;
  };
}

interface Props {
  title: string;
  description: string;
  permalink: string;
  eyebrow?: string;
  anchorLinks: AnchorLink[];
  version?: string;
  lastUpdated?: string;
  panelCopy?: PanelCopy;
  seoTitle?: string;
  publishedTime?: string;
  modifiedTime?: string;
  mainClass?: string;
  jsonAlternates?: Array<{ href: string; title: string }>;
}

const {
  title,
  description,
  permalink,
  eyebrow = "Standard",
  anchorLinks,
  version,
  lastUpdated,
  panelCopy,
  seoTitle,
  publishedTime,
  modifiedTime,
  mainClass,
  jsonAlternates,
} = Astro.props as Props;
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  mainClass={mainClass}
  jsonAlternates={jsonAlternates}
>
  <slot name="pre-intro" />
  <PageIntro
    eyebrow={eyebrow}
    title={title}
    description={description}
    permalink={permalink}
    anchorLinks={anchorLinks}
    version={version}
    lastUpdated={lastUpdated}
    panelCopy={panelCopy}
  />
  <slot />
</BaseLayout>
