---
import { randomUUID } from "node:crypto";
import SearchDialog from "./search/SearchDialog.astro";
import SearchTrigger from "./search/SearchTrigger.astro";

interface Props {
  scope?: "desktop" | "mobile";
  label?: string;
  shortcut?: string;
  includeDialog?: boolean;
}

const { scope, label, shortcut, includeDialog = true }: Props = Astro.props;
const resolvedLabel =
  label ?? (scope === "mobile" ? "Search" : "Search the library…");
// `undefined` here does not suppress the badge: an omitted prop falls through
// to SearchTrigger's own `shortcut = "/"` default, so the mobile trigger has
// been advertising a keyboard shortcut on touch devices. An empty string is
// falsy at the render site and does not trigger the default.
const resolvedShortcut = shortcut ?? (scope === "mobile" ? "" : "⌘K");
const instanceId = randomUUID();
const dialogTitleId = `search-dialog-title-${instanceId}`;
const inputId = `search-input-${instanceId}`;
const helpTextId = `search-help-text-${instanceId}`;
---

{
  includeDialog ? (
    <div
      class="search-container"
      data-search-container
      data-search-scope={scope}
    >
      <SearchTrigger label={resolvedLabel} shortcut={resolvedShortcut} />
      <SearchDialog
        dialogTitleId={dialogTitleId}
        inputId={inputId}
        helpTextId={helpTextId}
      />
    </div>
  ) : (
    <div class="search-container" data-search-scope={scope}>
      <SearchTrigger
        label={resolvedLabel}
        shortcut={resolvedShortcut}
        proxy={true}
      />
    </div>
  )
}
