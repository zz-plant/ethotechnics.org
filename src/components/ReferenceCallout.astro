---
import ActionIcon from "./ActionIcon.astro";

interface Props {
  title: string;
  summary: string;
  href: string;
  /** Visible link text; it must make sense out of context. */
  linkLabel: string;
  /** Only when the visible text needs more for a screen reader. */
  ariaLabel?: string;
}

const { title, summary, href, linkLabel, ariaLabel }: Props = Astro.props;

const headingId = `callout-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const isExternal = href.startsWith("http");
const linkAriaLabel = ariaLabel;
---

<aside class="callout reference-callout" aria-labelledby={headingId}>
  <h3 id={headingId}>{title}</h3>
  <p class="muted">{summary}</p>
  <a
    class="reference-callout__link"
    href={href}
    aria-label={linkAriaLabel}
    rel={isExternal ? "noopener noreferrer" : undefined}
    target={isExternal ? "_blank" : undefined}
  >
    {linkLabel}
    {
      isExternal ? (
        <ActionIcon action="external" />
      ) : (
        <span aria-hidden="true">&rarr;</span>
      )
    }
  </a>
</aside>
