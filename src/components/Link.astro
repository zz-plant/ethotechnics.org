---
export interface Props {
  context?: "body" | "nav" | "footer" | "card" | "plain";
  href: string;
  class?: string;
}
const { context = "body", class: className, ...rest } = Astro.props;
const linkClass = ["link", `link--${context}`, className]
  .filter(Boolean)
  .join(" ");
---

<a class={linkClass} {...rest}><slot /></a>
<style>
  .link {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .link:hover,
  .link:focus-visible {
    color: var(--accent-strong);
  }
  .link--body {
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0 2px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    padding-bottom: 2px;
    transition:
      background-size 0.3s cubic-bezier(0.25, 1, 0.5, 1),
      color 0.2s ease;
  }
  .link--body:hover,
  .link--body:focus-visible {
    background-size: 100% 2px;
  }
  .link--nav {
    background-image: none;
    padding-bottom: 0;
  }
  .link--nav:hover,
  .link--nav:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .link--footer {
    background-image: none;
    padding-bottom: 0;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--muted) 40%, transparent);
    text-underline-offset: 0.25em;
  }
  .link--footer:hover {
    text-decoration-color: var(--muted);
  }
  .link--card {
    color: inherit;
    background-size: 0 1px;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    padding-bottom: 2px;
    transition: background-size 0.2s ease;
  }
  .link--card:hover,
  .link--card:focus-visible {
    background-size: 100% 1px;
    color: inherit;
  }
  .link--plain {
    background-image: none;
    padding-bottom: 0;
  }
</style>
