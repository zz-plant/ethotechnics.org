---
import InlineScript from "./InlineScript.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CardGrid from "./CardGrid.astro";
import CardItem from "./CardItem.astro";
import NextStep from "./NextStep.astro";
import PageIntro from "./PageIntro.astro";
import SectionBlock from "./SectionBlock.astro";
import { getExplainerSeoMetadata } from "../utils/explainer-metadata";

interface CtaLink {
  /** The kind of page the link opens: standard, evidence pack, eval. */
  eyebrow: string;
  title: string;
  description: string;
  href: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface DistinctSignal {
  title: string;
  detail: string;
}

interface Props {
  title: string;
  /** The <title>, when it should carry more than the heading. */
  seoTitle?: string;
  description: string;
  permalink: string;
  glossary: {
    href: string;
    label: string;
  };
  definition: string[];
  example: string;
  distinctSignals: DistinctSignal[];
  ctas: CtaLink[];
  faqs: FaqItem[];
  hasDiagram?: boolean;
}

const {
  title,
  seoTitle,
  description,
  permalink,
  glossary,
  definition,
  example,
  distinctSignals,
  ctas,
  faqs,
  hasDiagram = false,
}: Props = Astro.props;
const explainerSeoMetadata = getExplainerSeoMetadata(permalink);
// "A hypothetical case" and "Where the standards use it" were sections of
// their own, most under fifty words. The case now closes the definition it
// illustrates, and the links close what to look for.
const anchorLinks = [
  { href: "#definition", label: "Definition" },
  ...(hasDiagram ? [{ href: "#mechanism", label: "Visual model" }] : []),
  { href: "#distinct-signals", label: "What to look for" },
  { href: "#faq", label: "Common questions" },
];

// Each link runs into its description. It names its kind only when its title
// and description don't: "STD-01 evidence pack" needs no "(evidence pack)".
const standardLinks = ctas.map(({ eyebrow, title, description, href }) => {
  const text = `${title} ${description}`.toLowerCase();
  const kind = eyebrow.toLowerCase();
  const named = kind
    .split(/\s+/)
    .every((word) => text.includes(word.replace(/s$/, "")));
  const join = !named ? ` (${kind}). ` : /[.?!]$/.test(title) ? " " : ". ";
  return { href, title, after: `${join}${description}` };
});

const pageUrl = Astro.site
  ? new URL(permalink, Astro.site).toString()
  : permalink;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  // The layout's WebPage owns the page URL as its @id. Reusing it here gave
  // one entity two types.
  "@id": `${pageUrl}#faq`,
  mainEntityOfPage: { "@id": pageUrl },
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
const structuredDataJson = JSON.stringify(structuredData, null, 2);
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  publishedTime={explainerSeoMetadata.publishedTime}
  modifiedTime={explainerSeoMetadata.modifiedTime}
  structuredDataType="tech-article"
>
  <PageIntro
    eyebrow="Explainer"
    title={title}
    description={description}
    anchorLinks={anchorLinks}
  />

  <SectionBlock id="definition" eyebrow="Definition" title="Definition">
    {definition.map((paragraph) => <p>{paragraph}</p>)}
    <p><strong>A hypothetical case.</strong> {example}</p>
    <p class="small muted">
      In the glossary: <a href={glossary.href}>{glossary.label}</a>.
    </p>
  </SectionBlock>

  {
    hasDiagram && (
      <section id="mechanism" class="section section--alt">
        <slot />
      </section>
    )
  }

  <SectionBlock
    id="distinct-signals"
    eyebrow="In practice"
    title="What to look for"
    variant={hasDiagram ? "default" : "alt"}
  >
    <CardGrid className="grid--three">
      {
        distinctSignals.map((signal) => (
          <CardItem
            title={signal.title}
            description={signal.detail}
            descriptionTone="default"
          />
        ))
      }
    </CardGrid>
    <div class="explainer-uses">
      <p class="explainer-uses__label">Where the standards use it:</p>
      <ul>
        {
          standardLinks.map((link) =>
            // Astro renders a line break after </a> as a space before the
            // period, so the line is kept whole.
            // prettier-ignore
            <li><a href={link.href}>{link.title}</a>{link.after}</li>,
          )
        }
      </ul>
    </div>
  </SectionBlock>

  <SectionBlock
    id="faq"
    eyebrow="Questions"
    title="Common questions"
    variant={hasDiagram ? "alt" : "default"}
  >
    <CardGrid className="grid--two">
      {
        faqs.map((faq) => (
          <CardItem
            title={faq.question}
            description={faq.answer}
            descriptionTone="default"
          />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <NextStep topic={[title, permalink]} />

  <InlineScript type="application/ld+json" code={structuredDataJson} />
</BaseLayout>

<style>
  .explainer-uses {
    margin-top: var(--space-6);
    max-width: 70ch;
  }

  .explainer-uses__label {
    font-weight: 600;
  }

  .explainer-uses ul {
    margin: 0;
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }
</style>
