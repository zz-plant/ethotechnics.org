---
import InlineScript from "./InlineScript.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CardGrid from "./CardGrid.astro";
import CardItem from "./CardItem.astro";
import NextStep from "./NextStep.astro";
import PageIntro from "./PageIntro.astro";
import SectionBlock from "./SectionBlock.astro";
import { getExplainerSeoMetadata } from "../utils/explainer-metadata";

interface CtaLink {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  ctaLabel: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface DistinctSignal {
  title: string;
  detail: string;
}

interface Props {
  title: string;
  description: string;
  permalink: string;
  glossary: {
    href: string;
    label: string;
  };
  definition: string[];
  example: string;
  distinctSignals: DistinctSignal[];
  ctas: CtaLink[];
  faqs: FaqItem[];
  hasDiagram?: boolean;
}

const {
  title,
  description,
  permalink,
  glossary,
  definition,
  example,
  distinctSignals,
  ctas,
  faqs,
  hasDiagram = false,
}: Props = Astro.props;
const explainerSeoMetadata = getExplainerSeoMetadata(permalink);
const anchorLinks = [
  { href: "#definition", label: "Definition" },
  ...(hasDiagram ? [{ href: "#mechanism", label: "Visual Model" }] : []),
  { href: "#example", label: "Example use case" },
  { href: "#distinct-signals", label: "Distinct implementation signals" },
  { href: "#artifacts", label: "Related artifacts" },
  { href: "#faq", label: "FAQ" },
];

const pageUrl = Astro.site
  ? new URL(permalink, Astro.site).toString()
  : permalink;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": pageUrl,
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
const structuredDataJson = JSON.stringify(structuredData, null, 2);
---

<BaseLayout
  title={title}
  description={description}
  publishedTime={explainerSeoMetadata.publishedTime}
  modifiedTime={explainerSeoMetadata.modifiedTime}
  structuredDataType="tech-article"
>
  <PageIntro
    eyebrow="Explainer"
    title={title}
    description={description}
    anchorLinks={anchorLinks}
  />

  <SectionBlock
    id="definition"
    eyebrow="Definition"
    title="Short definition"
    description="Two-to-four sentences you can drop into briefs or specs."
  >
    {definition.map((paragraph) => <p>{paragraph}</p>)}
    <p class="small muted">
      Canonical entry: <a href={glossary.href}>{glossary.label}</a> in the glossary.
    </p>
  </SectionBlock>

  {
    hasDiagram && (
      <SectionBlock
        id="mechanism"
        eyebrow="Architecture"
        title="Mechanism in Operation"
        description="Visual model of operational states, transitions, boundaries, and failure points."
        variant="alt"
      >
        <slot />
      </SectionBlock>
    )
  }

  <SectionBlock
    id="example"
    eyebrow="Example"
    title="Example use case"
    description="A concrete scenario to ground the term in operations."
    variant={hasDiagram ? "default" : "alt"}
  >
    <p>{example}</p>
  </SectionBlock>

  <SectionBlock
    id="distinct-signals"
    eyebrow="Implementation"
    title="Distinct implementation signals"
    description="Unique operational detail to help this concept stand on its own in policy, procurement, and review workflows."
  >
    <CardGrid className="grid--three">
      {
        distinctSignals.map((signal) => (
          <CardItem
            title={signal.title}
            description={signal.detail}
            descriptionTone="default"
          />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="artifacts"
    eyebrow="CTAs"
    title="Related artifacts"
    description="Standards, bindings, and evidence packs to move from concept to adoption."
  >
    <CardGrid className="grid--three">
      {
        ctas.map((cta) => (
          <CardItem
            eyebrow={cta.eyebrow}
            title={cta.title}
            description={cta.description}
          >
            <p slot="footer">
              <a class="button ghost button--compact" href={cta.href}>
                {cta.ctaLabel}
              </a>
            </p>
          </CardItem>
        ))
      }
    </CardGrid>
  </SectionBlock>

  <SectionBlock
    id="faq"
    eyebrow="FAQ"
    title="Quick answers"
    description="Short replies for common implementation questions."
    variant="alt"
  >
    <CardGrid className="grid--two">
      {
        faqs.map((faq) => (
          <CardItem
            title={faq.question}
            description={faq.answer}
            descriptionTone="default"
          />
        ))
      }
    </CardGrid>
  </SectionBlock>

  <NextStep topic={[title, permalink]} />

  <InlineScript type="application/ld+json" code={structuredDataJson} />
</BaseLayout>
