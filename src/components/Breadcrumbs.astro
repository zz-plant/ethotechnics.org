---
import type { BreadcrumbItem } from "../lib/breadcrumbs";

interface Props {
  items: BreadcrumbItem[];
  className?: string;
}

const { items, className }: Props = Astro.props;

// The trail shows where the page sits, not what it is: the h1 directly below
// already names it, and the current-page crumb carried the full SEO title, so
// on a top-level page the reader met "Home / Ethotechnics glossary — Ethical
// technology, AI governance, and moral system terms" (three lines on a phone)
// and then the same name again as the heading. Ancestors only, and nothing
// at all when the only ancestor is Home -- the wordmark is that link. The
// BreadcrumbList in the page's JSON-LD still carries the full trail.
const ancestors = items.slice(0, -1);
---

{
  ancestors.length > 1 && (
    <nav
      class:list={["breadcrumbs", className]}
      aria-label="Breadcrumb"
      data-breadcrumbs
    >
      <ol>
        {ancestors.map((item, index) => (
          <li>
            <a href={item.href} class="breadcrumbs__link">
              {index === 0 && (
                <svg
                  class="breadcrumbs__home-icon"
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
              )}
              <span>{item.name}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
