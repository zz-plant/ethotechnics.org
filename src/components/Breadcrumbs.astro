---
import type { BreadcrumbItem } from "../lib/breadcrumbs";

interface Props {
  items: BreadcrumbItem[];
  className?: string;
}

const { items, className }: Props = Astro.props;
---

{
  items.length > 1 && (
    <nav
      class:list={["breadcrumbs", className]}
      aria-label="Breadcrumb"
      data-breadcrumbs
    >
      <ol>
        {items.map((item, index) => (
          <li>
            {index === items.length - 1 ? (
              <span aria-current="page" class="breadcrumbs__current">
                {item.name}
              </span>
            ) : (
              <a href={item.href} class="breadcrumbs__link">
                {index === 0 && (
                  <svg
                    class="breadcrumbs__home-icon"
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                  </svg>
                )}
                <span>{item.name}</span>
              </a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
