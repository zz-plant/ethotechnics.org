---
import { getStandardBySlug } from "../content/standards";
import { formatDatesInText } from "../utils/dates";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const standard = getStandardBySlug(slug);

if (!standard) {
  throw new Error(`Missing standard metadata for slug: ${slug}`);
}

const statusClass = standard.status.toLowerCase();
---

<aside
  class="standard-status panel stack-sm"
  aria-label="Standard publication status"
>
  <p class="eyebrow">Publication status</p>
  <p class="standard-status__headline">
    <span class={`status-badge status-badge--${statusClass}`}
      >{standard.status}</span
    >
    <span class="muted">{standard.id} · v{standard.version}</span>
  </p>
  <p class="muted small">
    Effective: {formatDatesInText(standard.effectiveDate)}
  </p>
  <p class="muted small">Stable criteria: {standard.stableCriteria}</p>
  {
    /* The changelog entries were listed here, above the text they revise.
       They are under "Publication history" at the end of the standard. */
  }
  {
    standard.changelogHref && (
      <p class="small">
        <a href={standard.changelogHref}>Publication history &rarr;</a>
      </p>
    )
  }
  {
    standard.deprecatedBy && standard.deprecatedBy.length > 0 && (
      <p class="muted small">
        Deprecated by:{" "}
        {standard.deprecatedBy.map((replacement, index) => (
          <Fragment>
            {index > 0 && ", "}
            <a href={`/standards/${replacement.slug}`}>{replacement.id}</a>
          </Fragment>
        ))}
      </p>
    )
  }
</aside>
