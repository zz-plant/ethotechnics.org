---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionIcon from "./ActionIcon.astro";
import ValidatorMicroDiagram from "./ValidatorMicroDiagram.astro";
import { validatorsContent } from "../content/validators";

/**
 * One validator's page: its form and report card, built from its entry in
 * content/validators.ts. The page supplies its intro as the default slot and
 * its scoring rule through `initValidatorForm`.
 */
interface Props {
  id: string;
  metaTitle: string;
  metaDescription: string;
  variant: "burden" | "latency" | "risk";
  defaults: Record<string, number>;
  fix: { href: string; label: string };
}

const { id, metaTitle, metaDescription, variant, defaults, fix }: Props =
  Astro.props;

const validator = validatorsContent.validators.find(
  (entry) => entry.id === id,
)!;
const siteBase = Astro.site ? Astro.site.toString() : Astro.url.origin;
const breadcrumbItems = [
  { name: "Home", url: new URL("/", siteBase).toString() },
  { name: "Validators", url: new URL("/validators", siteBase).toString() },
  {
    name: validator.title,
    url: new URL(`/validators/${validator.slug}`, siteBase).toString(),
  },
];
const fieldId = (name: string) => `${variant}-${name}`;
const greenSummary = validator.thresholds.find(
  (threshold) => threshold.level === "green",
)?.summary;
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  mainClass="page page--wide"
  breadcrumbItems={breadcrumbItems}
  structuredDataType="webpage"
  publishedTime="2026-01-10"
>
  <section class="validator">
    <header class="validator__header">
      <div>
        <p class="validator__id">{validator.id}</p>
        <h1>{validator.title}</h1>
        <p class="muted"><slot /></p>
      </div>
      <a class="validator__standard" href="/standards/std-01-temporal-rights">
        Linked standard: {validator.standardRef}
      </a>
    </header>

    <ValidatorMicroDiagram variant={variant} />

    <slot name="before-form" />

    <form
      class="validator__form"
      data-validator-form
      data-validator-meta={JSON.stringify(validator)}
    >
      {
        validator.inputs.map((field) =>
          field.type === "number" ? (
            <label class="validator__field">
              {field.label}
              <input
                id={fieldId(field.name)}
                type="number"
                name={field.name}
                min={field.min}
                value={defaults[field.name]}
                required
              />
            </label>
          ) : (
            <label class="validator__field">
              {`${field.label}?`}
              <select id={fieldId(field.name)} name={field.name}>
                <option value="yes" selected>
                  Yes
                </option>
                <option value="no">No</option>
              </select>
            </label>
          ),
        )
      }
      <button class="button primary" type="submit">Generate report card</button>
    </form>

    <div class="validator__report" data-validator-report hidden>
      <div class="validator__status" data-validator-status>
        <span class="status-pill status-pill--green" data-validator-pill>
          Green
        </span>
        <output
          class="validator__status-text"
          data-validator-output
          for={validator.inputs.map((field) => fieldId(field.name)).join(" ")}
        >
          {greenSummary}
        </output>
      </div>
      <p class="validator__recommendation">
        Fix this using <a href={fix.href}>{fix.label}</a>.
      </p>
      <button class="button ghost" type="button" data-validator-download>
        <ActionIcon action="download" />
        Download JSON
      </button>
    </div>
    {
      !Astro.slots.has("before-form") && (
        <p class="muted validator__see-also">
          See also: <a href="/standards">Standards</a> &middot;{" "}
          <a href="/mechanisms">Mechanisms</a>
        </p>
      )
    }
  </section>
</BaseLayout>
