---
import { resolveSemanticContext } from "../utils/semantic-graph";

interface Props {
  entityId: string;
  className?: string;
}

const { entityId, className = "" } = Astro.props;
const context = resolveSemanticContext(entityId);

if (!context) {
  return null;
}

const hasConnections =
  context.diagnostics.length > 0 ||
  context.failureModes.length > 0 ||
  context.standards.length > 0 ||
  context.regulatoryCrosswalks.length > 0;

if (!hasConnections) {
  return null;
}
---

<aside
  class={`semantic-connections ${className}`}
  aria-label="Connected standards and tools"
>
  <div class="semantic-connections__header">
    <h3 class="semantic-connections__title">Connected standards and tools</h3>
  </div>

  <div class="semantic-connections__grid">
    {
      context.diagnostics.length > 0 && (
        <div class="semantic-connections__column">
          <span class="semantic-connections__label">Tools to run</span>
          <div class="semantic-connections__list">
            {context.diagnostics.slice(0, 3).map((diag) => (
              <a
                href={diag.href}
                class="semantic-connections__card semantic-connections__card--tool"
              >
                <strong class="semantic-connections__card-title">
                  {diag.title}
                </strong>
                <p class="semantic-connections__card-desc">
                  {diag.description}
                </p>
                <span class="semantic-connections__card-action">
                  Launch tool &rarr;
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      context.failureModes.length > 0 && (
        <div class="semantic-connections__column">
          <span class="semantic-connections__label">
            Failure modes it addresses
          </span>
          <div class="semantic-connections__list">
            {context.failureModes.slice(0, 3).map((fm) => (
              <a
                href={fm.href}
                class="semantic-connections__card semantic-connections__card--risk"
              >
                <strong class="semantic-connections__card-title">
                  {fm.title}
                </strong>
                <p class="semantic-connections__card-desc">{fm.description}</p>
                <span class="semantic-connections__card-action">
                  Inspect failure mode &rarr;
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      context.standards.length > 0 && (
        <div class="semantic-connections__column">
          <span class="semantic-connections__label">Standards</span>
          <div class="semantic-connections__list">
            {context.standards.slice(0, 3).map((std) => (
              <a
                href={std.href}
                class="semantic-connections__card semantic-connections__card--spec"
              >
                <strong class="semantic-connections__card-title">
                  {std.title}
                </strong>
                <p class="semantic-connections__card-desc">{std.description}</p>
                <span class="semantic-connections__card-action">
                  Read the standard &rarr;
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</aside>

<style>
  .semantic-connections {
    margin: var(--space-8) 0 var(--space-6);
    padding: clamp(var(--space-4), 2.5vw, var(--space-5));
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-emphasis);
    box-shadow: var(--shadow-sm), var(--card-inner-highlight);
    display: grid;
    gap: var(--space-5);
  }

  .semantic-connections__header {
    display: grid;
    gap: var(--space-1);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    padding-bottom: var(--space-3);
  }

  .semantic-connections__title {
    margin: 0;
    font-size: var(--text-lg);
    font-family: var(--sans);
    font-weight: 750;
    color: var(--text);
  }

  .semantic-connections__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .semantic-connections__column {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .semantic-connections__label {
    font-size: var(--text-xs);
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }

  .semantic-connections__list {
    display: grid;
    gap: var(--space-3);
  }

  .semantic-connections__card {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-container-compact);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    transition: all var(--motion-fast) ease;
  }

  .semantic-connections__card:hover {
    border-color: var(--accent);
  }

  .semantic-connections__card-title {
    font-size: var(--text-sm);
    font-family: var(--sans);
    font-weight: 700;
    color: var(--text);
  }

  .semantic-connections__card-desc {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .semantic-connections__card-action {
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--accent);
    margin-top: var(--space-hair);
  }
</style>
