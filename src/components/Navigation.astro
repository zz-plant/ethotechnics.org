---
import NavigationDesktop from "./navigation/NavigationDesktop.astro";
import NavigationMobile from "./navigation/NavigationMobile.astro";
import { navPrimaryLinks } from "../content/navigation";

interface Props {
  currentPath?: string;
  currentHash?: string;
}

const {
  currentPath = Astro.url.pathname,
  currentHash = Astro.url.hash,
}: Props = Astro.props;
---

<nav class="nav" aria-label="Primary" data-nav>
  <div class="nav__inner container">
    <NavigationDesktop
      currentPath={currentPath}
      currentHash={currentHash}
      desktopLinks={navPrimaryLinks}
    />

    <NavigationMobile currentPath={currentPath} currentHash={currentHash} />
  </div>
</nav>

{
  /* Bundled scripts cannot be gated by a template conditional; the script
    itself no-ops when the page has no same-document hash links. */
}
<script>
  import "../scripts/navigation-home-hash.ts";
</script>
