---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import Search from "./Search.astro";
import Wordmark from "./Wordmark.astro";
import NavigationDesktop from "./navigation/NavigationDesktop.astro";
import NavigationMobile from "./navigation/NavigationMobile.astro";
import { normalizePath } from "../utils/navigation";

interface Props {
  currentPath?: string;
  currentHash?: string;
}

const {
  currentPath = Astro.url.pathname,
  currentHash = Astro.url.hash,
}: Props = Astro.props;

const normalizedPath = normalizePath(currentPath);
const isHome = normalizedPath === "/";
const isStart = normalizedPath === "/start";
---

<header class="nav" data-nav>
  <div class="nav__inner container">
    <a
      href="/"
      class="nav__brand"
      aria-label="Ethotechnics home"
      aria-current={isHome ? "page" : undefined}
    >
      <Logo class="nav__brand-logo" ariaHidden={true} />
      <Wordmark class="nav__wordmark" ariaHidden={true} />
    </a>

    <NavigationDesktop currentPath={currentPath} currentHash={currentHash} />

    <div class="nav__actions">
      <a
        href="/start"
        class:list={["nav__start-btn", { "nav__start-btn--active": isStart }]}
        aria-current={isStart ? "page" : undefined}
      >
        Start here
      </a>

      <div class="nav__search">
        <Search label="Search" shortcut="⌘K" />
      </div>

      <button
        class="theme-toggle nav__theme-desktop"
        data-theme-toggle
        aria-label="Toggle theme"
        type="button"
      >
        <Icon
          name="lucide:sun"
          class="theme-toggle__icon theme-toggle__icon--sun"
          aria-hidden="true"
        />
        <Icon
          name="lucide:moon"
          class="theme-toggle__icon theme-toggle__icon--moon"
          aria-hidden="true"
        />
      </button>

      <button
        class="nav__menu-btn"
        type="button"
        aria-controls="nav-drawer"
        aria-expanded="false"
        data-nav-drawer-open
      >
        <Icon name="lucide:menu" class="nav__menu-icon" aria-hidden="true" />
        <span class="nav__menu-label">Menu</span>
      </button>
    </div>
  </div>
</header>

<NavigationMobile currentPath={currentPath} currentHash={currentHash} />

<script>
  import "../client/navigation-menus.ts";
  import "../client/section-nav.ts";
</script>
