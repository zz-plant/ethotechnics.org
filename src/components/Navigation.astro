---
import NavigationDesktop from "./navigation/NavigationDesktop.astro";
import NavigationMobile from "./navigation/NavigationMobile.astro";
import { navPrimaryLinks } from "../content/navigation";
import navigationHomeHashScript from "../scripts/navigation-home-hash.ts?url";

interface Props {
  currentPath?: string;
  currentHash?: string;
}

const { currentPath = Astro.url.pathname, currentHash = Astro.url.hash } =
  Astro.props as Props;
---

<nav class="nav" aria-label="Primary" data-nav>
  <div class="nav__inner container">
    <NavigationDesktop
      currentPath={currentPath}
      currentHash={currentHash}
      desktopLinks={navPrimaryLinks}
    />

    <NavigationMobile
      currentPath={currentPath}
      currentHash={currentHash}
      mobileLinks={navPrimaryLinks}
    />
  </div>
</nav>

{
  currentPath === "/" && (
    <script type="module" src={navigationHomeHashScript} is:inline />
  )
}
