---
interface Props {
  title: string;
  author?: string;
  date?: string;
  url: string;
}

const {
  title,
  author = "Ethotechnics Institute",
  date = new Date().getFullYear().toString(),
  url,
} = Astro.props;
const apaCitation = `${author} (${date}). <i>${title}</i>. ${url}`;
const mlaCitation = `${author}. "${title}." <i>Ethotechnics Institute</i>, ${date}, ${url}.`;
---

<div
  class="cite-this"
  style="margin-top: var(--space-4); padding: var(--space-3); background: var(--surface-raised); border-radius: var(--radius-md); font-size: var(--text-sm);"
>
  <p class="eyebrow">Cite this</p>
  <p style="margin: 0.5rem 0;">
    <strong>APA:</strong>
    <span id="cite-apa"><Fragment set:html={apaCitation} /></span>
  </p>
  <p style="margin: 0.5rem 0 0.8rem;">
    <strong>MLA:</strong>
    <span id="cite-mla"><Fragment set:html={mlaCitation} /></span>
  </p>
  <div
    style="display: flex; gap: var(--space-2); flex-wrap: wrap; align-items: center;"
  >
    <button
      type="button"
      class="button button--compact ghost"
      id="cite-copy-apa-btn">Copy APA</button
    >
    <button
      type="button"
      class="button button--compact ghost"
      id="cite-copy-mla-btn">Copy MLA</button
    >
    <span
      id="cite-copy-status"
      role="status"
      aria-live="polite"
      style="display: none; color: var(--accent); font-weight: 600;"></span>
  </div>
</div>

<script>
  import "../scripts/cite-this.ts";
</script>
