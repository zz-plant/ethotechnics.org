---
import "@fontsource-variable/plus-jakarta-sans/wght.css";
import "@fontsource-variable/source-serif-4/wght.css";
import { SEO } from "astro-seo";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Navigation from "../components/Navigation.astro";
import SvgDefs from "../components/SvgDefs.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import Wordmark from "../components/Wordmark.astro";
import { siteFooter } from "../content/site-footer";
import glossaryHighlightsScript from "../scripts/glossary-highlights.ts?url";
import searchModalScript from "../scripts/search-modal.ts?url";
import { normalizeBreadcrumbItems } from "../lib/breadcrumbs";
import {
  buildJsonAlternateLinks,
  buildLanguageAlternates,
  normalizeDateTime,
  stringifyJsonLd,
} from "../utils/seo/alternate-jsonld";
import { resolveOgTemplate } from "../utils/seo/og-template";
import {
  resolveOpenGraphType,
  resolveStructuredDataType,
  type StructuredDataMode,
} from "../utils/seo/route-type";
import { buildSchemaGraph, type StructuredDataType } from "../utils/seo/schema";
import "../styles/theme.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  openGraphType?: string;
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /**
   * Optional class list for the <main> wrapper. Defaults to the standard
   * constrained layout (`"page container"`). Pass a custom value such as
   * "page page--wide" to allow full-bleed or alternative padding.
   */
  mainClass?: string;
  enableGlossaryHighlights?: boolean;
  breadcrumbItems?: Array<{ name: string; url: string }>;
  jsonAlternates?: Array<{ href: string; title?: string }>;
  structuredDataType?: StructuredDataMode;
  canonical?: string;
}

const siteName = "Ethotechnics Institute";
const defaultTitle =
  "Ethotechnics Institute — The Reference Standard for Accountable Systems";
const defaultDescription =
  "Ethotechnics.org is the Ethotechnics Institute: standards, mechanisms, and validators for ethical technology, AI governance, and accountable systems.";
const defaultRobots =
  "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const {
  title = defaultTitle,
  description = defaultDescription,
  openGraphType,
  robots = defaultRobots,
  publishedTime,
  modifiedTime,
  mainClass = "page container",
  enableGlossaryHighlights = true,
  breadcrumbItems,
  jsonAlternates,
  structuredDataType = "auto",
  canonical: canonicalProp,
}: Props = Astro.props;

const canonical =
  canonicalProp ||
  (Astro.site
    ? new URL(Astro.url.pathname, Astro.site).toString()
    : Astro.url.href);
const siteBase = Astro.site ? Astro.site.toString() : Astro.url.origin;
const currentPath = Astro.url.pathname;

const resolvedOpenGraphType = resolveOpenGraphType(currentPath, openGraphType);
const resolvedStructuredDataType = resolveStructuredDataType(
  currentPath,
  structuredDataType,
) as StructuredDataType;

const normalizedPublishedTime = normalizeDateTime(publishedTime);
const normalizedModifiedTime =
  normalizeDateTime(modifiedTime) ?? normalizedPublishedTime;

const organizationId = `${siteBase}#organization`;
const websiteId = `${siteBase}#website`;
const webpageId = canonical;
const { identity, navigation, cta } = siteFooter;
const logoUrl = new URL(identity.brand.logoSrc, siteBase).toString();
const logoId = `${siteBase}#logo`;
const primaryImageId = `${canonical}#primaryimage`;

const ogImageUrl = new URL("/api/og.png", siteBase);
ogImageUrl.searchParams.set("title", title);
ogImageUrl.searchParams.set("description", description);
ogImageUrl.searchParams.set(
  "template",
  resolveOgTemplate(undefined, currentPath),
);
ogImageUrl.searchParams.set("path", currentPath);

const seoImage = {
  src: ogImageUrl.toString(),
  alt: `${title} — Ethotechnics Institute`,
  width: 1200,
  height: 630,
};

const normalizedBreadcrumbItems = normalizeBreadcrumbItems({
  siteBase,
  currentPath,
  title,
  breadcrumbItems,
});

const structuredData = buildSchemaGraph({
  siteName,
  siteBase,
  siteDescription: defaultDescription,
  canonical,
  title,
  description,
  seoImage,
  organizationId,
  websiteId,
  webpageId,
  logoId,
  logoUrl,
  primaryImageId,
  structuredDataType: resolvedStructuredDataType,
  openGraphType: resolvedOpenGraphType,
  normalizedPublishedTime,
  normalizedModifiedTime,
  breadcrumbs: normalizedBreadcrumbItems,
});

const jsonAlternateLinks = buildJsonAlternateLinks(jsonAlternates);
const structuredDataJson = stringifyJsonLd(structuredData);
const languageAlternates = buildLanguageAlternates(canonical);

const pathSegments = currentPath.split("/").filter(Boolean);
const pagefindType = pathSegments[0] ?? "";
---

<!doctype html>
<html lang="en" id="top" data-pagefind-language="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <style is:inline>
      html,
      body {
        background-color: #f5f0e6;
        color: #2a2621;
      }

      @media (prefers-color-scheme: dark) {
        html,
        body {
          background-color: #1a1714;
          color: #e8e0d4;
        }
      }
    </style>
    <SEO
      title={title}
      titleDefault={defaultTitle}
      description={description}
      canonical={canonical}
      languageAlternates={languageAlternates}
      openGraph={{
        basic: {
          title,
          type: resolvedOpenGraphType,
          image: seoImage.src,
          url: canonical,
        },
        optional: {
          description,
          locale: "en_US",
          siteName,
        },
        article:
          resolvedOpenGraphType === "article"
            ? {
                publishedTime: normalizedPublishedTime,
                modifiedTime: normalizedModifiedTime,
              }
            : undefined,
        image: {
          alt: seoImage.alt,
          secureUrl: seoImage.src,
          type: "image/png",
          width: seoImage.width,
          height: seoImage.height,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: seoImage.src,
        imageAlt: seoImage.alt,
      }}
      extend={{
        link: [
          { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
          { rel: "apple-touch-icon", sizes: "180x180", href: "/apple-touch-icon.png" },
          { rel: "manifest", href: "/site.webmanifest" },
          ...jsonAlternateLinks,
        ],
        meta: [
          {
            name: "robots",
            content: robots,
          },
          { name: "author", content: siteName },
          { name: "publisher", content: siteName },
          { name: "theme-color", content: "#f5f0e6", media: "(prefers-color-scheme: light)" },
          { name: "theme-color", content: "#1a1714", media: "(prefers-color-scheme: dark)" },
        ],
      }}
    />
    <script
      type="application/ld+json"
      set:html={structuredDataJson}
      is:inline
    />
    <meta data-pagefind-meta="title" content={title} />
    <meta data-pagefind-meta="description" content={description} />
    {
      pagefindType ? (
        <meta data-pagefind-meta="type" content={pagefindType} />
      ) : null
    }
    <slot name="head" />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <SvgDefs />
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-shell">
      <header class="site-header" aria-label="Site header">
        <p class="institute-banner container">
          Open standards &amp; artifacts for accountable systems.
        </p>
      </header>
      <Navigation currentPath={currentPath} />
      <div class="page-shell__canvas">
        <div class="page-shell__panel">
          <main
            id="main-content"
            class={mainClass}
            tabindex="-1"
            data-glossary-highlights={enableGlossaryHighlights
              ? "true"
              : undefined}
            data-pagefind-body
          >
            <Breadcrumbs
              items={normalizedBreadcrumbItems}
              className="container page-breadcrumbs"
            />
            <slot />
          </main>
          <footer class="footer container" aria-label="Site footer">
            <section class="footer__section">
              <h2 class="eyebrow footer__heading">{identity.heading}</h2>
              <div class="footer__identity">
                <a
                  class="footer__brand"
                  href={identity.brand.href}
                  aria-label={identity.brand.ariaLabel}
                >
                  <img
                    src={identity.brand.logoSrc}
                    alt={identity.brand.logoAlt}
                    class="footer__logo"
                    loading="lazy"
                    decoding="async"
                    width="38"
                    height="38"
                  />
                  <Wordmark
                    class="footer__wordmark"
                    title={identity.brand.name}
                  />
                </a>
                <p class="muted">{identity.description}</p>
                <a
                  class="footer__link"
                  href={identity.license.href}
                  rel={identity.license.external
                    ? "noopener noreferrer"
                    : undefined}
                  target={identity.license.external ? "_blank" : undefined}
                >
                  {identity.license.label}
                </a>
                <a
                  class="footer__badge"
                  href={identity.license.href}
                  rel={identity.license.external
                    ? "noopener noreferrer"
                    : undefined}
                  target={identity.license.external ? "_blank" : undefined}
                >
                  <img
                    src={identity.licenseBadge.src}
                    alt={identity.licenseBadge.alt}
                    loading="lazy"
                    decoding="async"
                    width="88"
                    height="31"
                  />
                </a>
              </div>
            </section>
            <section class="footer__section">
              <NewsletterSignup />
            </section>
            {
              cta && (
                <section class="footer__section footer__cta">
                  <h2 class="eyebrow footer__heading">{cta.heading}</h2>
                  <p class="muted">{cta.description}</p>
                  <div class="footer__cta-actions">
                    {cta.links.map((link, index) => (
                      <a
                        class={`button button--compact ${
                          index === 0 ? "primary" : "ghost"
                        }`}
                        href={link.href}
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                </section>
              )
            }
            {
              navigation.map((section) => (
                <section class="footer__section">
                  <h2 class="eyebrow footer__heading">{section.heading}</h2>
                  <ul class="footer__list">
                    {section.links.map((link) => (
                      <li>
                        <a
                          class="footer__link"
                          href={link.href}
                          rel={
                            link.external ? "noopener noreferrer" : undefined
                          }
                          target={link.external ? "_blank" : undefined}
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </footer>
        </div>
      </div>
    </div>
    {
      enableGlossaryHighlights && (
        <script type="module" src={glossaryHighlightsScript} />
      )
    }
    <script type="module" src={searchModalScript} defer></script>
    <button class="back-to-top" data-back-to-top aria-label="Back to top" type="button" hidden>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <script is:inline>
      (() => {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* progress bar */
        const progressBar = document.querySelector('.scroll-progress');
        if (progressBar && !prefersReduced) {
          let ticking = false;
          const update = () => {
            const scrollTop = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            progressBar.style.width = docHeight > 0 ? (scrollTop / docHeight) * 100 + '%' : '0%';
            ticking = false;
          };
          window.addEventListener('scroll', () => {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          }, { passive: true });
        }

        /* back to top */
        const backToTop = document.querySelector('[data-back-to-top]');
        if (backToTop) {
          let ticking = false;
          const update = () => {
            backToTop.hidden = window.scrollY < window.innerHeight;
            ticking = false;
          };
          window.addEventListener('scroll', () => {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          }, { passive: true });
          backToTop.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
          });
        }

        /* mobile nav focus trap + inert */
        const mobileNav = document.querySelector('[data-mobile-nav]');
        if (mobileNav instanceof HTMLDetailsElement) {
          const pageRegions = () => {
            const main = document.getElementById('main-content');
            const footer = document.querySelector('.footer');
            return [main, footer].filter(Boolean);
          };

          let releaseFocusTrap = null;

          const trapFocus = (container) => {
            const focusable = container.querySelectorAll(
              'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
            );
            if (!focusable.length) return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            const onKeyDown = (e) => {
              if (e.key !== 'Tab') return;
              if (e.shiftKey) {
                if (document.activeElement === first) {
                  e.preventDefault();
                  last.focus();
                }
              } else {
                if (document.activeElement === last) {
                  e.preventDefault();
                  first.focus();
                }
              }
            };

            container.addEventListener('keydown', onKeyDown);
            return () => container.removeEventListener('keydown', onKeyDown);
          };

          mobileNav.addEventListener('toggle', () => {
            const isMobile = window.matchMedia('(max-width: 991px)').matches;
            if (mobileNav.open && isMobile) {
              pageRegions().forEach((el) => (el.inert = true));
              const firstLink = mobileNav.querySelector('a[href]');
              if (firstLink) firstLink.focus();
              if (releaseFocusTrap) releaseFocusTrap();
              releaseFocusTrap = trapFocus(mobileNav);
            } else {
              pageRegions().forEach((el) => (el.inert = false));
              if (releaseFocusTrap) {
                releaseFocusTrap();
                releaseFocusTrap = null;
              }
            }
          });
        }

        /* anchor scroll offset */
        document.addEventListener('click', (e) => {
          const link = e.target instanceof Element ? e.target.closest('a[href]') : null;
          if (!link) return;

          const href = link.getAttribute('href');
          if (!href || !href.includes('#') || href.startsWith('http') || href === '#') return;

          const parts = href.split('#');
          const hash = parts[1];
          if (!hash) return;

          const target = document.getElementById(hash);
          if (!target) return;

          const linkPath = parts[0];
          const current = window.location.pathname.replace(/\/$/, '');
          if (linkPath && linkPath.replace(/\/$/, '') !== current) return;

          e.preventDefault();

          const nav = document.querySelector('.nav');
          const navHeight = nav?.offsetHeight || 0;
          const top = target.getBoundingClientRect().top + window.scrollY - navHeight - 24;

          window.scrollTo({ top, behavior: prefersReduced ? 'auto' : 'smooth' });
          if (history.replaceState) {
            history.replaceState(null, '', href);
          }
        });
      })();
    </script>
  </body>
</html>
