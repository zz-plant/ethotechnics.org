---
import { SEO } from "astro-seo";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import InlineScript from "../components/InlineScript.astro";
import InlineStyle from "../components/InlineStyle.astro";
import Navigation from "../components/Navigation.astro";
import SvgDefs from "../components/SvgDefs.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import Wordmark from "../components/Wordmark.astro";
import { siteFooter } from "../content/site-footer";
import { normalizeBreadcrumbItems } from "../lib/breadcrumbs";
import {
  buildJsonAlternateLinks,
  buildLanguageAlternates,
  normalizeDateTime,
  stringifyJsonLd,
} from "../utils/seo/alternate-jsonld";
import { resolveOgTemplate } from "../utils/seo/og-template";
import {
  resolveOpenGraphType,
  resolveStructuredDataType,
  type StructuredDataMode,
} from "../utils/seo/route-type";
import { buildSchemaGraph, type StructuredDataType } from "../utils/seo/schema";

type FooterNavLink = { label: string; href: string; external?: boolean };
type FooterNavSection = { heading: string; links: FooterNavLink[] };

import "../styles/theme.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  openGraphType?: string;
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /**
   * Optional class list for the <main> wrapper. Defaults to the standard
   * constrained layout (`"page container"`). Pass a custom value such as
   * "page page--wide" to allow full-bleed or alternative padding.
   */
  mainClass?: string;
  enableGlossaryHighlights?: boolean;
  breadcrumbItems?: Array<{ name: string; url: string }>;
  jsonAlternates?: Array<{ href: string; title?: string }>;
  structuredDataType?: StructuredDataMode;
  canonical?: string;
}

const siteName = "Ethotechnics Institute";
const defaultTitle =
  "Ethotechnics Institute — The Reference Standard for Accountable Systems";
const defaultDescription =
  "Ethotechnics.org is the Ethotechnics Institute: standards, mechanisms, and validators for ethical technology, AI governance, and accountable systems.";
const defaultRobots =
  "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const {
  title = defaultTitle,
  description = defaultDescription,
  openGraphType,
  robots = defaultRobots,
  publishedTime,
  modifiedTime,
  mainClass = "page container",
  enableGlossaryHighlights = true,
  breadcrumbItems,
  jsonAlternates,
  structuredDataType = "auto",
  canonical: canonicalProp,
}: Props = Astro.props;

const canonical =
  canonicalProp ||
  (Astro.site
    ? new URL(Astro.url.pathname, Astro.site).toString()
    : Astro.url.href);
const siteBase = Astro.site ? Astro.site.toString() : Astro.url.origin;
const currentPath = Astro.url.pathname;

const resolvedOpenGraphType = resolveOpenGraphType(currentPath, openGraphType);
const resolvedStructuredDataType = resolveStructuredDataType(
  currentPath,
  structuredDataType,
) as StructuredDataType;

const normalizedPublishedTime = normalizeDateTime(publishedTime);
const normalizedModifiedTime =
  normalizeDateTime(modifiedTime) ?? normalizedPublishedTime;

const organizationId = `${siteBase}#organization`;
const websiteId = `${siteBase}#website`;
const webpageId = canonical;
const { identity, navigation } = siteFooter;
const footerNav = navigation as FooterNavSection[];
const logoUrl = new URL(identity.brand.logoSrc, siteBase).toString();
const logoId = `${siteBase}#logo`;
const primaryImageId = `${canonical}#primaryimage`;

const ogImageUrl = new URL("/api/og.png", siteBase);
ogImageUrl.searchParams.set("title", title);
ogImageUrl.searchParams.set("description", description);
ogImageUrl.searchParams.set(
  "template",
  resolveOgTemplate(undefined, currentPath),
);
ogImageUrl.searchParams.set("path", currentPath);

const seoImage = {
  src: ogImageUrl.toString(),
  alt: `${title} — Ethotechnics Institute`,
  width: 1200,
  height: 630,
};

const normalizedBreadcrumbItems = normalizeBreadcrumbItems({
  siteBase,
  currentPath,
  title,
  breadcrumbItems,
});

const structuredData = buildSchemaGraph({
  siteName,
  siteBase,
  siteDescription: defaultDescription,
  canonical,
  title,
  description,
  seoImage,
  organizationId,
  websiteId,
  webpageId,
  logoId,
  logoUrl,
  primaryImageId,
  structuredDataType: resolvedStructuredDataType,
  openGraphType: resolvedOpenGraphType,
  normalizedPublishedTime,
  normalizedModifiedTime,
  breadcrumbs: normalizedBreadcrumbItems,
});

const jsonAlternateLinks = buildJsonAlternateLinks(jsonAlternates);
const structuredDataJson = stringifyJsonLd(structuredData);

// Rendered inline so the page paints with the right background before the
// stylesheet arrives; InlineStyle/InlineScript register the CSP hashes.
const criticalCss = `html,
body {
  background-color: #f8fafc;
  color: #0f172a;
}

:root.dark,
:root.dark body {
  background-color: #0b0f19;
  color: #f8fafc;
}

@media (prefers-color-scheme: dark) {
  :root:not(.light),
  :root:not(.light) body {
    background-color: #0b0f19;
    color: #f8fafc;
  }
}`;

// Must run before the first paint, so it cannot be a bundled (deferred) script.
const themeBootScript = `(() => {
  const stored = localStorage.getItem("theme");
  if (
    stored === "dark" ||
    (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)
  ) {
    document.documentElement.classList.add("dark");
    document.documentElement.classList.remove("light");
  } else {
    document.documentElement.classList.add("light");
    document.documentElement.classList.remove("dark");
  }
})();`;
const languageAlternates = buildLanguageAlternates(canonical);

const pathSegments = currentPath.split("/").filter(Boolean);
const pagefindType = pathSegments[0] ?? "";
---

<!doctype html>
<html lang="en" id="top" data-pagefind-language="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <InlineStyle css={criticalCss} />
    <SEO
      title={title}
      titleDefault={defaultTitle}
      description={description}
      canonical={canonical}
      languageAlternates={languageAlternates}
      openGraph={{
        basic: {
          title,
          type: resolvedOpenGraphType,
          image: seoImage.src,
          url: canonical,
        },
        optional: {
          description,
          locale: "en_US",
          siteName,
        },
        article:
          resolvedOpenGraphType === "article"
            ? {
                publishedTime: normalizedPublishedTime,
                modifiedTime: normalizedModifiedTime,
              }
            : undefined,
        image: {
          alt: seoImage.alt,
          secureUrl: seoImage.src,
          type: "image/png",
          width: seoImage.width,
          height: seoImage.height,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: seoImage.src,
        imageAlt: seoImage.alt,
      }}
      extend={{
        link: [
          {
            rel: "icon",
            type: "image/svg+xml",
            href: "/favicon.svg",
            media: "(prefers-color-scheme: light)",
          },
          {
            rel: "icon",
            type: "image/svg+xml",
            href: "/favicon-dark.svg",
            media: "(prefers-color-scheme: dark)",
          },
          {
            rel: "apple-touch-icon",
            sizes: "180x180",
            href: "/apple-touch-icon.png",
          },
          { rel: "manifest", href: "/site.webmanifest" },
          {
            rel: "alternate",
            type: "application/rss+xml",
            title: "Ethotechnics Field Notes",
            href: "/rss.xml",
          },
          ...jsonAlternateLinks,
        ],
        meta: [
          {
            name: "robots",
            content: robots,
          },
          { name: "author", content: siteName },
          { name: "publisher", content: siteName },
          {
            name: "theme-color",
            content: "#f8fafc",
            media: "(prefers-color-scheme: light)",
          },
          {
            name: "theme-color",
            content: "#0b0f19",
            media: "(prefers-color-scheme: dark)",
          },
        ],
      }}
    />
    <InlineScript type="application/ld+json" code={structuredDataJson} />
    <meta data-pagefind-meta="title" content={title} />
    <meta data-pagefind-meta="description" content={description} />
    {
      pagefindType ? (
        <meta data-pagefind-meta="type" content={pagefindType} />
      ) : null
    }
    <slot name="head" />
    <meta name="color-scheme" content="light dark" />
    <InlineScript code={themeBootScript} />
  </head>
  <body>
    <div class="reading-progress" id="reading-progress" aria-hidden="true">
    </div>
    <SvgDefs />
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-shell">
      <Navigation currentPath={currentPath} />
      <div class="page-shell__content">
        <main
          id="main-content"
          class={mainClass}
          tabindex="-1"
          data-glossary-highlights={enableGlossaryHighlights
            ? "true"
            : undefined}
          data-pagefind-body
        >
          <Breadcrumbs
            items={normalizedBreadcrumbItems}
            className="container page-breadcrumbs"
          />
          <slot />
        </main>
        <footer class="footer container" aria-label="Site footer">
          <section class="footer__section">
            <h2 class="eyebrow footer__heading">{identity.heading}</h2>
            <div class="footer__identity">
              <a
                class="footer__brand"
                href={identity.brand.href}
                aria-label={identity.brand.ariaLabel}
              >
                <img
                  src={identity.brand.logoSrc}
                  alt={identity.brand.logoAlt}
                  class="footer__logo"
                  loading="lazy"
                  decoding="async"
                  width="38"
                  height="38"
                />
                <Wordmark
                  class="footer__wordmark"
                  title={identity.brand.name}
                />
              </a>
              <p class="muted">{identity.description}</p>
              <a
                class="footer__link"
                href={identity.license.href}
                rel={identity.license.external
                  ? "noopener noreferrer"
                  : undefined}
                target={identity.license.external ? "_blank" : undefined}
              >
                {identity.license.label}
              </a>
            </div>
          </section>
          <section class="footer__section">
            <NewsletterSignup />
          </section>
          {
            footerNav.map((section) => (
              <section class="footer__section">
                <h2 class="eyebrow footer__heading">{section.heading}</h2>
                <ul class="footer__list">
                  {section.links.map((link) => (
                    <li>
                      <a
                        class="footer__link"
                        href={link.href}
                        rel={link.external ? "noopener noreferrer" : undefined}
                        target={link.external ? "_blank" : undefined}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </footer>
      </div>
    </div>
    <button
      class="back-to-top"
      id="back-to-top"
      aria-label="Back to top"
      type="button"
      title="Back to top"
    >
      <svg class="back-to-top__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18 15l-6-6-6 6"></path>
      </svg>
    </button>
    {
      /* Both are bundled, so they load on every page; the highlighter is
        driven by the data-glossary-highlights attribute on <main>. */
    }
    <script>
      import "../scripts/glossary-highlights.ts";
    </script>
    <script>
      import "../scripts/search-modal.ts";
    </script>
    <script>
      import "../scripts/site-chrome.ts";
    </script>
  </body>
</html>
