---
import "@fontsource-variable/plus-jakarta-sans/index.css";
import "@fontsource-variable/source-serif-4/index.css";
import { SEO } from "astro-seo";
import Navigation from "../components/Navigation.astro";
import Wordmark from "../components/Wordmark.astro";
import SvgDefs from "../components/SvgDefs.astro";
import { siteFooter } from "../content/site-footer";
import glossaryHighlightsScript from "../scripts/glossary-highlights.ts?url";
import "../styles/theme.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  openGraphType?: string;
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /**
   * Optional class list for the <main> wrapper. Defaults to the standard
   * constrained layout (`"page container"`). Pass a custom value such as
   * "page page--wide" to allow full-bleed or alternative padding.
   */
  mainClass?: string;
  enableGlossaryHighlights?: boolean;
  breadcrumbItems?: Array<{ name: string; url: string }>;
  jsonAlternates?: Array<{ href: string; title?: string }>;
  structuredDataType?:
    | "auto"
    | "collection"
    | "webpage"
    | "defined-term"
    | "tech-article";
}

const siteName = "Ethotechnics Institute";
const defaultArticlePublishedTime = "2025-01-01T00:00:00.000Z";
const defaultTitle =
  "Ethotechnics Institute — The Reference Standard for Accountable Systems";
const defaultDescription =
  "Ethotechnics.org is the Ethotechnics Institute: standards, mechanisms, and validators for ethical technology, AI governance, and accountable systems.";
const defaultRobots =
  "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const {
  title = defaultTitle,
  description = defaultDescription,
  openGraphType,
  robots = defaultRobots,
  publishedTime,
  modifiedTime,
  mainClass = "page container",
  enableGlossaryHighlights = true,
  breadcrumbItems,
  jsonAlternates,
  structuredDataType = "auto",
} = Astro.props as Props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.href;
const siteBase = Astro.site ? Astro.site.toString() : Astro.url.origin;
const currentPath = Astro.url.pathname;
const nonArticleRoutes = new Set([
  "/",
  "/api",
  "/robots.txt",
  "/search",
  "/sitemap.xml",
]);
const isGlossaryRoute = currentPath.startsWith("/glossary");
const resolvedOpenGraphType =
  openGraphType ??
  (isGlossaryRoute || nonArticleRoutes.has(currentPath)
    ? "website"
    : "article");
const normalizeDateTime = (value?: string) => {
  if (!value) return undefined;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString();
};
const normalizedPublishedTime = normalizeDateTime(publishedTime);
const normalizedModifiedTime =
  normalizeDateTime(modifiedTime) ?? normalizedPublishedTime;
const resolvedPublishedTime =
  resolvedOpenGraphType === "article"
    ? normalizedPublishedTime ?? defaultArticlePublishedTime
    : undefined;
const resolvedModifiedTime =
  resolvedOpenGraphType === "article"
    ? normalizedModifiedTime ?? resolvedPublishedTime
    : undefined;
const organizationId = `${siteBase}#organization`;
const websiteId = `${siteBase}#website`;
const webpageId = canonical;
const { identity, navigation, cta } = siteFooter;
const logoUrl = new URL(identity.brand.logoSrc, siteBase).toString();
const logoId = `${siteBase}#logo`;
const primaryImageId = `${canonical}#primaryimage`;
const resolveOgTemplateFromPath = (path: string) => {
  if (path === "/") return "home";
  if (path.startsWith("/standards")) return "standards";
  if (path.startsWith("/glossary")) return "glossary";
  if (
    path.startsWith("/taxonomy") ||
    path.startsWith("/governance") ||
    path.startsWith("/delivery") ||
    path.startsWith("/assurance") ||
    path.startsWith("/experience")
  ) {
    return "taxonomy";
  }
  if (
    path.startsWith("/mechanisms") ||
    path.startsWith("/library") ||
    path.startsWith("/validators")
  ) {
    return "mechanisms";
  }
  if (
    path.startsWith("/research") ||
    path.startsWith("/incidents") ||
    path.startsWith("/field-notes") ||
    path.startsWith("/explainers")
  ) {
    return "editorial";
  }

  return "default";
};
const ogTemplate = resolveOgTemplateFromPath(currentPath);
const ogImageUrl = new URL("/api/og.png", siteBase);
ogImageUrl.searchParams.set("title", title);
ogImageUrl.searchParams.set("description", description);
ogImageUrl.searchParams.set("template", ogTemplate);
ogImageUrl.searchParams.set("path", currentPath);

const seoImage = {
  src: ogImageUrl.toString(),
  alt: `${title} — Ethotechnics Institute`,
  width: 1200,
  height: 630,
};
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: siteName,
  url: siteBase,
  description: defaultDescription,
  logo: {
    "@type": "ImageObject",
    "@id": logoId,
    url: logoUrl,
  },
  sameAs: [
    "https://ethotechnics.com",
    "https://syadvada.com",
    "https://github.com/zz-plant/ethotechnics",
  ],
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: siteName,
  url: siteBase,
  inLanguage: "en",
  publisher: {
    "@id": organizationId,
  },
  potentialAction: {
    "@type": "SearchAction",
    target: `${new URL("/search", siteBase).toString()}?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
const webpage: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": webpageId,
  name: title,
  description,
  url: canonical,
  inLanguage: "en",
  isPartOf: {
    "@id": websiteId,
  },
  publisher: {
    "@id": organizationId,
  },
  primaryImageOfPage: {
    "@type": "ImageObject",
    "@id": primaryImageId,
    url: seoImage.src,
    width: seoImage.width,
    height: seoImage.height,
    caption: seoImage.alt,
  },
  image: {
    "@id": primaryImageId,
  },
};
const structuredData: Array<Record<string, unknown>> = [
  organization,
  website,
  webpage,
];
const { cspNonce } = Astro.locals;
const jsonAlternateLinks =
  jsonAlternates?.map((link) => ({
    rel: "alternate",
    type: "application/json",
    href: link.href,
    title: link.title,
  })) ?? [];

const pathSegments = currentPath.split("/").filter(Boolean);
const pagefindType = pathSegments[0] ?? "";
const inferredBreadcrumbItems = breadcrumbItems?.length
  ? breadcrumbItems
  : [
      { name: "Home", url: new URL("/", siteBase).toString() },
      ...pathSegments.map((segment, index) => ({
        name: segment
          .replace(/-/g, " ")
          .replace(/\b\w/g, (letter) => letter.toUpperCase()),
        url: new URL(
          `/${pathSegments.slice(0, index + 1).join("/")}`,
          siteBase,
        ).toString(),
      })),
    ];

if (inferredBreadcrumbItems.length > 1) {
  const breadcrumbList = inferredBreadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: item.url,
  }));

  structuredData.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    itemListElement: breadcrumbList,
  });

  webpage.breadcrumb = {
    "@id": `${canonical}#breadcrumb`,
  };
}

const isIndexPage = currentPath === "/" || currentPath.endsWith("/");
const isGlossaryTerm =
  currentPath.startsWith("/glossary/") && pathSegments.length === 2;
const resolvedStructuredDataType =
  structuredDataType === "auto"
    ? isGlossaryTerm
      ? "defined-term"
      : isIndexPage
        ? "collection"
        : "webpage"
    : structuredDataType;

if (resolvedStructuredDataType === "collection") {
  webpage["@type"] = "CollectionPage";
}

if (resolvedStructuredDataType === "defined-term") {
  webpage["@type"] = "DefinedTerm";
  webpage.inDefinedTermSet = new URL("/glossary", siteBase).toString();
}

if (resolvedOpenGraphType === "article") {
  const articleJsonLd: Record<string, unknown> = {
    "@context": "https://schema.org",
    "@type":
      resolvedStructuredDataType === "tech-article" ? "TechArticle" : "Article",
    "@id": `${canonical}#article`,
    headline: title,
    description,
    image: [seoImage.src],
    author: {
      "@id": organizationId,
    },
    publisher: {
      "@id": organizationId,
    },
    mainEntityOfPage: {
      "@id": webpageId,
    },
    inLanguage: "en",
  };

  if (resolvedPublishedTime) {
    articleJsonLd.datePublished = resolvedPublishedTime;
  }

  if (resolvedModifiedTime) {
    articleJsonLd.dateModified = resolvedModifiedTime;
    webpage.dateModified = resolvedModifiedTime;
  }

  structuredData.push(articleJsonLd);
}

const structuredDataJson = JSON.stringify(structuredData);
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <style is:inline>
      :root {
        color-scheme: light;
      }

      html,
      body {
        background-color: #f5f0e6;
        color: #2a2621;
      }
    </style>
    <SEO
      title={title}
      titleDefault={defaultTitle}
      description={description}
      canonical={canonical}
      languageAlternates={[{ hrefLang: "en", href: canonical }]}
      openGraph={{
        basic: {
          title,
          type: resolvedOpenGraphType,
          image: seoImage.src,
          url: canonical,
        },
        optional: {
          description,
          locale: "en_US",
          siteName,
        },
        article:
          resolvedOpenGraphType === "article"
            ? {
                publishedTime: resolvedPublishedTime,
                modifiedTime: resolvedModifiedTime,
              }
            : undefined,
        image: {
          alt: seoImage.alt,
          secureUrl: seoImage.src,
          type: "image/png",
          width: seoImage.width,
          height: seoImage.height,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: seoImage.src,
        imageAlt: seoImage.alt,
      }}
      extend={{
        link: [
          { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
          { rel: "manifest", href: "/site.webmanifest" },
          ...jsonAlternateLinks,
        ],
        meta: [
          {
            name: "robots",
            content: robots,
          },
          { name: "author", content: siteName },
          { name: "publisher", content: siteName },
          { name: "theme-color", content: "#ffffff" },
        ],
      }}
    />
    <script
      type="application/ld+json"
      nonce={cspNonce}
      set:html={structuredDataJson}
      is:inline
    />
    <meta data-pagefind-meta="title" content={title} />
    <meta data-pagefind-meta="description" content={description} />
    {
      pagefindType ? (
        <meta data-pagefind-meta="type" content={pagefindType} />
      ) : null
    }
    <slot name="head" />
  </head>
  <body>
    <SvgDefs />
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-shell">
      <header class="site-header" aria-label="Site header">
        <p class="institute-banner container">
          Open standards &amp; artifacts for accountable systems.
        </p>
      </header>
      <Navigation currentPath={currentPath} />
      <div class="page-shell__canvas">
        <div class="page-shell__panel">
          <main
            id="main-content"
            class={mainClass}
            tabindex="-1"
            data-glossary-highlights={enableGlossaryHighlights
              ? "true"
              : undefined}
            data-pagefind-body
          >
            <slot />
          </main>
          <footer class="footer container" aria-label="Site footer">
            <section class="footer__section">
              <h2 class="eyebrow footer__heading">{identity.heading}</h2>
              <div class="footer__identity">
                <a
                  class="footer__brand"
                  href={identity.brand.href}
                  aria-label={identity.brand.ariaLabel}
                >
                  <img
                    src={identity.brand.logoSrc}
                    alt={identity.brand.logoAlt}
                    class="footer__logo"
                    loading="lazy"
                    decoding="async"
                    width="38"
                    height="38"
                  />
                  <Wordmark
                    class="footer__wordmark"
                    title={identity.brand.name}
                  />
                </a>
                <p class="muted">{identity.description}</p>
                <a
                  class="footer__link"
                  href={identity.license.href}
                  rel={identity.license.external
                    ? "noopener noreferrer"
                    : undefined}
                  target={identity.license.external ? "_blank" : undefined}
                >
                  {identity.license.label}
                </a>
                <a
                  class="footer__badge"
                  href={identity.license.href}
                  rel={identity.license.external
                    ? "noopener noreferrer"
                    : undefined}
                  target={identity.license.external ? "_blank" : undefined}
                >
                  <img
                    src={identity.licenseBadge.src}
                    alt={identity.licenseBadge.alt}
                    loading="lazy"
                    decoding="async"
                    width="88"
                    height="31"
                  />
                </a>
              </div>
            </section>
            {
              cta && (
                <section class="footer__section footer__cta">
                  <h2 class="eyebrow footer__heading">{cta.heading}</h2>
                  <p class="muted">{cta.description}</p>
                  <div class="footer__cta-actions">
                    {cta.links.map((link, index) => (
                      <a
                        class={`button button--compact ${
                          index === 0 ? "primary" : "ghost"
                        }`}
                        href={link.href}
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                </section>
              )
            }
            {
              navigation.map((section) => (
                <section class="footer__section">
                  <h2 class="eyebrow footer__heading">{section.heading}</h2>
                  <ul class="footer__list">
                    {section.links.map((link) => (
                      <li>
                        <a
                          class="footer__link"
                          href={link.href}
                          rel={
                            link.external ? "noopener noreferrer" : undefined
                          }
                          target={link.external ? "_blank" : undefined}
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </footer>
        </div>
      </div>
    </div>
    {
      enableGlossaryHighlights && (
        <script type="module" src={glossaryHighlightsScript} is:inline />
      )
    }
  </body>
</html>
